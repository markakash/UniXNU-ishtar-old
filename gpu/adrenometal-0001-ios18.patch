@@ -111,8 +111,18 @@ static void journal(const std::string &line) {
 @interface NBObject : NSObject
 @property(atomic,copy) NSString *label;
 @end
+static void nbIgnoredSetter(id self, SEL selector) {(void)self;(void)selector;}   // the setter's own arguments are ignored
 @implementation NBObject
 - (id<MTLDevice>)device {return gDeviceObject;}
+// ishtar (iOS 18.7.8): QuartzCore sends setters the iPadOS 17 runtime never did (-[MTLCommandBuffer setResponsibleTaskIDs:count:],
+// task attribution). A setter none of these classes implements is logged once and ignored instead of raising in the compositor.
+// ponytail: setters only; a missing getter still reaches doesNotRecognizeSelector, implement it when the log names one.
++ (BOOL)resolveInstanceMethod:(SEL)selector {
+ const char *name=sel_getName(selector);
+ if(strncmp(name,"set",3) || ![self isSubclassOfClass:[NBObject class]])return [super resolveInstanceMethod:selector];
+ NBLOG(@"native-metal: ignoring %s %s",class_getName(self),name);
+ return class_addMethod(self,selector,(IMP)nbIgnoredSetter,"v@:");
+}
 - (void)doesNotRecognizeSelector:(SEL)selector {
  if(gMissing)gMissing(class_getName(object_getClass(self)),sel_getName(selector));
  noteProblem([NSString stringWithFormat:@"missing %s %s",class_getName(object_getClass(self)),sel_getName(selector)]);
