+
+#if defined(ISHTAR)
+/*
+ * Bring-up diagnostics that bypass the console (no locks, no timers): a 40x40 block in one of four rows
+ * near the bottom of the panel. Usable from interrupt context once the video console has mapped the panel.
+ */
+void ishtar_diag_block(unsigned int row, unsigned int slot, uint32_t color);
+void
+ishtar_diag_block(unsigned int row, unsigned int slot, uint32_t color)
+{
+	unsigned long base = vinfo.v_baseaddr;
+	if (base == 0 || vinfo.v_depth != 32 || row > 3 || vinfo.v_height < 300) {
+		return;
+	}
+	unsigned int x0 = 40 + slot * 44, y0 = vinfo.v_height - 260 + row * 60;
+	if (x0 + 40 > vinfo.v_width) {
+		return;
+	}
+	for (unsigned int y = 0; y < 40; y++) {
+		volatile uint32_t *line = (volatile uint32_t *)(base + (unsigned long)(y0 + y) * vinfo.v_rowbytes);
+		for (unsigned int x = 0; x < 40; x++) {
+			line[x0 + x] = color;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+#endif /* ISHTAR */
