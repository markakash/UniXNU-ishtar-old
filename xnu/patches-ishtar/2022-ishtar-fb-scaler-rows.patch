+/*
+ * CPU scaler bands (patch 2022): the panel rows of one layer are cut into contiguous bands, one per thread; the caller
+ * scales the first band and ishtarfb_threads (default 4, 0 = caller only) worker threads the others, each with its own
+ * cached rows. ponytail: one job at a time (present() runs on the work loop), no affinity; pin to big cores if it matters.
+ */
+struct IshtarScaleJob {
+	const uint8_t *base;
+	uint64_t bpr, rowBytes;
+	uintptr_t draw;
+	const uint32_t *xmap;
+	int32_t sx, sy, w, h, dy, px0, n, py0, py1, padY;
+	uint32_t yNum, yDen;
+};
+#define ISHTAR_SCALE_MAX_THREADS 7
+static IshtarScaleJob gScaleJob;
+static IOLock *gScaleLock;
+static uint32_t gScaleGen, gScaleDone, gScaleThreads;
+
+static void
+ishtar_scale_band(const IshtarScaleJob &j, uint32_t band, uint32_t bands, uint32_t *rowIn, uint32_t *rowOut)
+{
+	int32_t rows = j.py1 - j.py0, a = j.py0 + (int32_t)((int64_t)rows * band / bands), b = j.py0 + (int32_t)((int64_t)rows * (band + 1) / bands);
+	int32_t built = -1;
+	for (int32_t py = a; py < b; py++) {
+		int32_t ly = (int32_t)((uint64_t)(py - j.padY) * j.yDen / j.yNum) - j.dy;
+		ly = ly < 0 ? 0 : (ly >= j.h ? j.h - 1 : ly);
+		if (ly != built) {
+			/*
+			 * The GPU writes the surface straight to DRAM; a cacheable kernel view may still hold lines of an earlier
+			 * frame (flip-1: 16-pixel streaks, one 64-byte line each, where content changed). Drop the row's lines first.
+			 */
+			const uint8_t *row = j.base + (uint64_t)(j.sy + ly) * j.bpr + (uint64_t)j.sx * 4;
+			for (uintptr_t a = (uintptr_t)row & ~(uintptr_t)63; a < (uintptr_t)row + (size_t)j.w * 4; a += 64) {
+				__asm__ volatile ("dc civac, %0" :: "r"(a) : "memory");
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+			memcpy(rowIn, row, (size_t)j.w * 4);
+			for (int32_t i = 0; i < j.n; i++) {
+				rowOut[i] = rowIn[j.xmap[i]];
+			}
+			built = ly;
+		}
+		memcpy((void *)((uint32_t *)(j.draw + (uint64_t)py * j.rowBytes) + j.px0), rowOut, (size_t)j.n * 4);
+	}
+}
+
+static void
+ishtar_scale_worker(void *arg, wait_result_t wr __unused)
+{
+	uint32_t band = (uint32_t)(uintptr_t)arg, seen = 0;
+	uint32_t *rowIn = (uint32_t *)IOMallocData(4096 * sizeof(uint32_t)), *rowOut = (uint32_t *)IOMallocData(4096 * sizeof(uint32_t));
+	for (;;) {
+		IOLockLock(gScaleLock);
+		while (gScaleGen == seen) {
+			IOLockSleep(gScaleLock, &gScaleGen, THREAD_UNINT);
+		}
+		seen = gScaleGen;
+		IshtarScaleJob job = gScaleJob;
+		IOLockUnlock(gScaleLock);
+		if (rowIn && rowOut && job.w <= 4096 && job.n <= 4096) {
+			ishtar_scale_band(job, band, gScaleThreads + 1, rowIn, rowOut);
+		}
+		IOLockLock(gScaleLock);
+		gScaleDone++;
+		IOLockWakeup(gScaleLock, &gScaleDone, false);
+		IOLockUnlock(gScaleLock);
+	}
+}
+
+/* Scales job's rows on the caller and the worker pool (started on first use); returns when every band is written. */
+static void
+ishtar_scale_rows(const IshtarScaleJob &job, uint32_t *rowIn, uint32_t *rowOut)
+{
+	static bool started;
+	if (!started) {
+		started = true;
+		uint32_t threads = 4;
+		PE_parse_boot_argn("ishtarfb_threads", &threads, sizeof(threads));
+		threads = threads > ISHTAR_SCALE_MAX_THREADS ? ISHTAR_SCALE_MAX_THREADS : threads;
+		gScaleLock = threads ? IOLockAlloc() : NULL;
+		for (uint32_t i = 0; gScaleLock && i < threads; i++) {
+			thread_t t;
+			if (kernel_thread_start(ishtar_scale_worker, (void *)(uintptr_t)(i + 1), &t) != KERN_SUCCESS) {
+				break;
+			}
+			thread_deallocate(t);
+			gScaleThreads++;
+		}
+		IOLog("ISHTAR FB: CPU scaler on %u threads\n", gScaleThreads + 1);
+	}
+	if (!gScaleThreads) {
+		ishtar_scale_band(job, 0, 1, rowIn, rowOut);
+		return;
+	}
+	IOLockLock(gScaleLock);
+	gScaleJob = job;
+	gScaleDone = 0;
+	gScaleGen++;
+	IOLockWakeup(gScaleLock, &gScaleGen, false);
+	IOLockUnlock(gScaleLock);
+	ishtar_scale_band(job, 0, gScaleThreads + 1, rowIn, rowOut);
+	IOLockLock(gScaleLock);
+	while (gScaleDone < gScaleThreads) {
+		IOLockSleep(gScaleLock, &gScaleDone, THREAD_UNINT);
+	}
+	IOLockUnlock(gScaleLock);
+}
