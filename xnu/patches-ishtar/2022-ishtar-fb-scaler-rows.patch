+/*
+ * SM8550 display path dump (boot-arg ishtarfb_dpuprobe=1, read-only): every DPU block of the mainline catalog
+ * (dpu_9_0_sm8550.h, offsets from the DPU top at 0xae01000) and the DSI0 controller, as the bootloader left them, two
+ * minutes after start (a read at 40 s, before the root and the USB log, stalled the boot with nothing logged). The ground truth for the SM8550 display driver (page flip, scaler, 120 Hz).
+ */
+static void __attribute__((unused))   /* the block dump, back once single reads answer */
+ishtar_dpu_dump_range(vm_offset_t base, const char *name, uint32_t from, uint32_t to)
+{
+	/* name first and a pause: a read that stalls the bus (a block without clock or power) leaves its name as the last line */
+	IOLog("ISHTAR DPU: reading %s +%03x..%03x\n", name, from, to);
+	IOSleep(100);
+	for (uint32_t off = from; off < to; off += 32) {
+		uint32_t v[8];
+		bool any = false;
+		for (int i = 0; i < 8; i++) {
+			v[i] = mdp_rd(base, off + 4 * i);
+			any |= v[i] != 0;
+		}
+		if (any) {
+			IOLog("ISHTAR DPU: %s +%03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", name, off,
+			    v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+		}
+	}
+}
+
+static void
+ishtar_dpu_probe_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	/* ishtarfb_dpuprobe=N: start N s after boot (default 120); the root and the USB log come up at 45-75 s */
+	uint32_t secs = 120;
+	PE_parse_boot_argn("ishtarfb_dpuprobe", &secs, sizeof(secs));
+	IOSleep((secs < 2 ? 120 : secs) * 1000);
+	vm_offset_t mdp = ml_io_map(0x0ae00000u, 0x84000u), dsi = ml_io_map(0x0ae94000u, 0x1000u);
+	if (mdp == 0 || dsi == 0) {
+		IOLog("ISHTAR DPU: no mapping\n");
+		return;
+	}
+	/*
+	 * One register at a time, each named before it is read (dpu-2: the first 32-byte group of the DPU top stalled the
+	 * bus): the hardware versions, the active CTL, VIG0/DMA0 sources and INTF_1 (DSI0). Widened once these answer.
+	 */
+	static const struct { const char *name; uint32_t off; bool dsi; } regs[] = {
+		{"mdss hw_version", 0x00000}, {"mdss hw_intr_status", 0x00010},
+		{"top +000", 0x01000}, {"top +004", 0x01004}, {"top +3fc hw_rev?", 0x013fc},
+		{"ctl0 top", 0x16014}, {"ctl0 flush", 0x16018}, {"ctl0 intf_active", 0x160f4}, {"ctl0 dsc_active", 0x160e8},
+		{"ctl0 pipe_active", 0x1612c}, {"ctl0 layer0", 0x16000},
+		{"vig0 src_size", 0x05000}, {"vig0 src0_addr", 0x05014}, {"vig0 ystride0", 0x05024}, {"vig0 format", 0x05030},
+		{"dma0 src_size", 0x25000}, {"dma0 src0_addr", 0x25014}, {"dma0 ystride0", 0x25024}, {"dma0 format", 0x25030},
+		{"intf1 timing_en", 0x36000}, {"intf1 config", 0x36004}, {"intf1 status", 0x3626c},
+		{"intf1 tear_check_en", 0x36284}, {"intf1 autorefresh", 0x362b4},
+		{"dsi0 hw_version", 0x000, true}, {"dsi0 ctrl", 0x004, true}, {"dsi0 status", 0x008, true},
+	};
+	for (uint32_t i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		IOLog("ISHTAR DPU: read %s\n", regs[i].name);
+		IOSleep(100);
+		IOLog("ISHTAR DPU: %s = %08x\n", regs[i].name, mdp_rd(regs[i].dsi ? dsi : mdp, regs[i].off));
+	}
+	IOLog("ISHTAR DPU: dump done\n");
+}
