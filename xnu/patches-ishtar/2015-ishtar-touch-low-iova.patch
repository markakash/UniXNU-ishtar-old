 	if (got < 2) {
 		printf("ISHTAR TOUCHPROBE: gpi xfer: %d events, last %08x %08x %08x %08x, ch0 %#x ch1 %#x glob %#x err %#x\n", got,
 		    ev[0], ev[1], ev[2], ev[3], gpi_rd(GPI_CH(0)), gpi_rd(GPI_CH(1)), gpi_rd(GPI_N(0x23100u)), gpi_rd(GPI_N(0x23200u)));
+		/* QUP FW error (TYPE_IRQ bit 6): GPII and SE8 state for diagnosis */
