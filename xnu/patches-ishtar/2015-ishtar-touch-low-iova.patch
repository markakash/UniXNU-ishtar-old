+		    gpi_rd(GPI_N(0x23080u)), gpi_rd(GPI_N(0x23090u)), gpi_rd(GPI_N(0x23094u)), gpi_rd(GPI_N(0x230b0u)), gpi_rd(GPI_N(0x23100u)));
+		for (uint32_t k = 0; k < 2; k++) {
