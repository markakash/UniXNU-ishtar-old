index 88e6ace..ef44f47 100644
--- a/bsd/dev/ishtar_smmu.c
+++ b/bsd/dev/ishtar_smmu.c
@@ -48,6 +48,8 @@ static int smmu_cb = -1;                /* shared translating context bank */
 static unsigned smmu_nsmr;
 static int smmu_next_smr;               /* first free SMR to try next */
 static volatile uint32_t smmu_lock;
+static volatile uint64_t *smmu_l1;      /* bank level-1 table (entries 0-1 = low 2 GiB, free) */
+static uint32_t smmu_cbo;               /* bank register offset */
 
 static uint32_t
 smmu_rd(uint32_t off)
@@ -118,6 +120,7 @@ smmu_bank_create(void)
 	}
 	uint64_t l1_pa = ptoa_64(pn);
 	volatile uint64_t *l1 = (volatile uint64_t *)l1v;
+	smmu_l1 = l1;
 	for (unsigned i = 2; i < 64; i++) {      /* ishtar: RAM reaches 0x9xxxxxxxx, map 2..64 GiB */
 		l1[i] = (uint64_t)i << 30 | 1u << 10 | 2u << 8 | 1u << 6 | 1;
 	}
@@ -130,6 +133,7 @@ smmu_bank_create(void)
 	flush_dcache64((addr64_t)l1_pa, L1_SIZE, TRUE);
 
 	uint32_t cb = cb0 + ((uint32_t)smmu_cb << pgshift);
+	smmu_cbo = cb;
 	unsigned asid = (unsigned)smmu_cb;
 	smmu_wr(cb + 0x0, 0);                                    /* SCTLR off while programming */
 	smmu_wr(cb + 0x58, 0xffffffffu);                        /* FSR clear */
@@ -156,6 +160,38 @@ smmu_bank_create(void)
 	return 0;
 }
 
+/*
+ * Map len bytes at iova (below 2 MiB) to pa with 4K pages in the shared bank, for
+ * masters whose stock DT limits IOVAs (qcom,iommu-dma-addr-pool). One call per boot.
+ */
+int
+ishtar_smmu_map_low(uint64_t iova, uint64_t pa, uint32_t len)
+{
+	vm_offset_t t = 0;
+	if (!smmu_l1 || smmu_l1[0] || iova + len > 0x200000 ||
+	    kmem_alloc_contig(kernel_map, &t, 2 * L1_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return EINVAL;
+	}
+	volatile uint64_t *l2 = (volatile uint64_t *)t, *l3 = (volatile uint64_t *)(t + L1_SIZE);
+	uint64_t l2_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)t));
+	uint64_t l3_pa = l2_pa + L1_SIZE;       /* 16K kernel pages: same page, +4K */
+	for (uint32_t o = 0; o < len; o += 0x1000) {
+		l3[((iova + o) >> 12) & 511] = (pa + o) | 1u << 10 | 2u << 8 | 1u << 6 | 3;
+	}
+	l2[0] = l3_pa | 3;
+	ishtar_dma_sync_va((const void *)t, 2 * L1_SIZE);
+	smmu_l1[0] = l2_pa | 3;
+	ishtar_dma_sync_va((const void *)smmu_l1, 8);
+	smmu_wr(smmu_cbo + 0x618, 0);
+	smmu_wr(smmu_cbo + 0x7f0, 0);
+	for (int i = 0; i < 100000 && (smmu_rd(smmu_cbo + 0x7f4) & 1); i++) {
+		delay(1);
+	}
+	printf("ISHTAR SMMU: iova %#llx -> %#llx (%#x)\n", iova, pa, len);
+	return 0;
+}
