+		}
+		vm_offset_t se = gd.se;
+		static const uint16_t sr[] = { 0x20, 0x24, 0x28, 0x40, 0x48, 0x64, 0x68, 0x7c, 0x258, 0x25c, 0x268, 0x600, 0x610,
+		    0x614, 0x640, 0x644, 0x800, 0x804, 0xc40, 0xd40, 0xe18, 0xe1c, 0xe10, 0xe14 };
+		for (uint32_t i = 0; i < sizeof(sr) / sizeof(sr[0]); i += 6) {
+			printf("ISHTAR TOUCHPROBE: se8 %03x=%#x %03x=%#x %03x=%#x %03x=%#x %03x=%#x %03x=%#x\n",
+			    sr[i], touch_rd(se, sr[i]), sr[i + 1], touch_rd(se, sr[i + 1]), sr[i + 2], touch_rd(se, sr[i + 2]),
+			    sr[i + 3], touch_rd(se, sr[i + 3]), sr[i + 4], touch_rd(se, sr[i + 4]), sr[i + 5], touch_rd(se, sr[i + 5]));
+		}
 		return -1;
 	}
