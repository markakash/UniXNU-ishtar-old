+/*
+ * FTM5 event loop (stock fts.c): scan mode active (A0 00 01), then on IRQ (gpio67, active low) read the
+ * FIFO (87 + dummy + 8-byte events) and report pointers. Super-resolution packing (fts,support-super-resolution):
+ * x = e3<<8|e2, y = e5<<8|e4 in 0..14400 x 0..32000 (fts,x-max/y-max) = 10x the 1440x3200 panel.
+ * Event ids: 13 enter, 23 motion, 33 leave; finger = e1 >> 4.
+ * ponytail: polls the irq line every 4 ms, GIC irq when latency matters.
+ */
+static volatile uint32_t fr_polls, fr_reads, fr_evs, fr_low, fr_fail, fr_stage;
+static vm_offset_t fr_tlmm;
+
+/* watchdog: shows where the event loop is even if it stalls (stage: 1 poll, 2 in FIFO read, 3 reporting) */
+static void
+fts_watch(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		delay(2000000);
+		printf("ISHTAR TOUCH: wd stage %u polls %u reads %u events %u fails %u irq-low %u | irq %u tx_wp %u rx_wp %u ev_rp %u "
+		    "ch0 %#x rp %#x ch1 %#x rp %#x gpii-stts %#x se8 %#x\n", fr_stage, fr_polls, fr_reads, fr_evs, fr_fail, fr_low,
+		    !(touch_rd(fr_tlmm + 67 * 0x1000u, 4) & 1u), gd.tx_wp, gd.rx_wp, gd.ev_rp, gpi_rd(GPI_CH(0)), gpi_rd(GPI_CH(0) + 0x10),
+		    gpi_rd(GPI_CH(1)), gpi_rd(GPI_CH(1) + 0x10), gpi_rd(GPI_N(0x23118u)), touch_rd(gd.se, 0x40));
+	}
+}
+
+static void
+fts_run(vm_offset_t tlmm)
+{
+	static const uint8_t scan_on[3] = { 0xa0, 0x00, 0x01 }, fifo[1] = { 0x87 };
+	uint8_t rx[1 + 8 * 8];
+	int raw = 40;
+	PE_parse_boot_argn("ishtartouchraw", &raw, sizeof(raw));
+	static const uint8_t scan_off[3] = { 0xa0, 0x00, 0x00 };
+	/* stock fts_fw_update tail: mode handler sense on (01), then 00, 01 */
+	gpi_spi_xfer2(scan_on, 3, rx, 0);
+	gpi_spi_xfer2(scan_off, 3, rx, 0);
+	gpi_spi_xfer2(scan_on, 3, rx, 0);
+	/*
+	 * HyperOS runs THP (raw frames to the THP-ALG daemon; logcat "[THP-ALG] alg_input_report"). Without a host
+	 * algorithm switch the fw to native reporting, exactly stock fts_enable_thp_onoff(0): scan off, C0 21 01, scan on.
+	 */
+	int thp_off = 1;
+	PE_parse_boot_argn("ishtartouchthpoff", &thp_off, sizeof(thp_off));
+	if (thp_off) {
+		static const uint8_t thp[3] = { 0xc0, 0x21, 0x01 };
+		gpi_spi_xfer2(scan_off, 3, rx, 0);
+		gpi_spi_xfer2(thp, 3, rx, 0);
+		gpi_spi_xfer2(scan_on, 3, rx, 0);
+	}
+	printf("ISHTAR TOUCH: FTM5 running (scan on, thp %s, irq gpio67)\n", thp_off ? "off" : "on");
+	tp_quiet = true;
+	tp_pace_ms = 0;
+	fr_tlmm = tlmm;
+	thread_t wt;
+	(void)kernel_thread_start(fts_watch, NULL, &wt);
+	thread_deallocate(wt);
+	for (;;) {
+		fr_stage = 1;
+		bool irq = !(touch_rd(tlmm + 67 * 0x1000u, 4) & 1u);
+		fr_polls++;
+		fr_low += irq;
+		if (!irq && fr_polls % 125 != 0) {     /* irq high: still read the FIFO every ~500 ms */
+			delay(4000);
+			continue;
+		}
+		fr_reads++;
+		fr_stage = 2;
+		uint32_t w0 = gd.tx_wp, r0 = gd.rx_wp;
+		int rc = gpi_spi_xfer2(fifo, 1, rx, sizeof(rx));
+		if (fr_reads <= 100 || fr_reads % 50 == 0) {
+			printf("ISHTAR TOUCH: read %u irq %d rc %d tx_wp %u->%u rx_wp %u->%u ev_rp %u raw %02x | %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    fr_reads, irq, rc, w0, gd.tx_wp, r0, gd.rx_wp, gd.ev_rp, rx[0], rx[1], rx[2], rx[3], rx[4], rx[5], rx[6], rx[7], rx[8]);
+		}
+		if (fr_reads % 20 == 0 && fr_reads <= 400) {     /* is the chip still alive and in fw? */
+			static const uint8_t idc[5] = { 0xfb, 0x20, 0x00, 0x00, 0x00 };
+			uint8_t idr[4] = { 0 };
+			int irc = gpi_spi_xfer2(idc, 5, idr, 3);
+			printf("ISHTAR TOUCH: alive check rc %d chip id %02x %02x %02x irq %d\n", irc, idr[0], idr[1], idr[2],
+			    !(touch_rd(tlmm + 67 * 0x1000u, 4) & 1u));
+		}
+		if (rc != 0) {
+			fr_fail++;
+			delay(10000);
+			continue;
+		}
+		fr_stage = 3;
+		for (uint32_t k = 0; k < 8; k++) {
+			const uint8_t *e = rx + 1 + 8 * k;
+			if (e[0] == 0) {
+				break;
+			}
+			fr_evs++;
+			if (raw > 0) {
+				raw--;
+				printf("ISHTAR TOUCH: ev %02x %02x %02x %02x %02x %02x %02x %02x\n", e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+			}
+			int id = e[1] >> 4, x = ((e[3] << 8) | e[2]) / 10, y = ((e[5] << 8) | e[4]) / 10;
+			if (id >= (int)TOUCH_MAX) {
+				continue;
+			}
+			if (e[0] == 0x13 || e[0] == 0x23) {
+				ishtar_hid_touch(id, 1, x, y);
+			} else if (e[0] == 0x33) {
+				ishtar_hid_touch(id, 0, x, y);
+			}
+		}
+	}
+}
+
 static void
 ishtar_touch_probe(int stage)
 {
