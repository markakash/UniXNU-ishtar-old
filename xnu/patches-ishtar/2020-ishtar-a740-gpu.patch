+IOReturn NativeAdrenoPwrupList::buildA740(int (*read)(void *,uint32_t,uint32_t *),
+    void *cookie,uint8_t *out,size_t capacity,size_t *written)
+{
+    if(!read || !out || !written)return kIOReturnBadArgument;
+    uint32_t values[NATIVE_ADRENO_A740_PWRUP_COUNT]={};
+    for(size_t index=0;index<NATIVE_ADRENO_A740_PWRUP_COUNT;++index)
+        if(read(cookie,NativeAdrenoA740PwrupRegs[index],&values[index]))
+            return kIOReturnIOError;
+    const NativeAdrenoPwrupCounts counts={0,NATIVE_ADRENO_A740_PWRUP_COUNT,0};
+    return pack(counts,nullptr,nullptr,NativeAdrenoA740PwrupRegs,values,nullptr,
+        out,capacity,written);
+}
+IOReturn NativeAdrenoPwrupList::pack(const NativeAdrenoPwrupCounts &counts,
+    const uint32_t *ifpc_regs,const uint32_t *ifpc_values,
+    const uint32_t *preemption_regs,const uint32_t *preemption_values,
+    const uint32_t *dynamic_triplets,uint8_t *out,size_t capacity,size_t *written)
+{
+    if(!out || !written)return kIOReturnBadArgument;
+    *written=0;
+    if(counts.ifpc>0xff || counts.preemption>0xff || counts.dynamic>0xffff)
+        return kIOReturnBadArgument;
+    const size_t needed=requiredBytes(counts);
+    if(capacity<needed)return kIOReturnNoResources;
+    if((counts.ifpc && (!ifpc_regs || !ifpc_values)) ||
+        (counts.preemption && (!preemption_regs || !preemption_values)) ||
+        (counts.dynamic && !dynamic_triplets))return kIOReturnBadArgument;
+    memset(out,0,needed);
+    /* gpu_req/cpu_req/turn stay zero; unions carry the list lengths. */
+    out[12]=static_cast<uint8_t>(counts.ifpc);
+    out[13]=static_cast<uint8_t>(counts.preemption);
+    out[14]=static_cast<uint8_t>(counts.dynamic&0xff);
+    out[15]=static_cast<uint8_t>((counts.dynamic>>8)&0xff);
+    uint32_t *cursor=reinterpret_cast<uint32_t *>(out+HeaderBytes);
+    for(uint32_t i=0;i<counts.ifpc;++i) {
+        *cursor++=ifpc_regs[i];*cursor++=ifpc_values[i];
+    }
+    for(uint32_t i=0;i<counts.preemption;++i) {
+        *cursor++=preemption_regs[i];*cursor++=preemption_values[i];
+    }
+    for(uint32_t i=0;i<counts.dynamic;++i) {
+        *cursor++=dynamic_triplets[i*3];
+        *cursor++=dynamic_triplets[i*3+1];
+        *cursor++=dynamic_triplets[i*3+2];
+    }
+    *written=needed;
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoPwrup.h b/iokit/Kernel/arm/a740/NativeAdrenoPwrup.h
new file mode 100644
index 0000000..fa95865
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoPwrup.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_PWRUP_H
+#define NATIVE_ADRENO_PWRUP_H
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Pack the A7xx power-up register list consumed by CP_ME_INIT. The layout is
+ * the pinned `struct cpu_gpu_lock`: three u32 lock words, a union of either
+ * {u8 ifpc_len, u8 preemption_len, u16 dynamic_len} (A7xx) or two u16 fields
+ * (A6xx), then 64-bit register slots holding {reg, current value} pairs and
+ * 12-byte dynamic triplets {aperture, offset, value}. Only the A7xx form is
+ * packed here. Values must come from actual register reads at bring-up; this
+ * function never invents one, never reads MMIO and never clears the lock words
+ * silently. Capacity and count limits are checked before any write. */
+struct NativeAdrenoPwrupCounts {
+    uint32_t ifpc;
+    uint32_t preemption;
+    uint32_t dynamic;
+};
+class NativeAdrenoPwrupList final {
+    NativeAdrenoPwrupList()=delete;
+public:
+    static size_t requiredBytes(const NativeAdrenoPwrupCounts &);
+    /* regs/values are parallel arrays; dynamic triplets are {aperture,offset,
+     * value} in that order. Output is the exact byte image; *written receives
+     * the length on success. */
+    /* Read the sixteen A740 preemption registers through the callback (raw
+     * 32-bit GPU register reads) and pack them with zero IFPC and dynamic
+     * counts. A read failure refuses and writes nothing. */
+    static IOReturn buildA740(int (*read)(void *,uint32_t,uint32_t *),void *cookie,
+        uint8_t *out,size_t capacity,size_t *written);
+    static IOReturn pack(const NativeAdrenoPwrupCounts &,
+        const uint32_t *ifpc_regs,const uint32_t *ifpc_values,
+        const uint32_t *preemption_regs,const uint32_t *preemption_values,
+        const uint32_t *dynamic_triplets,uint8_t *out,size_t capacity,size_t *written);
+};
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoPwrupRegs.h b/iokit/Kernel/arm/a740/NativeAdrenoPwrupRegs.h
new file mode 100644
index 0000000..570f464
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoPwrupRegs.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_PWRUP_REGS_H
+#define NATIVE_ADRENO_PWRUP_REGS_H
+#include <stdint.h>
+/* Generated by scripts/derive-a740-pwrup.py from the pinned
+ * a6xx_catalog.c list and the pinned XMLs, selecting only entries whose
+ * variants include A7XX. Do not edit by hand. */
+static const uint32_t NativeAdrenoA740PwrupRegs[]={
+    0x00000e09,
+    0x00000e0a,
+    0x00000e07,
+    0x00000e08,
+    0x00000e0b,
+    0x00000e0c,
+    0x00000e0d,
+    0x00000e0e,
+    0x00000e17,
+    0x00000e01,
+    0x00008e08,
+    0x00008e28,
+    0x00008e50,
+    0x00000e3a,
+    0x00000e19,
+    0x0000b602,
+};
+#define NATIVE_ADRENO_A740_PWRUP_COUNT \
+    (sizeof(NativeAdrenoA740PwrupRegs)/sizeof(NativeAdrenoA740PwrupRegs[0]))
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoRing.cpp b/iokit/Kernel/arm/a740/NativeAdrenoRing.cpp
new file mode 100644
index 0000000..007608f
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoRing.cpp
@@ -0,0 +1,285 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoRing.h"
+#include "AdrenoPM4.h"
+#include <IOKit/IOLib.h>
+
+/* Values are taken from the pinned Linux source, not guessed:
+ * drivers/gpu/drm/msm/registers/adreno/a6xx.xml (register offsets), and
+ * registers/adreno/adreno_pm4.xml (opcode 0x46 CP_EVENT_WRITE7, event 0x31
+ * CACHE_CLEAN, WRITE_SRC bits 20..22, WRITE_DST bit 24, WRITE_ENABLED bit 27,
+ * IRQ bit 31). CP_RB_CNTL BUFSZ bits 0..5 and BLKSZ bits 8..13 are the same
+ * fields MSM_GPU_RB_CNTL_DEFAULT programs. All are dword register indices. */
+enum : uint32_t {
+    RingBase = 0x0800,        /* 64-bit CP_RB_BASE */
+    RingControl = 0x0802,     /* CP_RB_CNTL */
+    RingRptrAddress = 0x0804, /* 64-bit CP_RB_RPTR_ADDR */
+    RingRptr = 0x0806,
+    RingWptr = 0x0807,
+    RingScratch = 0x0885,     /* CP_SCRATCH(2) for A6XX..A7XX */
+    RingFenceOpcode = 0x46,   /* CP_EVENT_WRITE7 on A7XX */
+    RingFenceEvent = 0x31,    /* CACHE_CLEAN */
+    RingFenceEnable = 1u << 27,
+    RingFenceIrq = 1u << 31,
+    RingBlockBytes = 32,
+    /* A7XX framing, as a7xx_submit() in the pinned a6xx_gpu.c emits it: CP_THREAD_CONTROL (0x17; THREAD bits 0..1,
+     * BR 1, BV 2, BOTH 3; SYNC_THREADS bit 31), CP_SET_MARKER (0x65; 0x101 IFPC disable, 0x100 enable), CCU_INVALIDATE_DEPTH
+     * 0x18 / CCU_INVALIDATE_COLOR 0x19 and CP_WAIT_TIMESTAMP (0x14) from adreno_pm4.xml. User command streams synchronize
+     * the BR and BV threads themselves (Turnip waits on BV timestamps), so the IBs must run with both threads enabled. */
+    RingThreadControl = 0x17,
+    RingThreadBr = 1,
+    RingThreadBv = 2,
+    RingThreadBoth = 3,
+    RingSyncThreads = 1u << 31,
+    RingSetMarker = 0x65,
+    RingWaitTimestamp = 0x14,
+    RingCcuInvalidateDepth = 0x18,
+    RingCcuInvalidateColor = 0x19,
+    /* What the SQE's CP_SMMU_TABLE_UPDATE handler does before it switches tables (a740_sqe.fw, qrisc-disasm): CACHE_FLUSH7 (0x32)
+     * and CACHE_INVALIDATE7 (0x33) with a wait for idle (CP_WAIT_FOR_IDLE 0x26). Linux gets these from that packet on every context
+     * switch; this ring never sends it, and event 0x31 is only CACHE_CLEAN on A7XX, so nothing else ever invalidated UCHE. */
+    RingCacheFlush7 = 0x32,
+    RingCacheInvalidate7 = 0x33,
+    RingWaitForIdle = 0x26,
+    RingPrologueWords = 11,
+    /* a6xx_set_pagetable()'s A7XX context entry: CP_RESET_CONTEXT_STATE (0x1f; CLEAR_ON_CHIP_TS, CLEAR_RESOURCE_TABLE,
+     * CLEAR_BV_BR_COUNTER, RESET_GLOBAL_LOCAL_TS = bits 0..3) between thread syncs, LRZ_FLUSH_INVALIDATE (0x26), the
+     * RBBM_PERFCTR_SRAM_INIT_CMD (0x050e) write and CACHE_INVALIDATE (0x31), after a CP_WAIT_TIMESTAMP on the last fence, then the
+     * CP_WAIT_REG_MEM (0x3c, WRITE_EQ) on RBBM_PERFCTR_SRAM_INIT_STATUS (0x050f) bit 0 that Linux always emits after the SRAM init
+     * write. Without that wait the client's first IB started while the SRAM was still clearing; on ishtar (int-064..067) the CP then
+     * stopped on the IB's first CP_THREAD_CONTROL, while the same IB retired under the Linux driver. */
+    RingResetContextState = 0x1f,
+    RingResetAll = 0xf,
+    RingLrzFlushInvalidate = 0x26,
+    RingCacheInvalidate = 0x31,
+    RingPerfctrSramInit = 0x050e,
+    RingPerfctrSramInitStatus = 0x050f,
+    RingWaitRegMem = 0x3c,
+    RingWaitWriteEq = 3,
+    RingResetWords = 26,
+    RingFenceWords = 7,       /* kernel bring-up submissions: TYPE4 scratch + TYPE7 event */
+    RingFramedFenceWords = 31,/* user submissions: scratch, BV timestamp, BR wait, ring timestamp */
+    RingBvFenceOffset = 12    /* msm_rbmemptrs.bv_fence; +8 is bv_rptr, the BV RPTR shadow hw init programs */
+};
+static uint32_t ilog2(size_t value)
+{
+    uint32_t result=0;while(value>1) {value>>=1;++result;}return result;
+}
+/* The last submissions as the CP will read them: [slot] fence, start index, end index, word count, then up to 112 ring words from the start. The board log
+ * prints them, so a fence the GPU never wrote can be compared with the packets that should have written it. */
+extern "C" {volatile uint32_t native_adreno_ring_log[4][4+112];volatile uint32_t native_adreno_ring_log_count;}
+IOReturn NativeAdrenoRing::poison()
+{
+    poisoned_=true;return kIOReturnIOError;
+}
+IOReturn NativeAdrenoRing::readRptr(uint32_t *value)
+{
+    uint32_t rptr=0;
+    if(io_.read32(io_.cookie,RingRptr,&rptr))return poison();
+    if(rptr>=ring_bytes_/4)return poison(); /* unusable read pointer */
+    *value=rptr;rptr_shadow_=rptr;return kIOReturnSuccess;
+}
+/* Packs one TYPE7 packet into words; returns the next free index or 0 when the header cannot be built. */
+static size_t packet(uint32_t *words,size_t at,uint32_t opcode,const uint32_t *payload,uint32_t count)
+{
+    if(AdrenoPM4Type7(opcode,count,&words[at])!=AdrenoPM4Success)return 0;
+    for(uint32_t i=0;i<count;++i)words[at+1+i]=payload[i];
+    return at+1+count;
+}
+/* Thread selection and IFPC disable before the user buffers, as a7xx_submit() does; the first submission after
+ * requestContextReset() also carries the context entry a6xx_set_pagetable() emits when a new context first submits.
+ * Every prologue ends its BR-only part with the GPU cache flush and invalidate described at RingCacheFlush7. */
+IOReturn NativeAdrenoRing::emitPrologue(uint32_t at,bool reset,uint32_t *end)
+{
+    const uint32_t mask=(uint32_t)(ring_bytes_/4-1);
+    uint32_t words[RingPrologueWords+RingResetWords]={0};
+    const uint32_t br=RingSyncThreads|RingThreadBr,syncBoth=RingSyncThreads|RingThreadBoth,both=RingThreadBoth,marker=0x101;
+    const uint32_t count=RingPrologueWords+(reset?RingResetWords:0);
+    size_t n=packet(words,0,RingThreadControl,&br,1);
+    if(reset) {
+        const uint64_t at4=fence_iova_+4;
+        const uint32_t wait[4]={0,(uint32_t)at4,(uint32_t)(at4>>32),seqno_},all=RingResetAll,lrz=RingLrzFlushInvalidate,
+            invalidate=RingCacheInvalidate;
+        if(n)n=packet(words,n,RingWaitTimestamp,wait,4);
+        if(n)n=packet(words,n,RingThreadControl,&syncBoth,1);
+        if(n)n=packet(words,n,RingResetContextState,&all,1);
+        if(n)n=packet(words,n,RingThreadControl,&syncBoth,1);
+        if(n)n=packet(words,n,RingFenceOpcode,&lrz,1);
+        if(n)n=packet(words,n,RingThreadControl,&br,1);
+        if(n && AdrenoPM4Type4(RingPerfctrSramInit,1,&words[n])==AdrenoPM4Success) {words[n+1]=1;n+=2;} else n=0;
+        if(n)n=packet(words,n,RingFenceOpcode,&invalidate,1);
+        const uint32_t sram[6]={RingWaitWriteEq,RingPerfctrSramInitStatus,0,1,1,0};
+        if(n)n=packet(words,n,RingWaitRegMem,sram,6);
+    }
+    const uint32_t flush=RingCacheFlush7,invalidate7=RingCacheInvalidate7;
+    if(n)n=packet(words,n,RingFenceOpcode,&flush,1);
+    if(n)n=packet(words,n,RingFenceOpcode,&invalidate7,1);
+    if(n)n=packet(words,n,RingWaitForIdle,nullptr,0);
+    if(n)n=packet(words,n,RingThreadControl,&both,1);
+    if(n)n=packet(words,n,RingSetMarker,&marker,1);
+    if(n!=count)return poison();
+    for(uint32_t i=0;i<count;++i)ring_[(at+i)&mask]=words[i];
+    *end=(at+count)&mask;return kIOReturnSuccess;
+}
+/* Writes the timestamp fence that makes a submission observable. */
+IOReturn NativeAdrenoRing::emitFence(uint32_t at,uint32_t seqno,uint32_t *end)
+{
+    const uint32_t mask=(uint32_t)(ring_bytes_/4-1);
+    uint32_t words[RingFenceWords]={0};
+    if(AdrenoPM4Type4(RingScratch,1,&words[0])!=AdrenoPM4Success ||
+        AdrenoPM4Type7(RingFenceOpcode,4,&words[2])!=AdrenoPM4Success)return poison();
+    words[1]=seqno;
+    words[3]=RingFenceEvent|RingFenceEnable|RingFenceIrq;
+    /* The timestamp goes to +4 (msm_rbmemptrs.fence), where wait() reads it; +0 is the CP's RPTR shadow. */
+    const uint64_t at4=fence_iova_+4;
+    words[4]=(uint32_t)at4;words[5]=(uint32_t)(at4>>32);words[6]=seqno;
+    for(uint32_t i=0;i<RingFenceWords;++i)ring_[(at+i)&mask]=words[i];
+    *end=(at+RingFenceWords)&mask;return kIOReturnSuccess;
+}
+/* The fence of a framed submission: CP_SCRATCH(2), the BV thread's timestamp, a BR wait for it (so BR cannot report the
+ * submission while BV still works on it), then the ring timestamp with an interrupt, both threads and IFPC back on. */
+IOReturn NativeAdrenoRing::emitFramedFence(uint32_t at,uint32_t seqno,uint32_t *end)
+{
+    const uint32_t mask=(uint32_t)(ring_bytes_/4-1);
+    uint32_t words[RingFramedFenceWords]={0};
+    if(AdrenoPM4Type4(RingScratch,1,&words[0])!=AdrenoPM4Success)return poison();
+    words[1]=seqno;
+    /* The timestamp goes to +4 (msm_rbmemptrs.fence), where wait() reads it; +0 is the CP's RPTR shadow. */
+    const uint64_t at4=fence_iova_+4,bv=fence_iova_+RingBvFenceOffset;
+    const uint32_t br=RingThreadBr,bvThread=RingThreadBv,both=RingThreadBoth,depth=RingCcuInvalidateDepth,
+        color=RingCcuInvalidateColor,marker=0x100;
+    const uint32_t bvWrite[4]={RingFenceEvent|RingFenceEnable,(uint32_t)bv,(uint32_t)(bv>>32),seqno};
+    const uint32_t bvWait[4]={0,(uint32_t)bv,(uint32_t)(bv>>32),seqno};
+    const uint32_t fence[4]={RingFenceEvent|RingFenceEnable|RingFenceIrq,(uint32_t)at4,(uint32_t)(at4>>32),seqno};
+    size_t n=packet(words,2,RingThreadControl,&br,1);
+    if(n)n=packet(words,n,RingFenceOpcode,&depth,1);
+    if(n)n=packet(words,n,RingFenceOpcode,&color,1);
+    if(n)n=packet(words,n,RingThreadControl,&bvThread,1);
+    if(n)n=packet(words,n,RingFenceOpcode,bvWrite,4);
+    if(n)n=packet(words,n,RingThreadControl,&br,1);
+    if(n)n=packet(words,n,RingWaitTimestamp,bvWait,4);
+    if(n)n=packet(words,n,RingFenceOpcode,fence,4);
+    if(n)n=packet(words,n,RingThreadControl,&both,1);
+    if(n)n=packet(words,n,RingSetMarker,&marker,1);
+    if(n!=RingFramedFenceWords)return poison();
+    for(uint32_t i=0;i<RingFramedFenceWords;++i)ring_[(at+i)&mask]=words[i];
+    *end=(at+RingFramedFenceWords)&mask;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoRing::attach(const NativeAdrenoRingIo *io,const NativeAdrenoRingCache *cache,
+    void *ring,size_t ring_bytes,uint64_t ring_iova,void *fence,size_t fence_bytes,uint64_t fence_iova)
+{
+    if(attached_ || poisoned_ || ring_ || fence_)return kIOReturnBusy;
+    if(!io || !io->write32 || !io->read32 || !io->barrier || !cache ||
+        !cache->publish || !cache->acquire || !ring || !fence ||
+        ring_bytes<8192 || ring_bytes>(1u<<20) || (ring_bytes&(ring_bytes-1)) ||
+        ((ring_iova|ring_bytes)&(ring_bytes-1)) || (ring_iova&4095) ||
+        fence_bytes<64 || (fence_iova&7) || fence_bytes>=(1u<<24))return kIOReturnBadArgument;
+    /* No register may be touched before every argument is acceptable. */
+    io_=*io;cache_=*cache;ring_=static_cast<volatile uint32_t *>(ring);
+    ring_bytes_=ring_bytes;ring_iova_=ring_iova;
+    fence_=static_cast<volatile uint32_t *>(fence);fence_bytes_=fence_bytes;fence_iova_=fence_iova;
+    for(size_t i=0;i<fence_bytes_/4;++i)fence_[i]=0;
+    const uint32_t control=(uint32_t)(ilog2(ring_bytes/8)&0x3f)|(ilog2(RingBlockBytes/8)<<8);
+    const uint32_t base_lo=(uint32_t)ring_iova_,base_hi=(uint32_t)(ring_iova_>>32);
+    const uint32_t rptr_lo=(uint32_t)fence_iova_,rptr_hi=(uint32_t)(fence_iova_>>32);
+    const uint32_t writes[]={RingBase,base_lo,RingBase+1,base_hi,RingControl,control,
+        RingRptrAddress,rptr_lo,RingRptrAddress+1,rptr_hi,RingWptr,0,RingScratch,0};
+    for(size_t i=0;i<sizeof(writes)/sizeof(writes[0]);i+=2)
+        if(io_.write32(io_.cookie,writes[i],writes[i+1]))return poison();
+    uint32_t rptr=0;IOReturn status=readRptr(&rptr);
+    if(status)return status;
+    next_=rptr;seqno_=0;completed_=0;submissions_=0;
+    attached_=true;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoRing::detach()
+{
+    if(poisoned_)return kIOReturnBusy;
+    if(!attached_)return kIOReturnNotReady;
+    if(outstanding())return kIOReturnBusy;
+    attached_=false;ring_=nullptr;fence_=nullptr;ring_bytes_=fence_bytes_=0;
+    ring_iova_=fence_iova_=0;next_=rptr_shadow_=seqno_=completed_=submissions_=0;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoRing::submit(const uint32_t *words,size_t word_count,uint32_t *fence)
+{
+    return submitWords(words,word_count,fence,false);
+}
+IOReturn NativeAdrenoRing::submitFramed(const uint32_t *words,size_t word_count,uint32_t *fence)
+{
+    return submitWords(words,word_count,fence,true);
+}
+IOReturn NativeAdrenoRing::submitWords(const uint32_t *words,size_t word_count,uint32_t *fence,bool framed)
+{
+    if(!fence)return kIOReturnBadArgument;*fence=0;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!words || !word_count || word_count>SIZE_MAX/sizeof(uint32_t))return kIOReturnBadArgument;
+    const uint32_t size_words=(uint32_t)(ring_bytes_/4),mask=size_words-1;
+    const bool reset=framed && reset_pending_;
+    const uint32_t extra=framed?RingPrologueWords+(reset?RingResetWords:0)+RingFramedFenceWords:RingFenceWords;
+    if(word_count>size_words-extra-8)return kIOReturnNoResources;
+    uint32_t rptr=0;IOReturn status=readRptr(&rptr);
+    if(status)return status;
+    const uint32_t used=(next_-rptr)&mask;
+    if(word_count+extra+8>size_words-used)return kIOReturnNoResources;
+    uint32_t at=next_;
+    if(framed) {
+        status=emitPrologue(at,reset,&at);
+        if(status)return status;
+    }
+    for(size_t i=0;i<word_count;++i)ring_[(at+i)&mask]=words[i];
+    at=(at+(uint32_t)word_count)&mask;
+    uint32_t end=0;
+    status=framed?emitFramedFence(at,seqno_+1,&end):emitFence(at,seqno_+1,&end);
+    if(status)return status;
+    /* Whole-ring publication is deliberate: a submission may wrap, and one
+     * clean of the owned pool is cheaper than a split range proof. */
+    {
+        const uint32_t slot=native_adreno_ring_log_count&3;
+        const uint32_t total=(end-next_)&mask;
+        volatile uint32_t *record=native_adreno_ring_log[slot];
+        record[0]=seqno_+1;record[1]=next_;record[2]=end;record[3]=total;
+        for(uint32_t i=0;i<112;++i)record[4+i]=i<total?ring_[(next_+i)&mask]:0;
+        native_adreno_ring_log_count=native_adreno_ring_log_count+1;
+    }
+    if(cache_.publish(cache_.cookie,ring_,ring_bytes_))return poison();
+    if(io_.barrier(io_.cookie))return poison();
+    if(io_.write32(io_.cookie,RingWptr,end))return poison();
+    next_=end;*fence=++seqno_;++submissions_;
+    if(reset)reset_pending_=false;
+    return kIOReturnSuccess;
+}
+NativeAdrenoRingFence NativeAdrenoRing::observeFence(uint32_t fence,
+    const NativeAdrenoRingClock *clock,uint32_t timeout_us,uint32_t *observed)
+{
+    if(observed)*observed=0;
+    if(!attached_ || poisoned_)return NativeAdrenoRingFencePoisoned;
+    if(!fence || fence>seqno_)return NativeAdrenoRingFenceArgument;
+    uint64_t start=clock && clock->now_us?clock->now_us(clock->cookie):0;
+    for(;;) {
+        if(cache_.acquire(cache_.cookie,fence_,fence_bytes_)) {poison();return NativeAdrenoRingFencePoisoned;}
+        const uint32_t value=fence_[1];
+        if(observed)*observed=value;
+        if(value>seqno_) {poison();return NativeAdrenoRingFencePoisoned;}
+        if(value>=fence)return NativeAdrenoRingFenceComplete;
+        if(!clock || !clock->now_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->now_us(clock->cookie)-start>=timeout_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->idle && clock->idle(clock->cookie))return NativeAdrenoRingFenceTimeout;
+    }
+}
+NativeAdrenoRingFence NativeAdrenoRing::wait(uint32_t fence,const NativeAdrenoRingClock *clock,
+    uint32_t timeout_us,uint32_t *observed)
+{
+    if(observed)*observed=0;
+    if(!attached_ || poisoned_)return NativeAdrenoRingFencePoisoned;
+    if(!fence || fence>seqno_)return NativeAdrenoRingFenceArgument;
+    uint64_t start=clock && clock->now_us?clock->now_us(clock->cookie):0;
+    for(;;) {
+        if(cache_.acquire(cache_.cookie,fence_,fence_bytes_)) {poison();return NativeAdrenoRingFencePoisoned;}
+        const uint32_t value=fence_[1];
+        if(observed)*observed=value;
+        if(value>=fence) {if(value>seqno_) {poison();return NativeAdrenoRingFencePoisoned;}completed_=value;
+            return NativeAdrenoRingFenceComplete;}
+        if(!clock || !clock->now_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->now_us(clock->cookie)-start>=timeout_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->idle && clock->idle(clock->cookie))return NativeAdrenoRingFenceTimeout;
+    }
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoRing.h b/iokit/Kernel/arm/a740/NativeAdrenoRing.h
new file mode 100644
index 0000000..55c6a93
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoRing.h
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_RING_H
+#define NATIVE_ADRENO_RING_H
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* A7XX command processor ring and timestamp fence, not a scheduler.
+ * Register indices are dword offsets; the platform adds the MMIO base and
+ * multiplies by four. Caller must already own an exclusive, powered GPU with
+ * SQE microcode loaded (CP_SQE_INSTR_BASE), global reset released and all
+ * masters quiesced while attach programs the ring. Ring and fence CPU
+ * addresses must be actual writable mappings of the same IOVAs that were
+ * mapped into the active native-4K GPU context. No MMIO base, IRQ, power,
+ * GMU, context switching or per-client validation is implemented here.
+ * Every submit publishes ring memory before advancing WPTR and completes
+ * only when the CP timestamp value is observed at the fence address.
+ * A failed WPTR write or cache publication is uncertain: the ring is poisoned
+ * and every resource must be retained until an independently verified reset. */
+struct NativeAdrenoRingIo {
+    void *cookie;
+    /* Return zero only on a completed access. */
+    int (*write32)(void *,uint32_t reg,uint32_t value);
+    int (*read32)(void *,uint32_t reg,uint32_t *value);
+    int (*barrier)(void *);
+};
+struct NativeAdrenoRingCache {
+    void *cookie;
+    /* Clean owned ring bytes to PoC before the device reads them. */
+    int (*publish)(void *,const volatile uint32_t *words,size_t bytes);
+    /* Invalidate the fence page before the CPU reads CP-written values. */
+    int (*acquire)(void *,volatile uint32_t *words,size_t bytes);
+};
+struct NativeAdrenoRingClock {
+    void *cookie;
+    uint64_t (*now_us)(void *);
+    /* Optional; may sleep. Never used before a successful submit. */
+    int (*idle)(void *);
+};
+enum NativeAdrenoRingFence {
+    NativeAdrenoRingFenceComplete = 0,
+    NativeAdrenoRingFenceTimeout,
+    NativeAdrenoRingFencePoisoned,
+    NativeAdrenoRingFenceArgument
+};
+class NativeAdrenoRing final {
+    NativeAdrenoRingIo io_{};
+    NativeAdrenoRingCache cache_{};
+    volatile uint32_t *ring_=nullptr,*fence_=nullptr;
+    size_t ring_bytes_=0,fence_bytes_=0;
+    uint64_t ring_iova_=0,fence_iova_=0;
+    uint32_t next_=0,rptr_shadow_=0,seqno_=0,completed_=0,submissions_=0;
+    bool attached_=false,poisoned_=false,reset_pending_=false;
+    IOReturn poison();
+    IOReturn readRptr(uint32_t *);
+    IOReturn emitPrologue(uint32_t at,bool reset,uint32_t *end);
+    IOReturn emitFence(uint32_t at,uint32_t seqno,uint32_t *end);
+    IOReturn emitFramedFence(uint32_t at,uint32_t seqno,uint32_t *end);
+    IOReturn submitWords(const uint32_t *words,size_t word_count,uint32_t *fence,bool framed);
+public:
+    NativeAdrenoRing()=default;
+    ~NativeAdrenoRing()=default;
+    NativeAdrenoRing(const NativeAdrenoRing &)=delete;
+    NativeAdrenoRing &operator=(const NativeAdrenoRing &)=delete;
+    /* ring_bytes is a power of two in [8KiB,1MiB]; ring_iova must be aligned
+     * to ring_bytes. fence_bytes >=64 and fence_iova 8-aligned. The fence page
+     * layout is: +0 CP read-pointer shadow, +4 completed timestamp, +8 spare.
+     * All outputs are prevalidated before any register write. */
+    IOReturn attach(const NativeAdrenoRingIo *,const NativeAdrenoRingCache *,
+        void *ring,size_t ring_bytes,uint64_t ring_iova,
+        void *fence,size_t fence_bytes,uint64_t fence_iova);
+    /* Programs nothing. Refuses while submissions are unobserved or poisoned,
+     * because only the caller can establish real GPU quiescence and unmap. */
+    IOReturn detach();
+    /* Emit an entire command stream followed by the timestamp fence and commit
+     * it with one WPTR update. Returns a nonzero fence value on success. The
+     * words are copied; the caller's buffer is never retained. */
+    IOReturn submit(const uint32_t *words,size_t word_count,uint32_t *fence);
+    /* User command buffers: the A7XX BR/BV thread framing of a7xx_submit() around the words (CP init and the kernel's own
+     * bring-up packets keep the plain submit() above, as Linux sends them outside a7xx_submit()). */
+    IOReturn submitFramed(const uint32_t *words,size_t word_count,uint32_t *fence);
+    /* The next framed submission starts with the A7XX context entry of a6xx_set_pagetable() (BR/BV counters, on-chip
+     * timestamps and resource table cleared between thread syncs); a new user client requests it, as Linux does per context. */
+    void requestContextReset() {reset_pending_=true;}
+    /* Polls the CP-written timestamp after invalidating the fence page. Never
+     * writes registers and never advances the ring. Timeout is not poison. */
+    NativeAdrenoRingFence wait(uint32_t fence,const NativeAdrenoRingClock *,
+        uint32_t timeout_us,uint32_t *observed);
+    /* Observe a previously issued fence without retiring or accounting for it.
+     * Used before a new submission waits on an earlier batch; only fence values
+     * this ring issued are accepted. Never writes a register. */
+    NativeAdrenoRingFence observeFence(uint32_t fence,const NativeAdrenoRingClock *,
+        uint32_t timeout_us,uint32_t *observed);
+    bool poisoned() const {return poisoned_;}
+    uint32_t outstanding() const {return seqno_-completed_;}
+    uint32_t lastSubmitted() const {return seqno_;}      /* the newest fence number handed out */
+    uint32_t completedFence() const {return completed_;}
+    uint32_t submissions() const {return submissions_;}
+    uint32_t readPointer() const {return rptr_shadow_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoSmmuContext.cpp b/iokit/Kernel/arm/a740/NativeAdrenoSmmuContext.cpp
new file mode 100644
index 0000000..c9ae161
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoSmmuContext.cpp
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoSmmuContext.h"
+#include <IOKit/IOLib.h>
+IOReturn NativeAdrenoSmmuContext::prepare(NativeAdrenoMemory *tables,unsigned upper,uint64_t iova,
+    size_t bytes,size_t leaf_budget,unsigned bank,unsigned asid,unsigned poll_budget,unsigned output_bits)
+{
+    if(prepared_ || poisoned_)return kIOReturnBusy;
+    if(!tables || upper>1 || !bytes || (iova&4095) || !leaf_budget || leaf_budget>MaxLeaves ||
+        bank>63 || asid>0xffff || !poll_budget || poll_budget>4096)
+        return kIOReturnBadArgument;
+    const IOReturn prepared=NativeAdrenoPrepareSmmuMemory(tables,32,output_bits,iova,bytes,upper,leaf_budget,
+        &arena_,&state_,&visibility_);
+    if(prepared!=kIOReturnSuccess)return prepared==kIOReturnNoResources?prepared:kIOReturnBadArgument;
+    /* The adreno SMMU node is dma-coherent at the pinned tree, so table walks are inner write-back. */
+    config_=(ArmSmmu4KContextConfig){.lower=upper?nullptr:&arena_.config,.upper=upper?&arena_.config:nullptr,
+        .lower_tables=upper?nullptr:&state_.tables,.upper_tables=upper?&state_.tables:nullptr,.id0=0,.id2=0,
+        .asid=asid,.coherent_walk=1,.stall_on_fault=0,.continue_after_fault=1};
+    tables_=tables;bank_=bank;poll_budget_=poll_budget;prepared_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSmmuContext::program(const ArmSmmu4KIo *io)
+{
+    if(!prepared_ || programmed_ || poisoned_ || !io)return kIOReturnBadArgument;
+    const ArmSmmu4KStatus status=ArmSmmu4KProgramDisabledContext(io,bank_,&config_,
+        poll_budget_,&program_);
+    program_status_=status;
+    if(status!=ArmSmmu4KSuccess) {poisoned_=true;return kIOReturnIOError;}
+    io_=*io;programmed_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSmmuContext::attach(const ArmSmmu4KStream *routes,size_t count)
+{
+    if(!programmed_ || attached_ || poisoned_ || !routes || !count || count>8)
+        return kIOReturnBadArgument;
+    const ArmSmmu4KStatus status=ArmSmmu4KAttachStreams(&io_,&streams_,routes,count,
+        bank_,&config_,&routes_);
+    attach_status_=status;
+    if(status!=ArmSmmu4KSuccess) {poisoned_=true;return kIOReturnIOError;}
+    attached_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSmmuContext::observe() const
+{
+    if(!programmed_ || poisoned_)return kIOReturnBadArgument;
+    ArmSmmu4KProgramResult result{};
+    return ArmSmmu4KObserveOwnedContext(&io_,bank_,&config_,&result)==ArmSmmu4KSuccess?
+        kIOReturnSuccess:kIOReturnIOError;
+}
+IOReturn NativeAdrenoSmmuContext::disable()
+{
+    if(!attached_ || poisoned_)return kIOReturnBadArgument;
+    ArmSmmu4KProgramResult result{};
+    if(ArmSmmu4KDisableOwnedContext(&io_,bank_,&config_,poll_budget_,&result)!=ArmSmmu4KSuccess) {
+        poisoned_=true;
+        return kIOReturnIOError;
+    }
+    attached_=false;programmed_=false;
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoSmmuContext.h b/iokit/Kernel/arm/a740/NativeAdrenoSmmuContext.h
new file mode 100644
index 0000000..4ed1bcc
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoSmmuContext.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_SMMU_CONTEXT_H
+#define NATIVE_ADRENO_SMMU_CONTEXT_H
+#include "NativeAdrenoSmmuMemory.h"
+#include "ArmSmmu4KStreams.h"
+
+/* One single-region GPU SMMU context (lower/TTBR0, as the GMU's own 0..2 GiB
+ * space, or upper/TTBR1), composed from the qualified kits:
+ * prepare an inactive native4K table pool, program the context bank through the
+ * real register sequence, then attach the caller's streams. Every step is
+ * separate and can only run in order; a failure leaves the earlier state
+ * retained and marks this object unusable for further programming. The bank
+ * number, ASID and stream slots are required inputs and are never guessed.
+ * No power, clock, reset, fault-interrupt or global SMMU setup is performed. */
+class NativeAdrenoSmmuContext final {
+    NativeAdrenoMemory *tables_=nullptr;
+    ArmSmmu4KLiveArena arena_{};
+    ArmSmmu4KLiveState state_{};
+    ArmSmmu4KLiveVisibility visibility_{};
+    ArmSmmu4KContextConfig config_{};
+    ArmSmmu4KProgramResult program_{};
+    ArmSmmu4KStreamState streams_{};
+    ArmSmmu4KStreamResult routes_{};
+    ArmSmmu4KIo io_{};
+    unsigned bank_=0,poll_budget_=0;
+    ArmSmmu4KStatus program_status_=ArmSmmu4KSuccess,attach_status_=ArmSmmu4KSuccess;
+    bool prepared_=false,programmed_=false,attached_=false,poisoned_=false;
+public:
+    NativeAdrenoSmmuContext()=default;
+    ~NativeAdrenoSmmuContext()=default;
+    NativeAdrenoSmmuContext(const NativeAdrenoSmmuContext &)=delete;
+    NativeAdrenoSmmuContext &operator=(const NativeAdrenoSmmuContext &)=delete;
+    /* A 2 GiB lower aperture, the GMU's, is 524288 leaves. */
+    enum : size_t {MaxLeaves=size_t(1)<<19};
+    /* iova/bytes describe the aperture in the chosen region; the pool must be contiguous. */
+    /* output_bits: the context's output size, at most the SMMU's ID2.OAS (Linux uses OAS for stage 1). */
+    IOReturn prepare(NativeAdrenoMemory *tables,unsigned upper,uint64_t iova,size_t bytes,
+        size_t leaf_budget,unsigned bank,unsigned asid,unsigned poll_budget,unsigned output_bits=40);
+    /* Reads actual IDs, programs and enables exactly this bank. */
+    IOReturn program(const ArmSmmu4KIo *);
+    /* Attach the caller's exact stream routes to the programmed bank. */
+    IOReturn attach(const ArmSmmu4KStream *,size_t count);
+    /* Read-only observation of the owned enabled context. */
+    IOReturn observe() const;
+    /* Only after attach; leaves streams faulted by the caller's own recovery. */
+    IOReturn disable();
+    bool prepared() const {return prepared_;}
+    bool programmed() const {return programmed_;}
+    bool attached() const {return attached_;}
+    bool poisoned() const {return poisoned_;}
+    const ArmSmmu4KContextConfig *configuration() const {return &config_;}
+    const ArmSmmu4KLiveArena *arena() const {return &arena_;}
+    /* Handles for a NativeAdrenoVm that will map buffers through this bank. */
+    ArmSmmu4KLiveArena *arenaHandle() {return &arena_;}
+    /* Scratch the kit's physical-alias checks sort in (ArmSmmu4KLiveArena::alias_scratch), owned by the caller for this context's
+     * lifetime; without it those checks compare pairwise. Only after prepare. */
+    void setAliasScratch(uint32_t *entries,size_t count) {arena_.alias_scratch=entries;arena_.alias_scratch_entries=entries?count:0;}
+    ArmSmmu4KLiveState *stateHandle() {return &state_;}
+    ArmSmmu4KContextConfig *configHandle() {return &config_;}
+    ArmSmmu4KStreamState *streamsHandle() {return &streams_;}
+    const ArmSmmu4KIo *ioHandle() const {return &io_;}
+    const ArmSmmu4KProgramResult *programResult() const {return &program_; }
+    const ArmSmmu4KStreamResult *streamResult() const {return &routes_;}
+    /* The kit's own status of the last program/attach, which IOReturn folds into one error. */
+    ArmSmmu4KStatus programStatus() const {return program_status_;}
+    ArmSmmu4KStatus attachStatus() const {return attach_status_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoSmmuMemory.cpp b/iokit/Kernel/arm/a740/NativeAdrenoSmmuMemory.cpp
new file mode 100644
index 0000000..9aa7d0b
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoSmmuMemory.cpp
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoSmmuMemory.h"
+static int publishTable(void *cookie,volatile uint64_t *page,size_t bytes)
+{
+    auto *memory=static_cast<NativeAdrenoMemory *>(cookie);
+    if(!memory || !page || bytes!=4096 || ((uintptr_t)page&4095) ||
+        (uintptr_t)page<(uintptr_t)memory->mapping())return 1;
+    uintptr_t offset=(uintptr_t)page-(uintptr_t)memory->mapping();
+    if(offset>memory->bytes() || bytes>memory->bytes()-offset)return 1;
+    return memory->publishForDevice(offset,bytes,false)==kIOReturnSuccess?0:1;
+}
+IOReturn NativeAdrenoBindSmmuVisibility(NativeAdrenoMemory *memory,ArmSmmu4KLiveVisibility *visibility)
+{
+    if(!visibility)return kIOReturnBadArgument;*visibility={};
+    if(!memory || memory->quarantined() || !memory->deviceReferences() || !memory->mapping() ||
+        memory->spanCount()!=1 || memory->spans()[0].offset ||
+        memory->spans()[0].bytes!=memory->bytes())return kIOReturnBadArgument;
+    *visibility={memory,publishTable};return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoPrepareSmmuMemory(NativeAdrenoMemory *memory,unsigned input_bits,
+    unsigned output_bits,uint64_t iova,uint64_t bytes,unsigned upper,size_t budget,
+    ArmSmmu4KLiveArena *arena,ArmSmmu4KLiveState *state,ArmSmmu4KLiveVisibility *visibility)
+{
+    if(!memory || !arena || !state || !visibility)return kIOReturnBadArgument;
+    *visibility={};
+    if(state->prepared || state->poisoned || memory->quarantined() || memory->deviceReferences())
+        return kIOReturnBusy;
+    if(!memory->mapping() || memory->spanCount()!=1 ||
+        memory->spans()[0].offset || memory->spans()[0].bytes!=memory->bytes() ||
+        !memory->bytes() || (memory->bytes()&4095))return kIOReturnUnsupported;
+    *arena={{input_bits,output_bits,memory->spans()[0].physical,budget},iova,bytes,upper,
+        static_cast<volatile uint64_t *>(memory->mapping()),memory->bytes()/4096,nullptr,0};
+    ArmSmmu4KStatus status=ArmSmmu4KLivePrepare(arena,state);
+    if(status!=ArmSmmu4KSuccess)return status==ArmSmmu4KCapacity?kIOReturnNoResources:kIOReturnBadArgument;
+    ArmSmmu4KLiveResult audit;
+    status=ArmSmmu4KLiveAudit(arena,state,nullptr,0,&audit);
+    if(status!=ArmSmmu4KSuccess) {state->poisoned=1;return kIOReturnIOError;}
+    IOReturn result=memory->publishForDevice(0,state->tables.table_pages*4096,false);
+    if(result==kIOReturnSuccess)result=memory->holdForDevice();
+    if(result!=kIOReturnSuccess) {state->poisoned=1;return result;}
+    return NativeAdrenoBindSmmuVisibility(memory,visibility);
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoSmmuMemory.h b/iokit/Kernel/arm/a740/NativeAdrenoSmmuMemory.h
new file mode 100644
index 0000000..6fb40d3
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoSmmuMemory.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_SMMU_MEMORY_H
+#define NATIVE_ADRENO_SMMU_MEMORY_H
+#include "NativeAdrenoMemory.h"
+#include "ArmSmmu4KLive.h"
+/* Bind the actual contiguous raw-PA backing allocation to an INACTIVE native
+ * arena, publish its used table pages and take a device-lifetime reference.
+ * Caller retains memory/arena/state/visibility under an exclusive resource
+ * gate; all outputs and the backing pool are disjoint. State starts zeroed.
+ * Never invoke on an active or foreign table pool. This does not program a
+ * context, route streams, allocate MMIO/IRQs or establish power/security.
+ * On success the memory reference remains held until real masters are stopped,
+ * streams faulted, context disabled and native TLB synchronization completes.
+ * On prepare/publication failure no context has been exposed; caller retains
+ * allocation and poisoned state and handles cleanup. No automatic replay. */
+IOReturn NativeAdrenoPrepareSmmuMemory(NativeAdrenoMemory *,unsigned input_bits,
+    unsigned output_bits,uint64_t iova,uint64_t bytes,unsigned upper_region,
+    size_t leaf_budget,ArmSmmu4KLiveArena *,ArmSmmu4KLiveState *,ArmSmmu4KLiveVisibility *);
+/* Bind only the native PoC publisher to an already retained contiguous table
+ * allocation. No caller-supplied success callback or page-table copy. */
+IOReturn NativeAdrenoBindSmmuVisibility(NativeAdrenoMemory *,ArmSmmu4KLiveVisibility *);
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoStatus.h b/iokit/Kernel/arm/a740/NativeAdrenoStatus.h
new file mode 100644
index 0000000..fa69ac8
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoStatus.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_STATUS_H
+#define NATIVE_ADRENO_STATUS_H
+#include <IOKit/IOTypes.h>
+#include <stdint.h>
+/* Monotonic fault and suspend counters for Turnip's device_check_status and
+ * device_get_suspend_count. Turnip compares the fault count against the value
+ * it saw last; a change means the context is lost. This object only counts
+ * what the driver tells it: the IRQ path records a fatal decode, the reset or
+ * power path records a suspend, and submission poisoning must be recorded by
+ * the caller that observed it. It performs no detection, reset or recovery and
+ * never clears a count, so a client cannot hide a fault by re-reading. */
+struct NativeAdrenoStatusCounts {
+    uint64_t faults;
+    uint64_t suspends;
+};
+class NativeAdrenoStatus final {
+    uint64_t faults_=0,suspends_=0;
+public:
+    void noteFault() {if(faults_!=UINT64_MAX)++faults_;}
+    void noteSuspend() {if(suspends_!=UINT64_MAX)++suspends_;}
+    uint64_t faults() const {return faults_;}
+    uint64_t suspends() const {return suspends_;}
+    NativeAdrenoStatusCounts counts() const {return {faults_,suspends_};}
+};
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoSubmit.cpp b/iokit/Kernel/arm/a740/NativeAdrenoSubmit.cpp
new file mode 100644
index 0000000..238ebb6
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoSubmit.cpp
@@ -0,0 +1,280 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoSubmit.h"
+#include "AdrenoPM4.h"
+#include <IOKit/IOLib.h>
+
+/* CP_INDIRECT_BUFFER is opcode 0x3f with a 3-word payload: 64-bit GPU address
+ * and IB_SIZE in dwords (bits 0..19), exactly as the pinned adreno_pm4.xml
+ * domain states and Linux msm_gem_submit.c converts the userspace byte size. */
+enum : uint32_t {SubmitIndirectBuffer=0x3f,SubmitIbWords=3,SubmitMaxJobs=8,
+    SubmitMaxBuffers=16,SubmitMaxIbBytes=0xfffffu*4u,
+    SubmitAuditBytes=256u*1024u};   /* IB bytes the write-combine audit compares per submission */
+extern "C" {volatile uint32_t native_adreno_coherence[8];}
+/* The submission (1-based count) at which the write-combine audit found a dirty IB line or failed; 0 = never. */
+extern "C" {volatile uint32_t native_adreno_wc_distrusted;}
+/* The write-combine audit before each submission while trusted: [0] submissions audited, [1] IB lines compared, [2] dirty lines,
+ * [3] stale clean lines, [4] the last audit failure (any failure also ends the trust), [5] pages found back at the default attribute
+ * and write-combined again. */
+extern "C" {volatile uint32_t native_adreno_wc_audit[6];}
+/* Fence waits: [0] calls, [1] timeouts, [2] the fence of the last timed-out wait, [3] the fence value the GPU had written then, [4] the newest fence handed out,
+ * [5] the newest completed, [6] waits for a fence no job holds (observeFence path), [7] the last fence refused as never submitted. */
+extern "C" {volatile uint32_t native_adreno_fence_wait[8];}
+/* The IBs of the last submissions: [slot] fence, iova low/high, bytes, then the first 28 dwords of the first IB (read as the kernel maps it). */
+extern "C" {volatile uint32_t native_adreno_ib_log[4][4+28];volatile uint32_t native_adreno_ib_log_count;}
+IOReturn NativeAdrenoSubmit::poison()
+{
+    poisoned_=true;return kIOReturnIOError;
+}
+NativeAdrenoSubmit::Job *NativeAdrenoSubmit::find(uint32_t fence)
+{
+    if(fence)for(auto &job:jobs_)if(job.active && job.fence==fence)return &job;
+    return nullptr;
+}
+NativeAdrenoSubmit::Job *NativeAdrenoSubmit::free()
+{
+    for(auto &job:jobs_)if(!job.active)return &job;
+    return nullptr;
+}
+IOReturn NativeAdrenoSubmit::attach(NativeAdrenoVm *vm,NativeAdrenoRing *ring)
+{
+    if(attached_ || poisoned_ || vm_ || ring_)return kIOReturnBusy;
+    if(!vm || !ring || vm->poisoned() || ring->poisoned())return kIOReturnBadArgument;
+    vm_=vm;ring_=ring;attached_=true;stats_={};
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::release(Job &job)
+{
+    IOReturn status=kIOReturnSuccess;
+    for(size_t i=0;i<job.count;++i) {
+        IOReturn retired=vm_->retireJobAfterCompletion(job.handles[i]);
+        if(retired)status=retired;else ++stats_.references_retired;
+    }
+    if(status)return poison();
+    if(vm_->acquireImported())return poison();
+    job={};return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::detach()
+{
+    if(poisoned_ || outstanding())return kIOReturnBusy;
+    if(!attached_)return kIOReturnNotReady;
+    attached_=false;vm_=nullptr;ring_=nullptr;return kIOReturnSuccess;
+}
+bool NativeAdrenoSubmit::queueOutstanding(uint32_t queue) const
+{
+    return rangeOutstanding(queue,1);
+}
+bool NativeAdrenoSubmit::rangeOutstanding(uint32_t first,uint32_t count) const
+{
+    for(const auto &job:jobs_)if(job.active && job.queue-first<count)return true;
+    return false;
+}
+size_t NativeAdrenoSubmit::outstanding() const
+{
+    size_t count=0;for(const auto &job:jobs_)if(job.active)++count;return count;
+}
+IOReturn NativeAdrenoSubmit::submit(const NativeAdrenoSubmitBuffer *buffers,size_t count,
+    uint32_t queue,uint32_t *fence)
+{
+    if(!fence)return kIOReturnBadArgument;*fence=0;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!buffers || !count || count>SubmitMaxBuffers)return kIOReturnBadArgument;
+    /* Every buffer is validated against the live VM before any reference. */
+    uint64_t handles[SubmitMaxBuffers];size_t handle_count=0;
+    uint32_t words[SubmitMaxBuffers*(1+SubmitIbWords)];size_t word_count=0;
+    for(size_t i=0;i<count;++i) {
+        const NativeAdrenoSubmitBuffer &buffer=buffers[i];
+        if(!buffer.handle || !buffer.bytes || (buffer.bytes&3) || buffer.bytes>SubmitMaxIbBytes)
+            return kIOReturnBadArgument;
+        uint64_t iova=0;size_t bytes=0;unsigned permissions=0;
+        IOReturn status=vm_->describe(buffer.handle,&iova,&bytes,&permissions);
+        if(status)return status;
+        if(!(permissions&ArmSmmu4KRead) || buffer.iova<iova ||
+            buffer.iova-iova>bytes || buffer.bytes>bytes-(buffer.iova-iova))return kIOReturnBadArgument;
+        uint32_t header=0;
+        if(AdrenoPM4Type7(SubmitIndirectBuffer,SubmitIbWords,&header)!=AdrenoPM4Success)
+            return poison();
+        words[word_count++]=header;
+        words[word_count++]=(uint32_t)buffer.iova;
+        words[word_count++]=(uint32_t)(buffer.iova>>32);
+        words[word_count++]=(uint32_t)(buffer.bytes/4);
+        bool known=false;
+        for(size_t j=0;j<handle_count;++j)if(handles[j]==buffer.handle) {known=true;break;}
+        if(!known)handles[handle_count++]=buffer.handle;
+    }
+    IOReturn swept=retireCompleted();
+    if(swept)return swept;
+    Job *job=free();
+    if(!job)return kIOReturnBusy;
+    for(size_t i=0;i<handle_count;++i) {
+        IOReturn status=vm_->holdJob(handles[i]);
+        if(status) {
+            while(i) {vm_->retireJobAfterCompletion(handles[--i]);++stats_.references_retired;}
+            return status;
+        }
+        ++stats_.references_held;
+    }
+    uint32_t value=0;
+    /* int-070: the first IB word as the kernel's cacheable alias and DRAM see it before any maintenance, then DRAM after the CPU
+     * caches over every mapped BO are cleaned and invalidated. The board shows the last submission's record on a stall. */
+    uint32_t cached=~0u,before=~0u,ignored=0,after=~0u;
+    /* Write-combined stores this CPU made before the call (the client's command words) complete before anything below. */
+    __asm__ volatile("dsb sy":::"memory");
+    /* int-098/099: with write-combined user BOs and no maintenance the CP stopped at the end of the first IB, as in int-065..069 when an
+     * IB sat in a CPU cache. While write-combined BOs are trusted, every line of this submission's IBs is compared as a CPU cache and
+     * DRAM hold it (bounded). A dirty line means a client view still caches its BOs: maintain every BO from now on, this submission
+     * included (the audit already wrote the IB lines back; the rest of the BOs may hold more). */
+    if(vm_->writeCombinedTrusted()) {
+        /* int-100: the dirty IB page was back at XNU's default (cacheable) attribute. Write-combine every such page again first; the
+         * pmap writes its lines back on the way, so the audit below should then find none. */
+        uint32_t reset=0;
+        IOReturn audited=vm_->reassertWriteCombined(&reset);
+        native_adreno_wc_audit[5]=native_adreno_wc_audit[5]+reset;
+        uint32_t lines=0,dirty=0,stale=0;size_t budget=SubmitAuditBytes;
+        /* The re-assertion above is the correction and runs every time; the audit only detects, and found no dirty line in int-141's
+         * 133798, so after the first 16 submissions it compares every eighth one's IBs (it cost about 2 ms each). */
+        ++audit_tick_;
+        const bool audit_now=audit_tick_<=16 || (audit_tick_&7)==1;
+        if(!audit_now)budget=0;
+        for(size_t i=0;i<count && budget && !audited;++i) {   /* a failed re-assertion skips the audit and ends the trust */
+            const size_t bytes=buffers[i].bytes<budget?(size_t)buffers[i].bytes:budget;
+            audited=vm_->auditRange(buffers[i].iova,bytes,&lines,&dirty,&stale);budget-=bytes;
+        }
+        if(audit_now && audited!=kIOReturnUnsupported) {   /* no board hook (host): nothing to compare */
+            native_adreno_wc_audit[0]=native_adreno_wc_audit[0]+1;
+            native_adreno_wc_audit[1]=native_adreno_wc_audit[1]+lines;
+            native_adreno_wc_audit[2]=native_adreno_wc_audit[2]+dirty;
+            native_adreno_wc_audit[3]=native_adreno_wc_audit[3]+stale;
+            if(audited)native_adreno_wc_audit[4]=audited;
+        }
+        if(dirty || (audited && audited!=kIOReturnUnsupported)) {
+            vm_->distrustWriteCombined();
+            native_adreno_wc_distrusted=native_adreno_coherence[0]+1;
+        }
+    }
+    (void)vm_->sampleWord(buffers[0].iova,&cached,&before);
+    IOReturn status=vm_->publishMapped();
+    if(!status) {
+        (void)vm_->sampleWord(buffers[0].iova,&ignored,&after);
+        native_adreno_coherence[0]=native_adreno_coherence[0]+1;
+        native_adreno_coherence[1]=cached;native_adreno_coherence[2]=before;native_adreno_coherence[3]=after;
+        if(cached!=before || before!=after) {
+            if(!native_adreno_coherence[4]) {
+                native_adreno_coherence[5]=cached;native_adreno_coherence[6]=before;native_adreno_coherence[7]=after;
+            }
+            native_adreno_coherence[4]=native_adreno_coherence[4]+1;
+        }
+        status=vm_->invalidateTlb();
+    }
+    if(status) {
+        for(size_t i=0;i<handle_count;++i) {vm_->retireJobAfterCompletion(handles[i]);++stats_.references_retired;}
+        return status;
+    }
+    {
+        const uint32_t slot=native_adreno_ib_log_count&3;uint32_t head[28];
+        (void)vm_->peekWords(buffers[0].iova,head,28);
+        native_adreno_ib_log[slot][0]=ring_->lastSubmitted()+1;native_adreno_ib_log[slot][1]=(uint32_t)buffers[0].iova;
+        native_adreno_ib_log[slot][2]=(uint32_t)(buffers[0].iova>>32);native_adreno_ib_log[slot][3]=(uint32_t)buffers[0].bytes;
+        for(unsigned i=0;i<28;++i)native_adreno_ib_log[slot][4+i]=head[i];
+        native_adreno_ib_log_count=native_adreno_ib_log_count+1;
+    }
+    status=ring_->submitFramed(words,word_count,&value);
+    if(status) {
+        /* A poisoned ring may already have consumed the WPTR write, so the
+         * referenced buffers cannot be retired here. */
+        if(ring_->poisoned()) {
+            *job=Job{};++stats_.poisoned_jobs;
+            for(size_t i=0;i<handle_count;++i)job->handles[i]=handles[i];
+            job->count=handle_count;job->queue=queue;job->active=true;
+            return poison();
+        }
+        while(handle_count) {vm_->retireJobAfterCompletion(handles[--handle_count]);++stats_.references_retired;}
+        return status;
+    }
+    for(size_t i=0;i<handle_count;++i)job->handles[i]=handles[i];
+    job->count=handle_count;job->fence=value;job->queue=queue;job->active=true;
+    ++stats_.submissions;
+    if(outstanding()>stats_.peak_jobs)stats_.peak_jobs=outstanding();
+    *fence=value;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::observeFence(uint32_t fence,const NativeAdrenoRingClock *clock,
+    uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!fence)return kIOReturnBadArgument;
+    const NativeAdrenoRingFence result=ring_->observeFence(fence,clock,timeout_us,nullptr);
+    if(result==NativeAdrenoRingFencePoisoned)return poison();
+    if(result==NativeAdrenoRingFenceArgument)return kIOReturnBadArgument;
+    if(result==NativeAdrenoRingFenceTimeout)return kIOReturnTimeout;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::wait(uint32_t fence,const NativeAdrenoRingClock *clock,
+    uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    Job *job=find(fence);
+    uint32_t observed=0;
+    native_adreno_fence_wait[0]=native_adreno_fence_wait[0]+1;
+    if(!job) {
+        native_adreno_fence_wait[6]=native_adreno_fence_wait[6]+1;
+        const NativeAdrenoRingFence passed=ring_->observeFence(fence,clock,timeout_us,&observed);
+        if(passed==NativeAdrenoRingFencePoisoned)return poison();
+        if(passed==NativeAdrenoRingFenceArgument) {native_adreno_fence_wait[7]=fence;return kIOReturnBadArgument;}
+        if(passed==NativeAdrenoRingFenceTimeout) {
+            ++stats_.timeouts;
+            native_adreno_fence_wait[1]=native_adreno_fence_wait[1]+1;native_adreno_fence_wait[2]=fence;native_adreno_fence_wait[3]=observed;
+            native_adreno_fence_wait[4]=ring_->lastSubmitted();native_adreno_fence_wait[5]=ring_->completedFence();
+            return kIOReturnTimeout;
+        }
+        return kIOReturnSuccess;
+    }
+    const NativeAdrenoRingFence result=ring_->wait(fence,clock,timeout_us,&observed);
+    if(result==NativeAdrenoRingFencePoisoned)return poison();
+    if(result==NativeAdrenoRingFenceArgument) {native_adreno_fence_wait[7]=fence;return kIOReturnBadArgument;}
+    if(result==NativeAdrenoRingFenceTimeout) {
+        ++stats_.timeouts;
+        native_adreno_fence_wait[1]=native_adreno_fence_wait[1]+1;native_adreno_fence_wait[2]=fence;native_adreno_fence_wait[3]=observed;
+        native_adreno_fence_wait[4]=ring_->lastSubmitted();native_adreno_fence_wait[5]=ring_->completedFence();
+        return kIOReturnTimeout;
+    }
+    IOReturn status=release(*job);
+    if(status)return status;
+    ++stats_.completed;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::waitAll(const NativeAdrenoRingClock *clock,uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    while(outstanding()) {
+        Job *oldest=nullptr;
+        for(auto &job:jobs_)if(job.active && (!oldest || job.fence-oldest->fence>0x80000000u))oldest=&job;
+        const IOReturn status=wait(oldest->fence,clock,timeout_us);
+        if(status)return status;
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::waitRange(uint32_t first,uint32_t count,const NativeAdrenoRingClock *clock,uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    while(rangeOutstanding(first,count)) {
+        Job *oldest=nullptr;
+        for(auto &job:jobs_)if(job.active && job.queue-first<count && (!oldest || job.fence-oldest->fence>0x80000000u))oldest=&job;
+        const IOReturn status=wait(oldest->fence,clock,timeout_us);
+        if(status)return status;
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::retireCompleted()
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(auto &job:jobs_) {
+        if(!job.active)continue;
+        const NativeAdrenoRingFence state=ring_->observeFence(job.fence,nullptr,0,nullptr);
+        if(state==NativeAdrenoRingFencePoisoned)return poison();
+        if(state!=NativeAdrenoRingFenceComplete)continue;
+        const IOReturn status=release(job);
+        if(status)return status;
+        ++stats_.completed;
+    }
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoSubmit.h b/iokit/Kernel/arm/a740/NativeAdrenoSubmit.h
new file mode 100644
index 0000000..6e99aff
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoSubmit.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_SUBMIT_H
+#define NATIVE_ADRENO_SUBMIT_H
+#include "NativeAdrenoRing.h"
+#include "NativeAdrenoVm.h"
+
+struct NativeAdrenoSubmitBuffer {
+    uint64_t handle;
+    uint64_t iova;
+    size_t bytes;      /* Complete indirect-buffer range in bytes. */
+};
+/* Coherence samples (int-070): [0] submissions sampled; [1..3] the last one's first IB word through the kernel's cacheable alias,
+ * through DRAM before and through DRAM after the CPU cache maintenance of every mapped BO (~0 when unreadable); [4] samples whose
+ * three values differ and [5..7] the first such sample. */
+extern "C" volatile uint32_t native_adreno_coherence[8];
+/* The write-combine audit (int-100), see NativeAdrenoSubmit.cpp, and the submission (1-based) that ended the trust; 0 = never. */
+extern "C" volatile uint32_t native_adreno_wc_audit[6];
+extern "C" volatile uint32_t native_adreno_wc_distrusted;
+struct NativeAdrenoSubmitStats {
+    uint32_t submissions,completed,timeouts,poisoned_jobs;
+    size_t references_held,references_retired,peak_jobs;
+};
+/* Kernel-side execbuf: turns validated indirect buffers into one ring
+ * submission and owns a device reference per distinct buffer until the
+ * timestamp fence is actually observed. This is not a userspace ABI and not a
+ * scheduler: at most eight jobs are outstanding, callers serialize every
+ * method, and the ring/VM must already be attached to the same live context.
+ * Buffers may be sub-ranges of a live VM mapping but never a different IOVA,
+ * unmapped handle, table pool or a range that includes unreadable bytes.
+ * A failed ring commit that poisons the ring keeps every reference and the
+ * submit object unusable; only an independent reset may reclaim them. */
+class NativeAdrenoSubmit final {
+    struct Job {
+        uint32_t fence=0;
+        size_t count=0;
+        uint64_t handles[16]{};
+        uint32_t queue=0;
+        bool active=false;
+    } jobs_[8];
+    NativeAdrenoVm *vm_=nullptr;
+    NativeAdrenoRing *ring_=nullptr;
+    NativeAdrenoSubmitStats stats_{};
+    bool attached_=false,poisoned_=false;
+    uint32_t audit_tick_=0;   /* submissions since attach; every eighth one audits its IB lines */
+    Job *find(uint32_t fence);
+    Job *free();
+    IOReturn release(Job &);
+    IOReturn poison();
+public:
+    NativeAdrenoSubmit()=default;
+    ~NativeAdrenoSubmit()=default;
+    NativeAdrenoSubmit(const NativeAdrenoSubmit &)=delete;
+    NativeAdrenoSubmit &operator=(const NativeAdrenoSubmit &)=delete;
+    IOReturn attach(NativeAdrenoVm *,NativeAdrenoRing *);
+    /* Refuses while jobs are outstanding or poisoned; the caller must have
+     * stopped the GPU and observed every fence before calling this. */
+    IOReturn detach();
+    /* queue is bookkeeping for one shared ring; it never reorders or isolates
+     * submissions and is validated by the caller's open queue set. */
+    IOReturn submit(const NativeAdrenoSubmitBuffer *,size_t,uint32_t queue,
+        uint32_t *fence);
+    bool queueOutstanding(uint32_t queue) const;
+    /* Queues [first, first+count): whether any of their jobs is outstanding, and a wait for every one of them (oldest first) that
+     * leaves other queues' jobs alone. Each client of the shared ring owns one such range. */
+    bool rangeOutstanding(uint32_t first,uint32_t count) const;
+    IOReturn waitRange(uint32_t first,uint32_t count,const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Retires (without waiting) every job whose fence the CP has already passed, so completed work never pins buffers or
+     * job slots just because nobody called wait(). */
+    IOReturn retireCompleted();
+    /* Waits for every outstanding job in submission order and retires its references. */
+    IOReturn waitAll(const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Polls the CP timestamp; on completion retires every buffer reference. A fence whose job was already retired (by
+     * wait or retireCompleted) is checked against the ring and succeeds once the CP has passed it. */
+    IOReturn wait(uint32_t fence,const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Wait for an earlier fence without touching job references; a timeout
+     * leaves every job and reference exactly as they were. */
+    IOReturn observeFence(uint32_t fence,const NativeAdrenoRingClock *,uint32_t timeout_us);
+    bool poisoned() const {return poisoned_;}
+    size_t outstanding() const;
+    NativeAdrenoSubmitStats stats() const {return stats_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoTimer.cpp b/iokit/Kernel/arm/a740/NativeAdrenoTimer.cpp
new file mode 100644
index 0000000..0222415
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoTimer.cpp
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoTimer.h"
+#include <IOKit/IOLib.h>
+
+/* Derivation, not a guess:
+ *   pinned a6xx_gmu.xml  GMU_ALWAYS_ON_COUNTER_L 0x1f888, _H 0x1f889
+ *                        (dword offsets, variants A6XX-A7XX)
+ *   pinned sm8550.dtsi   gpu@3d00000, gmu@3d6a000
+ *   byte offset = (offset << 2) - (gmu_base - gpu_base)
+ *               = (0x1f888 << 2) - 0x6a000 = 0x14220
+ *   pinned a6xx.xml      CP_ALWAYS_ON_COUNTER 0x0980 (64-bit, A6XX-A7XX)
+ *     read as low at 0x0980 and high at 0x0981, as Linux gpu_read64 does. */
+enum : uint32_t {
+    TimerGmuLow = 0x14220,
+    TimerGmuHigh = 0x14224,
+    TimerCpLow = 0x0980,
+    TimerCpHigh = 0x0981,
+    TimerRetries = 8
+};
+uint32_t NativeAdrenoTimer::gmuLowOffset(){return TimerGmuLow;}
+uint32_t NativeAdrenoTimer::gmuHighOffset(){return TimerGmuHigh;}
+uint32_t NativeAdrenoTimer::cpLowRegister(){return TimerCpLow;}
+uint32_t NativeAdrenoTimer::cpHighRegister(){return TimerCpHigh;}
+IOReturn NativeAdrenoTimer::attach(const NativeAdrenoTimeIo *io,uint32_t source)
+{
+    if(attached_)return kIOReturnBusy;
+    if(!io || !io->read32)return kIOReturnBadArgument;
+    if(source!=NativeAdrenoTimeGmu && source!=NativeAdrenoTimeCp)return kIOReturnBadArgument;
+    io_=*io;source_=source;attached_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoTimer::detach()
+{
+    if(!attached_)return kIOReturnNotReady;
+    attached_=false;io_={};
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoTimer::read(uint64_t *ticks) const
+{
+    if(!ticks)return kIOReturnBadArgument;*ticks=0;
+    if(!attached_)return kIOReturnNotReady;
+    const uint32_t low=source_==NativeAdrenoTimeGmu?TimerGmuLow:TimerCpLow;
+    const uint32_t high=source_==NativeAdrenoTimeGmu?TimerGmuHigh:TimerCpHigh;
+    for(unsigned attempt=0;attempt<TimerRetries;++attempt) {
+        uint32_t first=0,low_word=0,second=0;
+        if(io_.read32(io_.cookie,high,&first) ||
+            io_.read32(io_.cookie,low,&low_word) ||
+            io_.read32(io_.cookie,high,&second))return kIOReturnIOError;
+        if(first==second) {
+            *ticks=(uint64_t(first)<<32)|low_word;
+            return kIOReturnSuccess;
+        }
+    }
+    return kIOReturnTimeout;
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoTimer.h b/iokit/Kernel/arm/a740/NativeAdrenoTimer.h
new file mode 100644
index 0000000..4366105
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoTimer.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_TIMER_H
+#define NATIVE_ADRENO_TIMER_H
+#include <IOKit/IOTypes.h>
+#include <stdint.h>
+
+/* GPU always-on counter reader for the user-visible timestamp. Two sources are
+ * distinguished because their address spaces differ:
+ *  - GMU window: byte offsets inside the already bound GMU window. The A740
+ *    offset is derived from the pinned a6xx_gmu.xml dword offset 0x1f888 and
+ *    the SM8550 DT layout: (0x1f888 << 2) - (gmu 0x03d6a000 - gpu 0x03d00000)
+ *    = 0x14220 for the low word and 0x14224 for the high word.
+ *  - CP window: dword register indices in the GPU register window, from
+ *    a6xx.xml CP_ALWAYS_ON_COUNTER at 0x0980 for A6XX..A7XX.
+ * The caller binds exactly one already powered window; this object performs no
+ * power, reset or window discovery. Reads retry while the high word changes,
+ * so a counter rollover cannot return a torn value; exceeding the retry bound
+ * is an error. A failed read reports an I/O error and never fabricates ticks. */
+enum NativeAdrenoTimeSource { NativeAdrenoTimeGmu = 0, NativeAdrenoTimeCp = 1 };
+struct NativeAdrenoTimeIo {
+    void *cookie;
+    int (*read32)(void *,uint32_t address,uint32_t *value);
+};
+class NativeAdrenoTimer final {
+    NativeAdrenoTimeIo io_{};
+    uint32_t source_=NativeAdrenoTimeGmu;
+    bool attached_=false;
+public:
+    NativeAdrenoTimer()=default;
+    ~NativeAdrenoTimer()=default;
+    NativeAdrenoTimer(const NativeAdrenoTimer &)=delete;
+    NativeAdrenoTimer &operator=(const NativeAdrenoTimer &)=delete;
+    /* Source is a numeric ABI boundary value and is range-checked. */
+    IOReturn attach(const NativeAdrenoTimeIo *,uint32_t source);
+    IOReturn detach();
+    IOReturn read(uint64_t *ticks) const;
+    static uint32_t gmuLowOffset();
+    static uint32_t gmuHighOffset();
+    static uint32_t cpLowRegister();
+    static uint32_t cpHighRegister();
+};
