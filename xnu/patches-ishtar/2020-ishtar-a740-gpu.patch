+#include <kern/clock.h>
+#include <vm/memory_types.h>
+extern "C" vm_offset_t phystokv(uint64_t pa);
+extern "C" uint64_t gPhysBase,gPhysSize;   /* the physical range phystokv covers (the kernel's own DRAM); anything else panics in phystokv */
+extern "C" void pmap_set_cache_attributes(ppnum_t pn,unsigned int cacheattr);
+extern "C" unsigned int pmap_cache_attributes(ppnum_t pn);
+/* Time and bytes of every CPU cache maintenance pass (the board page shows them per submission), and the pages user BOs made
+ * write-combined: [0] ticks, [1] bytes, [2] longest pass in ticks, [3] passes, [4] write-combined pages now. */
+extern "C" {volatile uint64_t native_adreno_cache_stats[5];}
+/* Time spent checking and re-asserting write-combined page attributes (NativeAdrenoReassertWriteCombined), for the board page. */
+extern "C" {volatile uint64_t native_adreno_reassert_ticks;}
+static void noteMaintenance(uint64_t began,size_t bytes)
+{
+    const uint64_t ticks=mach_absolute_time()-began;
+    __atomic_fetch_add(&native_adreno_cache_stats[0],ticks,__ATOMIC_RELAXED);
+    __atomic_fetch_add(&native_adreno_cache_stats[1],bytes,__ATOMIC_RELAXED);
+    __atomic_fetch_add(&native_adreno_cache_stats[3],1,__ATOMIC_RELAXED);
+    uint64_t longest=__atomic_load_n(&native_adreno_cache_stats[2],__ATOMIC_RELAXED);
+    while(ticks>longest && !__atomic_compare_exchange_n(&native_adreno_cache_stats[2],&longest,ticks,true,__ATOMIC_RELAXED,__ATOMIC_RELAXED)) {}
+}
+
+IOReturn NativeAdrenoQueryCpu4K(NativeAdrenoCpuState *out)
+{
+    if(!out)return kIOReturnBadArgument;
+    *out={};
+    disable_preemption();
+    __asm__ volatile("mrs %0, tcr_el1" : "=r"(out->tcr));
+    __asm__ volatile("mrs %0, ttbr0_el1" : "=r"(out->ttbr0));
+    __asm__ volatile("mrs %0, ttbr1_el1" : "=r"(out->ttbr1));
+    __asm__ volatile("mrs %0, sctlr_el1" : "=r"(out->sctlr));
+    out->kernel_page_bytes=page_size;
+    out->kernel_map_page_bytes=vm_map_page_size(kernel_map);
+    enable_preemption();
+    bool native=(PAGE_SIZE==4096 || PAGE_SIZE==16384) && out->kernel_page_bytes==PAGE_SIZE &&
+        out->kernel_map_page_bytes==PAGE_SIZE &&
+        (out->sctlr&1) && (out->ttbr1&UINT64_C(0x0000fffffffff000));
+    return native?kIOReturnSuccess:kIOReturnUnsupported;
+}
+static IOReturn maintainOwnedPages(void *mapping,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    /* Whole owned pages avoid IVAC corruption of a neighbour's dirty line.
+     * No Apple coherent-I/O shortcut is used for these noncoherent DMA paths.
+     * Pin this CPU while reading its CTR and issuing all cache operations. */
+    if(!mapping || !bytes || (((uintptr_t)mapping|bytes)&4095) ||
+        bytes>UINTPTR_MAX-(uintptr_t)mapping || op>NativeAdrenoInvalidate || op<NativeAdrenoClean)
+        return kIOReturnBadArgument;
+    disable_preemption();
+    uint64_t ctr;__asm__ volatile("mrs %0, ctr_el0":"=r"(ctr));
+    size_t line=(size_t)4<<((ctr>>16)&15);
+    if(line>4096) {enable_preemption();return kIOReturnUnsupported;}
+    uintptr_t address=(uintptr_t)mapping,end=address+bytes;
+    __asm__ volatile("dsb sy":::"memory");
+    for(;address<end;address+=line) {
+        if(op==NativeAdrenoClean)__asm__ volatile("dc cvac, %0"::"r"(address):"memory");
+        else if(op==NativeAdrenoCleanInvalidate)__asm__ volatile("dc civac, %0"::"r"(address):"memory");
+        else __asm__ volatile("dc ivac, %0"::"r"(address):"memory");
+    }
+    __asm__ volatile("dsb sy":::"memory");
+    enable_preemption();return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMaintainOwnedPages(void *mapping,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    const uint64_t began=mach_absolute_time();
+    const IOReturn status=maintainOwnedPages(mapping,bytes,op);
+    if(!status)noteMaintenance(began,bytes);
+    return status;
+}
+IOReturn NativeAdrenoMaintainPhysicalPages(uint64_t physical,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    if(!physical || !bytes || ((physical|bytes)&4095) || physical>UINT64_MAX-bytes || op>NativeAdrenoInvalidate || op<NativeAdrenoClean)
+        return kIOReturnBadArgument;
+    const uint64_t began=mach_absolute_time();
+    /* One barrier pair per run of up to 64 pages instead of per page (an imported 3048x2032 surface is 5952 pages): preemption stays off
+     * for a bounded run, and the closing DSB on the issuing core completes every operation of that run. */
+    for(size_t offset=0;offset<bytes;) {
+        disable_preemption();
+        uint64_t ctr;__asm__ volatile("mrs %0, ctr_el0":"=r"(ctr));
+        const size_t line=(size_t)4<<((ctr>>16)&15);
+        if(line>4096) {enable_preemption();return kIOReturnUnsupported;}
+        __asm__ volatile("dsb sy":::"memory");
+        for(unsigned run=0;run<64 && offset<bytes;++run,offset+=4096) {
+            /* A page outside the kernel's DRAM is device memory (the firmware framebuffer the display hand-off imports): the CPU maps it
+             * uncached (kIOMapInhibitCache), no cache line of it exists to maintain, and phystokv would panic on it (int-080: illegal PA
+             * 0xb8000000). */
+            const uint64_t page=physical+offset;
+            if(page<gPhysBase || page-gPhysBase>=gPhysSize)continue;
+            const vm_offset_t alias=phystokv(page);
+            if(!alias) {__asm__ volatile("dsb sy":::"memory");enable_preemption();return kIOReturnUnsupported;}
+            for(uintptr_t address=alias,end=alias+4096;address<end;address+=line) {
+                if(op==NativeAdrenoClean)__asm__ volatile("dc cvac, %0"::"r"(address):"memory");
+                else if(op==NativeAdrenoCleanInvalidate)__asm__ volatile("dc civac, %0"::"r"(address):"memory");
+                else __asm__ volatile("dc ivac, %0"::"r"(address):"memory");
+            }
+        }
+        __asm__ volatile("dsb sy":::"memory");
+        enable_preemption();
+    }
+    noteMaintenance(began,bytes);
+    return kIOReturnSuccess;
+}
+/* A user BO's pages become Normal non-cacheable (write-combined) for every CPU mapping the pmap tracks: the kernel's own mapping and each
+ * client view. The views did not get the cache mode their mapping asked for (int-070: Turnip's write-combine view left IB words in a CPU
+ * cache line), but they do take the page's own attribute. That is the Linux msm model for its WC BOs: CPU writes reach DRAM, the GPU's
+ * non-cacheable reads see them and CPU reads see GPU writes without per-submission maintenance. The physical aperture keeps its cacheable
+ * block mapping on this kernel (no __ARM_PTE_PHYSMAP__); nothing writes through it, and the caller cleans and invalidates the pages first.
+ * Before the pages go back to the VM they get the default attribute again. */
+IOReturn NativeAdrenoSetPagesCacheMode(const NativeAdrenoPhysicalSpan *spans,size_t count,bool write_combined)
+{
+    if(!spans || !count)return kIOReturnBadArgument;
+    uint64_t pages=0;
+    for(size_t i=0;i<count;++i) {
+        const NativeAdrenoPhysicalSpan &span=spans[i];
+        if(!span.bytes || ((span.physical|span.bytes)&4095) || span.physical>UINT64_MAX-span.bytes ||
+            span.physical<gPhysBase || span.physical+span.bytes-gPhysBase>gPhysSize)return kIOReturnBadArgument;
+        pages+=span.bytes/4096;
+    }
+    for(size_t i=0;i<count;++i)
+        for(uint64_t offset=0;offset<spans[i].bytes;offset+=4096)
+            pmap_set_cache_attributes((ppnum_t)((spans[i].physical+offset)>>PAGE_SHIFT),write_combined?VM_WIMG_WCOMB:VM_WIMG_USE_DEFAULT);
+    if(write_combined)__atomic_fetch_add(&native_adreno_cache_stats[4],pages,__ATOMIC_RELAXED);
+    else __atomic_fetch_sub(&native_adreno_cache_stats[4],pages,__ATOMIC_RELAXED);
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoReassertWriteCombined(const NativeAdrenoPhysicalSpan *spans,size_t count,uint32_t *reset)
+{
+    if(!spans || !count || !reset)return kIOReturnBadArgument;
+    const uint64_t began=mach_absolute_time();
+    for(size_t i=0;i<count;++i) {
+        const NativeAdrenoPhysicalSpan &span=spans[i];
+        if(!span.bytes || ((span.physical|span.bytes)&4095) || span.physical>UINT64_MAX-span.bytes ||
+            span.physical<gPhysBase || span.physical+span.bytes-gPhysBase>gPhysSize)return kIOReturnBadArgument;
+        for(uint64_t offset=0;offset<span.bytes;offset+=4096) {
+            const ppnum_t pn=(ppnum_t)((span.physical+offset)>>PAGE_SHIFT);
+            /* From the default attribute the pmap also cleans and invalidates the page (pmap_sync_wimg), so lines a cacheable view
+             * dirtied reach DRAM before the GPU reads it. */
+            if((pmap_cache_attributes(pn)&VM_WIMG_MASK)!=VM_WIMG_WCOMB) {pmap_set_cache_attributes(pn,VM_WIMG_WCOMB);++*reset;}
+        }
+    }
+    __atomic_fetch_add(&native_adreno_reassert_ticks,mach_absolute_time()-began,__ATOMIC_RELAXED);
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoGmuContext.cpp b/iokit/Kernel/arm/a740/NativeAdrenoGmuContext.cpp
new file mode 100644
index 0000000..eb41fd9
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoGmuContext.cpp
@@ -0,0 +1,121 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoGmuContext.h"
+#include "ArmSmmu4KMmio.h"
+#include <IOKit/IOLib.h>
+
+static void readBack(const ArmSmmu4KIo *io,const ArmSmmu4KProgramResult *program,unsigned bank,
+    unsigned slot,NativeAdrenoGmuContextReport *r)
+{
+    /* Only registers the program step itself has already read; skipped if that step never ran. */
+    if(!program->context_offset || !program->id1)return;
+    const size_t page=(program->id1&(1u<<31))?0x10000:0x1000;
+    io->read32(io->cookie,0x800+4*slot,&r->smr);
+    io->read32(io->cookie,0xc00+4*slot,&r->s2cr);
+    io->read32(io->cookie,page+4*bank,&r->cbar);
+    io->read32(io->cookie,size_t(program->context_offset),&r->sctlr);
+    io->read64(io->cookie,size_t(program->context_offset)+0x20,&r->ttbr0);
+}
+IOReturn NativeAdrenoGmuContext::bringUp(const ArmSmmu4KIo *io,unsigned bank,unsigned asid,
+    unsigned slot,uint16_t sid,void (*progress)(uint32_t),NativeAdrenoGmuContextReport *report)
+{
+    if(!report)return kIOReturnBadArgument;
+    *report={};
+    if(used_)return kIOReturnBusy;
+    if(!io || bank>63 || !asid || asid>0xffff || slot>127)return kIOReturnBadArgument;
+    used_=true;
+    IOReturn status=kIOReturnSuccess;
+    auto step=[&](Step s) {report->step=s;if(progress)progress(s);};
+    step(Allocate);
+    /* Stage-1 output size is ID2.OAS, as arm_smmu_init_domain_context uses smmu->ipa_size; tables and
+     * payloads must then lie below it. 40 bits is this driver's own allocation ceiling. */
+    static const uint8_t oas_bits[16]={32,36,40,42,44,48};
+    if(io->read32(io->cookie,0x28,&report->id2))status=kIOReturnIOError;
+    else {
+        const unsigned code=(report->id2>>4)&15;
+        report->output_bits=code<6?oas_bits[code]:0;
+        if(report->output_bits>40)report->output_bits=40;
+        if(!report->output_bits)status=kIOReturnUnsupported;
+    }
+    if(!status)status=gmu_.allocate(NativeAdrenoGmuDefaultSizes(TablePages*0x1000),report->output_bits);
+    if(!status) {
+        step(Prepare);
+        status=smmu_.prepare(&gmu_.tables(),0,0,GmuApertureBytes,NativeAdrenoSmmuContext::MaxLeaves,
+            bank,asid,1000,report->output_bits);
+    }
+    if(!status) {
+        step(Program);
+        status=smmu_.program(io);
+        const ArmSmmu4KProgramResult *p=smmu_.programResult();
+        report->program_phase=p->phase;report->program_writes=p->writes;
+        report->program_readback_valid=p->readback_valid;report->program_enabled=p->enabled;
+        report->id1=p->id1;report->program_status=smmu_.programStatus();
+        report->image=p->readback;
+        ArmSmmu4KContextConfig actual=*smmu_.configHandle();
+        actual.id0=p->id0;actual.id2=p->id2;
+        ArmSmmu4KContextImage want;
+        if(p->phase>=3 && ArmSmmu4KEncodeContext(&actual,&want)==ArmSmmu4KSuccess) {
+            const ArmSmmu4KContextImage &got=p->readback;
+            const uint32_t sctlr_want=p->enabled?want.sctlr:0;
+            report->mismatch=(got.cbar!=want.cbar)|(got.cba2r!=want.cba2r)<<1|(got.tcr!=want.tcr)<<2|
+                (got.tcr2!=want.tcr2)<<3|(got.mair0!=want.mair0)<<4|(got.mair1!=want.mair1)<<5|
+                (got.ttbr0!=want.ttbr0)<<6|(got.ttbr1!=want.ttbr1)<<7|(got.sctlr!=sctlr_want)<<8;
+        }
+    }
+    if(!status) {
+        step(Attach);
+        const ArmSmmu4KStream route{slot,sid};
+        status=smmu_.attach(&route,1);
+        const ArmSmmu4KStreamResult *s=smmu_.streamResult();
+        report->route_status=smmu_.attachStatus();
+        report->route_phase=s->phase;report->route_writes=s->writes;report->routes_verified=s->streams_verified;
+    }
+    if(!status) {
+        step(VmAttach);
+        NativeAdrenoVmRegion lower={&gmu_.tables(),smmu_.arenaHandle(),smmu_.stateHandle()};
+        status=vm_.attach(io,smmu_.configHandle(),smmu_.streamsHandle(),&lower,nullptr,64,4000);
+    }
+    if(!status) {
+        step(Map);
+        status=gmu_.mapInto(&vm_);
+        report->spans=uint32_t(vm_.spanCount());
+    }
+    if(!status) {
+        step(Ready);
+        ready_=true;
+    }
+    report->status=status;
+    if(report->step>=Program)readBack(io,smmu_.programResult(),bank,slot,report);
+    return status;
+}
+/* Lives for the rest of the boot: the context bank points at its tables. */
+static NativeAdrenoGmuContext *board_context;
+extern "C" IOReturn NativeAdrenoGmuContextBringup(volatile uint8_t *smmu,size_t bytes,
+    unsigned bank,unsigned asid,unsigned slot,unsigned sid,void (*progress)(uint32_t),
+    NativeAdrenoGmuContextReport *report)
+{
+    static ArmSmmu4KMmio mmio;
+    static ArmSmmu4KIo io;
+    NativeAdrenoGmuContext *&context=board_context;
+    if(!report || context || !smmu || !bytes || sid>0xffff)return kIOReturnBadArgument;
+    mmio={reinterpret_cast<volatile unsigned char *>(smmu),bytes};
+    if(ArmSmmu4KBindMmio(&mmio,&io)!=ArmSmmu4KSuccess)return kIOReturnBadArgument;
+    context=new NativeAdrenoGmuContext;
+    if(!context)return kIOReturnNoMemory;
+    return context->bringUp(&io,bank,asid,slot,uint16_t(sid),progress,report);
+}
+extern "C" IOReturn NativeAdrenoGmuContextPayloads(NativeAdrenoGmuPayload out[5])
+{
+    if(!out)return kIOReturnBadArgument;
+    for(unsigned i=0;i<5;++i)out[i]={};
+    if(!board_context || !board_context->ready())return kIOReturnNotReady;
+    NativeAdrenoGmuAllocator &gmu=board_context->allocator();
+    const NativeAdrenoGmuMemoryLayout &layout=gmu.layout();
+    const NativeAdrenoMemory *objects[5]={&gmu.icache(),&gmu.dummy(),&gmu.debug(),&gmu.log(),&gmu.hfi()};
+    const uint64_t iovas[5]={layout.icache_iova,layout.dummy_iova,layout.debug_iova,layout.log_iova,layout.hfi_iova};
+    for(unsigned i=0;i<5;++i) {
+        const NativeAdrenoMemory *m=objects[i];
+        if(m->spanCount()!=1 || m->spans()[0].bytes!=m->bytes())return kIOReturnUnsupported;
+        out[i]={m->spans()[0].physical,m->bytes(),iovas[i]};
+    }
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoGmuContext.h b/iokit/Kernel/arm/a740/NativeAdrenoGmuContext.h
new file mode 100644
index 0000000..dbd1b92
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoGmuContext.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_GMU_CONTEXT_H
+#define NATIVE_ADRENO_GMU_CONTEXT_H
+#include "NativeAdrenoGmuMemory.h"
+#include "NativeAdrenoSmmuContext.h"
+
+/* The GMU's own SMMU context, in the order a6xx_gmu_memory_probe and the arm-smmu
+ * attach build it: allocate the payloads at their fixed GMU addresses, prepare a
+ * native4K lower-region (TTBR0) table pool for the whole 0..2 GiB GMU space,
+ * program one context bank, route the GMU stream to it, attach the VM and map the
+ * payloads. Bank, ASID, SMR slot and stream ID are caller inputs. Every resource
+ * is retained on every outcome; there is no teardown. Caller keeps CX powered and
+ * the SMMU clocks running, and keeps the GMU halted (nothing is booted here). */
+struct NativeAdrenoGmuContextReport {
+    uint32_t step;                  /* last step started, NativeAdrenoGmuContext::Step */
+    IOReturn status;                /* of that step */
+    uint32_t program_phase,program_writes,program_readback_valid,program_enabled;
+    uint32_t route_phase,route_writes,routes_verified;
+    uint32_t id1,id2;               /* id2 is read before any allocation */
+    uint32_t output_bits;           /* from ID2.OAS, capped at 40 */
+    uint32_t program_status,route_status;   /* ArmSmmu4KStatus of program/attach */
+    uint32_t sctlr,cbar,smr,s2cr;   /* register readback after the last step reached */
+    uint64_t ttbr0;
+    uint32_t spans;
+    /* The program step's last context readback and which fields differ from the encoded image: bit 0 CBAR,
+     * 1 CBA2R, 2 TCR, 3 TCR2, 4 MAIR0, 5 MAIR1, 6 TTBR0, 7 TTBR1, 8 SCTLR (SCTLR is 0 before enable). */
+    ArmSmmu4KContextImage image;
+    uint32_t mismatch;
+};
+class NativeAdrenoGmuContext final {
+    NativeAdrenoGmuAllocator gmu_;
+    NativeAdrenoSmmuContext smmu_;
+    NativeAdrenoVm vm_;
+    bool ready_=false,used_=false;
+public:
+    /* Allocate also reads ID2 first and refuses an output size the kit cannot encode. */
+    enum Step : uint32_t {Allocate=1,Prepare,Program,Attach,VmAttach,Map,Ready};
+    /* Lower region: 1 L1 + 2 L2 + 1024 L3 pages for 2 GiB with a 32-bit input. */
+    enum : size_t {TablePages=1027};
+    NativeAdrenoGmuContext()=default;
+    NativeAdrenoGmuContext(const NativeAdrenoGmuContext &)=delete;
+    NativeAdrenoGmuContext &operator=(const NativeAdrenoGmuContext &)=delete;
+    /* One attempt per object. progress (may be null) is called before each step. */
+    IOReturn bringUp(const ArmSmmu4KIo *io,unsigned bank,unsigned asid,unsigned slot,
+        uint16_t sid,void (*progress)(uint32_t step),NativeAdrenoGmuContextReport *report);
+    bool ready() const {return ready_;}
+    NativeAdrenoGmuAllocator &allocator() {return gmu_;}
+    NativeAdrenoVm &vm() {return vm_;}
+};
+/* Board entry: binds the kit's direct MMIO adapter to an owned live mapping of the
+ * whole SMMU window and runs bringUp on a context that lives forever. */
+extern "C" IOReturn NativeAdrenoGmuContextBringup(volatile uint8_t *smmu,size_t bytes,
+    unsigned bank,unsigned asid,unsigned slot,unsigned sid,void (*progress)(uint32_t),
+    NativeAdrenoGmuContextReport *report);
+/* The payloads of the context the board entry built, in Sm8550GmuConfig order (icache, dummy, debug,
+ * log, hfi): physical base, size and GMU address of each physically contiguous object. Only after
+ * that context reached Ready. The GMU maps them Normal non-cacheable (MAIR index 0), as Linux maps
+ * the GMU buffers without IOMMU_CACHE; the caller gives the CPU a matching non-cacheable view. */
+struct NativeAdrenoGmuPayload {uint64_t physical,bytes,iova;};
+extern "C" IOReturn NativeAdrenoGmuContextPayloads(NativeAdrenoGmuPayload out[5]);
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoGmuMemory.cpp b/iokit/Kernel/arm/a740/NativeAdrenoGmuMemory.cpp
new file mode 100644
index 0000000..b7fc903
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoGmuMemory.cpp
@@ -0,0 +1,92 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoGmuMemory.h"
+#include <IOKit/IOLib.h>
+enum : size_t { PageBytes=0x1000 };
+NativeAdrenoGmuSizes NativeAdrenoGmuDefaultSizes(size_t table_bytes)
+{
+    return {0xffc000,0x4000,0x7000,0x4000,0x4000,table_bytes};
+}
+IOReturn NativeAdrenoGmuAllocator::allocate(const NativeAdrenoGmuSizes &sizes,unsigned address_bits)
+{
+    if(ready_ || icache_.bytes())return kIOReturnBusy;
+    const uint64_t requested[]={sizes.icache,sizes.dummy,sizes.debug,sizes.log,
+        sizes.hfi,sizes.tables};
+    for(uint64_t value:requested)
+        if(!value || (value&(PageBytes-1)) || value>uint64_t(SIZE_MAX))
+            return kIOReturnBadArgument;
+    /* The fixed addresses of a6xx_gmu.c at the pinned tree: icache at 0x4000 below the uncached range, dummy and
+     * debug at 0x60000000/0x60400000. Log and HFI have no fixed address there; drm_mm gives them the lowest free
+     * pages after the dummy, which is where they are put here. */
+    if(sizes.icache>GmuUncachedBase-GmuIcacheIova ||
+        sizes.dummy+sizes.log+sizes.hfi>GmuDebugIova-GmuUncachedBase ||
+        sizes.debug>GmuApertureBytes-GmuDebugIova)return kIOReturnBadArgument;
+    struct Selection {NativeAdrenoMemory *memory;uint64_t bytes;uint64_t *iova;uint64_t at;};
+    const Selection selections[]={
+        {&icache_,sizes.icache,&layout_.icache_iova,GmuIcacheIova},
+        {&dummy_,sizes.dummy,&layout_.dummy_iova,GmuUncachedBase},
+        {&debug_,sizes.debug,&layout_.debug_iova,GmuDebugIova},
+        {&log_,sizes.log,&layout_.log_iova,GmuUncachedBase+sizes.dummy},
+        {&hfi_,sizes.hfi,&layout_.hfi_iova,GmuUncachedBase+sizes.dummy+sizes.log},
+        {&tables_,sizes.tables,&layout_.tables_iova,0}};
+    for(const Selection &selection:selections) {
+        const IOReturn status=selection.memory->allocate(static_cast<size_t>(selection.bytes),
+            address_bits,true,static_cast<size_t>(selection.bytes));
+        if(status) {
+            (void)releaseAll();
+            return status;
+        }
+        *selection.iova=selection.at;
+    }
+    layout_.tables_bytes=static_cast<size_t>(sizes.tables);
+    layout_.end_iova=GmuDebugIova+sizes.debug;
+    ready_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoGmuAllocator::mapInto(NativeAdrenoVm *vm)
+{
+    if(!ready_ || !vm)return kIOReturnBadArgument;
+    for(uint64_t handle:handles_)if(handle)return kIOReturnBusy;
+    /* The table pool itself is never mapped: its physical pages are the
+     * translation storage and the VM refuses such an overlap. */
+    NativeAdrenoMemory *objects[]={&icache_,&dummy_,&debug_,&log_,&hfi_};
+    const uint64_t iovas[]={layout_.icache_iova,layout_.dummy_iova,layout_.debug_iova,
+        layout_.log_iova,layout_.hfi_iova};
+    for(size_t index=0;index<5;++index) {
+        /* a6xx_gmu.c maps the icache MAP_PRIV and every buffer without NOEXEC; here only the icache, which
+         * the GMU executes from, is executable, and the data buffers stay execute-never. */
+        const unsigned permissions=index?3u:15u;
+        const IOReturn status=vm->map(objects[index],0,iovas[index],permissions,0,2,&handles_[index]);
+        if(status) {
+            for(size_t previous=0;previous<index;++previous)
+                if(handles_[previous]) {vm->unmap(handles_[previous]);handles_[previous]=0;}
+            return status;
+        }
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoGmuAllocator::unmapFrom(NativeAdrenoVm *vm)
+{
+    if(!vm)return kIOReturnBadArgument;
+    IOReturn status=kIOReturnSuccess;
+    for(size_t index=5;index--;)if(handles_[index]) {
+        const IOReturn unmapped=vm->unmap(handles_[index]);
+        if(unmapped)status=unmapped;else handles_[index]=0;
+    }
+    return status;
+}
+IOReturn NativeAdrenoGmuAllocator::releaseAll()
+{
+    NativeAdrenoMemory *objects[]={&icache_,&dummy_,&debug_,&log_,&hfi_,&tables_};
+    IOReturn status=kIOReturnSuccess;
+    for(NativeAdrenoMemory *object:objects)
+        if(object->bytes() && object->release()!=kIOReturnSuccess)status=kIOReturnIOError;
+    return status;
+}
+IOReturn NativeAdrenoGmuAllocator::release()
+{
+    if(!ready_)return kIOReturnNotReady;
+    const IOReturn status=releaseAll();
+    if(status)return status;
+    ready_=false;layout_={};
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoGmuMemory.h b/iokit/Kernel/arm/a740/NativeAdrenoGmuMemory.h
new file mode 100644
index 0000000..f7ffec2
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoGmuMemory.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_GMU_MEMORY_H
+#define NATIVE_ADRENO_GMU_MEMORY_H
+#include "NativeAdrenoMemory.h"
+#include "NativeAdrenoVm.h"
+
+/* Backing objects for the GMU cold start, laid out at the fixed IOVAs of the
+ * GMU's own address space (0..2 GiB, the lower/TTBR0 region of its context
+ * bank, as a6xx_gmu_memory_probe creates it): instruction cache payload, dummy,
+ * debug and log buffers, HFI queues, plus the contiguous native4K table pool
+ * that will translate them (the pool itself has no IOVA). Sizes are the ones the qualified GMU startup uses. All
+ * objects are physically contiguous and page aligned; the allocator only
+ * assigns addresses and never maps them or touches the SMMU. Any failure
+ * releases what it allocated and leaves no layout. */
+enum : uint64_t {
+    GmuIcacheIova=0x4000, GmuUncachedBase=0x60000000, GmuDebugIova=0x60400000,
+    GmuApertureBytes=0x80000000
+};
+struct NativeAdrenoGmuSizes {
+    uint64_t icache,dummy,debug,log,hfi,tables;
+};
+/* Exact sizes of the qualified startup; table pool is caller sized. */
+NativeAdrenoGmuSizes NativeAdrenoGmuDefaultSizes(size_t table_bytes);
+struct NativeAdrenoGmuMemoryLayout {
+    uint64_t icache_iova,dummy_iova,debug_iova,log_iova,hfi_iova;
+    uint64_t tables_iova;
+    size_t tables_bytes;
+    uint64_t end_iova;            /* first address after the whole reservation */
+};
+class NativeAdrenoGmuAllocator final {
+    NativeAdrenoMemory icache_,dummy_,debug_,log_,hfi_,tables_;
+    NativeAdrenoGmuMemoryLayout layout_{};
+    uint64_t handles_[5]{};
+    bool ready_=false;
+    IOReturn releaseAll();
+public:
+    NativeAdrenoGmuAllocator()=default;
+    ~NativeAdrenoGmuAllocator()=default;
+    NativeAdrenoGmuAllocator(const NativeAdrenoGmuAllocator &)=delete;
+    NativeAdrenoGmuAllocator &operator=(const NativeAdrenoGmuAllocator &)=delete;
+    /* Every size must be a nonzero 4KiB multiple and fit its fixed range. Every page lies below
+     * 2^address_bits: the SMMU output size (ID2.OAS) the context will use. */
+    IOReturn allocate(const NativeAdrenoGmuSizes &sizes,unsigned address_bits=40);
+    /* Map every payload into the VM's lower region at its assigned IOVA with
+     * read/write access (icache also privileged and executable). The VM must already be attached with a lower arena
+     * covering the reservation. Handles are retained for unmapFrom. */
+    IOReturn mapInto(NativeAdrenoVm *vm);
+    /* Reverse order unmap; refuses while a mapping has outstanding jobs. */
+    IOReturn unmapFrom(NativeAdrenoVm *vm);
+    /* Only when every object has been released; on any refusal nothing is
+     * destroyed and the caller keeps the quarantined objects alive. */
+    IOReturn release();
+    bool ready() const {return ready_;}
+    const NativeAdrenoGmuMemoryLayout &layout() const {return layout_;}
+    NativeAdrenoMemory &icache() {return icache_;}
+    NativeAdrenoMemory &dummy() {return dummy_;}
+    NativeAdrenoMemory &debug() {return debug_;}
+    NativeAdrenoMemory &log() {return log_;}
+    NativeAdrenoMemory &hfi() {return hfi_;}
+    NativeAdrenoMemory &tables() {return tables_;}
+    const NativeAdrenoMemory &icache() const {return icache_;}
+    const NativeAdrenoMemory &dummy() const {return dummy_;}
+    const NativeAdrenoMemory &debug() const {return debug_;}
+    const NativeAdrenoMemory &log() const {return log_;}
+    const NativeAdrenoMemory &hfi() const {return hfi_;}
+    const NativeAdrenoMemory &tables() const {return tables_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoGpuContext.cpp b/iokit/Kernel/arm/a740/NativeAdrenoGpuContext.cpp
new file mode 100644
index 0000000..6828102
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoGpuContext.cpp
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoGpuContext.h"
+#include "ArmSmmu4KMmio.h"
+#include <IOKit/IOLib.h>
+
+extern "C" volatile uint32_t native_adreno_pool_mib;
+extern "C" volatile uint32_t native_adreno_pool_stats[8],native_adreno_pool_status;
+extern "C" volatile uint32_t native_adreno_wc_enabled,native_adreno_pool_wc;
+static const uint64_t kIovas[GpuBufferCount]={GpuSqeIova,GpuRingIova,GpuMemptrsIova,GpuPwrupIova,GpuScratchIova};
+static const size_t kBytes[GpuBufferCount]={GpuSqeBytes,GpuRingBytes,GpuPageBytes,GpuPageBytes,GpuPageBytes};
+IOReturn NativeAdrenoGpuContext::bringUp(const ArmSmmu4KIo *io,unsigned bank,unsigned asid,const unsigned slots[2],
+    const uint16_t sids[2],void (*progress)(uint32_t),NativeAdrenoGmuContextReport *report)
+{
+    if(!report)return kIOReturnBadArgument;
+    *report={};
+    if(used_)return kIOReturnBusy;
+    if(!io || !slots || !sids || bank>63 || !asid || asid>0xffff || slots[0]>127 || slots[1]>127 ||
+        slots[0]==slots[1])return kIOReturnBadArgument;
+    used_=true;
+    IOReturn status=kIOReturnSuccess;
+    auto step=[&](Step s) {report->step=s;if(progress)progress(s);};
+    step(Allocate);
+    static const uint8_t oas_bits[16]={32,36,40,42,44,48};
+    if(io->read32(io->cookie,0x28,&report->id2))status=kIOReturnIOError;
+    else {
+        const unsigned code=(report->id2>>4)&15;
+        report->output_bits=code<6?oas_bits[code]:0;
+        if(report->output_bits>40)report->output_bits=40;
+        if(!report->output_bits)status=kIOReturnUnsupported;
+    }
+    /* The BO pool is taken first, while the VM still has long contiguous runs (the board sets the size from ishtar-gpu-pool; 0 = scattered BOs only).
+     * A pool that cannot be had at one size is tried at the next smaller; none is not an error. */
+    if(!status && native_adreno_pool_mib) {
+        for(uint32_t mib=native_adreno_pool_mib;mib>=16;mib>>=1) {
+            const IOReturn pooled=NativeAdrenoMemory::reservePool(report->output_bits,(size_t)mib<<20);
+            native_adreno_pool_stats[0]=pooled==kIOReturnSuccess?mib:0;native_adreno_pool_status=(uint32_t)pooled;
+            if(pooled==kIOReturnSuccess)break;
+        }
+        /* Not fatal: without it each pooled BO changes its pages' attribute itself, as a scattered one does. */
+        if(native_adreno_wc_enabled && NativeAdrenoMemory::poolBytes())native_adreno_pool_wc=(uint32_t)NativeAdrenoMemory::writeCombinePool()|1u<<31;
+    }
+    if(!status)status=tables_.allocate(TablePages*0x1000,report->output_bits,true,TablePages*0x1000);
+    for(unsigned i=0;!status && i<GpuBufferCount;++i)
+        status=buffers_[i].allocate(kBytes[i],report->output_bits,true,kBytes[i]);
+    if(!status) {
+        step(Prepare);
+        status=smmu_.prepare(&tables_,0,0,GpuApertureBytes,NativeAdrenoSmmuContext::MaxLeaves,
+            bank,asid,1000,report->output_bits);
+        if(!status)smmu_.setAliasScratch(alias_scratch_,sizeof alias_scratch_/sizeof *alias_scratch_);
+    }
+    if(!status) {
+        step(Program);
+        status=smmu_.program(io);
+        const ArmSmmu4KProgramResult *p=smmu_.programResult();
+        report->program_phase=p->phase;report->program_writes=p->writes;
+        report->program_readback_valid=p->readback_valid;report->program_enabled=p->enabled;
+        report->id1=p->id1;report->program_status=smmu_.programStatus();
+        report->image=p->readback;
+    }
+    if(!status) {
+        step(Attach);
+        const ArmSmmu4KStream routes[2]={{slots[0],sids[0]},{slots[1],sids[1]}};
+        status=smmu_.attach(routes,2);
+        const ArmSmmu4KStreamResult *s=smmu_.streamResult();
+        report->route_status=smmu_.attachStatus();
+        report->route_phase=s->phase;report->route_writes=s->writes;report->routes_verified=s->streams_verified;
+    }
+    if(!status) {
+        step(VmAttach);
+        NativeAdrenoVmRegion lower={&tables_,smmu_.arenaHandle(),smmu_.stateHandle()};
+        /* 65536 spans: 256 MiB of BOs even when every page is its own span. The Metal runtime pools its memory in 64 MiB blocks,
+         * which XNU rarely finds physically contiguous; one scattered block is 16384 spans (int-070 ran out at 16384). */
+        status=vm_.attach(io,smmu_.configHandle(),smmu_.streamsHandle(),&lower,nullptr,131072,262144);
+    }
+    if(!status) {
+        step(Map);
+        /* adreno_fw_create_bo maps the SQE MSM_BO_GPU_READONLY without NOEXEC; every other kernel BO read/write. */
+        for(unsigned i=0;!status && i<GpuBufferCount;++i)
+            status=vm_.map(&buffers_[i],0,kIovas[i],i?3u:5u,0,2,&handles_[i]);
+        report->spans=uint32_t(vm_.spanCount());
+    }
+    if(!status) {
+        step(Ready);
+        ready_=true;
+    }
+    report->status=status;
+    return status;
+}
+static NativeAdrenoGpuContext *board_gpu_context;
+extern "C" IOReturn NativeAdrenoGpuContextBringup(volatile uint8_t *smmu,size_t bytes,unsigned bank,unsigned asid,
+    unsigned slot0,unsigned sid0,unsigned slot1,unsigned sid1,void (*progress)(uint32_t),
+    NativeAdrenoGmuContextReport *report)
+{
+    static ArmSmmu4KMmio mmio;
+    static ArmSmmu4KIo io;
+    if(!report || board_gpu_context || !smmu || !bytes || sid0>0xffff || sid1>0xffff)return kIOReturnBadArgument;
+    mmio={reinterpret_cast<volatile unsigned char *>(smmu),bytes};
+    if(ArmSmmu4KBindMmio(&mmio,&io)!=ArmSmmu4KSuccess)return kIOReturnBadArgument;
+    board_gpu_context=new NativeAdrenoGpuContext;
+    if(!board_gpu_context)return kIOReturnNoMemory;
+    const unsigned slots[2]={slot0,slot1};
+    const uint16_t sids[2]={uint16_t(sid0),uint16_t(sid1)};
+    return board_gpu_context->bringUp(&io,bank,asid,slots,sids,progress,report);
+}
+extern "C" IOReturn NativeAdrenoGpuContextBuffers(NativeAdrenoGpuBuffer out[5])
+{
+    if(!out)return kIOReturnBadArgument;
+    for(unsigned i=0;i<GpuBufferCount;++i)out[i]={};
+    if(!board_gpu_context || !board_gpu_context->ready())return kIOReturnNotReady;
+    for(unsigned i=0;i<GpuBufferCount;++i) {
+        const NativeAdrenoMemory &m=board_gpu_context->buffer(i);
+        if(m.spanCount()!=1 || m.spans()[0].bytes!=m.bytes())return kIOReturnUnsupported;
+        out[i]={m.spans()[0].physical,m.bytes(),kIovas[i]};
+    }
+    return kIOReturnSuccess;
+}
+extern "C" NativeAdrenoVm *NativeAdrenoGpuContextVm()
+{
+    return board_gpu_context?board_gpu_context->vm():nullptr;
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoGpuContext.h b/iokit/Kernel/arm/a740/NativeAdrenoGpuContext.h
new file mode 100644
index 0000000..dbe915a
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoGpuContext.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_GPU_CONTEXT_H
+#define NATIVE_ADRENO_GPU_CONTEXT_H
+#include "NativeAdrenoGmuContext.h"
+
+/* The GPU's own SMMU context, built like the GMU's (NativeAdrenoGmuContext): a native4K lower-region (TTBR0) table
+ * pool for a 0..2 GiB GPU space, one context bank, the GPU's two streams routed to it, then the kernel buffers the
+ * command processor needs at fixed GPU addresses below the A740 GMEM window (UCHE_GMEM_RANGE_MIN 16 MiB):
+ *   sqe      the SQE microcode (a740_sqe.fw without its first dword, as adreno_fw_create_bo copies it), R+X
+ *   ring     ring buffer 0, 32 KiB, aligned to its size, R+W
+ *   memptrs  msm_rbmemptrs layout: +0 rptr, +4 fence, +8 bv_rptr, +12 bv_fence, R+W
+ *   pwrup    the a7xx power-up register list (cpu_gpu_lock header + pairs), R+W
+ *   scratch  one page the first submissions may write, R+W
+ * All mappings are Normal non-cacheable (Linux maps kernel BOs write-combined) and outer shareable; the CPU must use
+ * a matching non-cacheable view. Bank, ASID, SMR slots and stream IDs are caller inputs. Nothing is torn down. */
+enum : uint64_t {
+    GpuSqeIova=0x100000, GpuRingIova=0x200000, GpuMemptrsIova=0x300000, GpuPwrupIova=0x301000,
+    GpuScratchIova=0x302000, GpuApertureBytes=0x80000000
+};
+enum : size_t {GpuSqeBytes=0x13000, GpuRingBytes=0x8000, GpuPageBytes=0x1000, GpuBufferCount=5};
+struct NativeAdrenoGpuBuffer {uint64_t physical,bytes,iova;};
+class NativeAdrenoGpuContext final {
+    NativeAdrenoMemory tables_,buffers_[GpuBufferCount];
+    uint64_t handles_[GpuBufferCount]{};
+    NativeAdrenoSmmuContext smmu_;
+    NativeAdrenoVm vm_;
+    /* The alias checks' sort scratch: one entry per range of the smaller compared side, at most half the aperture's leaves. */
+    uint32_t alias_scratch_[NativeAdrenoSmmuContext::MaxLeaves/2];
+    bool ready_=false,used_=false;
+public:
+    enum Step : uint32_t {Allocate=1,Prepare,Program,Attach,VmAttach,Map,Ready};
+    enum : size_t {TablePages=1027};
+    NativeAdrenoGpuContext()=default;
+    NativeAdrenoGpuContext(const NativeAdrenoGpuContext &)=delete;
+    NativeAdrenoGpuContext &operator=(const NativeAdrenoGpuContext &)=delete;
+    /* The report is the GMU context's: route counts cover both streams. */
+    IOReturn bringUp(const ArmSmmu4KIo *io,unsigned bank,unsigned asid,const unsigned slots[2],
+        const uint16_t sids[2],void (*progress)(uint32_t step),NativeAdrenoGmuContextReport *report);
+    bool ready() const {return ready_;}
+    const NativeAdrenoMemory &buffer(unsigned index) const {return buffers_[index];}
+    NativeAdrenoVm *vm() {return ready_?&vm_:nullptr;}
+};
+extern "C" IOReturn NativeAdrenoGpuContextBringup(volatile uint8_t *smmu,size_t bytes,unsigned bank,unsigned asid,
+    unsigned slot0,unsigned sid0,unsigned slot1,unsigned sid1,void (*progress)(uint32_t),
+    NativeAdrenoGmuContextReport *report);
+/* sqe, ring, memptrs, pwrup, scratch: physical base, size and GPU address, only after Ready. */
+extern "C" IOReturn NativeAdrenoGpuContextBuffers(NativeAdrenoGpuBuffer out[5]);
+/* The live VM of the ready GPU context (null before Ready), for the user-client core. */
+extern "C" NativeAdrenoVm *NativeAdrenoGpuContextVm();
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoMemory.cpp b/iokit/Kernel/arm/a740/NativeAdrenoMemory.cpp
new file mode 100644
index 0000000..51c0827
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoMemory.cpp
@@ -0,0 +1,320 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoMemory.h"
+/* Where a call that never returns is stuck: the free/unmap/release path stores a stage number here, the board page shows it. */
+extern "C" {volatile uint32_t native_adreno_trace_stage;}
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOLib.h>
+#include <kern/task.h>
+
+static bool outputWidth(unsigned bits)
+{return bits==32 || bits==36 || bits==40 || bits==42 || bits==44 || bits==48;}
+/* Where the last import stopped (10..19, 19 = done), and for a refused page the physical address and offset: the board log shows them. */
+enum : IOReturn {kNativeAdrenoProtectionFailure=2};   /* KERN_PROTECTION_FAILURE, as prepare() reports a range that cannot be wired for writing */
+extern "C" {volatile uint32_t native_adreno_pool_mib=0,native_adreno_pool_status=0;volatile uint32_t native_adreno_import_stage;volatile uint64_t native_adreno_import_fail_pa,native_adreno_import_fail_offset;}
+/* The pool (see reservePool): a free list of page extents over one contiguous block; best fit, neighbours merged on release. */
+extern "C" {volatile uint32_t native_adreno_pool_stats[8];}
+/* The pool's write-combine (writeCombinePool): bit 31 once tried, the low bits its status. */
+extern "C" {volatile uint32_t native_adreno_pool_wc;}   /* [0] pool MiB, [1] BOs from the pool, [2] fell back, [3] MiB in use, [4] peak MiB, [5] scattered BOs, [6] their spans, [7] import spans */
+namespace {
+struct PoolExtent {size_t offset,bytes;};
+struct Pool {
+    IOBufferMemoryDescriptor *descriptor=nullptr;
+    unsigned char *virt=nullptr;uint64_t physical=0;size_t bytes=0,used=0,peak=0;
+    PoolExtent free[512];unsigned count=0;
+    bool write_combined=false;
+} pool;
+bool poolTake(size_t bytes,size_t *offset) {
+    int best=-1;
+    for(unsigned i=0;i<pool.count;++i)if(pool.free[i].bytes>=bytes && (best<0 || pool.free[i].bytes<pool.free[best].bytes))best=(int)i;
+    if(best<0)return false;
+    *offset=pool.free[best].offset;
+    pool.free[best].offset+=bytes;pool.free[best].bytes-=bytes;
+    if(!pool.free[best].bytes) {for(unsigned i=(unsigned)best;i+1<pool.count;++i)pool.free[i]=pool.free[i+1];--pool.count;}
+    pool.used+=bytes;if(pool.used>pool.peak)pool.peak=pool.used;
+    native_adreno_pool_stats[3]=(uint32_t)(pool.used>>20);native_adreno_pool_stats[4]=(uint32_t)(pool.peak>>20);
+    return true;
+}
+void poolGive(size_t offset,size_t bytes) {
+    unsigned at=0;while(at<pool.count && pool.free[at].offset<offset)++at;
+    if(pool.count>=512) {pool.used-=bytes;return;}   /* cannot happen with bounded fragmentation; the extent is lost, not reused */
+    for(unsigned i=pool.count;i>at;--i)pool.free[i]=pool.free[i-1];
+    pool.free[at]={offset,bytes};++pool.count;
+    if(at+1<pool.count && pool.free[at].offset+pool.free[at].bytes==pool.free[at+1].offset) {
+        pool.free[at].bytes+=pool.free[at+1].bytes;
+        for(unsigned i=at+1;i+1<pool.count;++i)pool.free[i]=pool.free[i+1];
+        --pool.count;
+    }
+    if(at && pool.free[at-1].offset+pool.free[at-1].bytes==pool.free[at].offset) {
+        pool.free[at-1].bytes+=pool.free[at].bytes;
+        for(unsigned i=at;i+1<pool.count;++i)pool.free[i]=pool.free[i+1];
+        --pool.count;
+    }
+    pool.used-=bytes;native_adreno_pool_stats[3]=(uint32_t)(pool.used>>20);
+}
+}
+size_t NativeAdrenoMemory::poolBytes() {return pool.bytes;}
+/* int-152: a user BO's pages changed attribute one pmap_set_cache_attributes call at a time (each walks the page's mappings, flushes the
+ * TLB and cleans the page), on allocation and again on release, under the connection lock: 3 ms a BO on average and 90-130 ms for a
+ * surface-sized one, while every other GPU call of every client waited. The pool is the BOs' own block and nothing else maps it, so
+ * its pages take the attribute once here and keep it while the pool lives. */
+IOReturn NativeAdrenoMemory::writeCombinePool()
+{
+    if(!pool.descriptor || !pool.virt || !pool.bytes)return kIOReturnNotReady;
+    if(pool.write_combined)return kIOReturnSuccess;
+    IOReturn status=NativeAdrenoMaintainOwnedPages(pool.virt,pool.bytes,NativeAdrenoCleanInvalidate);
+    if(status)return status;
+    const NativeAdrenoPhysicalSpan span={0,pool.physical,pool.bytes};
+    status=NativeAdrenoSetPagesCacheMode(&span,1,true);
+    if(status)return status;
+    pool.write_combined=true;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::reservePool(unsigned bits,size_t bytes)
+{
+    if(pool.descriptor)return kIOReturnBusy;
+    if(!bytes || (bytes&4095) || !outputWidth(bits))return kIOReturnBadArgument;
+    NativeAdrenoCpuState cpu{};
+    IOReturn status=NativeAdrenoQueryCpu4K(&cpu);if(status!=kIOReturnSuccess)return status;
+    const uint64_t limit=UINT64_C(1)<<bits;
+    IOBufferMemoryDescriptor *descriptor=IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+        static_cast<IOOptionBits>(kIODirectionInOut)|static_cast<IOOptionBits>(kIOMemoryMapperNone)|kIOMemoryPhysicallyContiguous,
+        bytes,(limit-1)&~UINT64_C(4095));
+    if(!descriptor)return kIOReturnNoMemory;
+    status=descriptor->prepare();
+    if(status!=kIOReturnSuccess) {descriptor->release();return status;}
+    IOByteCount length=0,tail=0;
+    const addr64_t first=descriptor->getPhysicalSegment(0,&length,kIOMemoryMapperNone);
+    const addr64_t last=descriptor->getPhysicalSegment(bytes-4096,&tail,kIOMemoryMapperNone);
+    unsigned char *virt=static_cast<unsigned char *>(descriptor->getBytesNoCopy());
+    if(!first || (first&4095) || !virt || ((uintptr_t)virt&4095) || last!=first+bytes-4096 || first>=limit || bytes>limit-first ||
+        descriptor->getLength()!=bytes) {
+        (void)descriptor->complete();descriptor->release();return kIOReturnUnsupported;
+    }
+    pool.descriptor=descriptor;pool.virt=virt;pool.physical=first;pool.bytes=bytes;pool.used=pool.peak=0;
+    pool.free[0]={0,bytes};pool.count=1;
+    native_adreno_pool_stats[0]=(uint32_t)(bytes>>20);
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::allocate(size_t bytes,unsigned bits,bool contiguous,size_t budget,bool pooled)
+{
+    if(descriptor_ || spans_ || quarantined_)return kIOReturnBusy;
+    if(!bytes || (bytes&4095) || !outputWidth(bits) || !budget || budget>256u*1024u*1024u)
+        return kIOReturnBadArgument;
+    if(bytes>budget)return kIOReturnNoResources;
+    const size_t whole=(bytes+PAGE_SIZE-1)&~(size_t)(PAGE_SIZE-1);
+    NativeAdrenoCpuState cpu{};
+    IOReturn status=NativeAdrenoQueryCpu4K(&cpu);if(status!=kIOReturnSuccess)return status;
+    uint64_t limit=UINT64_C(1)<<bits;
+    if(pooled && pool.descriptor && bytes<=pool.bytes) {
+        size_t offset=0;
+        if(poolTake(bytes,&offset)) {
+            const uint64_t physical=pool.physical+offset;
+            if(physical>=limit || bytes>limit-physical) {poolGive(offset,bytes);}
+            else {
+                spans_=IONewData(NativeAdrenoPhysicalSpan,1);
+                if(!spans_) {poolGive(offset,bytes);return kIOReturnNoMemory;}
+                span_capacity_=1;span_count_=1;spans_[0]={0,physical,bytes};
+                mapping_=pool.virt+offset;bytes_=bytes;pooled_=true;pool_offset_=offset;prepared_=true;
+                bzero(mapping_,bytes);
+                /* Through a write-combined pool's own mapping the zeros go to DRAM; the barrier completes them. */
+                if(pool.write_combined)__asm__ volatile("dsb sy":::"memory");
+                else status=NativeAdrenoMaintainOwnedPages(mapping_,bytes,NativeAdrenoClean);
+                if(status!=kIOReturnSuccess) {(void)release();return status;}
+                native_adreno_pool_stats[1]=native_adreno_pool_stats[1]+1;
+                return kIOReturnSuccess;
+            }
+        }
+        native_adreno_pool_stats[2]=native_adreno_pool_stats[2]+1;
+    }
+    IOOptionBits options=static_cast<IOOptionBits>(kIODirectionInOut)|static_cast<IOOptionBits>(kIOMemoryMapperNone);
+    if(contiguous)options|=kIOMemoryPhysicallyContiguous;
+    descriptor_=IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,options,whole,(limit-1)&~UINT64_C(4095));
+    if(!descriptor_)return kIOReturnNoMemory;
+    status=descriptor_->prepare();
+    if(status!=kIOReturnSuccess) {descriptor_->release();descriptor_=nullptr;return status;}
+    prepared_=true;bytes_=bytes;mapping_=descriptor_->getBytesNoCopy();
+    status=kIOReturnUnsupported;
+    if(!mapping_ || ((uintptr_t)mapping_&4095) || bytes>UINTPTR_MAX-(uintptr_t)mapping_ ||
+        descriptor_->getLength()!=whole)goto failed;
+    span_capacity_=bytes/4096;
+    spans_=IONewData(NativeAdrenoPhysicalSpan,span_capacity_);
+    if(!spans_) {status=kIOReturnNoMemory;goto failed;}
+    for(size_t offset=0;offset<bytes;offset+=4096) {
+        IOByteCount length=0;
+        addr64_t physical=descriptor_->getPhysicalSegment(offset,&length,kIOMemoryMapperNone);
+        if(!physical || (physical&4095) || length<4096 || physical>=limit || 4096>limit-physical)
+            {status=kIOReturnUnsupported;goto failed;}
+        if(contiguous && offset && physical!=spans_[0].physical+offset)
+            {status=kIOReturnUnsupported;goto failed;}
+        if(span_count_ && physical==spans_[span_count_-1].physical+spans_[span_count_-1].bytes)
+            spans_[span_count_-1].bytes+=4096;
+        else spans_[span_count_++]={offset,physical,4096};
+    }
+    bzero(mapping_,bytes);
+    status=NativeAdrenoMaintainOwnedPages(mapping_,bytes,NativeAdrenoClean);
+    if(status!=kIOReturnSuccess)goto failed;
+    native_adreno_pool_stats[5]=native_adreno_pool_stats[5]+1;native_adreno_pool_stats[6]=native_adreno_pool_stats[6]+(uint32_t)span_count_;
+    return kIOReturnSuccess;
+failed:
+    /* release() deliberately retains descriptor/metadata if complete fails.
+     * Preserve the allocation's original failure instead of reporting cleanup
+     * as success. No object has been exposed to a GPU or userspace yet. */
+    (void)release();return status;
+}
+/* An import holds the pages through a memory entry of its own (kIOMemoryPersistent), which references the VM object: the owner may unmap
+ * its range while the GPU still uses it (Core Animation frees an image's Shmem once its no-copy buffer is released, before the runtime frees
+ * the import), and the object then lives on until the import completes instead of being torn down under a wired UPL (int-233..235: the render
+ * thread stuck in vm_deallocate). A range no memory entry can be made of is imported as before; [0] counts the persistent imports, [1] those. */
+extern "C" {volatile uint32_t native_adreno_import_persistent[2];}
+static IOMemoryDescriptor *importRange(uint64_t address,size_t bytes,IODirection direction,void *task)
+{
+    const IOOptionBits options=static_cast<IOOptionBits>(direction)|static_cast<IOOptionBits>(kIOMemoryMapperNone);
+    IOMemoryDescriptor *range=IOMemoryDescriptor::withAddressRange(address,bytes,options|kIOMemoryPersistent,static_cast<task_t>(task));
+    if(range) {native_adreno_import_persistent[0]=native_adreno_import_persistent[0]+1;return range;}
+    range=IOMemoryDescriptor::withAddressRange(address,bytes,options,static_cast<task_t>(task));
+    if(range)native_adreno_import_persistent[1]=native_adreno_import_persistent[1]+1;
+    return range;
+}
+IOReturn NativeAdrenoMemory::importTask(void *task,uint64_t address,size_t bytes,unsigned bits,size_t budget)
+{
+    native_adreno_import_stage=10;
+    if(descriptor_ || imported_ || spans_ || quarantined_)return kIOReturnBusy;
+    native_adreno_import_stage=11;
+    if(!task || !address || (address&4095) || !bytes || (bytes&4095) || address>UINT64_MAX-bytes || !outputWidth(bits) ||
+        !budget || budget>256u*1024u*1024u)return kIOReturnBadArgument;
+    native_adreno_import_stage=12;
+    if(bytes>budget)return kIOReturnNoResources;
+    NativeAdrenoCpuState cpu{};
+    native_adreno_import_stage=13;
+    IOReturn status=NativeAdrenoQueryCpu4K(&cpu);if(status!=kIOReturnSuccess)return status;
+    const uint64_t limit=UINT64_C(1)<<bits;
+    imported_=importRange(address,bytes,kIODirectionInOut,task);
+    native_adreno_import_stage=14;
+    if(!imported_)return kIOReturnNoMemory;
+    native_adreno_import_stage=15;
+    status=imported_->prepare();
+    if(status==kNativeAdrenoProtectionFailure) {
+        /* Read-only memory of the owner (a mapped file, constant data): cannot be pinned for writing. Pin it for reading only; the GPU then maps it
+         * read-only. Metal's no-copy buffers over such memory are only ever read by shaders. */
+        imported_->release();imported_=nullptr;
+        imported_=importRange(address,bytes,kIODirectionOut,task);
+        if(!imported_)return kIOReturnNoMemory;
+        status=imported_->prepare();
+        if(status==kIOReturnSuccess)read_only_=true;
+    }
+    if(status!=kIOReturnSuccess) {imported_->release();imported_=nullptr;return status;}
+    prepared_=true;bytes_=bytes;
+    status=kIOReturnUnsupported;
+    native_adreno_import_stage=16;
+    if(imported_->getLength()!=bytes)goto failed;
+    native_adreno_import_stage=17;
+    span_capacity_=bytes/4096;
+    spans_=IONewData(NativeAdrenoPhysicalSpan,span_capacity_);
+    if(!spans_) {status=kIOReturnNoMemory;goto failed;}
+    for(size_t offset=0;offset<bytes;offset+=4096) {
+        IOByteCount length=0;
+        addr64_t physical=imported_->getPhysicalSegment(offset,&length,kIOMemoryMapperNone);
+        if(!physical || (physical&4095) || length<4096 || physical>=limit || 4096>limit-physical)
+            {native_adreno_import_stage=18;native_adreno_import_fail_pa=physical;native_adreno_import_fail_offset=offset;
+             status=kIOReturnUnsupported;goto failed;}
+        if(span_count_ && physical==spans_[span_count_-1].physical+spans_[span_count_-1].bytes)
+            spans_[span_count_-1].bytes+=4096;
+        else spans_[span_count_++]={offset,physical,4096};
+    }
+    native_adreno_import_stage=19;
+    native_adreno_pool_stats[7]=native_adreno_pool_stats[7]+(uint32_t)span_count_;
+    return kIOReturnSuccess;
+failed:
+    (void)release();return status;
+}
+IOReturn NativeAdrenoMemory::makeWriteCombined()
+{
+    if(!(descriptor_ || pooled_) || imported_ || !prepared_ || quarantined_ || device_references_ || write_combined_ || !mapping_ || !span_count_)
+        return kIOReturnNotReady;
+    if(pooled_ && pool.write_combined) {write_combined_=true;return kIOReturnSuccess;}
+    IOReturn status=NativeAdrenoMaintainOwnedPages(mapping_,bytes_,NativeAdrenoCleanInvalidate);
+    if(status)return status;
+    status=NativeAdrenoSetPagesCacheMode(spans_,span_count_,true);
+    if(status)return status;
+    write_combined_=true;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::release()
+{
+    native_adreno_trace_stage=30;
+    if(device_references_ || quarantined_)return kIOReturnBusy;
+    if(write_combined_ && pooled_ && pool.write_combined)write_combined_=false;   /* the pool's pages keep the attribute */
+    if(write_combined_) {
+        /* The pages go back to the VM cacheable, as they came. */
+        const IOReturn status=NativeAdrenoSetPagesCacheMode(spans_,span_count_,false);
+        if(status) {quarantined_=true;return status;}
+        write_combined_=false;
+    }
+    if(imported_) {
+        if(prepared_) {
+            IOReturn status=imported_->complete();
+            if(status!=kIOReturnSuccess) {quarantined_=true;return status;}
+            prepared_=false;
+        }
+        imported_->release();imported_=nullptr;
+    }
+    if(descriptor_) {
+        if(prepared_) {
+            native_adreno_trace_stage=31;
+            IOReturn status=descriptor_->complete();
+            native_adreno_trace_stage=32;
+            if(status!=kIOReturnSuccess) {quarantined_=true;return status;}
+            prepared_=false;
+        }
+        native_adreno_trace_stage=33;
+        descriptor_->release();descriptor_=nullptr;
+        native_adreno_trace_stage=34;
+    }
+    if(pooled_) {poolGive(pool_offset_,bytes_);pooled_=false;prepared_=false;pool_offset_=0;}
+    if(spans_)IODeleteData(spans_,NativeAdrenoPhysicalSpan,span_capacity_);
+    mapping_=nullptr;spans_=nullptr;bytes_=span_count_=span_capacity_=0;read_only_=false;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::holdForDevice()
+{
+    if(!backed() || !prepared_ || !span_count_ || quarantined_)return kIOReturnNotReady;
+    if(device_references_==UINT32_MAX)return kIOReturnNoResources;
+    ++device_references_;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::retireAfterQuiescence()
+{
+    if(!device_references_)return kIOReturnBadArgument;
+    if(quarantined_)return kIOReturnNotReady;
+    --device_references_;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::publishForDevice(size_t offset,size_t bytes,bool writes,bool include_write_combined)
+{
+    if(!backed() || !prepared_ || quarantined_)return kIOReturnNotReady;
+    if(!bytes || ((offset|bytes)&4095) || offset>bytes_ || bytes>bytes_-offset)return kIOReturnBadArgument;
+    if(imported_)return maintainImported(offset,bytes,writes?NativeAdrenoCleanInvalidate:NativeAdrenoClean);
+    if(write_combined_)   /* no CPU mapping should cache these pages; if one does, reach its lines through the physical pages */
+        return include_write_combined?maintainImported(offset,bytes,writes?NativeAdrenoCleanInvalidate:NativeAdrenoClean):kIOReturnSuccess;
+    return NativeAdrenoMaintainOwnedPages(static_cast<unsigned char *>(mapping_)+offset,bytes,
+        writes?NativeAdrenoCleanInvalidate:NativeAdrenoClean);
+}
+IOReturn NativeAdrenoMemory::acquireDeviceWrites(size_t offset,size_t bytes)
+{
+    if(!backed() || !prepared_ || quarantined_)return kIOReturnNotReady;
+    if(!bytes || ((offset|bytes)&4095) || offset>bytes_ || bytes>bytes_-offset)return kIOReturnBadArgument;
+    /* Imported pages may hold the owner's unrelated dirty lines next to the GPU's writes: clean as well as invalidate. */
+    if(imported_)return maintainImported(offset,bytes,NativeAdrenoCleanInvalidate);
+    if(write_combined_)return kIOReturnSuccess;
+    return NativeAdrenoMaintainOwnedPages(static_cast<unsigned char *>(mapping_)+offset,bytes,NativeAdrenoInvalidate);
+}
+/* Imported pages have no kernel mapping here (and write-combined ones only a non-cacheable one); maintain each span's part of
+ * [offset, offset+bytes) by physical address. */
+IOReturn NativeAdrenoMemory::maintainImported(size_t offset,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    for(size_t i=0;i<span_count_;++i) {
+        const NativeAdrenoPhysicalSpan &span=spans_[i];
+        const size_t begin=offset>span.offset?offset:span.offset;
+        const size_t end=offset+bytes<span.offset+span.bytes?offset+bytes:span.offset+span.bytes;
+        if(begin>=end)continue;
+        const IOReturn status=NativeAdrenoMaintainPhysicalPages(span.physical+(begin-span.offset),end-begin,op);
+        if(status)return status;
+    }
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoMemory.h b/iokit/Kernel/arm/a740/NativeAdrenoMemory.h
new file mode 100644
index 0000000..f91b19e
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoMemory.h
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_MEMORY_H
+#define NATIVE_ADRENO_MEMORY_H
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+class IOBufferMemoryDescriptor;
+class IOMemoryDescriptor;
+struct NativeAdrenoPhysicalSpan {uint64_t offset,physical,bytes;};
+struct NativeAdrenoCpuState {
+    uint64_t tcr,ttbr0,ttbr1,sctlr;
+    uint64_t kernel_page_bytes,kernel_map_page_bytes;
+};
+IOReturn NativeAdrenoQueryCpu4K(NativeAdrenoCpuState *);
+enum NativeAdrenoCacheOperation {NativeAdrenoClean,NativeAdrenoCleanInvalidate,NativeAdrenoInvalidate};
+IOReturn NativeAdrenoMaintainOwnedPages(void *,size_t,NativeAdrenoCacheOperation);
+/* The same over whole physical pages of DRAM, through the kernel's physical aperture: data cache lines are physically tagged, so this
+ * reaches lines another task's mapping left (an imported IOSurface). Apple's sys_dcache_flush is only a DSB, so user space cannot. */
+IOReturn NativeAdrenoMaintainPhysicalPages(uint64_t physical,size_t bytes,NativeAdrenoCacheOperation);
+/* Every CPU mapping of the spans' pages becomes write-combined (true) or takes the default cacheable attribute again (false). */
+IOReturn NativeAdrenoSetPagesCacheMode(const NativeAdrenoPhysicalSpan *,size_t count,bool write_combined);
+/* int-100 found a write-combined BO's page back at the default (cacheable) attribute with dirty IB lines: XNU's view machinery sets a page's
+ * attribute when it populates or tears down a device-pager view. Every page of the spans no longer write-combined is made so again (the pmap
+ * then rewrites every mapping it tracks and writes the page's cache lines back); *reset counts them. */
+IOReturn NativeAdrenoReassertWriteCombined(const NativeAdrenoPhysicalSpan *,size_t count,uint32_t *reset);
+
+/* Native XNU backing store, not a Metal device or user ABI. No IOMMU mapper,
+ * Linux fd/ioctl, hardware address, guessed PA or implicit destructor cleanup.
+ * Driver owns this object until release() succeeds; do not destroy/copy it
+ * with outstanding memory. Serialize every call under the queue/resource gate.
+ * Every published mapping/job must hold a device reference BEFORE publication,
+ * and retire it only after actual DMA quiescence and completed native TLB unmap.
+ * References are lifetime accounting, never fences or proof of quiescence. */
+class NativeAdrenoMemory final {
+    IOBufferMemoryDescriptor *descriptor_=nullptr;
+    IOMemoryDescriptor *imported_=nullptr;
+    bool read_only_=false;
+    void *mapping_=nullptr;
+    NativeAdrenoPhysicalSpan *spans_=nullptr;
+    size_t bytes_=0,span_count_=0,span_capacity_=0;
+    uint32_t device_references_=0;
+    bool prepared_=false,quarantined_=false,write_combined_=false,pooled_=false;
+    size_t pool_offset_=0;
+    IOReturn maintainImported(size_t offset,size_t bytes,NativeAdrenoCacheOperation);
+public:
+    NativeAdrenoMemory()=default;
+    ~NativeAdrenoMemory()=default;
+    NativeAdrenoMemory(const NativeAdrenoMemory &)=delete;
+    NativeAdrenoMemory &operator=(const NativeAdrenoMemory &)=delete;
+    /* Explicit driver budget; bounded to 256MiB per backing object for now.
+     * Error may retain quarantined allocation state if complete() fails.
+     * Caller always keeps this object and checks quarantined(), even on error.
+     * CPU native4K state and kernel page ABI are checked before allocation.
+     * prepare(), raw unmapped physical segments, span/PA bounds and optional
+     * physical contiguity are verified before zeroing/PoC publication. */
+    /* `pooled`: take the bytes from the BO pool when one is reserved and has room. Only user BOs do: the pool is write-combined for
+     * the CPU (writeCombinePool), and the kernel's own objects (SMMU tables, ring, fence and firmware pages) are walked or read by the
+     * CPU through their cacheable mapping (int-153: page tables from the write-combined pool made each map's table update 2.6x slower). */
+    IOReturn allocate(size_t bytes,unsigned output_bits,bool contiguous,size_t byte_budget,bool pooled=false);
+    /* One physically contiguous block taken from the VM early (while memory is not yet fragmented) and cut into BOs afterwards: a BO from it is
+     * one span of the GPU's table instead of one per scattered page (int-137: 59474 spans for 332 MiB, the 65536 span capacity ran out,
+     * BoMap failed, the translator answered out of device memory and the compositor fell back to the CPU; each map also walked every span, 167 ms).
+     * allocate(..., pooled=true) uses the pool when one is reserved and has room, else the scattered path. Only the board calls this. */
+    static IOReturn reservePool(unsigned output_bits,size_t bytes);
+    static size_t poolBytes();
+    /* The whole pool write-combined once, for good: a pooled BO then takes no page-attribute change on allocation or release.
+     * Board only, after reservePool, when user BOs are write-combined. */
+    static IOReturn writeCombinePool();
+    /* Pins bytes at address in task (a user task's own pages) instead of allocating; prepare() wires them until release().
+     * There is no kernel mapping: the owner keeps its CPU mapping and does its own cache maintenance around GPU use, so
+     * publishForDevice/acquireDeviceWrites have nothing to do for this object. Spans and PA bounds are checked as for allocate. */
+    IOReturn importTask(void *task,uint64_t address,size_t bytes,unsigned output_bits,size_t byte_budget);
+    bool imported() const {return imported_!=nullptr;}
+    /* An import of memory the owner maps read-only (the kernel could pin it for reading only): the GPU may read it, never write it. */
+    bool readOnly() const {return read_only_;}
+    /* After allocate(), before any device or client mapping: cleans and invalidates the pages and makes every CPU mapping of them
+     * write-combined, so publishForDevice/acquireDeviceWrites have nothing left to do. release() restores the default attribute. */
+    IOReturn makeWriteCombined();
+    bool writeCombined() const {return write_combined_;}
+    /* NativeAdrenoReassertWriteCombined over this object's pages; nothing for an object that is not write-combined, nor for one from the
+     * BO pool: XNU set scattered BOs' pages back to the default attribute (int-160: 123847 pages), never a pool page (int-161: none in
+     * 1280 submissions, while walking the pool's pages took 0.65 ms of each). The submissions' line audit still covers every object. */
+    IOReturn reassertWriteCombined(uint32_t *reset) const
+    {return write_combined_ && span_count_ && !pooled_?NativeAdrenoReassertWriteCombined(spans_,span_count_,reset):kIOReturnSuccess;}
+    bool backed() const {return descriptor_ || imported_ || pooled_;}
+    /* Refuses device references/quarantine; only clears ownership after real
+     * descriptor complete() succeeds. No automatic reset or resource recycling. */
+    IOReturn release();
+    IOReturn holdForDevice();
+    IOReturn retireAfterQuiescence();
+    void quarantine() {quarantined_=true;}
+    /* Requires real CPU/device exclusion and retained ownership. Before GPU
+     * writes, clean+invalidate; after genuine completion, invalidate only.
+     * CPU must not dirty these pages while the device owns access. */
+    /* A write-combined object is skipped unless include_write_combined: then its pages are maintained through the physical aperture,
+     * for a client whose view turned out to be cacheable after all (NativeAdrenoVm::distrustWriteCombined). */
+    IOReturn publishForDevice(size_t offset,size_t bytes,bool device_writes,bool include_write_combined=false);
+    IOReturn acquireDeviceWrites(size_t offset,size_t bytes);
+    bool quarantined() const {return quarantined_;}
+    uint32_t deviceReferences() const {return device_references_;}
+    size_t bytes() const {return bytes_;}
+    size_t spanCount() const {return span_count_;}
+    const NativeAdrenoPhysicalSpan *spans() const {return spans_;}
+    void *mapping() const {return mapping_;}
+    /* Borrowed descriptor, never release independently or expose table pools
+     * through clientMemoryForType. Sharing requires a separate owner/task ABI. */
+    IOBufferMemoryDescriptor *descriptor() const {return descriptor_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoPublish.cpp b/iokit/Kernel/arm/a740/NativeAdrenoPublish.cpp
new file mode 100644
index 0000000..6c695ca
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoPublish.cpp
@@ -0,0 +1,768 @@
+/* SPDX-License-Identifier: MIT */
+/* IOKit surface for an already-running GPU context. The board code (kits/ishtar) brings the GPU up, then hands this file
+ * the live VM, submit object, ring, clock and optional timer; one IOService is published and each IOServiceOpen creates a
+ * connection that mounts its own NativeAdrenoUserClient core. Up to NativeAdrenoMaxClients connections (one per Metal process) share
+ * the VM, the submit object and the ring: each core has its own handles, its own queue range on the ring and its own window of the
+ * one GPU address space (the render server the large one), and closing a connection waits for its own jobs only, then unmaps and
+ * frees everything it created. Not yet done: per-process GPU page tables (the windows are enforced by the driver, not by the SMMU)
+ * and a reset path. This is not the Metal or Turnip ABI; it carries NativeAdrenoABI.h unchanged.
+ * BO CPU mappings are handed out as uncached physical-range mappings to match the GPU's non-cacheable PTEs.
+ * The connection class is named AGXDeviceUserClient on purpose: the original sandbox profiles of the processes that use Metal
+ * allow IOServiceOpen for that user-client class name, and nothing else in this system can create one (the Apple AGX kext is
+ * never loaded without an Apple GPU), so the name only decides whether the Adreno Metal plugin may open its own driver. */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOUserClient.h>
+#include <string.h>
+#include <kern/thread.h>
+#include "NativeAdrenoUserClient.h"
+
+extern "C" void proc_selfname(char *, int);
+/* The plugin's telemetry table (rows of text the Metal bridge keeps), sent as markers: 0xC000|row starts a row, 0x8000|(a<<7)|b appends two characters. */
+extern "C" {char native_adreno_metal_rows[48][96];volatile uint32_t native_adreno_metal_rows_seq;}
+
+extern "C" {
+/* What the processes that reached this driver did, for the boot diagnostic page. Plain counters and short strings. */
+struct NativeAdrenoMetalDiag {
+    uint32_t opens, busy, bad, closes, reports, property_reads, foreign_opens, foreign_type, name_reads, calls, last_selector, last_status, ext_entries, ext_selector, ext_status, ext_in, ext_out, tunnel_calls, probes, sel_bits[8], mb_maps, mb_calls, marks_total, marks[16], chk_macf, chk_res, chk_type, type_pass_lo, type_pass_hi, attach_status, inflight, inflight_since_calls, forced_unmaps;
+    char opener[3][17];      /* process names of the latest connections, newest first */
+    char reader[3][17];      /* process names that read a registry property of the accelerator, newest first */
+    char name_reader[17];    /* latest process that read MetalPluginName specifically */
+    char starter[3][17];     /* processes that sent plugin marker 1 (the plugin's initWithAcceleratorPort: started), newest first */
+    char report[64];         /* the plugin's own result line (SetMetadata text), latest */
