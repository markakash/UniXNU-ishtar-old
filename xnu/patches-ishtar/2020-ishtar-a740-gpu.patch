+    const uint64_t ttbr = (uint64_t(base[(bank0 + 0x24) / 4]) << 32) | base[(bank0 + 0x20) / 4];
+    const unsigned bits = 64 - (base[(bank0 + 0x30) / 4] & 0x3f);
