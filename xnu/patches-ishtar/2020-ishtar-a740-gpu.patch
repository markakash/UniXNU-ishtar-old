+}
+IOReturn NativeAdrenoUserClient::status(NativeAdrenoAbiStatus *reply)
+{
+    if(!reply)return kIOReturnBadArgument;*reply={};
+    if(!open_)return kIOReturnNotReady;
+    if(!status_)return kIOReturnUnsupported;
