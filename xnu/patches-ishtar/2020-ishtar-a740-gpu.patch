+        const Mapping &m=mappings_[i];
+        if(!m.memory || !m.memory->mapping() || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        const size_t offset=(size_t)(iova-m.iova);
+        for(size_t k=0;k<count && offset+4*k+4<=m.memory->bytes();++k)out[k]=static_cast<const volatile uint32_t *>(m.memory->mapping())[offset/4+k];
+        return kIOReturnSuccess;
+    }
+    return kIOReturnBadArgument;
+}
+IOReturn NativeAdrenoVm::holdJob(uint64_t handle)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    Mapping *record=find(handle);if(!record)return kIOReturnBadArgument;
+    if(record->jobs==UINT32_MAX)return kIOReturnNoResources;
+    IOReturn status=record->memory->holdForDevice();if(status)return status;
+    ++record->jobs;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::retireJobAfterCompletion(uint64_t handle)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    Mapping *record=find(handle);if(!record || !record->jobs)return kIOReturnBadArgument;
+    IOReturn status=record->memory->retireAfterQuiescence();if(status)return status;
+    --record->jobs;return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoVm.h b/iokit/Kernel/arm/a740/NativeAdrenoVm.h
new file mode 100644
index 0000000..13689ce
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoVm.h
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_VM_H
+#define NATIVE_ADRENO_VM_H
+#include "NativeAdrenoSmmuMemory.h"
+#include "ArmSmmu4KStreams.h"
+struct NativeAdrenoVmRegion {
+    NativeAdrenoMemory *tables;
+    ArmSmmu4KLiveArena *arena;
+    ArmSmmu4KLiveState *state;
+};
+struct NativeAdrenoVmResult {
+    ArmSmmu4KStatus operation,quarantine;
+    size_t completed_spans;
+    bool complete;
+};
+/* Kernel-owned BO mapping transactions, not a userspace ABI or GPU scheduler.
+ * Attach only under the actual bank/ASID/stream and powered-MMIO lease, with
+ * fault IRQ handling installed and empty native4K arenas already active.
+ * The real table allocations, context/streams and BO objects remain retained
+ * by the owning driver. No implicit destructor cleanup; detach must succeed.
+ * Serialize all methods, table updates and submission under the DRIVER gate.
+ * ALL masters must stay genuinely quiesced through each map/unmap transaction.
+ * Job counts are lifetime accounting; neither they nor these APIs are fences.
+ * Each active region is audited, including the unmodified peer. Partial failure
+ * keeps every old/new BO reference, poisons both arenas and attempts to FAULT
+ * only the owned streams. Uncertain resources require independent real reset.
+ * No VM may be advertised to apps until per-client isolation, submission
+ * validation/protection, genuine IRQ fences and reset are implemented. */
+/* One table for every client's mappings: 1024 filled up once the render server primed its shaders (int-237: BoMap refused with
+ * kIOReturnNoResources at objects=1024, Turnip wrote through a NULL command stream and backboardd crashed). */
+enum : size_t {NativeAdrenoVmMaxObjects=4096};
+/* Board hook for sampleWord(): reads one aligned word of physical memory through a fresh uncached mapping; 0 on success. */
+extern "C" int (*native_adreno_dram_read32)(uint64_t physical,uint32_t *value);
+/* The board's reader through the kernel's cacheable physical aperture (null on the host: the BO's own mapping is read). */
+extern "C" int (*native_adreno_cached_read32)(uint64_t physical,uint32_t *value);
+/* Board hook for auditRange(): [physical, physical+bytes), whole 64-byte lines inside one page, as the cacheable physical aperture and
+ * DRAM (a fresh uncached mapping) read it. A line that differs is cleaned and invalidated and DRAM read again: when DRAM then holds the
+ * cached copy the line was dirty (*dirty), when DRAM is unchanged it was a stale clean copy (*stale). 0 on success. */
+extern "C" int (*native_adreno_line_audit)(uint64_t physical,size_t bytes,uint32_t *dirty,uint32_t *stale);
+class NativeAdrenoVm final {
+    struct Mapping {
+        NativeAdrenoMemory *memory=nullptr;
+        uint64_t handle=0,iova=0;
+        size_t spans=0,mapped_spans=0;
+        unsigned permissions=0,writeback=0,shareability=0,jobs=0;
+    };
+    Mapping *mappings_=nullptr;
+    NativeAdrenoVmRegion regions_[2]{};
+    ArmSmmu4KLiveVisibility visibility_[2]{};
+    ArmSmmu4KIo io_{};
+    ArmSmmu4KContextConfig *context_=nullptr;
+    ArmSmmu4KStreamState *streams_=nullptr;
+    ArmSmmu4KRange *ranges_=nullptr;
+    size_t capacity_=0,lower_count_=0,upper_count_=0,objects_=0;
+    unsigned budget_=0;
+    uint64_t next_handle_=1;
+    bool attached_=false,poisoned_=false,distrust_write_combined_=false;
+    NativeAdrenoVmResult result_{};
+    ArmSmmu4KLiveRegion region(unsigned) const;
+    ArmSmmu4KStatus observe() const;
+    /* The route check alone: the table walk is the update's own (it verifies every region before the first store and after the last), so
+     * map/unmap pay a full extra audit only every 64th operation (int-139: 4 full walks of the 2 GiB aperture made every map 70 ms). */
+    ArmSmmu4KStatus observeStreamsOnly() const;
+    ArmSmmu4KStatus observeCheap();
+    unsigned since_audit_=0;
+    IOReturn fail(ArmSmmu4KStatus);
+    Mapping *find(uint64_t);
+    void insert(size_t,unsigned);
+    void erase(size_t,size_t,unsigned);
+    IOReturn preflight(const NativeAdrenoMemory *,unsigned,uint64_t,unsigned,unsigned,unsigned) const;
+public:
+    NativeAdrenoVm()=default;
+    ~NativeAdrenoVm()=default;
+    NativeAdrenoVm(const NativeAdrenoVm &)=delete;
+    NativeAdrenoVm &operator=(const NativeAdrenoVm &)=delete;
+    IOReturn attach(const ArmSmmu4KIo *,ArmSmmu4KContextConfig *,ArmSmmu4KStreamState *,
+        const NativeAdrenoVmRegion *lower,const NativeAdrenoVmRegion *upper,
+        size_t max_spans,unsigned poll_budget);
+    /* Frees CPU metadata only, with no BOs remaining. Never releases roots,
+     * disables a bank or returns the platform lease; board lifecycle owns it. */
+    IOReturn detach();
+    IOReturn findAddress(unsigned upper,size_t bytes,uint64_t alignment,uint64_t *iova) const;
+    IOReturn map(NativeAdrenoMemory *,unsigned upper,uint64_t iova,
+        unsigned permissions,unsigned writeback,unsigned shareability,uint64_t *handle);
+    IOReturn unmap(uint64_t handle);
+    IOReturn holdJob(uint64_t handle);
+    /* TLBIALL for the context bank plus TLBSYNC: drops every cached translation of the bank whatever its ASID. Unmap already
+     * synchronizes by ASID; this is the stronger form the submit path uses before each submission (int-070: on ishtar the CP read
+     * zeros from an IB whose table entry and DRAM were both correct, after the address had been mapped to other pages before). */
+    IOReturn invalidateTlb();
+    /* Cleans and invalidates the CPU caches over every mapped BO (whole objects; imported ones through their physical pages), so
+     * no CPU cache line can hold data the GPU should see or hide what it wrote. Lines are physically tagged, so this also reaches
+     * lines a user mapping of the same pages left behind. int-070 runs it before every submission. */
+    IOReturn publishMapped();
+    /* The submit path saw a CPU-cached word that DRAM did not hold yet in a client's BO: from now on write-combined BOs are maintained
+     * like any other (sticky; the safe behaviour of int-070..097). */
+    void distrustWriteCombined() {distrust_write_combined_=true;}
+    bool writeCombinedTrusted() const {return !distrust_write_combined_;}
+    /* After a submission completed: cleans and invalidates the CPU caches over every GPU-writable imported BO, so the owner's mapping
+     * (an IOSurface) reads what the GPU wrote, not a line prefetched while the GPU ran. Jobs name only their IBs, so every such BO
+     * is covered. int-071: an imported render target read back 672 of 4096 texels stale. */
+    IOReturn acquireImported();
+    /* Diagnostic, never a proof of coherence: the 32-bit word at a mapped GPU address as the kernel's cacheable alias reads it
+     * and, when the board installed native_adreno_dram_read32, as DRAM reads it through an uncached mapping (else ~0). */
+    IOReturn sampleWord(uint64_t iova,uint32_t *cached,uint32_t *dram) const;
+    /* Every line of [iova, iova+bytes) that lies in a write-combined BO, through native_adreno_line_audit: *dirty counts lines a CPU
+     * cache held newer than DRAM (a client view that caches after all; each such line is written back by the audit), *stale clean
+     * copies, *lines the lines compared. kIOReturnUnsupported without a board hook. int-099 sampled one word and wrote its line back
+     * before reading DRAM, so it could never see a dirty line. */
+    /* Before a submission while write-combined BOs are trusted: every page of every mapped write-combined BO that XNU set back to the
+     * default attribute is write-combined again (and its lines written back); *reset counts the pages. */
+    IOReturn reassertWriteCombined(uint32_t *reset) const;
+    IOReturn auditRange(uint64_t iova,size_t bytes,uint32_t *lines,uint32_t *dirty,uint32_t *stale) const;
+    /* Read-only description of a live mapping; never pins or extends it. */
+    IOReturn describe(uint64_t handle,uint64_t *iova,size_t *bytes,unsigned *permissions) const;
+    /* Up to `count` dwords of a mapped kernel-owned BO at a GPU address (through the kernel's own mapping), for the board log. */
+    IOReturn peekWords(uint64_t iova,uint32_t *out,size_t count) const;
+    /* Only a scheduler's actual successful GPU completion may call this.
+     * A timeout, interrupt bit alone or CPU-written timestamp is insufficient. */
+    IOReturn retireJobAfterCompletion(uint64_t handle);
+    bool poisoned() const {return poisoned_;}
+    size_t objectCount() const {return objects_;}
+    size_t spanCount() const {return lower_count_+upper_count_;}
+    NativeAdrenoVmResult lastResult() const {return result_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoVmAlias.h b/iokit/Kernel/arm/a740/NativeAdrenoVmAlias.h
new file mode 100644
index 0000000..bdd6b9e
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoVmAlias.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_VM_ALIAS_H
+#define NATIVE_ADRENO_VM_ALIAS_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* Temporary CPU validation index, never a GPU mapping or translation table.
+ * Range has physical/bytes fields. The caller has validated nonempty ranges
+ * with nonoverflowing ends and supplies count valid indices in owned scratch.
+ * Original ranges are immutable. One serialized owner uses scratch at a time. */
+template<class Range> class NativeAdrenoPhysicalIndex final {
+    const Range *ranges_;
+    uint32_t *order_;
+    size_t count_;
+    uint64_t end(uint32_t i) const {return ranges_[i].physical+ranges_[i].bytes;}
+    bool less(uint32_t a,uint32_t b) const {
+        return ranges_[a].physical<ranges_[b].physical ||
+            (ranges_[a].physical==ranges_[b].physical && ranges_[a].bytes<ranges_[b].bytes);
+    }
+    void sift(size_t root,size_t count) {
+        while(root<count/2) {
+            size_t child=root*2+1;
+            if(child+1<count && less(order_[child],order_[child+1]))++child;
+            if(!less(order_[root],order_[child]))break;
+            uint32_t t=order_[root];order_[root]=order_[child];order_[child]=t;root=child;
+        }
+    }
+public:
+    NativeAdrenoPhysicalIndex(const Range *ranges,uint32_t *order,size_t count):ranges_(ranges),order_(order),count_(count) {
+        for(size_t i=count/2;i-->0;)sift(i,count);
+        for(size_t n=count;n>1;) {--n;uint32_t t=order_[0];order_[0]=order_[n];order_[n]=t;sift(0,n);}
+        /* Discard an interval contained by an earlier interval. The remaining
+         * starts AND ends are monotonic, even for nested/duplicate/overlapping
+         * inputs. Each query then needs a binary search, with no backward scan. */
+        size_t kept=0;
+        for(size_t i=0;i<count;++i) {
+            uint32_t index=order_[i];
+            if(!kept || end(index)>end(order_[kept-1]))order_[kept++]=index;
+        }
+        count_=kept;
+    }
+    bool overlaps(uint64_t physical,uint64_t bytes) const {
+        size_t lo=0,hi=count_;
+        while(lo<hi) {size_t mid=lo+(hi-lo)/2;if(end(order_[mid])<=physical)lo=mid+1;else hi=mid;}
+        return lo<count_ && ranges_[order_[lo]].physical<physical+bytes;
+    }
+};
+#endif
diff --git a/iokit/Kernel/arm/a740/Sm8550Gmu.c b/iokit/Kernel/arm/a740/Sm8550Gmu.c
new file mode 100644
index 0000000..94660e1
--- /dev/null
+++ b/iokit/Kernel/arm/a740/Sm8550Gmu.c
@@ -0,0 +1,282 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "Sm8550Gmu.h"
+#include "AdrenoFirmware.h"
+/* Generated only from exact pinned XML/catalog/DT/firmware policy; ignored.
+ * In particular, no vendor firmware or sequencer payload is stored in Git. */
+#include "Sm8550GmuSource.h"
+#if !defined(__aarch64__) || __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error ishtar GMU requires little-endian AArch64
+#endif
+static int extent(uintptr_t at,size_t bytes)
+{return at && bytes && bytes-1<=UINTPTR_MAX-at;}
+static int overlap(uintptr_t a,size_t na,uintptr_t b,size_t nb)
+{return a<=b?(b-a<na):(a-b<nb);}
+static size_t core_offset(uint32_t word)
+{return ((size_t)word<<2)-ISHTAR_GMU_CORE_GPU_DELTA;}
+static int read32(Sm8550GmuDevice *d,unsigned window,size_t at,uint32_t *v,Sm8550GmuResult *r)
+{++r->read_attempts;return d->io.read32(d->io.cookie,window,at,v);}
+static int write32(Sm8550GmuDevice *d,unsigned window,size_t at,uint32_t v,Sm8550GmuResult *r)
+{++r->write_attempts;return d->io.write32(d->io.cookie,window,at,v);}
+static int core_read(Sm8550GmuDevice *d,uint32_t word,uint32_t *v,Sm8550GmuResult *r)
+{return read32(d,Sm8550GmuCore,core_offset(word),v,r);}
+static int core_write(Sm8550GmuDevice *d,uint32_t word,uint32_t v,Sm8550GmuResult *r)
+{return write32(d,Sm8550GmuCore,core_offset(word),v,r);}
+static Sm8550GmuStatus check_faults(Sm8550GmuDevice *d,Sm8550GmuResult *r)
+{
+    if(core_read(d,REG_GMU_AO_HOST_INTERRUPT_STATUS,&r->ao_fault_status,r) ||
+        core_read(d,REG_GMU_GMU2HOST_INTR_INFO,&r->cm3_fault_status,r))return Sm8550GmuIoError;
+    return (r->ao_fault_status&ISHTAR_GMU_AO_FATAL_MASK) ||
+        (r->cm3_fault_status&ISHTAR_GMU_CM3_FATAL_MASK)?Sm8550GmuFault:Sm8550GmuSuccess;
+}
+static int notify(void *cookie)
+{
+    Sm8550GmuDevice *d=cookie;
+    return d->io.barrier(d->io.cookie) ||
+        d->io.write32(d->io.cookie,Sm8550GmuCore,core_offset(REG_GMU_HOST2GMU_INTR_SET),1) ||
+        d->io.barrier(d->io.cookie);
+}
+static Sm8550GmuStatus poll(Sm8550GmuDevice *d,uint32_t reg,uint32_t mask,
+    uint32_t expected,unsigned budget,uint32_t *observed,Sm8550GmuResult *r)
+{
+    uint64_t start,last,now;
+    if(d->services.now_us(d->services.cookie,&start))return Sm8550GmuClockError;
+    last=start;
+    for(unsigned i=0;i<budget;++i) {
+        if(d->services.now_us(d->services.cookie,&now) || now<last)return Sm8550GmuClockError;
+        if(now-start>=10000)return Sm8550GmuTimeout;
+        last=now;++r->poll_reads;
+        Sm8550GmuStatus fault=check_faults(d,r);if(fault!=Sm8550GmuSuccess)return fault;
+        if(core_read(d,reg,observed,r))return Sm8550GmuIoError;
+        if((*observed&mask)==expected) {
+            if(d->io.barrier(d->io.cookie))return Sm8550GmuIoError;
+            return Sm8550GmuSuccess;
+        }
+        if(i+1<budget && d->services.wait_us(d->services.cookie,100))return Sm8550GmuClockError;
+    }
+    return Sm8550GmuTimeout;
+}
+static void reset_after_failure(Sm8550GmuDevice *d,Sm8550GmuResult *r)
+{
+    uint32_t actual;r->reset_verified=0;d->poisoned=1;d->hfi.poisoned=1;
+    if(!core_write(d,REG_GMU_CM3_SYSRESET,1,r) && !d->io.barrier(d->io.cookie) &&
+        !core_read(d,REG_GMU_CM3_SYSRESET,&actual,r) && actual==1)r->reset_verified=1;
+}
+static uint32_t le32(const uint8_t *p)
+{return (uint32_t)p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24;}
+static Sm8550GmuStatus validate(Sm8550GmuDevice *d,const Sm8550GmuConfig *c,Sm8550GmuResult *r)
+{
+    if(!d || !c || !d->io.read32 || !d->io.write32 || !d->io.barrier ||
+        !d->services.sha256 || !d->services.now_us || !d->services.wait_us ||
+        c->chip_id!=ISHTAR_GMU_CHIP_ID || !c->firmware || c->firmware_bytes!=ISHTAR_GMU_FIRMWARE_BYTES ||
+        !extent((uintptr_t)c->firmware,c->firmware_bytes) || !c->poll_budget || c->poll_budget>1024)
+        return Sm8550GmuArgument;
+    if(d->poisoned)return Sm8550GmuPoisoned;
+    if(d->boot_attempted)return Sm8550GmuBusy;
+    for(unsigned i=0;i<Sm8550GmuWindows;++i)if(d->io.bytes[i]!=ishtar_gmu_window_bytes[i])return Sm8550GmuArgument;
+    const Sm8550GmuMemory *mem[]={&c->icache,&c->dummy,&c->debug,&c->log,&c->hfi};
+    const size_t sizes[]={0xffc000,0x4000,0x7000,0x4000,0x4000};
+    for(unsigned i=0;i<5;++i) {
+        const Sm8550GmuMemory *m=mem[i];
+        if(m->bytes!=sizes[i] || !extent((uintptr_t)m->cpu,m->bytes) || ((uintptr_t)m->cpu&4095) ||
+            !m->iova || (m->iova&4095) || m->iova>UINT32_MAX-(m->bytes-1) ||
+            overlap((uintptr_t)m->cpu,m->bytes,(uintptr_t)c->firmware,c->firmware_bytes))return Sm8550GmuArgument;
+        for(unsigned j=0;j<i;++j)if(overlap((uintptr_t)m->cpu,m->bytes,(uintptr_t)mem[j]->cpu,mem[j]->bytes) ||
+            overlap((uintptr_t)m->iova,m->bytes,(uintptr_t)mem[j]->iova,mem[j]->bytes))return Sm8550GmuArgument;
+    }
+    if(c->icache.iova!=0x4000 || c->dummy.iova!=0x60000000 || c->debug.iova!=0x60400000)return Sm8550GmuArgument;
+    if(d->services.sha256(d->services.cookie,c->firmware,c->firmware_bytes,r->complete_sha256))return Sm8550GmuFirmware;
+    for(unsigned i=0;i<32;++i)if(r->complete_sha256[i]!=ishtar_gmu_firmware_sha256[i])return Sm8550GmuFirmware;
+    r->complete_hash_verified=1;return Sm8550GmuSuccess;
+}
+Sm8550GmuStatus Sm8550GmuLoadAndStartHfi(Sm8550GmuDevice *d,const Sm8550GmuConfig *c,Sm8550GmuResult *r)
+{
+    if(!r)return Sm8550GmuArgument;
+    *r=(Sm8550GmuResult){0};r->resources_must_retain=1;
+    Sm8550GmuStatus status=validate(d,c,r);if(status!=Sm8550GmuSuccess)return status;
+    const AdrenoFirmwareRegion regions[]={{0,0x4000,1},{0x4000,0xffc000,2},{0x10004000,0x4000,3}};
+    AdrenoFirmwareBlock blocks[32];size_t count=0;
+    if(AdrenoFirmwarePlanGmu(c->firmware,c->firmware_bytes,regions,3,blocks,32,&count)!=AdrenoFirmwareSuccess || count!=15)
+        return Sm8550GmuFirmware;
+    r->phase=1;uint32_t value;
+    if(core_read(d,REG_GMU_CM3_SYSRESET,&value,r))return Sm8550GmuIoError;
+    if(value!=1)return Sm8550GmuBusy;
+    r->reset_verified=1;
+    if(read32(d,Sm8550GmuCxMisc,REG_CX_MISC_TCM_RET_CNTL*4,&value,r))return Sm8550GmuIoError;
+    if(value)return Sm8550GmuStateMismatch;
+    if(read32(d,Sm8550GmuRscc,REG_RSCC_SEQ_BUSY_DRV0*4,&value,r))return Sm8550GmuIoError;
+    if(value)return Sm8550GmuBusy;
+    if(core_read(d,REG_GMU_HFI_CTRL_STATUS,&value,r))return Sm8550GmuIoError;
+    if(value&1)return Sm8550GmuStateMismatch; /* A stale ready bit cannot pass. */
+    status=check_faults(d,r);if(status!=Sm8550GmuSuccess)return status;
+    r->phase=2;
+    d->boot_attempted=1;
+    for(unsigned i=0;i<ISHTAR_GMU_RSC_SETUP_COUNT;++i) {
+        const Sm8550GmuSetupWrite *w=ishtar_gmu_rsc_setup+i;
+        if(write32(d,w->window,w->byte_offset,w->value,r)) {status=Sm8550GmuIoError;goto failed;}
+    }
+    if(d->io.barrier(d->io.cookie)) {status=Sm8550GmuIoError;goto failed;}
+    if(core_write(d,REG_GPU_GMU_CX_GMU_CX_FALNEXT_INTF,1,r) ||
+        core_write(d,REG_GPU_GMU_CX_GMU_CX_FAL_INTF,1,r) ||
+        write32(d,Sm8550GmuCxMisc,REG_CX_MISC_TCM_RET_CNTL*4,1,r)) {status=Sm8550GmuIoError;goto failed;}
+    if(d->io.barrier(d->io.cookie) || read32(d,Sm8550GmuCxMisc,REG_CX_MISC_TCM_RET_CNTL*4,&value,r)) {status=Sm8550GmuIoError;goto failed;}
+    if(value!=1) {status=Sm8550GmuStateMismatch;goto failed;}
+    /* All shared allocations are real owned coherent memory, not simulated
+     * GMU addresses. Zero only after actual stopped/idle checks above. */
+    const Sm8550GmuMemory *memory[]={&c->icache,&c->dummy,&c->debug,&c->log};
+    r->memory_changed=1;
+    for(unsigned m=0;m<4;++m)for(size_t i=0;i<memory[m]->bytes/4;++i)memory[m]->cpu[i]=0;
+    if(AdrenoHfiInitializeStopped(&d->hfi,c->hfi.cpu,c->hfi.bytes,c->hfi.iova,d,notify)!=AdrenoHfiSuccess) {
+        status=Sm8550GmuArgument;goto failed;
+    }
+    r->phase=3;
+    for(size_t i=0;i<count;++i) {
+        const AdrenoFirmwareBlock *b=blocks+i;
+        /* Zero-size records authorize no allocation or write. The pinned
+         * loader skips them; all real extents were independently supplied. */
+        if(!b->bytes)continue;
+        for(size_t at=0;at<b->bytes;at+=4) {
+            uint32_t word=le32(c->firmware+b->payload_offset+at);
+            if(b->region_identifier==2)c->icache.cpu[(b->address-0x4000+at)/4]=word;
+            else {
+                uint32_t reg=b->region_identifier==1?REG_GMU_CM3_ITCM_START+b->address/4:
+                    REG_GMU_CM3_DTCM_START+(b->address-0x10004000)/4;
+                if(core_write(d,reg+(uint32_t)(at/4),word,r)) {status=Sm8550GmuIoError;goto failed;}
+            }
+        }
+    }
+    if(d->io.barrier(d->io.cookie)) {status=Sm8550GmuIoError;goto failed;}
+    /* Read every TCM payload word before releasing reset. CPU cache readback
+     * checks copied bytes only; actual GMU coherency is still a prerequisite. */
+    for(size_t i=0;i<count;++i) {
+        const AdrenoFirmwareBlock *b=blocks+i;
+        for(size_t at=0;at<b->bytes;at+=4) {
+            if(b->region_identifier==2)value=c->icache.cpu[(b->address-0x4000+at)/4];
+            else {
+                uint32_t reg=b->region_identifier==1?REG_GMU_CM3_ITCM_START+b->address/4:
+                    REG_GMU_CM3_DTCM_START+(b->address-0x10004000)/4;
+                if(core_read(d,reg+(uint32_t)(at/4),&value,r)) {status=Sm8550GmuIoError;goto failed;}
+            }
+            if(value!=le32(c->firmware+b->payload_offset+at)) {status=Sm8550GmuStateMismatch;goto failed;}
+        }
+    }
+    r->phase=4;
+    if(core_write(d,REG_GMU_CM3_FW_INIT_RESULT,0,r) ||
+        core_write(d,REG_GMU_CM3_BOOT_CONFIG,2,r) ||
+        core_write(d,REG_GMU_HFI_QTBL_ADDR,(uint32_t)c->hfi.iova,r) ||
+        core_write(d,REG_GMU_HFI_QTBL_INFO,1,r) ||
+        core_write(d,REG_GMU_AHB_FENCE_RANGE_0,UINT32_C(0x80000000)|(0x32u<<18)|0x8a0,r) ||
+        core_write(d,REG_GMU_CM3_CFG,0x4052,r) ||
+        core_write(d,REG_GMU_GENERAL_10,ISHTAR_GMU_FW_CHIP_ID,r) ||
+        core_write(d,REG_GMU_GENERAL_8,(uint32_t)c->log.iova|3,r)) {status=Sm8550GmuIoError;goto failed;}
+    for(unsigned i=0;i<4;++i)if(write32(d,Sm8550GmuGpu,(REG_GBIF_QSB_SIDE0+i)*4,0x71620,r)) {status=Sm8550GmuIoError;goto failed;}
+    if(core_write(d,REG_GMU_SYS_BUS_CONFIG,1,r) || core_write(d,REG_GMU_ICACHE_CONFIG,1,r) ||
+        core_write(d,REG_GMU_DCACHE_CONFIG,1,r) || core_read(d,REG_GMU_CM3_DTCM_START+0xff8,&value,r)) {status=Sm8550GmuIoError;goto failed;}
+    uint32_t mask=value<=UINT32_C(0x20010004)?UINT32_MAX:0x1ff;
+    uint32_t ready=mask==UINT32_MAX?UINT32_C(0xbabeface):0x100;
+    if(core_write(d,REG_GMU_CM3_SYSRESET,1,r) || core_write(d,REG_GMU_GENERAL_9,0,r) ||
+        d->io.barrier(d->io.cookie)) {status=Sm8550GmuIoError;goto failed;}
+    const uint32_t config_regs[]={REG_GMU_CM3_FW_INIT_RESULT,REG_GMU_CM3_BOOT_CONFIG,
+        REG_GMU_HFI_QTBL_ADDR,REG_GMU_HFI_QTBL_INFO,REG_GMU_CM3_CFG,REG_GMU_GENERAL_10,
+        REG_GMU_GENERAL_8,REG_GMU_AHB_FENCE_RANGE_0,REG_GMU_SYS_BUS_CONFIG,
+        REG_GMU_ICACHE_CONFIG,REG_GMU_DCACHE_CONFIG};
+    const uint32_t config_values[]={0,2,(uint32_t)c->hfi.iova,1,0x4052,ISHTAR_GMU_FW_CHIP_ID,
+        (uint32_t)c->log.iova|3,UINT32_C(0x80000000)|(0x32u<<18)|0x8a0,1,1,1};
+    for(unsigned i=0;i<sizeof(config_regs)/sizeof(config_regs[0]);++i) {
+        if(core_read(d,config_regs[i],&value,r)) {status=Sm8550GmuIoError;goto failed;}
+        if(value!=config_values[i]) {status=Sm8550GmuStateMismatch;goto failed;}
+    }
+    r->reset_verified=0;
+    if(core_write(d,REG_GMU_CM3_SYSRESET,0,r) || d->io.barrier(d->io.cookie)) {status=Sm8550GmuIoError;goto failed;}
+    r->phase=5;
+    status=poll(d,REG_GMU_CM3_FW_INIT_RESULT,mask,ready,c->poll_budget,&r->firmware_init_result,r);
+    if(status!=Sm8550GmuSuccess)goto failed;
+    r->firmware_ready_observed=1;
+    if(core_write(d,REG_GMU_HFI_CTRL_INIT,1,r) || d->io.barrier(d->io.cookie)) {status=Sm8550GmuIoError;goto failed;}
+    r->phase=6;
+    status=poll(d,REG_GMU_HFI_CTRL_STATUS,1,1,c->poll_budget,&r->hfi_status,r);
+    if(status!=Sm8550GmuSuccess)goto failed;
+    status=check_faults(d,r);if(status!=Sm8550GmuSuccess)goto failed;
+    if(d->io.barrier(d->io.cookie)) {status=Sm8550GmuIoError;goto failed;}
+    r->hfi_ready_observed=1;r->phase=7;return Sm8550GmuSuccess;
+failed:
+    reset_after_failure(d,r);return status;
+}
+typedef struct {
+    Sm8550GmuDevice *device;
+    Sm8550GmuStartupResult *result;
+} StartupContext;
+static int startup_now(void *cookie,uint64_t *value)
+{
+    Sm8550GmuDevice *d=((StartupContext *)cookie)->device;
+    return d->services.now_us(d->services.cookie,value);
+}
+static int startup_wait(void *cookie,unsigned us)
+{
+    Sm8550GmuDevice *d=((StartupContext *)cookie)->device;
+    return d->services.wait_us(d->services.cookie,us);
+}
+static int startup_health(void *cookie)
+{
+    StartupContext *c=cookie;Sm8550GmuDevice *d=c->device;
+    Sm8550GmuStartupResult *r=c->result;uint32_t reset,status;
+    r->health_status=check_faults(d,&r->load);
+    if(r->health_status!=Sm8550GmuSuccess)return 1;
+    if(core_read(d,REG_GMU_CM3_SYSRESET,&reset,&r->load) ||
+        core_read(d,REG_GMU_HFI_CTRL_STATUS,&status,&r->load))r->health_status=Sm8550GmuIoError;
+    else if(reset!=0 || !(status&1))r->health_status=Sm8550GmuStateMismatch;
+    return r->health_status!=Sm8550GmuSuccess;
+}
+Sm8550GmuStatus Sm8550GmuColdStart(Sm8550GmuDevice *d,const Sm8550GmuConfig *c,
+    const AdrenoHfiStartupConfig *config,const Sm8550GmuStartupLimits *limits,Sm8550GmuStartupResult *r)
+{
+    if(!r)return Sm8550GmuArgument;
+    *r=(Sm8550GmuStartupResult){0};r->load.resources_must_retain=r->protocol.resources_must_retain=1;
+    r->protocol_status=AdrenoHfiStartupInvalid; /* Not attempted until the load succeeds. */
+    if(!d || !c || !limits || AdrenoHfiStartupValidate(config)!=AdrenoHfiStartupSuccess)return Sm8550GmuArgument;
+    StartupContext context={d,r};
+    AdrenoHfiStartupServices services={&context,startup_now,startup_wait,startup_health,
+        limits->polls_per_command,limits->wait_interval_us,limits->command_timeout_us,limits->total_timeout_us};
+    if(AdrenoHfiStartupValidateServices(&services)!=AdrenoHfiStartupSuccess)return Sm8550GmuArgument;
+    if(d->poisoned || d->startup.poisoned)return Sm8550GmuPoisoned;
+    if(d->startup.attempted || d->startup.completed)return Sm8550GmuBusy;
+    Sm8550GmuStatus status=Sm8550GmuLoadAndStartHfi(d,c,&r->load);
+    if(status!=Sm8550GmuSuccess)return status;
+    r->protocol_status=AdrenoHfiStartupRun(&d->startup,&d->hfi,config,&services,&r->protocol);
+    if(r->protocol_status==AdrenoHfiStartupSuccess)return Sm8550GmuSuccess;
+    switch(r->protocol_status) {
+    case AdrenoHfiStartupClockError:case AdrenoHfiStartupWaitError:status=Sm8550GmuClockError;break;
+    case AdrenoHfiStartupTimeout:status=Sm8550GmuTimeout;break;
+    case AdrenoHfiStartupPlatformFault:status=r->health_status;break;
+    default:status=Sm8550GmuProtocolError;break;
+    }
+    reset_after_failure(d,&r->load);d->startup.poisoned=1;
+    return status;
+}
+static int fits(Sm8550GmuMmio *m,unsigned window,size_t at)
+{
+    if(!m || window>=Sm8550GmuWindows)return 0;
+    Sm8550GmuMmioWindow *w=m->windows+window;
+    return extent((uintptr_t)w->cpu,w->bytes) && !((uintptr_t)w->cpu&3) && !(at&3) &&
+        at<=w->bytes && w->bytes-at>=4;
+}
+static int mmio_read(void *cookie,unsigned window,size_t at,uint32_t *v)
+{Sm8550GmuMmio *m=cookie;if(!v || !fits(m,window,at))return 1;*v=*(volatile uint32_t *)(m->windows[window].cpu+at);return 0;}
+static int mmio_write(void *cookie,unsigned window,size_t at,uint32_t v)
+{Sm8550GmuMmio *m=cookie;if(!fits(m,window,at))return 1;*(volatile uint32_t *)(m->windows[window].cpu+at)=v;return 0;}
+static int mmio_barrier(void *cookie)
+{(void)cookie;__asm__ volatile("dsb sy":::"memory");return 0;}
+Sm8550GmuStatus Sm8550GmuBindMmio(Sm8550GmuMmio *m,Sm8550GmuIo *out)
+{
+    if(!out)return Sm8550GmuArgument;
+    *out=(Sm8550GmuIo){0};
+    if(!m)return Sm8550GmuArgument;
+    for(unsigned i=0;i<Sm8550GmuWindows;++i) {
+        const Sm8550GmuMmioWindow *w=m->windows+i;
+        if(!fits(m,i,0) || w->physical!=ishtar_gmu_window_physical[i] ||
+            w->bytes!=ishtar_gmu_window_bytes[i])return Sm8550GmuArgument;
+        for(unsigned j=0;j<i;++j)if(overlap((uintptr_t)w->cpu,w->bytes,(uintptr_t)m->windows[j].cpu,m->windows[j].bytes))return Sm8550GmuArgument;
+    }
+    out->cookie=m;out->read32=mmio_read;out->write32=mmio_write;out->barrier=mmio_barrier;
+    for(unsigned i=0;i<Sm8550GmuWindows;++i)out->bytes[i]=m->windows[i].bytes;
+    return Sm8550GmuSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/Sm8550Gmu.h b/iokit/Kernel/arm/a740/Sm8550Gmu.h
new file mode 100644
index 0000000..3ca5aaa
--- /dev/null
+++ b/iokit/Kernel/arm/a740/Sm8550Gmu.h
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef ISHTAR_GMU_H
+#define ISHTAR_GMU_H
+#include "AdrenoHfiStartup.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum {Sm8550GmuCore,Sm8550GmuRscc,Sm8550GmuPdc,Sm8550GmuGpu,Sm8550GmuCxMisc,Sm8550GmuWindows};
+typedef enum {
+    Sm8550GmuSuccess,Sm8550GmuArgument,Sm8550GmuFirmware,Sm8550GmuBusy,
+    Sm8550GmuIoError,Sm8550GmuStateMismatch,Sm8550GmuTimeout,Sm8550GmuClockError,
+    Sm8550GmuPoisoned,Sm8550GmuFault,Sm8550GmuProtocolError
+} Sm8550GmuStatus;
+typedef struct {
+    void *cookie;
+    size_t bytes[Sm8550GmuWindows];
+    int (*read32)(void *,unsigned window,size_t byte_offset,uint32_t *);
+    int (*write32)(void *,unsigned window,size_t byte_offset,uint32_t);
+    int (*barrier)(void *);
+} Sm8550GmuIo;
+typedef struct {
+    void *cookie;
+    int (*sha256)(void *,const void *,size_t,uint8_t digest[32]);
+    int (*now_us)(void *,uint64_t *);
+    int (*wait_us)(void *,unsigned);
+} Sm8550GmuServices;
+typedef struct {volatile uint32_t *cpu;size_t bytes;uint64_t iova;} Sm8550GmuMemory;
+typedef struct {
+    uint32_t chip_id;
+    const uint8_t *firmware;size_t firmware_bytes;
+    Sm8550GmuMemory icache,dummy,debug,log,hfi;
+    unsigned poll_budget;
+} Sm8550GmuConfig;
+typedef struct {
+    Sm8550GmuIo io;Sm8550GmuServices services;AdrenoHfi hfi;
+    uint32_t poisoned,boot_attempted;
+    AdrenoHfiStartup startup;
+} Sm8550GmuDevice;
+typedef struct {
+    uint32_t phase,write_attempts,read_attempts,poll_reads;
+    uint32_t complete_hash_verified,memory_changed,reset_verified;
+    uint32_t firmware_init_result,hfi_status,firmware_ready_observed,hfi_ready_observed;
+    uint32_t ao_fault_status,cm3_fault_status;
+    uint32_t resources_must_retain;
+    uint8_t complete_sha256[32];
+} Sm8550GmuResult;
+
+/* Board-specific COLD start through firmware/HFI controller readiness.
+ * This is NOT a power/clock, SMMU ownership or production boot entry point.
+ * Caller must establish exclusive device/stream ownership; hold CX/GX,
+ * core/hub clocks at the verified A740 boot rates, RPMh/interconnect votes,
+ * fault interrupts and secure/platform prerequisites; install actual native4K
+ * GMU SMMU mappings; prove coherent CPU/GMU visibility and pin all storage.
+ * The GMU must already be held in reset and RSC idle, with retention cleared.
+ * This function verifies those readable states before mutating anything.
+ * It does not read silicon identity; chip_id must be from trusted discovery.
+ * It validates the complete pinned firmware hash before register writes,
+ * installs RSC/PDC setup and all payloads, verifies TCM payload readback,
+ * initializes HFI memory, configures/releases CM3 and polls fresh FW/HFI
+ * status with elapsed-time AND iteration bounds. No substituted ACK exists.
+ * The required hash/time/wait services must perform real operations.
+ * Memory extents are byte sizes, mapped with native4K pages, never 16K pages.
+ * Config/input/device/result/IO/services and all storage must be disjoint,
+ * immutable where applicable and retained for the device's lifetime.
+ * Virtual extent checks do not prove physical ownership or alias isolation;
+ * inspect actual CPU/GPU tables independently. A device allows one attempt.
+ * Use ColdStart below to also exchange the modern HFI startup messages.
+ * Debug draining, GPU submission and fault recovery are separate operations.
+ * Any failure after mutation attempts reset assertion and poisons the session.
+ * Even verified reset does NOT drain SMMU/bus traffic or authorize release;
+ * resources_must_retain stays true on all paths. No automatic retry is safe. */
+/* Result readiness fields are observations, never current-running assertions:
+ * a later failure may already have reasserted reset. */
+Sm8550GmuStatus Sm8550GmuLoadAndStartHfi(Sm8550GmuDevice *,const Sm8550GmuConfig *,Sm8550GmuResult *);
+
+typedef struct {
+    unsigned polls_per_command,wait_interval_us;
+    uint64_t command_timeout_us,total_timeout_us;
+} Sm8550GmuStartupLimits;
+typedef struct {
+    Sm8550GmuResult load;
+    AdrenoHfiStartupResult protocol;
+    AdrenoHfiStartupStatus protocol_status;
+    Sm8550GmuStatus health_status;
+} Sm8550GmuStartupResult;
+/* Full cold firmware/HFI startup sequence, under all LoadAndStartHfi platform
+ * preconditions above. Validate protocol/limits before any hardware mutation,
+ * then load firmware and exchange every required command with actual ACKs.
+ * Health checks reread reset/HFI status and fatal registers around commands.
+ * Supplied OPP/ARC/BCM/ACD data must be platform-derived; this function neither
+ * invents command-db values nor sets power, clocks, SMMU or AOSS policy.
+ * Any protocol failure after the load attempts reset and permanently poisons
+ * the device. A verified reset still does not authorize releasing mappings.
+ * Success covers firmware startup exchanges, NOT SQE/ZAP/GPU initialization,
+ * shader execution, submission, presentation or a complete hardware driver. */
+Sm8550GmuStatus Sm8550GmuColdStart(Sm8550GmuDevice *,const Sm8550GmuConfig *,
+    const AdrenoHfiStartupConfig *,const Sm8550GmuStartupLimits *,Sm8550GmuStartupResult *);
+
+typedef struct {volatile unsigned char *cpu;uint64_t physical;size_t bytes;} Sm8550GmuMmioWindow;
+typedef struct {Sm8550GmuMmioWindow windows[Sm8550GmuWindows];} Sm8550GmuMmio;
+/* Bind only already owned/powered Device mappings of exact pinned DT ranges.
+ * Uses direct AArch64 volatile 32-bit I/O + dsb sy. No map/allocation/power,
+ * pointer ownership proof or external-abort recovery is provided. */
+Sm8550GmuStatus Sm8550GmuBindMmio(Sm8550GmuMmio *,Sm8550GmuIo *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/Sm8550GmuCommandDb.c b/iokit/Kernel/arm/a740/Sm8550GmuCommandDb.c
new file mode 100644
index 0000000..330f67b
--- /dev/null
+++ b/iokit/Kernel/arm/a740/Sm8550GmuCommandDb.c
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "Sm8550GmuCommandDb.h"
+#include "Sm8550GmuCommandDbSource.h"
+static uint16_t u16(const uint8_t *p){return (uint16_t)(p[0]|(uint16_t)p[1]<<8);}
+static uint32_t u32(const uint8_t *p){return u16(p)|(uint32_t)u16(p+2)<<16;}
+static int range(size_t at,size_t len,size_t size){return at<=size && len<=size-at;}
+static int overlaps(size_t a,size_t n,size_t b,size_t m){return n && m && a<b+m && b<a+n;}
+static int equal(const uint8_t *a,const char *b)
+{for(unsigned i=0;i<8;++i)if(a[i]!=(uint8_t)b[i])return 0;return 1;}
+Sm8550GmuDbStatus Sm8550GmuCommandDbInputs(const uint8_t *data,size_t bytes,uint32_t expected,Sm8550GmuVoteInputs *out)
+{
+    if(!data || !out || bytes!=ISHTAR_GMU_COMMAND_DB_BYTES || !expected)return Sm8550GmuDbArgument;
+    if(u32(data)!=expected)return Sm8550GmuDbVersion;
+    if(u32(data+4)!=0x0c0330db)return Sm8550GmuDbCorrupt;
+    /* cmd_db_get_header: the slave table ends at the first zero slv_id, and every slave type is searched (int-011:
+     * the ishtar AOP database failed the earlier 3..5-only, no-gap rule). Only extents are checked for records that
+     * are not used here; the records used below get the full address/slave/aux checks. */
+    size_t heads[8]={0},sizes[8]={0},aux[8]={0};unsigned rows=0;
+    for(unsigned i=0;i<8;++i) {
+        const uint8_t *r=data+8+16*i;unsigned id=u16(r),count=u16(r+6);
+        if(!id)break;
+        heads[i]=144u+u16(r+2);sizes[i]=(size_t)count*24;aux[i]=144u+u16(r+4);
+        if(!range(heads[i],sizes[i],bytes) || !range(aux[i],0,bytes))return Sm8550GmuDbCorrupt;
+        ++rows;
+    }
+    static const char names[8][8]={{'g','f','x','.','l','v','l',0},{'m','x','.','l','v','l',0,0},
+        {'c','x','.','l','v','l',0,0},{'g','m','x','c','.','l','v','l'},
+        {'S','H','0',0,0,0,0,0},{'M','C','0',0,0,0,0,0},{'A','C','V',0,0,0,0,0},{'C','N','0',0,0,0,0,0}};
+    Sm8550GmuAux found[8]={{0}};uint32_t addresses[8]={0};unsigned seen=0;
+    for(unsigned i=0;i<rows;++i)for(size_t at=heads[i];at<heads[i]+sizes[i];at+=24) {
+        const uint8_t *e=data+at;uint32_t address=u32(e+16);size_t len=u16(e+20),offset=aux[i]+u16(e+22);
+        unsigned slave=u16(data+8+16*i);
+        for(unsigned name=0;name<8;++name)if(equal(e,names[name])) {
+            if(seen&(1u<<name))return Sm8550GmuDbDuplicate;
+            if(!address || (address&3) || ((address>>16)&7)!=slave || !range(offset,len,bytes))return Sm8550GmuDbCorrupt;
+            for(unsigned j=0;j<rows;++j)if(overlaps(offset,len,heads[j],sizes[j]))return Sm8550GmuDbCorrupt;
+            if(slave!=(name<4?3u:5u))return Sm8550GmuDbCorrupt;
+            seen|=1u<<name;found[name]=(Sm8550GmuAux){data+offset,len};addresses[name]=address;
+        }
+    }
+    if((seen&0xf7)!=0xf7)return Sm8550GmuDbMissing;
+    Sm8550GmuVoteInputs result=*out;
+    result.gfx=found[0];result.mx=found[1];result.cx=found[2];result.gmxc=found[3];result.gmxc_present=(seen>>3)&1;
+    result.sh0=(Sm8550GmuBcmInput){addresses[4],found[4]};result.mc0=(Sm8550GmuBcmInput){addresses[5],found[5]};
+    result.acv=(Sm8550GmuBcmInput){addresses[6],found[6]};result.cn0_address=addresses[7];
+    *out=result;return Sm8550GmuDbSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/Sm8550GmuCommandDb.h b/iokit/Kernel/arm/a740/Sm8550GmuCommandDb.h
new file mode 100644
index 0000000..77b78f5
--- /dev/null
+++ b/iokit/Kernel/arm/a740/Sm8550GmuCommandDb.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef ISHTAR_GMU_COMMAND_DB_H
+#define ISHTAR_GMU_COMMAND_DB_H
+#include "Sm8550GmuVotes.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef enum {Sm8550GmuDbSuccess,Sm8550GmuDbArgument,Sm8550GmuDbVersion,
+    Sm8550GmuDbCorrupt,Sm8550GmuDbDuplicate,Sm8550GmuDbMissing} Sm8550GmuDbStatus;
+/* Parse an immutable CPU-readable snapshot of the complete pinned DT command
+ * DB reservation. No mapping, MMIO or allocation. Caller must obtain/retain
+ * actual platform-owned bytes coherently and bind expected_version from an
+ * independently qualified platform policy; reading that word and passing it
+ * back is not version qualification. No version is guessed here.
+ * The format's checksum is unused by the source; this parser does NOT verify
+ * provenance/integrity/authenticity. All offsets/counts are checked, with a
+ * 4096-entry bound and unique target records. Missing GMxC is authoritative
+ * only after the complete structurally valid database has been scanned.
+ * Output contains aliases into input, must be disjoint and retained/immutable
+ * through startup configuration construction. Failure leaves output unchanged.
+ * Output must be initialized. Chip identity and optional features are caller
+ * policy; this sets
+ * only cmd-db fields and preserves those policy fields. No hardware readiness
+ * follows from parsing, and malformed data never permits a power operation. */
+Sm8550GmuDbStatus Sm8550GmuCommandDbInputs(const uint8_t *,size_t,uint32_t expected_version,Sm8550GmuVoteInputs *);
+#ifdef __cplusplus
+}
+#endif
+#endif
