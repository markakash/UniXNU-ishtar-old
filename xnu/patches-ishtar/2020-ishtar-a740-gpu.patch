+}
+size_t NativeAdrenoUserClient::inputSize(uint32_t method)
+{
+    switch(method) {
+    case NativeAdrenoMethodQuery:
+    case NativeAdrenoMethodGetTimestamp:
+    case NativeAdrenoMethodGetStatus:
+    case NativeAdrenoMethodGetDeviceInfo:return 0;
+    case NativeAdrenoMethodBoAlloc:return sizeof(NativeAdrenoAbiBoAlloc);
+    case NativeAdrenoMethodBoMap:return sizeof(NativeAdrenoAbiBoMap);
+    case NativeAdrenoMethodBoImport:return sizeof(NativeAdrenoAbiBoImport);
+    case NativeAdrenoMethodBoFree:return sizeof(NativeAdrenoAbiBoFree);
+    case NativeAdrenoMethodSubmit:return sizeof(NativeAdrenoAbiSubmit);
+    case NativeAdrenoMethodSetMetadata:
+    case NativeAdrenoMethodGetMetadata:return sizeof(NativeAdrenoAbiMetadata);
+    case NativeAdrenoMethodCreateQueue:
+    case NativeAdrenoMethodCloseQueue:return sizeof(NativeAdrenoAbiQueue);
+    case NativeAdrenoMethodBoCpuMap:return sizeof(NativeAdrenoAbiBoCpuMap);
+    case NativeAdrenoMethodBoCpuUnmap:return sizeof(NativeAdrenoAbiBoCpuUnmap);
+    case NativeAdrenoMethodWaitFence:return sizeof(NativeAdrenoAbiWaitFence);
+    default:return SIZE_MAX;
+    }
+}
+size_t NativeAdrenoUserClient::outputSize(uint32_t method)
+{
+    switch(method) {
+    case NativeAdrenoMethodQuery:return sizeof(NativeAdrenoAbiParams);
+    case NativeAdrenoMethodBoAlloc:return sizeof(NativeAdrenoAbiBoAllocReply);
+    case NativeAdrenoMethodBoMap:return sizeof(NativeAdrenoAbiBoMapReply);
+    case NativeAdrenoMethodBoFree:return 0;
+    case NativeAdrenoMethodSubmit:return sizeof(NativeAdrenoAbiSubmitReply);
+    case NativeAdrenoMethodWaitFence:return 0;
+    case NativeAdrenoMethodGetTimestamp:return sizeof(NativeAdrenoAbiTimestamp);
+    case NativeAdrenoMethodGetStatus:return sizeof(NativeAdrenoAbiStatus);
+    case NativeAdrenoMethodGetDeviceInfo:return sizeof(NativeAdrenoAbiDeviceInfo);
+    case NativeAdrenoMethodGetMetadata:return sizeof(NativeAdrenoAbiMetadata);
+    case NativeAdrenoMethodSetMetadata:return 0;
+    case NativeAdrenoMethodCreateQueue:return sizeof(NativeAdrenoAbiQueueReply);
+    case NativeAdrenoMethodCloseQueue:return 0;
+    case NativeAdrenoMethodBoCpuMap:return sizeof(NativeAdrenoAbiBoCpuMapReply);
+    case NativeAdrenoMethodBoCpuUnmap:return 0;
+    case NativeAdrenoMethodBoImport:return sizeof(NativeAdrenoAbiBoAllocReply);
+    default:return SIZE_MAX;
+    }
+}
+IOReturn NativeAdrenoUserClient::dispatch(uint32_t method,const void *input,
+    size_t input_size,void *output,size_t output_size,const NativeAdrenoRingClock *clock)
+{
+    struct Tally {
+        uint32_t method;uint64_t began;IOReturn *result;const NativeAdrenoRingClock *clock;
+        Tally(uint32_t m,IOReturn *r,const NativeAdrenoRingClock *c):method(m),began(c && c->now_us?c->now_us(c->cookie):0),result(r),clock(c) {}
+        ~Tally() {
+            if(method>=20)return;
+            const uint64_t now=clock && clock->now_us?clock->now_us(clock->cookie):0;
+            native_adreno_method_stats[method][0]=native_adreno_method_stats[method][0]+1;
+            if(*result)native_adreno_method_stats[method][1]=native_adreno_method_stats[method][1]+1;
+            native_adreno_method_stats[method][2]=(uint32_t)*result;
+            native_adreno_method_stats[method][3]=native_adreno_method_stats[method][3]+(uint32_t)(now-began);
+        }
+    };
+    /* The same clock times the VM's table transactions (the board service's probe never ran on this path, so nothing else installed it). */
+    static const NativeAdrenoRingClock *vm_clock=nullptr;
+    vm_clock=clock;
+    native_adreno_vm_now_us=[]()->uint64_t{return vm_clock && vm_clock->now_us?vm_clock->now_us(vm_clock->cookie):0;};
+    IOReturn tally_result=kIOReturnSuccess;
+    Tally tally(method,&tally_result,clock);
+    const size_t expected_in=inputSize(method),expected_out=outputSize(method);
+    if(expected_in==SIZE_MAX || expected_out==SIZE_MAX)return kIOReturnUnsupported;
+    if(input_size!=expected_in || output_size!=expected_out)return kIOReturnBadArgument;
+    if((expected_in && !input) || (expected_out && !output))return kIOReturnBadArgument;
+    IOReturn status=kIOReturnSuccess;
+    switch(method) {
+    case NativeAdrenoMethodQuery: {
+        NativeAdrenoAbiParams reply{};
+        status=query(&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodBoAlloc: {
+        NativeAdrenoAbiBoAlloc request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiBoAllocReply reply{};
+        status=allocBo(&request,&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodBoImport:
+        status=kIOReturnUnsupported;
+        break;
+    case NativeAdrenoMethodBoMap: {
+        NativeAdrenoAbiBoMap request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiBoMapReply reply{};
+        status=mapBo(&request,&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        else {
+            /* Why maps fail (int-135: 55 of 191, and the translator answers each as a device out-of-memory): status, count, and what the table
+             * held and the failed request asked for the last time. */
+            unsigned at=0;while(at<5 && native_adreno_map_fail[at][0] && native_adreno_map_fail[at][0]!=(uint32_t)status)++at;
+            native_adreno_map_fail[at][0]=(uint32_t)status;native_adreno_map_fail[at][1]=native_adreno_map_fail[at][1]+1;
+            native_adreno_map_fail[5][0]=(uint32_t)vm_->spanCount();native_adreno_map_fail[5][1]=(uint32_t)vm_->objectCount();
+            native_adreno_map_fail[6][0]=(uint32_t)(request.iova>>12);native_adreno_map_fail[6][1]=(uint32_t)(request.handle);
+        }
+        break;
+    }
+    case NativeAdrenoMethodBoFree: {
+        NativeAdrenoAbiBoFree request{};
+        memcpy(&request,input,sizeof(request));
+        status=freeBo(&request);
+        break;
+    }
+    case NativeAdrenoMethodSubmit: {
+        NativeAdrenoAbiSubmit request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiSubmitReply reply{};
+        status=submit(&request,&reply,clock);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodWaitFence: {
+        NativeAdrenoAbiWaitFence request{};
+        memcpy(&request,input,sizeof(request));
+        status=waitFence(&request,clock);
+        break;
+    }
+    case NativeAdrenoMethodGetDeviceInfo: {
+        NativeAdrenoAbiDeviceInfo reply{};
+        status=deviceInfo(&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodGetTimestamp: {
+        NativeAdrenoAbiTimestamp reply{};
+        status=timestamp(&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodBoCpuMap: {
+        NativeAdrenoAbiBoCpuMap request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiBoCpuMapReply reply{};
+        status=cpuMap(&request,&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodBoCpuUnmap: {
+        NativeAdrenoAbiBoCpuUnmap request{};
+        memcpy(&request,input,sizeof(request));
+        status=cpuUnmap(&request);
+        break;
+    }
+    case NativeAdrenoMethodCreateQueue: {
+        NativeAdrenoAbiQueueReply reply{};
+        status=createQueue(&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodCloseQueue: {
+        NativeAdrenoAbiQueue request{};
+        memcpy(&request,input,sizeof(request));
+        status=closeQueue(&request);
+        break;
+    }
+    case NativeAdrenoMethodSetMetadata: {
+        NativeAdrenoAbiMetadata request{};
+        memcpy(&request,input,sizeof(request));
+        status=setMetadata(&request);
+        break;
+    }
+    case NativeAdrenoMethodGetMetadata: {
+        NativeAdrenoAbiMetadata request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiMetadata reply{};
+        status=getMetadata(&request,&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodGetStatus: {
+        NativeAdrenoAbiStatus reply{};
+        status=this->status(&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    default:return kIOReturnUnsupported;
+    }
+    tally_result=status;
+    return status;
+}
+IOReturn NativeAdrenoUserClient::cpuMap(const NativeAdrenoAbiBoCpuMap *request,
+    NativeAdrenoAbiBoCpuMapReply *reply)
+{
+    if(!request || !reply)return kIOReturnBadArgument;*reply={};
+    if(!open_)return kIOReturnNotReady;
+    Entry *entry=find(request->handle);
+    if(!entry || entry->unreleasable)return kIOReturnBadArgument;
+    /* An imported BO is the caller's own memory, already mapped where it came from. */
+    if(entry->memory.imported())return kIOReturnUnsupported;
+    if(entry->mapping_leases==UINT32_MAX)return kIOReturnNoResources;
+    ++entry->mapping_leases;
+    reply->token=entry->token;reply->bytes=entry->memory.bytes();
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::cpuUnmap(const NativeAdrenoAbiBoCpuUnmap *request)
+{
+    if(!request)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    if(request->reserved)return kIOReturnBadArgument;
+    Entry *entry=find(request->handle);
+    if(!entry || entry->unreleasable || !entry->token)return kIOReturnBadArgument;
+    if(request->token!=entry->token)return kIOReturnBadArgument;
+    if(!entry->mapping_leases)return kIOReturnBusy;
+    --entry->mapping_leases;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::createQueue(NativeAdrenoAbiQueueReply *reply)
+{
+    if(!reply)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    for(size_t i=1;i<NativeAdrenoAbiMaxQueues;++i)if(!queues_[i].active) {
+        queues_[i]={static_cast<uint32_t>(i),true};
+        reply->queue=i;
+        return kIOReturnSuccess;
+    }
+    return kIOReturnNoResources;
+}
+IOReturn NativeAdrenoUserClient::closeQueue(const NativeAdrenoAbiQueue *request)
+{
+    if(!request)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    if(!request->queue || request->queue>=NativeAdrenoAbiMaxQueues)return kIOReturnBadArgument;
+    Queue &queue=queues_[request->queue];
+    if(!queue.active)return kIOReturnBadArgument;
+    /* A queue must be drained by the caller before it disappears. */
+    if(submit_->queueOutstanding(queue_base_+static_cast<uint32_t>(request->queue)))
+        return kIOReturnBusy;
+    queue={};
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::setMetadata(const NativeAdrenoAbiMetadata *request)
+{
+    if(!request)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    if(request->reserved || request->bytes>NativeAdrenoAbiMetadataBytes)return kIOReturnBadArgument;
+    Entry *entry=find(request->handle);
+    if(!entry || entry->unreleasable)return kIOReturnBadArgument;
+    if(request->bytes)memcpy(entry->metadata,request->text,request->bytes);
+    entry->metadata_bytes=request->bytes;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::getMetadata(const NativeAdrenoAbiMetadata *request,
+    NativeAdrenoAbiMetadata *reply)
+{
+    if(!request || !reply)return kIOReturnBadArgument;
+    /* Snapshot the request so an in/out alias is still well defined. */
+    const uint64_t handle=request->handle;
+    const uint32_t asked=request->bytes;
+    const uint32_t reserved=request->reserved;
+    *reply={};
+    if(!open_)return kIOReturnNotReady;
+    if(reserved || asked>NativeAdrenoAbiMetadataBytes)return kIOReturnBadArgument;
+    Entry *entry=find(handle);
+    if(!entry || entry->unreleasable)return kIOReturnBadArgument;
+    if(asked<entry->metadata_bytes)return kIOReturnBadArgument;
+    reply->handle=entry->handle;reply->bytes=entry->metadata_bytes;
+    if(entry->metadata_bytes)memcpy(reply->text,entry->metadata,entry->metadata_bytes);
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::waitFence(const NativeAdrenoAbiWaitFence *request,
+    const NativeAdrenoRingClock *clock)
+{
+    if(!request || !clock)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    if(!request->fence)return kIOReturnBadArgument;
+    const uint32_t timeout_us=request->timeout_ns==0?0:
+        (request->timeout_ns>UINT64_C(0xffffffff)*1000u?0xffffffffu:
+        (uint32_t)(request->timeout_ns/1000));
+    return submit_->wait((uint32_t)request->fence,clock,timeout_us);
+}
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoUserClient.h b/iokit/Kernel/arm/a740/NativeAdrenoUserClient.h
new file mode 100644
index 0000000..46c4aea
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoUserClient.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_USERCLIENT_H
+#define NATIVE_ADRENO_USERCLIENT_H
+#include "NativeAdrenoABI.h"
+#include "NativeAdrenoSubmit.h"
+#include "NativeAdrenoTimer.h"
+#include "NativeAdrenoStatus.h"
+
+/* Kernel-side body of the Adreno user client, deliberately free of IOKit so it
+ * can be exercised on a host. The future IOService/IOUserClient wrapper only
+ * copies one fixed ABI record in and out and calls these methods; it must not
+ * add policy. Handles are this object's own identities, never VM, IOVA or
+ * pointer values. A mapping is retirable only through freeBo, which unmaps
+ * first and then releases the backing object; both steps must succeed.
+ * Up to NativeAdrenoClientMaxObjects live objects and the execbuf's own eight-job limit apply. */
+enum : size_t {NativeAdrenoClientMaxObjects=4096,NativeAdrenoClientContiguousFirstBytes=65536};
+class NativeAdrenoUserClient final {
+    struct Queue {uint32_t id=0;bool active=false;};
+    struct Entry {
+        NativeAdrenoMemory memory;
+        uint64_t handle=0;
+        uint64_t mapped=0;
+        uint64_t iova=0;
+        bool used=false;
+        bool mapped_state=false;
+        bool unreleasable=false;
+        bool imported=false;
+        uint32_t metadata_bytes=0;
+        uint32_t token=0;
+        uint32_t mapping_leases=0;
+        char metadata[NativeAdrenoAbiMetadataBytes]{};
+    };
+    /* Allocated at open(), all-zero is the free state. */
+    Entry *entries_=nullptr;
+    size_t entry_count_=0;
+    Queue queues_[NativeAdrenoAbiMaxQueues]{};
+    NativeAdrenoVm *vm_=nullptr;
+    NativeAdrenoSubmit *submit_=nullptr;
+    NativeAdrenoRing *ring_=nullptr;
+    const NativeAdrenoTimer *timer_=nullptr;
+    const NativeAdrenoStatus *status_=nullptr;
+    const NativeAdrenoAbiDeviceInfo *info_=nullptr;
+    uint32_t input_bits_=0,output_bits_=0;
+    /* Scope on the shared ring and GPU space: this client's queues are the submit object's queues [queue_base_, +MaxQueues), and with a
+     * window (window_bytes_ nonzero) every mapping must lie inside [window_start_, +window_bytes_), which GetDeviceInfo reports as the VA. */
+    uint32_t queue_base_=0;
+    /* A client owns a queue range once setScope() gave it one or it has submitted into the default one (a single client that never scopes owns
+     * range 0). Before either, queue_base_ is only the default 0, which a scoped client may own, so a check of "this client's own range" would
+     * test someone else's jobs. */
+    bool scoped_=false,used_=false;
+    uint64_t window_start_=0,window_bytes_=0,window_peak_=0;
+    uint64_t next_handle_=1;
+    bool open_=false;
+    Entry *find(uint64_t);
+    Entry *free();
+    static void clear(Entry &);
+public:
+    NativeAdrenoUserClient()=default;
+    ~NativeAdrenoUserClient()=default;
+    NativeAdrenoUserClient(const NativeAdrenoUserClient &)=delete;
+    NativeAdrenoUserClient &operator=(const NativeAdrenoUserClient &)=delete;
+    /* Mounts one already-qualified context. input/output bits describe the
+     * active native4K arena and are reported, never guessed. */
+    IOReturn open(uint32_t abi_version,NativeAdrenoVm *,NativeAdrenoSubmit *,
+        NativeAdrenoRing *,uint32_t input_bits,uint32_t output_bits);
+    /* One client of several on the same VM, submit object and ring: its queue range (queue_base a multiple of NativeAdrenoAbiMaxQueues) and
+     * GPU address window (4 KiB aligned, inside the input range; bytes 0 = unrestricted). Only while open with no live object or job. */
+    IOReturn setScope(uint32_t queue_base,uint64_t window_start,uint64_t window_bytes);
+    /* Highest end address (exclusive) any mapping of this client has reached, 0 before the first. */
+    uint64_t windowPeak() const {return window_peak_;}
+    /* Whether any job is unobserved in the range this client owns (never, while it owns none). */
+    bool ownRangeOutstanding() const;
+    /* Refuses while any object is live or any of this client's jobs is unobserved. */
+    IOReturn close();
+    /* Connection teardown: waits for every outstanding job, then unmaps and frees every object, closes every queue and
+     * closes the client. The first failure stops it and leaves what remains live; nothing is forced. */
+    IOReturn releaseAll(const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Backing object of a token returned by cpuMap while its lease is held (clientMemoryForType); null otherwise. */
+    NativeAdrenoMemory *memoryForToken(uint32_t token);
+    /* CPU mappings of the BO of this token that BoCpuMap handed out and BoCpuUnmap has not given back; 0 for no such BO. */
+    uint32_t mappingLeases(uint32_t token) const;
+    IOReturn query(NativeAdrenoAbiParams *);
+    IOReturn allocBo(const NativeAdrenoAbiBoAlloc *,NativeAdrenoAbiBoAllocReply *);
+    IOReturn allocBoInner(const NativeAdrenoAbiBoAlloc *,NativeAdrenoAbiBoAllocReply *);
+    IOReturn mapBo(const NativeAdrenoAbiBoMap *,NativeAdrenoAbiBoMapReply *);
+    /* BoImport: pins the caller's pages. Only the IOKit wrapper can call it, with the calling task; dispatch() refuses the method
+     * because it has no task (the kernel mailbox path cannot import). */
+    IOReturn importBo(const NativeAdrenoAbiBoImport *,void *task,NativeAdrenoAbiBoAllocReply *);
+    /* Unmaps if still mapped, then releases the backing object. A failure at
+     * either step keeps the entry live and unmapped where possible. */
+    IOReturn freeBo(const NativeAdrenoAbiBoFree *);
+    IOReturn submit(const NativeAdrenoAbiSubmit *,NativeAdrenoAbiSubmitReply *,
+        const NativeAdrenoRingClock *);
+    IOReturn cpuMap(const NativeAdrenoAbiBoCpuMap *,NativeAdrenoAbiBoCpuMapReply *);
+    IOReturn cpuUnmap(const NativeAdrenoAbiBoCpuUnmap *);
+    IOReturn createQueue(NativeAdrenoAbiQueueReply *);
+    IOReturn closeQueue(const NativeAdrenoAbiQueue *);
+    IOReturn setMetadata(const NativeAdrenoAbiMetadata *);
+    IOReturn getMetadata(const NativeAdrenoAbiMetadata *,NativeAdrenoAbiMetadata *);
+    IOReturn waitFence(const NativeAdrenoAbiWaitFence *,const NativeAdrenoRingClock *);
+    /* One external-method entry: exact record sizes are required, unknown
+     * methods are unsupported and no output byte is modified on failure. The
+     * IOKit wrapper should only copy these buffers and call this function. */
+    IOReturn dispatch(uint32_t method,const void *input,size_t input_size,
+        void *output,size_t output_size,const NativeAdrenoRingClock *);
+    static size_t inputSize(uint32_t method);
+    static size_t outputSize(uint32_t method);
+    size_t liveObjects() const;
+    /* Optional GPU timestamp source; absent means the method stays unsupported. */
+    IOReturn attachTimer(const NativeAdrenoTimer *);
+    IOReturn timestamp(NativeAdrenoAbiTimestamp *);
+    /* Optional counters; absent means the status method stays unsupported. */
+    IOReturn attachStatus(const NativeAdrenoStatus *);
+    IOReturn status(NativeAdrenoAbiStatus *);
+    /* Optional constant device facts; absent means the method stays unsupported. */
+    IOReturn attachDeviceInfo(const NativeAdrenoAbiDeviceInfo *);
+    IOReturn deviceInfo(NativeAdrenoAbiDeviceInfo *);
+    bool mapped(uint64_t handle);
+    /* Backing object of a live handle, for the IOKit wrapper's clientMemoryForType and for kernel self-tests;
+     * null for an unknown or unreleasable handle. The client keeps ownership. */
+    NativeAdrenoMemory *memoryOf(uint64_t handle);
+};
+#endif
diff --git a/iokit/Kernel/arm/a740/NativeAdrenoVm.cpp b/iokit/Kernel/arm/a740/NativeAdrenoVm.cpp
new file mode 100644
index 0000000..5a72a93
--- /dev/null
+++ b/iokit/Kernel/arm/a740/NativeAdrenoVm.cpp
@@ -0,0 +1,448 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoVm.h"
+#include "NativeAdrenoVmAlias.h"
+extern "C" volatile uint32_t native_adreno_trace_stage;
+extern "C" {int (*native_adreno_dram_read32)(uint64_t,uint32_t *);int (*native_adreno_cached_read32)(uint64_t,uint32_t *);
+    int (*native_adreno_line_audit)(uint64_t,size_t,uint32_t *,uint32_t *);}
+#include <string.h>
+#include <IOKit/IOLib.h>
+/* 1 once the board proved the GPU's cacheable inner-shareable accesses coherent with the CPU's caches in both directions (the A740's
+ * ADRENO_QUIRK_HAS_CACHED_COHERENT behind the dma-coherent GPU SMMU, which Linux maps with IOMMU_CACHE): a mapping with write-back
+ * attributes then needs no CPU cache maintenance. 0 keeps every mapping maintained as before. Counters: maintenance passes skipped for
+ * coherent mappings at map, unmap, submission and completion. */
+extern "C" {volatile uint32_t native_adreno_io_coherent;volatile uint32_t native_adreno_coherent_skips[4];}
+static bool coherentMapping(unsigned writeback) {return writeback && native_adreno_io_coherent;}
+/* GPU-written imports (render targets) are mapped non-coherent (the GPU stopped inside its end-of-pass clean writing them through
+ * write-back mappings), and the CPU never touches their pixels while the GPU owns them: they were cleaned when mapped and need no
+ * maintenance per submission, which cost about 60 ms per frame. */
+static bool importedUntouched(const NativeAdrenoMemory *memory) {return memory->imported() && native_adreno_io_coherent;}
+static bool overlap(uint64_t a,uint64_t ab,uint64_t b,uint64_t bb)
+{return a<b+bb && b<a+ab;}
+/* Mappings of one cache/shareability/privilege class may share pages; only pages shared across classes refuse. */
+static unsigned aliasClass(unsigned permissions,unsigned writeback,unsigned shareability)
+{return writeback|(shareability<<1)|((permissions&ArmSmmu4KPrivileged)?8u:0u);}
+static void reverse(ArmSmmu4KRange *first,ArmSmmu4KRange *last)
+{while(first<last && first<--last) {const ArmSmmu4KRange t=*first;*first++=*last;*last=t;}}
+static bool validBinding(const NativeAdrenoVmRegion &r,unsigned upper)
+{
+    return r.tables && r.arena && r.state && !r.tables->quarantined() &&
+        r.tables->deviceReferences() && r.tables->spanCount()==1 &&
+        r.tables->spans()[0].bytes==r.tables->bytes() && !r.tables->spans()[0].offset &&
+        r.arena->mapping==r.tables->mapping() && r.arena->upper_region==upper &&
+        r.arena->config.table_physical==r.tables->spans()[0].physical &&
+        r.arena->capacity_pages==r.tables->bytes()/4096 && r.state->prepared &&
+        !r.state->poisoned && !r.state->tables.leaf_pages;
+}
+ArmSmmu4KLiveRegion NativeAdrenoVm::region(unsigned upper) const
+{
+    return {regions_[upper].arena,regions_[upper].state,
+        ranges_+(upper?lower_count_:0),upper?upper_count_:lower_count_};
+}
+/* Board hook and per-phase time of the two table transactions, for the log: [0] map, [1] unmap; each row is count, the phases in order, the slowest call
+ * and the bytes mapped (int-134: BoMap averaged 135 ms and the desktop crawled). */
+extern "C" {uint64_t (*native_adreno_vm_now_us)(void)=nullptr;volatile uint64_t native_adreno_vm_phase_us[2][8];}
+namespace {
+struct PhaseClock {
