diff --git a/iokit/Kernel/arm/a740/Sm8550GmuVotes.c b/iokit/Kernel/arm/a740/Sm8550GmuVotes.c
new file mode 100644
index 0000000..ce0da9b
--- /dev/null
+++ b/iokit/Kernel/arm/a740/Sm8550GmuVotes.c
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "Sm8550GmuVotes.h"
+#include "Sm8550GmuVotesSource.h"
+AdrenoHfiStartupStatus Sm8550GmuBuildStartup(const Sm8550GmuVoteInputs *in,AdrenoHfiStartupConfig *out)
+{
+    if(!in || !out || in->chip_id!=ISHTAR_GMU_VOTES_CHIP_ID || in->gmxc_present>1 ||
+        in->enable_acd>1 || in->enable_ifpc>1 ||
+        (!in->gmxc_present && (in->gmxc.data || in->gmxc.bytes)))return AdrenoHfiStartupInvalid;
+    AdrenoHfiStartupConfig c={0};uint32_t votes[16],levels[16];
+    const Sm8550GmuAux *gpu_secondary=in->gmxc_present?&in->gmxc:&in->mx;
+    for(unsigned i=0;i<ISHTAR_GPU_OPPS;++i)levels[i]=ishtar_gpu_opps[i].level;
+    if(AdrenoHfiArcVotes(levels,ISHTAR_GPU_OPPS,in->gfx.data,in->gfx.bytes,
+        gpu_secondary->data,gpu_secondary->bytes,votes,16))return AdrenoHfiStartupInvalid;
+    c.gpu_count=ISHTAR_GPU_OPPS;
+    for(unsigned i=0;i<c.gpu_count;++i) {
+        c.gpu[i]=(AdrenoHfiPerformanceLevel){ishtar_gpu_opps[i].hz,votes[i]};
+        if(in->enable_acd && ishtar_gpu_opps[i].acd_present) {
+            c.acd_enable_mask|=1u<<i;c.acd_data[c.acd_count++]=ishtar_gpu_opps[i].acd;
+        }
+    }
+    if(c.acd_count)c.acd_version=c.acd_stride=1;
+    for(unsigned i=0;i<ISHTAR_GMU_OPPS;++i)levels[i]=ishtar_gmu_opps[i].level;
+    if(AdrenoHfiArcVotes(levels,ISHTAR_GMU_OPPS,in->cx.data,in->cx.bytes,
+        in->mx.data,in->mx.bytes,votes,16))return AdrenoHfiStartupInvalid;
+    c.gmu_count=ISHTAR_GMU_OPPS;
+    for(unsigned i=0;i<c.gmu_count;++i)c.gmu[i]=(AdrenoHfiPerformanceLevel){ishtar_gmu_opps[i].hz,votes[i]};
+    const Sm8550GmuBcmInput *inputs[]={&in->sh0,&in->mc0,&in->acv};AdrenoHfiBcm bcms[3];
+    for(unsigned i=0;i<3;++i) {
+        bcms[i]=ishtar_bcm_policy[i];bcms[i].address=inputs[i]->address;
+        if(AdrenoHfiBcmAux(bcms+i,inputs[i]->aux.data,inputs[i]->aux.bytes))return AdrenoHfiStartupInvalid;
+    }
+    if(AdrenoHfiBuildBandwidth(ishtar_gpu_bandwidths,ISHTAR_GPU_BANDWIDTHS,bcms,3,in->cn0_address,&c))
+        return AdrenoHfiStartupInvalid;
+    c.enable_ifpc=in->enable_ifpc;
+    if(AdrenoHfiStartupValidate(&c))return AdrenoHfiStartupInvalid;
+    *out=c;return AdrenoHfiStartupSuccess;
+}
+unsigned Sm8550GmuPerfVote(unsigned perf,unsigned *bandwidth)
+{
+    if(perf<1)perf=1;
+    if(perf>=ISHTAR_GPU_OPPS)perf=ISHTAR_GPU_OPPS-1;
+    unsigned bw=1;
+    for(unsigned i=1;i<ISHTAR_GPU_BANDWIDTHS;++i)if(ishtar_gpu_bandwidths[i]==ishtar_gpu_opps[perf].kbps){bw=i;break;}
+    if(bandwidth)*bandwidth=bw;
+    return perf;
+}
