+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_A740_HWINIT_H
+#define NATIVE_ADRENO_A740_HWINIT_H
+#include <stdint.h>
+/* Generated by scripts/derive-a740-hwinit.py from the pinned a6xx.xml/adreno_common.xml/a6xx_gmu.xml (A7XX
+ * variants) and a6xx_catalog.c (a740_hwcg, a730_protect). Dword register offsets. Do not edit by hand. */
+#define A740_GBIF_HALT 0x03c45
+#define A740_RBBM_GBIF_HALT 0x00016
+#define A740_RBBM_SECVID_TSB_CNTL 0x0f803
+#define A740_RBBM_SECVID_TSB_TRUSTED_BASE 0x0f800
+#define A740_RBBM_SECVID_TSB_TRUSTED_SIZE 0x0f802
+#define A740_RBBM_GBIF_CLIENT_QOS_CNTL 0x00011
+#define A740_UCHE_GBIF_GX_CONFIG 0x00e3a
+#define A740_RBBM_PERFCTR_GPU_BUSY_MASKED 0x0050b
+#define A740_UCHE_TRAP_BASE 0x00e09
+#define A740_UCHE_WRITE_THRU_BASE 0x00e07
+#define A740_UCHE_GMEM_RANGE_MIN 0x00e0b
+#define A740_UCHE_GMEM_RANGE_MAX 0x00e0d
+#define A740_UCHE_CACHE_WAYS 0x00e17
+#define A740_CP_AHB_CNTL 0x0098d
+#define A740_RBBM_PERFCTR_CNTL 0x00500
+#define A740_RBBM_INTERFACE_HANG_INT_CNTL 0x0001f
+#define A740_UCHE_CLIENT_PF 0x00e19
+#define A740_CP_PROTECT_CNTL 0x0084f
+#define A740_UCHE_CMDQ_CONFIG 0x00e3c
+#define A740_CP_APRIV_CNTL 0x00844
