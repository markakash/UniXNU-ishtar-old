diff --git a/iokit/Kernel/arm/a740/Sm8550GmuSource.h b/iokit/Kernel/arm/a740/Sm8550GmuSource.h
new file mode 100644
index 0000000..6372c00
--- /dev/null
+++ b/iokit/Kernel/arm/a740/Sm8550GmuSource.h
@@ -0,0 +1,71 @@
+/* Generated by scripts/gen-a740-sources.py from pinned sm8550-mainline sources. */
+#include <stdint.h>
+#include <stddef.h>
+#define REG_GMU_CM3_ITCM_START UINT32_C(0x1b400)
+#define REG_GMU_CM3_DTCM_START UINT32_C(0x1c400)
