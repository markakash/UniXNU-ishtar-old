diff --git a/iokit/Kernel/arm/a740/AdrenoFirmware.c b/iokit/Kernel/arm/a740/AdrenoFirmware.c
new file mode 100644
index 0000000..e776c80
--- /dev/null
+++ b/iokit/Kernel/arm/a740/AdrenoFirmware.c
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "AdrenoFirmware.h"
+
+static uint32_t le32(const uint8_t *p)
+{
+  return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+         (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+AdrenoFirmwareResult AdrenoFirmwarePlanGmu(
+    const uint8_t *firmware, size_t bytes,
+    const AdrenoFirmwareRegion *regions, size_t region_count,
+    AdrenoFirmwareBlock *blocks, size_t capacity, size_t *count)
+{
+  if (!count) return AdrenoFirmwareInvalid;
+  *count = 0;
+  if (!firmware || !regions || !blocks || !region_count || region_count > 64)
+    return AdrenoFirmwareInvalid;
+  if (bytes < 16) return AdrenoFirmwareTruncated;
+  for (size_t i = 0; i < region_count; ++i) {
+    const AdrenoFirmwareRegion *a = regions + i;
+    if (!a->bytes || (a->address & 3) || (a->bytes & 3) ||
+        a->bytes > UINT64_C(0x100000000) - a->address || a->identifier == UINT32_MAX)
+      return AdrenoFirmwareInvalid;
+    for (size_t j = 0; j < i; ++j) {
+      const AdrenoFirmwareRegion *b = regions + j;
+      if (a->identifier == b->identifier ||
+          ((uint64_t)a->address < (uint64_t)b->address + b->bytes &&
+           (uint64_t)b->address < (uint64_t)a->address + a->bytes))
+        return AdrenoFirmwareInvalid;
+    }
+  }
+  for (unsigned pass = 0; pass < 2; ++pass) {
+    size_t offset = 0, n = 0;
+    while (offset < bytes) {
+      if (bytes - offset < 16) return AdrenoFirmwareTruncated;
+      uint32_t address = le32(firmware + offset);
+      uint32_t length = le32(firmware + offset + 4);
+      uint32_t identifier = UINT32_MAX;
+      if (length > bytes - offset - 16) return AdrenoFirmwareTruncated;
+      if (length) {
+        if ((address & 3) || (length & 3) ||
+            length > UINT64_C(0x100000000) - address)
+          return AdrenoFirmwareInvalid;
+        for (size_t i = 0; i < region_count; ++i) {
+          if (address >= regions[i].address && length <= regions[i].bytes &&
+              (uint64_t)address - regions[i].address <= regions[i].bytes - length) {
+            identifier = regions[i].identifier;
+            break;
+          }
+        }
+        if (identifier == UINT32_MAX) return AdrenoFirmwareUnmapped;
+      }
+      if (n == capacity) return AdrenoFirmwareNoSpace;
+      if (pass) {
+        blocks[n].address = address;
+        blocks[n].bytes = length;
+        blocks[n].type = le32(firmware + offset + 8);
+        blocks[n].value = le32(firmware + offset + 12);
+        blocks[n].payload_offset = offset + 16;
+        blocks[n].region_identifier = identifier;
+      }
+      n++;
+      offset += 16 + (size_t)length;
+    }
+    if (pass) *count = n;
+  }
+  return AdrenoFirmwareSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/AdrenoFirmware.h b/iokit/Kernel/arm/a740/AdrenoFirmware.h
new file mode 100644
index 0000000..9588fa7
--- /dev/null
+++ b/iokit/Kernel/arm/a740/AdrenoFirmware.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef ADRENO_FIRMWARE_H
+#define ADRENO_FIRMWARE_H
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+  uint32_t address;
+  uint64_t bytes;
+  uint32_t identifier;
+} AdrenoFirmwareRegion;
+
+typedef struct {
+  uint32_t address, bytes, type, value;
+  size_t payload_offset;
+  uint32_t region_identifier;
+} AdrenoFirmwareBlock;
+
+typedef enum {
+  AdrenoFirmwareSuccess,
+  AdrenoFirmwareInvalid,
+  AdrenoFirmwareTruncated,
+  AdrenoFirmwareUnmapped,
+  AdrenoFirmwareNoSpace
+} AdrenoFirmwareResult;
+
+/* No output entries are changed on failure; *count is then zero.
+ * Zero-size metadata stays opaque, with region_identifier UINT32_MAX.
+ * Success validates structure/ranges, not firmware authenticity or execution.
+ */
+#ifdef __cplusplus
+extern "C" {
+#endif
+AdrenoFirmwareResult AdrenoFirmwarePlanGmu(
+    const uint8_t *firmware, size_t bytes,
+    const AdrenoFirmwareRegion *regions, size_t region_count,
+    AdrenoFirmwareBlock *blocks, size_t capacity, size_t *count);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/AdrenoHfi.c b/iokit/Kernel/arm/a740/AdrenoHfi.c
new file mode 100644
index 0000000..a398d2f
--- /dev/null
+++ b/iokit/Kernel/arm/a740/AdrenoHfi.c
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* HFI wire facts from the source pinned by the umbrella. No Linux runtime. */
+#include "AdrenoHfi.h"
+#if !defined(__aarch64__) || __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error Modern GMU HFI transport requires little-endian AArch64
+#endif
+#define WORDS 1024u
+static void acquire(void){__asm__ volatile("dmb oshld":::"memory");}
+static void publish(void){__asm__ volatile("dsb oshst":::"memory");}
+static void complete(void){__asm__ volatile("dmb osh":::"memory");}
+static AdrenoHfiStatus poison(AdrenoHfi *h,AdrenoHfiStatus status)
+{h->poisoned=1;return status;}
+static AdrenoHfiStatus valid(AdrenoHfi *h,unsigned q,volatile uint32_t **header,
+    volatile uint32_t **data,uint32_t *read,uint32_t *write)
+{
+    if(!h || !h->shared || !h->notify || !h->iova || (h->iova&4095) ||
+        ((uintptr_t)h->shared&4095))return AdrenoHfiInvalid;
+    if(h->poisoned)return AdrenoHfiPoisoned;
+    volatile uint32_t *m=h->shared;acquire();
+    if(m[0]!=0 || m[1]!=168 || m[2]!=6 || m[3]!=12 || m[4]!=3 || m[5]!=3)
+        return poison(h,AdrenoHfiCorrupt);
+    volatile uint32_t *v=m+6+12*q;
+    if(v[0]!=1 || v[1]!=h->iova+(q+1)*4096 || v[2]!=(0xa00|q) ||
+        v[3]!=WORDS || v[4]!=0)return poison(h,AdrenoHfiCorrupt);
+    *read=v[10];*write=v[11];acquire();
+    if(*read>=WORDS || *write>=WORDS || (*read&3) || (*write&3))return poison(h,AdrenoHfiCorrupt);
+    *header=v;*data=m+(q+1)*WORDS;return AdrenoHfiSuccess;
+}
+AdrenoHfiStatus AdrenoHfiInitializeStopped(AdrenoHfi *h,volatile uint32_t *shared,
+    size_t bytes,uint64_t iova,void *cookie,int (*notify)(void *))
+{
+    if(!h || !shared || !notify || bytes!=16384 || ((uintptr_t)shared&4095) ||
+        (uintptr_t)shared>UINTPTR_MAX-16383 || !iova || (iova&4095) || iova>UINT32_MAX-16383)
+        return AdrenoHfiInvalid;
+    for(unsigned i=0;i<4096;++i)shared[i]=0;
+    shared[1]=168;shared[2]=6;shared[3]=12;shared[4]=3;shared[5]=3;
+    for(unsigned q=0;q<3;++q) {
+        volatile uint32_t *v=shared+6+12*q;
+        v[0]=1;v[1]=(uint32_t)iova+(q+1)*4096;v[2]=0xa00|q;v[3]=WORDS;
+        v[6]=1;v[7]=1;v[8]=1;
+    }
+    publish();
+    *h=(AdrenoHfi){shared,(uint32_t)iova,0,0,0,cookie,notify,0,0,0,0};
+    return AdrenoHfiSuccess;
+}
+AdrenoHfiStatus AdrenoHfiSend(AdrenoHfi *h,unsigned id,const uint32_t *payload,
+    size_t words,uint32_t *wire_header)
+{
+    if(!wire_header || id>255 || words>254 || (words && !payload))return AdrenoHfiInvalid;
+    volatile uint32_t *v,*data;uint32_t read,write;
+    AdrenoHfiStatus status=valid(h,0,&v,&data,&read,&write);
+    if(status!=AdrenoHfiSuccess)return status;
+    if(h->pending_header)return AdrenoHfiBusy;
+    unsigned count=(unsigned)words+1,padded=(count+3)&~3u;
+    if(((read-write-1)&(WORDS-1))<padded)return AdrenoHfiNoSpace;
+    uint32_t sequence=(h->sequence+1)%4095;
+    uint32_t header=(sequence<<20)|(count<<8)|id;
+    data[write]=header;
+    for(unsigned i=0;i<words;++i)data[(write+1+i)&(WORDS-1)]=payload[i];
+    for(unsigned i=count;i<padded;++i)data[(write+i)&(WORDS-1)]=UINT32_C(0xfafafafa);
+    publish();v[11]=(write+padded)&(WORDS-1);publish();
+    h->pending_header=header;h->sequence=sequence;*wire_header=header;
+    if(h->notify(h->cookie))return poison(h,AdrenoHfiNotifyError);
+    return AdrenoHfiSuccess;
+}
+AdrenoHfiStatus AdrenoHfiPoll(AdrenoHfi *h,uint32_t *payload,size_t capacity,
+    size_t *payload_words,uint32_t *error)
+{
+    if(!payload || capacity<16 || !payload_words || !error)return AdrenoHfiInvalid;
+    *payload_words=0;*error=0;
+    volatile uint32_t *v,*data;uint32_t read,write;
+    AdrenoHfiStatus status=valid(h,1,&v,&data,&read,&write);
+    if(status!=AdrenoHfiSuccess)return status;
+    if(!h->pending_header)return AdrenoHfiInvalid;
+    /* A ring holds at most WORDS/4 packets; each pass consumes one. */
+    for(unsigned pass=0;pass<WORDS/4;++pass) {
+        if(read==write) {v[8]=1;publish();return AdrenoHfiEmpty;}
+        uint32_t packet[19];uint32_t header=data[read];unsigned count=(header>>8)&255;
+        unsigned available=(write-read)&(WORDS-1),padded=(count+3)&~3u;
+        if(!count || count>19 || padded>available)return poison(h,AdrenoHfiCorrupt);
+        for(unsigned i=0;i<count;++i)packet[i]=data[(read+i)&(WORDS-1)];
+        complete();
+        const int firmware_error=(header&255)==100;
+        const int match=!firmware_error && count>=3 && (packet[1]>>20)==(h->pending_header>>20);
+        if(!match) {
+            if(count<2)return poison(h,AdrenoHfiCorrupt);
+            if(!h->skipped++) {h->skipped_header=header;h->skipped_ret=packet[1];h->skipped_code=count>2?packet[2]:0;}
+            read=(read+padded)&(WORDS-1);v[10]=read;publish();
+            continue;
+        }
+        if(packet[2]) {*error=packet[2];return poison(h,AdrenoHfiFirmwareError);}
+        /* Copy only the checked matching response, never padding. This is not
+         * cryptographic authentication of firmware or its response. */
+        for(unsigned i=3;i<count;++i)payload[i-3]=packet[i];
+        complete();v[10]=(read+padded)&(WORDS-1);publish();
+        h->pending_header=0;*payload_words=count-3;return AdrenoHfiSuccess;
+    }
+    return poison(h,AdrenoHfiCorrupt);
+}
+AdrenoHfiStatus AdrenoHfiExchange(AdrenoHfi *h,unsigned id,const uint32_t *input,
+    size_t words,unsigned budget,int (*wait_once)(void *),uint32_t *output,
+    size_t capacity,size_t *count,uint32_t *error)
+{
+    if(!budget || budget>1048576 || !output || capacity<16 || !count || !error)
+        return AdrenoHfiInvalid;
+    *count=0;*error=0;uint32_t header;
+    AdrenoHfiStatus status=AdrenoHfiSend(h,id,input,words,&header);
+    if(status!=AdrenoHfiSuccess)return status;
+    for(unsigned i=0;i<budget;++i) {
+        status=AdrenoHfiPoll(h,output,capacity,count,error);
+        if(status!=AdrenoHfiEmpty)return status;
+        if(i+1<budget && wait_once && wait_once(h->cookie))return poison(h,AdrenoHfiWaitError);
+    }
+    return poison(h,AdrenoHfiTimeout);
+}
diff --git a/iokit/Kernel/arm/a740/AdrenoHfi.h b/iokit/Kernel/arm/a740/AdrenoHfi.h
new file mode 100644
index 0000000..15986b5
--- /dev/null
+++ b/iokit/Kernel/arm/a740/AdrenoHfi.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef ADRENO_HFI_H
+#define ADRENO_HFI_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef enum {
+    AdrenoHfiSuccess,AdrenoHfiInvalid,AdrenoHfiBusy,AdrenoHfiNoSpace,
+    AdrenoHfiEmpty,AdrenoHfiCorrupt,AdrenoHfiUnexpected,AdrenoHfiFirmwareError,
+    AdrenoHfiNotifyError,AdrenoHfiWaitError,AdrenoHfiTimeout,AdrenoHfiPoisoned
+} AdrenoHfiStatus;
+typedef struct {
+    volatile uint32_t *shared;
+    uint32_t iova,sequence,pending_header,poisoned;
+    void *cookie;
+    int (*notify)(void *); /* real HOST2GMU interrupt write, 0=success */
+    /* Diagnostics of skipped response packets (a6xx_hfi_wait_for_ack skips firmware error messages and replies to
+     * another sequence number): their count and the first one's header, return header and code. */
+    uint32_t skipped,skipped_header,skipped_ret,skipped_code;
+} AdrenoHfi;
+/* Modern (nonlegacy) GMU HFI only. Caller owns an exclusive, 16KiB extent
+ * mapped with four native4K pages, coherent for CPU and GMU, and a valid 32bit
+ * GMU IOVA. Coherence, ownership and active mappings are platform obligations,
+ * not established by this API. The GMU MUST be stopped and unable to access
+ * this extent during initialization. No reset of a running queue is allowed.
+ * AArch64 little-endian; real outer-shareable barriers, no fake ACKs.
+ * All calls on an instance are serialized by the caller. Shared memory,
+ * object and message/output storage must be disjoint and remain owned.
+ * Never free/reuse shared storage until an external real stop+TLB drain is
+ * proved. Poison/timeout/notify failure do not establish safe release. */
+AdrenoHfiStatus AdrenoHfiInitializeStopped(AdrenoHfi *,volatile uint32_t *,
+    size_t shared_bytes,uint64_t iova,void *cookie,int (*notify)(void *));
+/* payload excludes the wire header. One command may be outstanding. A failed
+ * notify after publishing is indeterminate: poisons the session, no retry.
+ * NoSpace/Busy refuse before publishing. No firmware readiness is inferred. */
+AdrenoHfiStatus AdrenoHfiSend(AdrenoHfi *,unsigned id,const uint32_t *payload,
+    size_t payload_words,uint32_t *wire_header);
+/* Poll the response queue. As a6xx_hfi_wait_for_ack: the reply whose return
+ * header carries the pending command's sequence number completes it (error=0
+ * succeeds, otherwise FirmwareError); F2H error messages and replies to other
+ * sequence numbers are consumed, counted and skipped. payload_words reports
+ * actual returned words; output remains untouched on failure. Capacity must be
+ * >=16, the protocol's maximum ACK payload. Empty keeps the pending command.
+ * Malformed queues or packets poison the session; no success or queue reset is
+ * synthesized. Debug queue not drained. */
+AdrenoHfiStatus AdrenoHfiPoll(AdrenoHfi *,uint32_t *payload,size_t capacity,
+    size_t *payload_words,uint32_t *firmware_error);
+/* Serialized command + bounded response polling. Poll budget limits software
+ * iterations, not hardware elapsed microseconds. Optional wait callback must
+ * return promptly; an error poisons the session. Timeout also poisons it.
+ * This transport alone performs no power/firmware/performance-table startup. */
+AdrenoHfiStatus AdrenoHfiExchange(AdrenoHfi *,unsigned id,const uint32_t *,size_t,
+    unsigned poll_budget,int (*wait_once)(void *),uint32_t *,size_t,
+    size_t *,uint32_t *firmware_error);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/AdrenoHfiStartup.c b/iokit/Kernel/arm/a740/AdrenoHfiStartup.c
new file mode 100644
index 0000000..a136768
--- /dev/null
+++ b/iokit/Kernel/arm/a740/AdrenoHfiStartup.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Independent serialization from the pinned modern HFI wire contract. */
+#include "AdrenoHfiStartup.h"
+static int zero(const uint32_t *v,size_t n)
+{for(size_t i=0;i<n;++i)if(v[i])return 0;return 1;}
+static int levels(const AdrenoHfiPerformanceLevel *v,unsigned n,unsigned max)
+{
+    if(n<2 || n>max || v[0].hz)return 0;
+    for(unsigned i=0;i<n;++i)
+        if(v[i].hz%1000 || v[i].hz/1000>UINT32_MAX || (i && v[i].hz<=v[i-1].hz))return 0;
+    for(unsigned i=n;i<max;++i)if(v[i].hz || v[i].vote)return 0;
+    return 1;
+}
+static int addresses(const uint32_t *v,unsigned n,unsigned max)
+{
+    if(!n || n>max)return 0;
+    for(unsigned i=0;i<n;++i) {
+        if(!v[i] || (v[i]&3))return 0;
+        for(unsigned j=0;j<i;++j)if(v[i]==v[j])return 0;
+    }
+    return zero(v+n,max-n);
+}
+AdrenoHfiStartupStatus AdrenoHfiStartupValidate(const AdrenoHfiStartupConfig *c)
+{
+    if(!c || !levels(c->gpu,c->gpu_count,16) || !levels(c->gmu,c->gmu_count,4) ||
+        !c->bandwidth_count || c->bandwidth_count>16 || c->enable_ifpc>1 ||
+        !addresses(c->cnoc_addresses,c->cnoc_count,6) ||
+        !addresses(c->ddr_addresses,c->ddr_count,8))return AdrenoHfiStartupInvalid;
+    if(c->cnoc_wait_mask>>c->cnoc_count || c->ddr_wait_mask>>c->ddr_count)return AdrenoHfiStartupInvalid;
+    for(unsigned i=0;i<c->cnoc_count;++i)
+        for(unsigned j=0;j<c->ddr_count;++j)if(c->cnoc_addresses[i]==c->ddr_addresses[j])return AdrenoHfiStartupInvalid;
+    for(unsigned i=0;i<2;++i)if(!zero(c->cnoc_data[i]+c->cnoc_count,6-c->cnoc_count))return AdrenoHfiStartupInvalid;
+    for(unsigned i=0;i<16;++i)
+        if(!zero(c->ddr_data[i]+(i<c->bandwidth_count?c->ddr_count:0),
+            8-(i<c->bandwidth_count?c->ddr_count:0)))return AdrenoHfiStartupInvalid;
+    if(!c->acd_enable_mask) {
+        if(c->acd_version || c->acd_stride || c->acd_count || !zero(c->acd_data,32))return AdrenoHfiStartupInvalid;
+    } else {
+        if(c->acd_version!=1 || c->acd_stride!=1 || (c->acd_enable_mask&1) ||
+            c->acd_enable_mask>>c->gpu_count)return AdrenoHfiStartupInvalid;
+        unsigned count=0;
+        for(uint32_t bits=c->acd_enable_mask;bits;bits>>=1)count+=bits&1;
+        if(c->acd_count!=count || !zero(c->acd_data+count,32-count))return AdrenoHfiStartupInvalid;
+    }
+    return AdrenoHfiStartupSuccess;
+}
+AdrenoHfiStartupStatus AdrenoHfiStartupEncode(const AdrenoHfiStartupConfig *c,
+    AdrenoHfiStartupStage stage,uint32_t *id,uint32_t *p,size_t capacity,size_t *count)
+{
+    if(!count)return AdrenoHfiStartupInvalid;
+    *count=0;
+    if(!id || !p || capacity<159 || AdrenoHfiStartupValidate(c)!=AdrenoHfiStartupSuccess ||
+        stage<AdrenoHfiStagePerformance || stage>AdrenoHfiStageStart ||
+        ((stage==AdrenoHfiStageAcdEnable || stage==AdrenoHfiStageAcdTable) && !c->acd_enable_mask) ||
+        (stage==AdrenoHfiStageIfpc && !c->enable_ifpc))return AdrenoHfiStartupInvalid;
+    size_t n=0;unsigned message=0;
+    switch(stage) {
+    case AdrenoHfiStagePerformance:
+        message=4;n=58;
+        for(size_t i=0;i<n;++i)p[i]=0;
+        p[0]=c->gpu_count;p[1]=c->gmu_count;
+        for(unsigned i=0;i<c->gpu_count;++i) {
+            p[2+3*i]=c->gpu[i].vote;p[3+3*i]=UINT32_MAX;p[4+3*i]=(uint32_t)(c->gpu[i].hz/1000);
+        }
+        for(unsigned i=0;i<c->gmu_count;++i) {
+            p[50+2*i]=c->gmu[i].vote;p[51+2*i]=(uint32_t)(c->gmu[i].hz/1000);
+        }
+        break;
+    case AdrenoHfiStageBandwidth:
+        message=3;n=159;
+        p[0]=c->bandwidth_count;p[1]=c->cnoc_count;p[2]=c->ddr_count;
+        p[3]=c->cnoc_wait_mask;p[4]=c->ddr_wait_mask;
+        for(unsigned i=0;i<6;++i)p[5+i]=c->cnoc_addresses[i];
+        for(unsigned i=0;i<12;++i)p[11+i]=c->cnoc_data[i/6][i%6];
+        for(unsigned i=0;i<8;++i)p[23+i]=c->ddr_addresses[i];
+        for(unsigned i=0;i<128;++i)p[31+i]=c->ddr_data[i/8][i%8];
+        break;
+    case AdrenoHfiStageAcdEnable:message=11;n=3;p[0]=12;p[1]=1;p[2]=0;break;
+    case AdrenoHfiStageAcdTable:
+        message=7;n=36;p[0]=c->acd_version;p[1]=c->acd_enable_mask;p[2]=c->acd_stride;p[3]=c->acd_count;
+        for(unsigned i=0;i<32;++i)p[4+i]=c->acd_data[i];
+        break;
+    case AdrenoHfiStageIfpc:message=11;n=3;p[0]=9;p[1]=1;p[2]=0x1680;break;
+    case AdrenoHfiStageCoreStart:message=14;n=1;p[0]=0;break;
+    case AdrenoHfiStageStart:message=10;n=0;break;
+    default:return AdrenoHfiStartupInvalid;
+    }
+    *id=message;*count=n;return AdrenoHfiStartupSuccess;
+}
+AdrenoHfiStartupStatus AdrenoHfiStartupValidateServices(const AdrenoHfiStartupServices *s)
+{
+    if(!s || !s->now_us || !s->wait_us || !s->check_health ||
+        !s->polls_per_command || s->polls_per_command>1048576 ||
+        !s->wait_interval_us || s->wait_interval_us>1000000 ||
+        !s->command_timeout_us || s->command_timeout_us>10000000 ||
+        s->total_timeout_us<s->command_timeout_us || s->total_timeout_us>60000000)
+        return AdrenoHfiStartupInvalid;
+    return AdrenoHfiStartupSuccess;
+}
+static AdrenoHfiStartupStatus clock_check(const AdrenoHfiStartupServices *s,
+    uint64_t begin,uint64_t command,uint64_t *last,AdrenoHfiStartupResult *r)
+{
+    uint64_t now;
+    if(s->now_us(s->cookie,&now) || now<*last)return AdrenoHfiStartupClockError;
+    *last=now;r->elapsed_us=now-begin;
+    if(now-begin>=s->total_timeout_us || now-command>=s->command_timeout_us)return AdrenoHfiStartupTimeout;
+    return AdrenoHfiStartupSuccess;
+}
+AdrenoHfiStartupStatus AdrenoHfiStartupRun(AdrenoHfiStartup *state,AdrenoHfi *h,
+    const AdrenoHfiStartupConfig *c,const AdrenoHfiStartupServices *s,AdrenoHfiStartupResult *r)
+{
+    if(!r)return AdrenoHfiStartupInvalid;
+    *r=(AdrenoHfiStartupResult){0};r->resources_must_retain=1;
+    if(!state || !h || AdrenoHfiStartupValidateServices(s)!=AdrenoHfiStartupSuccess ||
+        AdrenoHfiStartupValidate(c)!=AdrenoHfiStartupSuccess)return AdrenoHfiStartupInvalid;
+    if(state->poisoned || h->poisoned)return AdrenoHfiStartupPoisoned;
+    if(state->attempted || state->completed || h->pending_header)return AdrenoHfiStartupBusy;
+    uint64_t begin,last,command;
+    if(s->now_us(s->cookie,&begin))return AdrenoHfiStartupClockError;
+    last=begin;
+    if(s->check_health(s->cookie))return AdrenoHfiStartupPlatformFault;
+    state->attempted=1;
+    AdrenoHfiStartupStatus status=AdrenoHfiStartupSuccess;
+    uint32_t payload[159],output[16],id;size_t words,returned;
+    for(unsigned step=AdrenoHfiStagePerformance;step<=AdrenoHfiStageStart;++step) {
+        if((step==AdrenoHfiStageAcdEnable || step==AdrenoHfiStageAcdTable) && !c->acd_enable_mask)continue;
+        if(step==AdrenoHfiStageIfpc && !c->enable_ifpc)continue;
+        r->stage=(AdrenoHfiStartupStage)step;command=last;
+        status=clock_check(s,begin,command,&last,r);if(status)goto failed;
+        if(s->check_health(s->cookie)) {status=AdrenoHfiStartupPlatformFault;goto failed;}
+        status=AdrenoHfiStartupEncode(c,r->stage,&id,payload,159,&words);if(status)goto failed;
+        r->wire_header=0;
+        r->transport_status=AdrenoHfiSend(h,id,payload,words,&r->wire_header);
+        if(r->wire_header)++r->published_commands;
+        if(r->transport_status!=AdrenoHfiSuccess) {status=AdrenoHfiStartupTransportError;goto failed;}
+        unsigned acknowledged=0;
+        for(unsigned i=0;i<s->polls_per_command;++i) {
+            status=clock_check(s,begin,command,&last,r);if(status)goto failed;
+            if(s->check_health(s->cookie)) {status=AdrenoHfiStartupPlatformFault;goto failed;}
+            ++r->poll_reads;
+            r->transport_status=AdrenoHfiPoll(h,output,16,&returned,&r->firmware_error);
+            if(r->transport_status==AdrenoHfiSuccess) {
+                status=clock_check(s,begin,command,&last,r);if(status)goto failed;
+                if(s->check_health(s->cookie)) {status=AdrenoHfiStartupPlatformFault;goto failed;}
+                r->acknowledged_stages|=1u<<step;acknowledged=1;break;
+            }
+            if(r->transport_status!=AdrenoHfiEmpty) {status=AdrenoHfiStartupTransportError;goto failed;}
+            if(i+1<s->polls_per_command && s->wait_us(s->cookie,s->wait_interval_us)) {
+                status=AdrenoHfiStartupWaitError;goto failed;
+            }
+        }
+        if(!acknowledged) {status=AdrenoHfiStartupTimeout;goto failed;}
+    }
+    state->completed=1;r->stage=AdrenoHfiStageComplete;return AdrenoHfiStartupSuccess;
+failed:
+    state->poisoned=1;h->poisoned=1;return status;
+}
diff --git a/iokit/Kernel/arm/a740/AdrenoHfiStartup.h b/iokit/Kernel/arm/a740/AdrenoHfiStartup.h
new file mode 100644
index 0000000..0496c6f
--- /dev/null
+++ b/iokit/Kernel/arm/a740/AdrenoHfiStartup.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef ADRENO_HFI_STARTUP_H
+#define ADRENO_HFI_STARTUP_H
+#include "AdrenoHfi.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Modern A6xx/A7xx wire profile. Legacy and A8xx table formats are excluded. */
+typedef struct {uint64_t hz;uint32_t vote;} AdrenoHfiPerformanceLevel;
+typedef struct {
+    unsigned gpu_count,gmu_count;
+    AdrenoHfiPerformanceLevel gpu[16],gmu[4];
+    unsigned bandwidth_count,cnoc_count,ddr_count;
+    uint32_t cnoc_wait_mask,ddr_wait_mask;
+    uint32_t cnoc_addresses[6],cnoc_data[2][6];
+    uint32_t ddr_addresses[8],ddr_data[16][8];
+    uint32_t acd_version,acd_enable_mask,acd_stride,acd_count,acd_data[32];
+    unsigned enable_ifpc;
+} AdrenoHfiStartupConfig;
+typedef enum {
+    AdrenoHfiStageNone,AdrenoHfiStagePerformance,AdrenoHfiStageBandwidth,
+    AdrenoHfiStageAcdEnable,AdrenoHfiStageAcdTable,AdrenoHfiStageIfpc,
+    AdrenoHfiStageCoreStart,AdrenoHfiStageStart,AdrenoHfiStageComplete
+} AdrenoHfiStartupStage;
+typedef enum {
+    AdrenoHfiStartupSuccess,AdrenoHfiStartupInvalid,AdrenoHfiStartupBusy,
+    AdrenoHfiStartupPoisoned,AdrenoHfiStartupClockError,AdrenoHfiStartupWaitError,
+    AdrenoHfiStartupTimeout,AdrenoHfiStartupPlatformFault,AdrenoHfiStartupTransportError
+} AdrenoHfiStartupStatus;
+typedef struct {
+    void *cookie;
+    int (*now_us)(void *,uint64_t *);
+    int (*wait_us)(void *,unsigned);
+    int (*check_health)(void *); /* real platform fault/ownership checks */
+    unsigned polls_per_command,wait_interval_us;
+    uint64_t command_timeout_us,total_timeout_us;
+} AdrenoHfiStartupServices;
+typedef struct {unsigned attempted,poisoned,completed;} AdrenoHfiStartup;
+typedef struct {
+    AdrenoHfiStartupStage stage;
+    AdrenoHfiStatus transport_status;
+    uint32_t firmware_error,wire_header,acknowledged_stages;
+    unsigned published_commands,poll_reads,resources_must_retain;
+    uint64_t elapsed_us;
+} AdrenoHfiStartupResult;
+/* Validate every input before any queue publication. Frequencies include the
+ * zero/off entry, are strictly ascending, exactly representable in wire kHz.
+ * Votes and command-db addresses are trusted platform inputs, never guessed
+ * by this library. ACD entries are packed for each enabled GPU level; AOSS
+ * notification and IFPC power prerequisites must already be established.
+ * Unused fixed-capacity slots must be zero. This prevents silently ignoring
+ * unsupported or malformed configuration. No input is authenticated here. */
+AdrenoHfiStartupStatus AdrenoHfiStartupValidate(const AdrenoHfiStartupConfig *);
+AdrenoHfiStartupStatus AdrenoHfiStartupValidateServices(const AdrenoHfiStartupServices *);
+/* Payload excludes header. All output storage must be disjoint from inputs.
+ * Encodes one selected stage; unused optional stages refuse. Failure leaves
+ * payload/header outputs untouched except word_count=0. Capacity >=159. */
+AdrenoHfiStartupStatus AdrenoHfiStartupEncode(const AdrenoHfiStartupConfig *,
+    AdrenoHfiStartupStage,uint32_t *id,uint32_t *payload,size_t capacity,size_t *word_count);
+/* Single attempt, serialized, caller-owned zero-initialized state. Requires
+ * a real ready GMU, exclusive coherent HFI allocation and active native4K GMU
+ * mappings. Only matching actual ACKs advance the startup sequence. All
+ * commands and the whole sequence have monotonic-time AND iteration bounds.
+ * Callback operations must themselves be bounded. On any attempted-sequence
+ * failure the transport is poisoned; no replay, synthetic ACK or implicit
+ * stop occurs. Even success does not authorize resource release or prove GPU
+ * execution, power/coherence/SMMU readiness, shader submission or a desktop.
+ * Input, state, services, transport, result and shared queues must remain
+ * disjoint and pinned; config remains immutable throughout the sequence. */
+AdrenoHfiStartupStatus AdrenoHfiStartupRun(AdrenoHfiStartup *,AdrenoHfi *,
+    const AdrenoHfiStartupConfig *,const AdrenoHfiStartupServices *,AdrenoHfiStartupResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/AdrenoHfiVotes.c b/iokit/Kernel/arm/a740/AdrenoHfiVotes.c
new file mode 100644
index 0000000..f3ce145
--- /dev/null
+++ b/iokit/Kernel/arm/a740/AdrenoHfiVotes.c
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "AdrenoHfiVotes.h"
+static uint16_t le16(const uint8_t *p){return (uint16_t)(p[0]|(uint16_t)p[1]<<8);}
+static uint32_t le32(const uint8_t *p){return le16(p)|(uint32_t)le16(p+2)<<16;}
+static int rail(const uint8_t *p,size_t bytes)
+{
+    if(!p || !bytes || (bytes&1) || bytes>512 || le16(p))return 0;
+    unsigned padding=0;uint16_t last=0;
+    for(size_t i=2;i<bytes;i+=2) {
+        uint16_t value=le16(p+i);
+        if(!value)padding=1;
+        else if(padding || value<last)return 0;
+        last=value;
+    }
+    return 1;
+}
+AdrenoHfiStartupStatus AdrenoHfiArcVotes(const uint32_t *levels,size_t count,
+    const uint8_t *primary,size_t primary_bytes,const uint8_t *secondary,size_t secondary_bytes,
+    uint32_t *votes,size_t capacity)
+{
+    if(!levels || !votes || !count || count>16 || capacity<count || levels[0] ||
+        !rail(primary,primary_bytes) || !rail(secondary,secondary_bytes))return AdrenoHfiStartupInvalid;
+    uint32_t result[16];
+    for(size_t i=0;i<count;++i) {
+        if(levels[i]>UINT16_MAX || (i && levels[i]<levels[i-1]))return AdrenoHfiStartupInvalid;
+        size_t p=0,s=0;
+        while(p<primary_bytes/2 && le16(primary+2*p)<levels[i])++p;
+        if(p==primary_bytes/2)return AdrenoHfiStartupInvalid;
+        for(size_t j=0;j<secondary_bytes/2;++j) {
+            uint16_t value=le16(secondary+2*j);
+            if(value>=levels[i]) {s=j;break;}
+            if(value)s=j;
+        }
+        result[i]=(uint32_t)le16(primary+2*p)<<16 | (uint32_t)s<<8 | (uint32_t)p;
+    }
+    for(size_t i=0;i<count;++i)votes[i]=result[i];
+    return AdrenoHfiStartupSuccess;
+}
+AdrenoHfiStartupStatus AdrenoHfiBcmAux(AdrenoHfiBcm *b,const uint8_t *p,size_t bytes)
+{
+    if(!b || !p || bytes!=8 || p[7])return AdrenoHfiStartupInvalid;
+    b->unit=le32(p);b->width=le16(p+4);b->vcd=p[6];return AdrenoHfiStartupSuccess;
+}
+static int address(uint32_t a){return a && !(a&3);}
+AdrenoHfiStartupStatus AdrenoHfiBuildBandwidth(const uint32_t *kbps,size_t count,
+    const AdrenoHfiBcm *bcms,size_t n,uint32_t cn0,AdrenoHfiStartupConfig *c)
+{
+    if(!c || !kbps || !bcms || !count || count>16 || kbps[0] || !n || n>3 || !address(cn0))
+        return AdrenoHfiStartupInvalid;
+    for(size_t i=1;i<count;++i)if(kbps[i]<=kbps[i-1])return AdrenoHfiStartupInvalid;
+    for(size_t j=0;j<n;++j) {
+        const AdrenoHfiBcm *b=bcms+j;
+        if(!address(b->address) || b->address==cn0 || b->fixed>1 || b->perfmode>0x3fff ||
+            (!b->fixed && (!b->unit || !b->width || !b->buswidth || b->perfmode || b->perfmode_kbps)))
+            return AdrenoHfiStartupInvalid;
+        for(size_t k=0;k<j;++k)if(b->address==bcms[k].address)return AdrenoHfiStartupInvalid;
+    }
+    /* All input validation is finished before changing caller storage. */
+    c->bandwidth_count=(unsigned)count;c->cnoc_count=1;c->ddr_count=(unsigned)n;
+    c->cnoc_wait_mask=1;c->ddr_wait_mask=0;
+    for(size_t i=0;i<6;++i) {
+        c->cnoc_addresses[i]=i?0:cn0;c->cnoc_data[0][i]=i?0:0x40000000;
+        c->cnoc_data[1][i]=i?0:0x60000001;
+    }
+    for(size_t j=0;j<8;++j) {
+        c->ddr_addresses[j]=j<n?bcms[j].address:0;
+        unsigned commit=j<n && (j+1==n || bcms[j].vcd!=bcms[j+1].vcd);
+        if(commit)c->ddr_wait_mask|=1u<<j;
+        for(size_t i=0;i<16;++i) {
+            uint32_t data=0;
+            if(i<count && j<n) {
+                const AdrenoHfiBcm *b=bcms+j;data=commit?0x40000000:0;
+                if(kbps[i]) {
+                    data|=0x20000000;
+                    if(b->fixed) {
+                        if(b->perfmode_kbps && kbps[i]>=b->perfmode_kbps)data|=b->perfmode;
+                    } else {
+                        uint64_t peak=(uint64_t)kbps[i]*b->width/b->buswidth;
+                        peak=peak*1000/b->unit;
+                        uint32_t vote=peak>0x3fff?0x3fff:peak?(uint32_t)peak:1;
+                        data|=vote<<14|vote;
+                    }
+                }
+            }
+            c->ddr_data[i][j]=data;
+        }
+    }
+    return AdrenoHfiStartupSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/AdrenoHfiVotes.h b/iokit/Kernel/arm/a740/AdrenoHfiVotes.h
new file mode 100644
index 0000000..48081ff
--- /dev/null
+++ b/iokit/Kernel/arm/a740/AdrenoHfiVotes.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef ADRENO_HFI_VOTES_H
+#define ADRENO_HFI_VOTES_H
+#include "AdrenoHfiStartup.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* CPU-side generation only, no RPMh transaction or power transition.
+ * Input levels are from exact enabled OPPs (including off=0), not frequencies
+ * or voltages. Rail byte spans are original little-endian cmd-db aux data.
+ * Caller selects actual primary/secondary rails (including GMxC discovery).
+ * Rail profile: off at entry zero, ascending active levels (duplicates allowed),
+ * optional zero padding at the end. Other profiles explicitly refuse.
+ * Supports <=256 rail entries, <=16 OPPs; no truncation or guessed fallback.
+ * Output remains unchanged on failure. Inputs/outputs must be disjoint and
+ * immutable during calls. Successful arithmetic does not authenticate inputs. */
+AdrenoHfiStartupStatus AdrenoHfiArcVotes(const uint32_t *levels,size_t level_count,
+    const uint8_t *primary,size_t primary_bytes,const uint8_t *secondary,size_t secondary_bytes,
+    uint32_t *votes,size_t capacity);
+typedef struct {
+    uint32_t address,unit;
+    uint16_t width,buswidth;
+    uint8_t vcd,fixed;
+    uint16_t perfmode;
+    uint32_t perfmode_kbps;
+} AdrenoHfiBcm;
+/* Decode exactly eight bytes of BCM aux data; address/buswidth/fixed/perfmode
+ * are separately supplied source/platform policy and are preserved. */
+AdrenoHfiStartupStatus AdrenoHfiBcmAux(AdrenoHfiBcm *,const uint8_t *,size_t);
+/* A7xx BCM arithmetic and modern HFI bandwidth layout. Off=0, then strictly
+ * ascending KB/s OPP bandwidths, <=16. Up to three platform-ordered BCMs;
+ * CN0 address must come from command-db. No source fallback address exists.
+ * Unit/width come from BCM aux; buswidth/fixed/perfmode from target catalog.
+ * Fills only bandwidth-related config fields, preserving performance/features.
+ * Failure leaves the entire config unchanged. Success requires no HFI/device.
+ * Does not validate actual rail/BCM ownership, limits, speed bin or power. */
+AdrenoHfiStartupStatus AdrenoHfiBuildBandwidth(const uint32_t *kbps,size_t level_count,
+    const AdrenoHfiBcm *bcms,size_t bcm_count,uint32_t cn0_address,AdrenoHfiStartupConfig *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/AdrenoPM4.c b/iokit/Kernel/arm/a740/AdrenoPM4.c
new file mode 100644
index 0000000..12b2936
--- /dev/null
+++ b/iokit/Kernel/arm/a740/AdrenoPM4.c
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: MIT */
+#include "AdrenoPM4.h"
+
+/* Add one bit to make the field's total population odd. */
+static uint32_t odd_bit(uint32_t field)
+{
+    uint32_t parity = 1;
+    while (field) {
+        parity ^= 1;
+        field &= field - 1;
+    }
+    return parity;
+}
+
+AdrenoPM4Status AdrenoPM4Type4(uint32_t reg, uint32_t count, uint32_t *header)
+{
+    if (!header || reg > 0x3ffff || !count || count > 127 ||
+        count - 1 > 0x3ffff - reg)
+        return AdrenoPM4InvalidArgument;
+    *header = 0x40000000u | count | (odd_bit(count) << 7) |
+        (reg << 8) | (odd_bit(reg) << 27);
+    return AdrenoPM4Success;
+}
+
+AdrenoPM4Status AdrenoPM4Type7(uint32_t opcode, uint32_t count, uint32_t *header)
+{
+    if (!header || opcode > 127 || count > 0x3fff)
+        return AdrenoPM4InvalidArgument;
+    *header = 0x70000000u | count | (odd_bit(count) << 15) |
+        (opcode << 16) | (odd_bit(opcode) << 23);
+    return AdrenoPM4Success;
+}
+
+static AdrenoPM4Status decode(uint32_t word, AdrenoPM4Packet *packet)
+{
+    uint32_t rebuilt;
+    AdrenoPM4Status status;
+    packet->type = word >> 28;
+    if (packet->type == 4) {
+        packet->identifier = (word >> 8) & 0x3ffff;
+        packet->payload_words = word & 127;
+        status = AdrenoPM4Type4(packet->identifier, packet->payload_words, &rebuilt);
+    } else if (packet->type == 7) {
+        packet->identifier = (word >> 16) & 127;
+        packet->payload_words = word & 0x3fff;
+        status = AdrenoPM4Type7(packet->identifier, packet->payload_words, &rebuilt);
+    } else {
+        return AdrenoPM4InvalidHeader;
+    }
+    if (status != AdrenoPM4Success || rebuilt != word)
+        return AdrenoPM4InvalidHeader;
+    return AdrenoPM4Success;
+}
+
+AdrenoPM4Status AdrenoPM4Plan(const uint32_t *words, size_t word_count,
+    AdrenoPM4Packet *output, size_t capacity, size_t *count)
+{
+    size_t at = 0, packets = 0;
+    AdrenoPM4Packet packet;
+    if (!count)
+        return AdrenoPM4InvalidArgument;
+    *count = 0;
+    if ((word_count && !words) || (capacity && !output) ||
+        word_count > SIZE_MAX / sizeof(*words) || capacity > SIZE_MAX / sizeof(*output))
+        return AdrenoPM4InvalidArgument;
+    while (at < word_count) {
+        AdrenoPM4Status status = decode(words[at], &packet);
+        if (status != AdrenoPM4Success)
+            return status;
+        /* Subtraction keeps both bounds checking and the next offset safe. */
+        if (packet.payload_words > word_count - at - 1)
+            return AdrenoPM4Truncated;
+        at += 1 + packet.payload_words;
+        ++packets;
+    }
+    if (packets > capacity)
+        return AdrenoPM4Capacity;
+    at = packets = 0;
+    while (at < word_count) {
+        (void)decode(words[at], &packet); /* Immutable input, already checked. */
+        packet.header_word = at;
+        output[packets++] = packet;
+        at += 1 + packet.payload_words;
+    }
+    *count = packets;
+    return AdrenoPM4Success;
+}
diff --git a/iokit/Kernel/arm/a740/AdrenoPM4.h b/iokit/Kernel/arm/a740/AdrenoPM4.h
new file mode 100644
index 0000000..ceaefa2
--- /dev/null
+++ b/iokit/Kernel/arm/a740/AdrenoPM4.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ADRENO_PM4_H
+#define ADRENO_PM4_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    AdrenoPM4Success = 0,
+    AdrenoPM4InvalidArgument,
+    AdrenoPM4InvalidHeader,
+    AdrenoPM4Truncated,
+    AdrenoPM4Capacity
+} AdrenoPM4Status;
+
+typedef struct {
+    size_t header_word;
+    uint32_t type;          /* 4 (register sequence) or 7 (opcode). */
+    uint32_t identifier;    /* Register index or opcode; NOT authorization. */
+    uint32_t payload_words;
+} AdrenoPM4Packet;
+
+/* Supported emission profile: 18-bit registers, 1..127 values; 7-bit
+ * opcodes, 0..16383 values. No silent masking. Failure preserves *header. */
+AdrenoPM4Status AdrenoPM4Type4(uint32_t reg, uint32_t count, uint32_t *header);
+AdrenoPM4Status AdrenoPM4Type7(uint32_t opcode, uint32_t count, uint32_t *header);
+
+/* Structural decoding only. A successful plan DOES NOT authorize register
+ * writes, addresses, opcodes, indirect buffers or hardware submission.
+ * Input is an immutable array of logical 32-bit words (little-endian on
+ * the target). All extents must be real caller-owned accessible storage.
+ * Input, output and count must not alias; input must remain immutable.
+ * Validate the whole input and capacity before writing any packet record.
+ * On failure, *count=0 and output is untouched. Empty input succeeds.
+ * No allocation, recursion, payload interpretation, MMIO or completion. */
+AdrenoPM4Status AdrenoPM4Plan(const uint32_t *words, size_t word_count,
+    AdrenoPM4Packet *output, size_t capacity, size_t *count);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4K.c b/iokit/Kernel/arm/a740/ArmSmmu4K.c
new file mode 100644
index 0000000..be5f302
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4K.c
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4K.h"
+#define PAGE_BYTES UINT64_C(4096)
+#define ADDRESS_MASK UINT64_C(0x0000fffffffff000)
+
+static ArmSmmu4KStatus build_region(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result, unsigned upper)
+{
+    if (!result) return ArmSmmu4KArgument;
+    result->root_physical = result->mair = 0;
+    result->table_pages = result->leaf_pages = result->start_level = 0;
+    result->upper_region = 0;
+    if (!config || !ranges || !range_count || !tables || !capacity ||
+        capacity > SIZE_MAX / PAGE_BYTES || range_count > SIZE_MAX / sizeof(*ranges) ||
+        config->input_bits < 32 || config->input_bits > 48 ||
+        !(config->output_bits == 32 || config->output_bits == 36 || config->output_bits == 40 ||
+          config->output_bits == 42 || config->output_bits == 44 || config->output_bits == 48) ||
+        !config->leaf_budget || config->leaf_budget > (SIZE_MAX - 1) / 3 ||
+        ((uintptr_t)tables & 7)) return ArmSmmu4KArgument;
+    if (range_count > config->leaf_budget) return ArmSmmu4KBudget;
+    uint64_t input_limit = UINT64_C(1) << config->input_bits;
+    uint64_t output_limit = UINT64_C(1) << config->output_bits;
+    uint64_t pool_bytes = (uint64_t)capacity * PAGE_BYTES;
+    uint64_t pool = config->table_physical;
+    if ((pool & 4095) || pool >= output_limit || pool_bytes > output_limit - pool)
+        return ArmSmmu4KBadRange;
+    size_t leaves = 0;
+    uint64_t previous_end = 0;
+    for (size_t i = 0; i < range_count; ++i) {
+        const ArmSmmu4KRange *r = &ranges[i];
+        if (!r->bytes || ((r->iova | r->physical | r->bytes) & 4095) ||
+            (!(r->permissions & ArmSmmu4KRead) || (r->permissions & ~15u)) || r->writeback > 1 || (r->shareability != 2 && r->shareability != 3) ||
+            r->physical >= output_limit || r->bytes > output_limit - r->physical)
+            return ArmSmmu4KBadRange;
+        if (upper ? (r->iova < UINT64_MAX-input_limit+1 || r->bytes-1 > UINT64_MAX-r->iova) :
+                    (r->iova >= input_limit || r->bytes > input_limit-r->iova))
+            return ArmSmmu4KBadRange;
+        if (i && r->iova <= previous_end) return ArmSmmu4KOverlap;
+        previous_end = r->iova + (r->bytes-1);
+        if (r->physical < pool + pool_bytes && pool < r->physical + r->bytes)
+            return ArmSmmu4KOverlap;
+        for (size_t j = 0; j < i; ++j) {
+            if ((r->writeback != ranges[j].writeback || r->shareability != ranges[j].shareability || ((r->permissions ^ ranges[j].permissions) & ArmSmmu4KPrivileged)) && r->physical < ranges[j].physical + ranges[j].bytes &&
+                ranges[j].physical < r->physical + r->bytes) return ArmSmmu4KOverlap;
+        }
+        uint64_t pages = r->bytes / PAGE_BYTES;
+        if (pages > config->leaf_budget - leaves) return ArmSmmu4KBudget;
+        leaves += (size_t)pages;
+    }
+    /* Each range has at least one leaf, so the validated leaf budget also
+     * bounds the range/alias loops. Sorted IOVAs make prefix counting exact. */
+    unsigned levels = (config->input_bits - 12 + 8) / 9;
+    unsigned start = 4 - levels;
+    size_t required = 1;
+    uint64_t last[3] = {UINT64_MAX, UINT64_MAX, UINT64_MAX};
+    for (size_t i = 0; i < range_count; ++i) {
+        for (uint64_t offset = 0; offset < ranges[i].bytes; offset += PAGE_BYTES) {
+            uint64_t va = ranges[i].iova + offset;
+            for (unsigned level = start; level < 3; ++level) {
+                uint64_t prefix = va >> (39 - 9 * level);
+                if (prefix != last[level]) { ++required; last[level] = prefix; }
+            }
+        }
+    }
+    if (required > capacity) return ArmSmmu4KCapacity;
+    for (size_t i = 0; i < required * 512; ++i) tables[i] = 0;
+    size_t next = 1;
+    for (size_t i = 0; i < range_count; ++i) {
+        const ArmSmmu4KRange *r = &ranges[i];
+        uint64_t attributes = (1u << 11) | (1u << 10) | 3;
+        if (!(r->permissions & ArmSmmu4KExecute)) attributes |= UINT64_C(3) << 53;
+        if (!(r->permissions & ArmSmmu4KPrivileged)) attributes |= 1u << 6;
+        if (!(r->permissions & ArmSmmu4KWrite)) attributes |= 1u << 7;
+        attributes |= (uint64_t)r->shareability << 8;
+        if (r->writeback) attributes |= 1u << 2;
+        for (uint64_t offset = 0; offset < r->bytes; offset += PAGE_BYTES) {
+            uint64_t va = r->iova + offset;
+            size_t table = 0;
+            for (unsigned level = start; level < 3; ++level) {
+                unsigned shift = 39-9*level;
+                unsigned width = level==start ? config->input_bits-shift : 9;
+                size_t slot = table * 512 + ((va >> shift) & ((1u<<width)-1));
+                if (!tables[slot]) tables[slot] = (pool + PAGE_BYTES * next++) | 3;
+                table = (size_t)(((tables[slot] & ADDRESS_MASK) - pool) / PAGE_BYTES);
+            }
+            tables[table * 512 + ((va >> 12) & 511)] = (r->physical + offset) | attributes;
+        }
+    }
+    result->root_physical = pool;
+    result->mair = 0xff44;
+    result->table_pages = required;
+    result->leaf_pages = leaves;
+    result->start_level = start;
+    result->upper_region = upper;
+    return ArmSmmu4KSuccess;
+}
+
+ArmSmmu4KStatus ArmSmmu4KBuild(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result)
+{
+    return build_region(config,ranges,range_count,tables,capacity,result,0);
+}
+
+ArmSmmu4KStatus ArmSmmu4KBuildUpper(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result)
+{
+    return build_region(config,ranges,range_count,tables,capacity,result,1);
+}
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4K.h b/iokit/Kernel/arm/a740/ArmSmmu4K.h
new file mode 100644
index 0000000..1b09a29
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4K.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_H
+#define ARM_SMMU_4K_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    ArmSmmu4KSuccess = 0, ArmSmmu4KArgument, ArmSmmu4KBadRange,
+    ArmSmmu4KOverlap, ArmSmmu4KCapacity, ArmSmmu4KBudget,
+    ArmSmmu4KUnsupported, ArmSmmu4KStateMismatch,
+    ArmSmmu4KIoError, ArmSmmu4KTimeout, ArmSmmu4KBusy, ArmSmmu4KFault
+} ArmSmmu4KStatus;
+typedef struct {
+    unsigned input_bits;           /* 32..48, low-address TTBR0 profile. */
+    unsigned output_bits;          /* 32,36,40,42,44,48. */
+    uint64_t table_physical;        /* Caller-owned contiguous pool, aligned 4K. */
+    size_t leaf_budget;            /* Explicit upper bound on mapping work. */
+} ArmSmmu4KConfig;
+enum {ArmSmmu4KRead=1,ArmSmmu4KWrite=2,ArmSmmu4KExecute=4,ArmSmmu4KPrivileged=8};
+typedef struct {
+    uint64_t iova, physical, bytes;
+    unsigned permissions;          /* Read required; optional Write/Execute/Privileged. */
+    unsigned writeback;            /* 0=normal NC, 1=normal WB/WA. */
+    unsigned shareability;         /* 2=outer, 3=inner; explicit, no default. */
+} ArmSmmu4KRange;
+typedef struct {
+    uint64_t root_physical;
+    uint64_t mair;                 /* NC at index 0, WB/WA at index 1. */
+    size_t table_pages, leaf_pages;
+    unsigned start_level;
+    unsigned upper_region;        /* 0=Build TTBR0, 1=BuildUpper TTBR1. */
+} ArmSmmu4KResult;
+
+/* Build inactive ARM LPAE stage-1 tables with ONLY 4K level-3 leaves.
+ * Sorted disjoint low IOVA ranges; no sign extension or input conversion.
+ * No resource may map the table pool. Conflicting cache/shareability/privilege
+ * aliases refuse. Default 1/3 retains unprivileged PXN/UXN behavior. Execute
+ * and Privileged explicitly describe DEVICE-stage1 accesses (e.g. firmware),
+ * never CPU permissions or authorization to execute unauthenticated images.
+ * All validation/capacity checks precede table writes. Failure zeros result
+ * and leaves tables untouched. Success writes only result.table_pages pages.
+ * Caller guarantees real accessible, disjoint storage, immutable inputs,
+ * native-endian uint64_t table storage aligned to at least 8 bytes, actual
+ * physical ownership and matching CPU attributes/cache maintenance.
+ * NO MMIO, allocation, barriers, TLB operations or activation. This does NOT
+ * prove hardware support, coherent walks or a live isolated GPU context. */
+ArmSmmu4KStatus ArmSmmu4KBuild(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t table_capacity_pages, ArmSmmu4KResult *result);
+/* Same native 4K format for TTBR1's upper, sign-extended address region.
+ * IOVAs must already be in [2^64-2^input_bits,2^64); truncated low addresses
+ * refuse. Uses the architectural partial-root index width. No lower-region
+ * remapping, page-size conversion, MMIO or translation activation occurs. */
+ArmSmmu4KStatus ArmSmmu4KBuildUpper(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t table_capacity_pages, ArmSmmu4KResult *result);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4KContext.c b/iokit/Kernel/arm/a740/ArmSmmu4KContext.c
new file mode 100644
index 0000000..c68b42d
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4KContext.c
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KContext.h"
+static int width_code(unsigned bits)
+{
+    switch(bits) {case 32:return 0;case 36:return 1;case 40:return 2;
+        case 42:return 3;case 44:return 4;case 48:return 5;default:return -1;}
+}
+static unsigned width_bits(unsigned code)
+{
+    switch(code) {case 0:return 32;case 1:return 36;case 2:return 40;
+        case 3:return 42;case 4:return 44;case 5:return 48;default:return 0;}
+}
+static int region_valid(const ArmSmmu4KConfig *c,const ArmSmmu4KResult *r,unsigned upper)
+{
+    if(!c || !r)return !c && !r;
+    if(c->input_bits<32 || c->input_bits>48 || width_code(c->output_bits)<0 ||
+        (c->table_physical&4095) || r->root_physical!=c->table_physical ||
+        r->mair!=0xff44 || r->upper_region!=upper || !r->table_pages ||
+        r->leaf_pages>c->leaf_budget || r->table_pages>UINT64_MAX/4096 ||
+        r->start_level!=4-(c->input_bits-12+8)/9)return 0;
+    uint64_t limit=UINT64_C(1)<<c->output_bits;
+    return r->root_physical<limit && (uint64_t)r->table_pages*4096<=limit-r->root_physical;
+}
+ArmSmmu4KStatus ArmSmmu4KEncodeContext(const ArmSmmu4KContextConfig *c,
+    ArmSmmu4KContextImage *out)
+{
+    if(!out)return ArmSmmu4KArgument;
+    out->cbar=out->cba2r=out->tcr=out->tcr2=out->mair0=out->mair1=out->sctlr=0;
+    out->reserved_zero=0;
+    out->ttbr0=out->ttbr1=0;
+    if(!c || (!c->lower && !c->upper) || c->asid>65535 || c->coherent_walk>1 ||
+        c->stall_on_fault>1 || c->continue_after_fault>1 ||
+        !region_valid(c->lower,c->lower_tables,0) || !region_valid(c->upper,c->upper_tables,1))return ArmSmmu4KArgument;
+    unsigned va=width_bits((c->id2>>8)&15),pa=width_bits((c->id2>>4)&15);
+    if(!(c->id0&(UINT32_C(1)<<30)) || !(c->id2&(1u<<12)) || !va || !pa)return ArmSmmu4KUnsupported;
+    const ArmSmmu4KConfig *basis=c->lower?c->lower:c->upper;
+    if(basis->output_bits>pa || (c->lower && c->lower->input_bits>va) ||
+        (c->upper && (c->upper->input_bits>va || c->upper->output_bits!=basis->output_bits)))return ArmSmmu4KUnsupported;
+    if(c->lower && c->upper) {
+        const ArmSmmu4KResult *a=c->lower_tables,*b=c->upper_tables;
+        if(a->root_physical<b->root_physical+(uint64_t)b->table_pages*4096 &&
+           b->root_physical<a->root_physical+(uint64_t)a->table_pages*4096)return ArmSmmu4KOverlap;
+    }
+    ArmSmmu4KContextImage v;
+    v.cbar=0x1f300; /* Stage1 translation, stage2 bypass; weakest bypass attrs. */
+    v.cba2r=1;      /* AArch64. No stage2 VMID or guest translation. */
+    v.tcr=UINT32_C(2)<<30; /* TG1=4K, TG0=4K. */
+    unsigned walk=c->coherent_walk?0x3500:0x2000;
+    if(c->lower)v.tcr|=walk|(64-c->lower->input_bits);
+    else v.tcr|=1u<<7; /* EPD0 */
+    if(c->upper)v.tcr|=(walk|(64-c->upper->input_bits))<<16;
+    else v.tcr|=1u<<23; /* EPD1 */
+    v.tcr2=(7u<<15)|(1u<<4)|(unsigned)width_code(basis->output_bits);
+    v.ttbr0=(uint64_t)c->asid<<48;v.ttbr1=v.ttbr0;
+    if(c->lower)v.ttbr0|=c->lower_tables->root_physical;
+    if(c->upper)v.ttbr1|=c->upper_tables->root_physical;
+    v.mair0=0xff44;v.mair1=0;
+    v.sctlr=0x1067|(c->stall_on_fault<<7)|(c->continue_after_fault<<8);
+    v.reserved_zero=0;
+    *out=v;
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KValidateContextReadback(const ArmSmmu4KContextConfig *c,
+    const ArmSmmu4KContextImage *observed)
+{
+    if(!observed)return ArmSmmu4KArgument;
+    ArmSmmu4KContextImage expected;
+    ArmSmmu4KStatus status=ArmSmmu4KEncodeContext(c,&expected);
+    if(status!=ArmSmmu4KSuccess)return status;
+    /* TCR2.TBI0/TBI1 (bits 5/6, top-byte ignore) are written 0 but may read 1: the ishtar Adreno MMU-500 reads
+     * 0x38071 for 0x38011 (int-008). Linux neither sets nor reads them back. With a 48-bit upstream bus the top
+     * byte of a device address is zero, so ignoring it changes no translation. Only 0 -> 1 is accepted here. */
+    const uint32_t tbi_set=observed->tcr2&~expected.tcr2&UINT32_C(0x60);
+    /* SCTLR.ASIDPNE (bit 12) is written 1 but may read 0: the same SMMU reads 0x167 for 0x1167 (int-009). Linux
+     * writes it and never reads it back. A shared ASID namespace is safe because every bank's ASID is the
+     * caller's exclusive lease. Only 1 -> 0 is accepted. */
+    const uint32_t asidpne_clear=expected.sctlr&~observed->sctlr&UINT32_C(0x1000);
+    if(expected.cbar!=observed->cbar || expected.cba2r!=observed->cba2r ||
+        expected.tcr!=observed->tcr || ((expected.tcr2^observed->tcr2)&~tbi_set) ||
+        expected.mair0!=observed->mair0 || expected.mair1!=observed->mair1 ||
+        ((expected.sctlr^observed->sctlr)&~asidpne_clear) || observed->reserved_zero || expected.ttbr0!=observed->ttbr0 ||
+        expected.ttbr1!=observed->ttbr1)return ArmSmmu4KStateMismatch;
+    return ArmSmmu4KSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4KContext.h b/iokit/Kernel/arm/a740/ArmSmmu4KContext.h
new file mode 100644
index 0000000..3c2faa4
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4KContext.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_CONTEXT_H
+#define ARM_SMMU_4K_CONTEXT_H
+#include "ArmSmmu4K.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    /* A config/result pair from Build, BuildUpper or LivePrepare; NULL pair disables it.
+     * A live arena may have zero mapped leaves while retaining its table topology.
+     * Both enabled regions need distinct physical pools and equal OAS/MAIR.
+     * The trusted caller retains actual pool ownership and immutable results. */
+    const ArmSmmu4KConfig *lower, *upper;
+    const ArmSmmu4KResult *lower_tables, *upper_tables;
+    uint32_t id0, id2;       /* Raw SMMUv2 identification register values. */
+    unsigned asid;          /* 0..65535, ownership managed by the caller. */
+    unsigned coherent_walk; /* Explicit: 1=inner WBWA, 0=outer NC. */
+    unsigned stall_on_fault, continue_after_fault; /* Each 0 or 1. */
+} ArmSmmu4KContextConfig;
+typedef struct {
+    uint32_t cbar, cba2r, tcr, tcr2, mair0, mair1, sctlr, reserved_zero;
+    uint64_t ttbr0, ttbr1;
+} ArmSmmu4KContextImage;
+
+/* Encode AArch64 stage1, stage2-bypass native4K SMMUv2 context registers.
+ * Capability/width/result/refusal checks precede publishing an image. Failure
+ * zeros it. Both TG0/TG1 select 4K even for a disabled region. No MMIO, power,
+ * stream/context assignment, cache barriers, TLB operations or activation.
+ * ID inputs are not proof that the caller read actual hardware. Inputs,
+ * their pointed-to configs/results, and output must be disjoint and immutable
+ * throughout the call; this is a trusted kernel integration boundary. */
+ArmSmmu4KStatus ArmSmmu4KEncodeContext(const ArmSmmu4KContextConfig *,
+    ArmSmmu4KContextImage *);
+/* Compare all supplied readback fields with the freshly encoded expected
+ * image. Caller must read real hardware and independently walk its actual
+ * TTBR tables, verify ownership/coherency and handle faults/TLB lifetime.
+ * Matching caller-supplied values alone never qualify an active GPU mapping. */
+ArmSmmu4KStatus ArmSmmu4KValidateContextReadback(const ArmSmmu4KContextConfig *,
+    const ArmSmmu4KContextImage *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4KLive.c b/iokit/Kernel/arm/a740/ArmSmmu4KLive.c
new file mode 100644
index 0000000..a400d3f
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4KLive.c
@@ -0,0 +1,530 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KLive.h"
+#define PAGE UINT64_C(4096)
+#define PA_MASK UINT64_C(0x0000fffffffff000)
+
+static int output_width(unsigned bits)
+{return bits==32 || bits==36 || bits==40 || bits==42 || bits==44 || bits==48;}
+static ArmSmmu4KStatus layout(const ArmSmmu4KLiveArena *a,ArmSmmu4KResult *out)
+{
+    if(!a || !a->mapping || ((uintptr_t)a->mapping&4095) || a->upper_region>1 ||
+        a->config.input_bits<32 || a->config.input_bits>48 ||
+        !output_width(a->config.output_bits) || !a->config.leaf_budget ||
+        !a->capacity_pages || a->capacity_pages>SIZE_MAX/4096 ||
+        a->capacity_pages*4096>UINTPTR_MAX-(uintptr_t)a->mapping)return ArmSmmu4KArgument;
+    uint64_t limit=UINT64_C(1)<<a->config.input_bits;
+    uint64_t physical_limit=UINT64_C(1)<<a->config.output_bits;
+    if(!a->bytes || ((a->iova|a->bytes|a->config.table_physical)&4095) ||
+        (a->upper_region ? a->iova<UINT64_MAX-limit+1 : a->iova>=limit) ||
+        a->bytes>limit-(a->iova&(limit-1)) ||
+        a->config.table_physical>=physical_limit ||
+        a->capacity_pages*PAGE>physical_limit-a->config.table_physical)return ArmSmmu4KBadRange;
+    if(a->bytes/PAGE>a->config.leaf_budget)return ArmSmmu4KBudget;
+    unsigned start=4-(a->config.input_bits-12+8)/9;
+    uint64_t low=a->iova&(limit-1),high=low+a->bytes-1;
+    size_t pages=1;
+    for(unsigned level=start;level<3;++level) {
+        unsigned shift=39-9*level;
+        uint64_t extra=(high>>shift)-(low>>shift)+1;
+        if(extra>SIZE_MAX-pages)return ArmSmmu4KCapacity;
+        pages+=(size_t)extra;
+    }
+    if(pages>a->capacity_pages)return ArmSmmu4KCapacity;
+    *out=(ArmSmmu4KResult){a->config.table_physical,0xff44,pages,0,start,a->upper_region};
+    return ArmSmmu4KSuccess;
+}
+static uint64_t descriptor(const ArmSmmu4KRange *r,uint64_t iova)
+{
+    uint64_t attrs=(1u<<11)|(1u<<10)|3u|((uint64_t)r->shareability<<8);
+    if(!(r->permissions&ArmSmmu4KExecute))attrs|=UINT64_C(3)<<53;
+    if(!(r->permissions&ArmSmmu4KPrivileged))attrs|=1u<<6;
+    if(!(r->permissions&ArmSmmu4KWrite))attrs|=1u<<7;
+    if(r->writeback)attrs|=1u<<2;
+    return (r->physical+(iova-r->iova))|attrs;
+}
+static const ArmSmmu4KRange *find(const ArmSmmu4KRange *ranges,size_t count,uint64_t iova)
+{
+    size_t low=0,high=count;
+    while(low<high) {
+        size_t mid=low+(high-low)/2;
+        const ArmSmmu4KRange *r=&ranges[mid];
+        if(iova<r->iova)high=mid;
+        else if(iova-r->iova>=r->bytes)low=mid+1;
+        else return r;
+    }
+    return 0;
+}
+/* The walk visits addresses in ascending order, so one cursor per range list replaces a binary search for every leaf: lower_bound once per
+ * leaf page, then forward. A range is behind the address when the address lies past its end (written as a difference: native addresses
+ * may end at 2^64). */
+static size_t first_not_behind(const ArmSmmu4KRange *ranges,size_t count,uint64_t va)
+{
+    size_t low=0,high=count;
+    while(low<high) {
+        size_t mid=low+(high-low)/2;
+        if(va>=ranges[mid].iova && va-ranges[mid].iova>=ranges[mid].bytes)low=mid+1;
+        else high=mid;
+    }
+    return low;
+}
+static const ArmSmmu4KRange *scan(const ArmSmmu4KRange *ranges,size_t count,size_t *cursor,uint64_t va)
+{
+    while(*cursor<count && va>=ranges[*cursor].iova && va-ranges[*cursor].iova>=ranges[*cursor].bytes)++*cursor;
+    if(*cursor<count && va>=ranges[*cursor].iova && va-ranges[*cursor].iova<ranges[*cursor].bytes)return &ranges[*cursor];
+    return 0;
+}
+static uint64_t expected(const ArmSmmu4KRange *ranges,size_t count,uint64_t iova)
+{
+    const ArmSmmu4KRange *r=find(ranges,count,iova);
+    return r?descriptor(r,iova):0;
+}
+static ArmSmmu4KStatus validate_range(const ArmSmmu4KLiveArena *a,const ArmSmmu4KRange *r)
+{
+    uint64_t physical_limit=UINT64_C(1)<<a->config.output_bits;
+    uint64_t pool=a->config.table_physical,pool_bytes=a->capacity_pages*PAGE;
+    if(!r || !r->bytes || ((r->iova|r->physical|r->bytes)&4095) ||
+        !(r->permissions&ArmSmmu4KRead) || (r->permissions&~15u) ||
+        r->writeback>1 || (r->shareability!=2 && r->shareability!=3) ||
+        r->physical>=physical_limit || r->bytes>physical_limit-r->physical ||
+        r->iova<a->iova || r->iova-a->iova>=a->bytes ||
+        r->bytes>a->bytes-(r->iova-a->iova))return ArmSmmu4KBadRange;
+    if(r->physical<pool+pool_bytes && pool<r->physical+r->bytes)return ArmSmmu4KOverlap;
+    return ArmSmmu4KSuccess;
+}
+static int conflicting_alias(const ArmSmmu4KRange *a,const ArmSmmu4KRange *b)
+{
+    return (a->writeback!=b->writeback || a->shareability!=b->shareability ||
+        ((a->permissions^b->permissions)&ArmSmmu4KPrivileged)) &&
+        a->physical<b->physical+b->bytes && b->physical<a->physical+a->bytes;
+}
+/* Only ranges of different cache/shareability/privilege classes can alias in conflict, and of two conflicting ranges at most one
+ * is in the class most ranges of both sets have. So for every other class k, the members of class k in one set are compared with
+ * the members of other classes in the other set, both ways. Each such comparison sorts the smaller side by physical address in
+ * the arena's scratch and looks every range of the larger side up in it: a scattered buffer is one range per physical page, and
+ * with coherent imports (write-back) beside the GPU's own non-cacheable buffers a pairwise loop over both was some 2.4 billion
+ * comparisons per map (int-144: 368 ms per map on average, 8 s at worst). Without scratch, or a side larger than it, the
+ * comparison is the pairwise loop. */
+static unsigned alias_class(const ArmSmmu4KRange *r)
+{return (r->writeback&1u)|((r->shareability&3u)<<1)|((r->permissions&ArmSmmu4KPrivileged)?8u:0u);}
+typedef struct {
+    const ArmSmmu4KRange *ranges;size_t count;
+    unsigned cls;int same;   /* members: class == cls (same) or class != cls */
+} AliasSide;
+static int alias_member(const AliasSide *s,size_t i)
+{return (alias_class(&s->ranges[i])==s->cls)==(s->same!=0);}
+static void sift(const ArmSmmu4KRange *r,uint32_t *h,size_t root,size_t n)
+{
+    for(;;) {
+        size_t child=2*root+1;
+        if(child>=n)return;
+        if(child+1<n && r[h[child+1]].physical>r[h[child]].physical)++child;
+        if(r[h[root]].physical>=r[h[child]].physical)return;
+        uint32_t t=h[root];h[root]=h[child];h[child]=t;root=child;
+    }
+}
+static int alias_pass(const ArmSmmu4KLiveArena *arena,const AliasSide *p,const AliasSide *q)
+{
+    size_t np=0,nq=0;
+    for(size_t i=0;i<p->count;++i)np+=(size_t)alias_member(p,i);
+    for(size_t j=0;j<q->count;++j)nq+=(size_t)alias_member(q,j);
+    if(!np || !nq)return 0;
+    const AliasSide *sorted=np<=nq?p:q,*probe=np<=nq?q:p;
+    const size_t n=np<=nq?np:nq;
+    uint32_t *h=arena?arena->alias_scratch:0;
+    if(!h || n>arena->alias_scratch_entries || sorted->count>UINT32_MAX) {
+        for(size_t i=0;i<p->count;++i)if(alias_member(p,i))
+            for(size_t j=0;j<q->count;++j)if(alias_member(q,j) && conflicting_alias(&p->ranges[i],&q->ranges[j]))return 1;
+        return 0;
+    }
+    const ArmSmmu4KRange *r=sorted->ranges;
+    size_t k=0;
+    for(size_t i=0;i<sorted->count;++i)if(alias_member(sorted,i)) {
+        h[k++]=(uint32_t)i;
+    }
+    for(size_t i=n/2;i-->0;)sift(r,h,i,n);
+    for(size_t end=n;end>1;) {--end;uint32_t t=h[0];h[0]=h[end];h[end]=t;sift(r,h,0,end);}
+    /* Drop intervals contained by an earlier interval. Both starts and ends of
+     * the retained indices are now monotonic, even with nested/duplicate runs.
+     * A distant long run cannot force gap queries to scan short runs backward.
+     * Every compared pair belongs to different classes by AliasSide's filter. */
+    size_t kept=0;
+    for(size_t i=0;i<n;++i) {
+        uint32_t index=h[i];
+        if(!kept || r[index].physical+r[index].bytes>r[h[kept-1]].physical+r[h[kept-1]].bytes)h[kept++]=index;
+    }
+    for(size_t j=0;j<probe->count;++j) {
+        if(!alias_member(probe,j))continue;
+        const ArmSmmu4KRange *y=&probe->ranges[j];
+        size_t lo=0,hi=kept;   /* first interval ending after y's start */
+        while(lo<hi) {size_t mid=lo+(hi-lo)/2;if(r[h[mid]].physical+r[h[mid]].bytes<=y->physical)lo=mid+1;else hi=mid;}
+        if(lo<kept && r[h[lo]].physical<y->physical+y->bytes)return 1;
+    }
+    return 0;
+}
+static int any_conflicting_alias(const ArmSmmu4KLiveArena *arena,const ArmSmmu4KRange *a,size_t na,
+    const ArmSmmu4KRange *b,size_t nb)
+{
+    if(!na || !nb)return 0;
+    size_t members[16]={0};
+    for(size_t i=0;i<na;++i)++members[alias_class(&a[i])];
+    for(size_t j=0;j<nb;++j)++members[alias_class(&b[j])];
+    unsigned reference=0;
+    for(unsigned k=1;k<16;++k)if(members[k]>members[reference])reference=k;
+    const int self=a==b && na==nb;
+    for(unsigned k=0;k<16;++k) {
+        if(k==reference || !members[k])continue;
+        const AliasSide ak={a,na,k,1},bo={b,nb,k,0};
+        if(alias_pass(arena,&ak,&bo))return 1;
+        if(self)continue;
+        const AliasSide bk={b,nb,k,1},ao={a,na,k,0};
+        if(alias_pass(arena,&bk,&ao))return 1;
+    }
+    return 0;
+}
+static ArmSmmu4KStatus validate_ranges_checked(const ArmSmmu4KLiveArena *a,
+    const ArmSmmu4KRange *ranges,size_t count,size_t *leaves,int aliases);
+static ArmSmmu4KStatus validate_ranges(const ArmSmmu4KLiveArena *a,
+    const ArmSmmu4KRange *ranges,size_t count,size_t *leaves)
+{return validate_ranges_checked(a,ranges,count,leaves,1);}
+static ArmSmmu4KStatus validate_ranges_checked(const ArmSmmu4KLiveArena *a,
+    const ArmSmmu4KRange *ranges,size_t count,size_t *leaves,int aliases)
+{
+    *leaves=0;
+    if((count && !ranges) || count>a->config.leaf_budget ||
+        count>SIZE_MAX/sizeof(*ranges))return ArmSmmu4KArgument;
+    for(size_t i=0;i<count;++i) {
+        ArmSmmu4KStatus status=validate_range(a,&ranges[i]);
+        if(status!=ArmSmmu4KSuccess)return status;
+        if(i && ranges[i].iova<=ranges[i-1].iova+(ranges[i-1].bytes-1))return ArmSmmu4KOverlap;
+        size_t pages=(size_t)(ranges[i].bytes/PAGE);
+        if(pages>a->config.leaf_budget-*leaves)return ArmSmmu4KBudget;
+        *leaves+=pages;
+    }
+    return aliases && any_conflicting_alias(a,ranges,count,ranges,count)?ArmSmmu4KOverlap:ArmSmmu4KSuccess;
+}
+/* Traverse the actual fixed topology, never generate/copy a reference table.
+ * A fixed owned aperture reserves empty intermediate tables; every other slot
+ * must be zero. Resource expectations are metadata, not translated page tables. */
+static ArmSmmu4KStatus walk(const ArmSmmu4KLiveArena *a,const ArmSmmu4KResult *shape,
+    unsigned level,size_t page,uint64_t prefix,size_t *next,unsigned build,
+    const ArmSmmu4KRange *ranges,size_t count,const ArmSmmu4KRange *changes,size_t changed,
+    unsigned map,ArmSmmu4KLiveResult *r)
+{
+    uint64_t limit=UINT64_C(1)<<a->config.input_bits;
+    uint64_t low=a->iova&(limit-1),high=low+a->bytes-1;
+    unsigned shift=39-9*level;
+    unsigned width=level==shape->start_level?a->config.input_bits-shift:9;
+    size_t range_cursor=0,change_cursor=0;
+    if(level==3) {
+        uint64_t first=a->upper_region ? prefix|~(limit-1) : prefix;
+        range_cursor=first_not_behind(ranges,count,first);change_cursor=first_not_behind(changes,changed,first);
+    }
+    for(unsigned slot=0;slot<512;++slot) {
+        uint64_t begin=prefix+((uint64_t)slot<<shift),value=0;
+        int reserved=slot<(1u<<width) && begin<=high && low<begin+(UINT64_C(1)<<shift);
+        size_t child=0;
+        if(level<3 && reserved) {
+            child=(*next)++;
+            if(child>=shape->table_pages)return ArmSmmu4KStateMismatch;
+            value=(a->config.table_physical+child*PAGE)|3u;
+        } else if(level==3 && reserved && !build) {
+            uint64_t va=a->upper_region ? begin|~(limit-1) : begin;
+            const ArmSmmu4KRange *c=scan(changes,changed,&change_cursor,va);
+            if(c)value=map?descriptor(c,va):0;
+            else {
+                const ArmSmmu4KRange *r0=scan(ranges,count,&range_cursor,va);
+                value=r0?descriptor(r0,va):0;
+            }
+        }
+        size_t index=page*512+slot;
+        if(build)a->mapping[index]=value;
+        else {++r->descriptor_reads;if(a->mapping[index]!=value)return ArmSmmu4KStateMismatch;}
+        if(level<3 && reserved) {
+            ArmSmmu4KStatus status=walk(a,shape,level+1,child,begin,next,build,ranges,count,changes,changed,map,r);
+            if(status!=ArmSmmu4KSuccess)return status;
+        }
+    }
+    return ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus leaf_index(const ArmSmmu4KLiveArena *a,
+    const ArmSmmu4KResult *shape,uint64_t va,size_t *index,ArmSmmu4KLiveResult *r);
+/* The changed leaves alone, through the table path each one's address takes: before the store (after=0) each holds what the
+ * operation replaces (nothing for a map, its range's descriptor for an unmap), after it what the operation wrote. */
+static ArmSmmu4KStatus verify_changed(const ArmSmmu4KLiveArena *a,const ArmSmmu4KResult *shape,
+    const ArmSmmu4KRange *changes,size_t changed,unsigned map,unsigned after,ArmSmmu4KLiveResult *r)
+{
+    for(size_t i=0;i<changed;++i)for(uint64_t offset=0;offset<changes[i].bytes;offset+=PAGE) {
+        const uint64_t va=changes[i].iova+offset;size_t index;
+        ArmSmmu4KStatus status=leaf_index(a,shape,va,&index,r);if(status!=ArmSmmu4KSuccess)return status;
+        const uint64_t want=(map==after)?descriptor(&changes[i],va):0;
+        ++r->descriptor_reads;
+        if(a->mapping[index]!=want)return ArmSmmu4KStateMismatch;
+    }
+    return ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus verify(const ArmSmmu4KLiveArena *a,const ArmSmmu4KResult *shape,
+    const ArmSmmu4KRange *ranges,size_t count,const ArmSmmu4KRange *changes,size_t changed,
+    unsigned map,ArmSmmu4KLiveResult *r)
+{
+    size_t next=1;
+    ArmSmmu4KStatus status=walk(a,shape,shape->start_level,0,0,&next,0,ranges,count,changes,changed,map,r);
+    return status==ArmSmmu4KSuccess && next!=shape->table_pages?ArmSmmu4KStateMismatch:status;
+}
+ArmSmmu4KStatus ArmSmmu4KLivePrepare(const ArmSmmu4KLiveArena *a,ArmSmmu4KLiveState *state)
+{
+    if(!state || state->prepared || state->poisoned)return ArmSmmu4KArgument;
+    ArmSmmu4KResult shape;
+    ArmSmmu4KStatus status=layout(a,&shape);
+    if(status!=ArmSmmu4KSuccess)return status;
+    size_t next=1;
+    status=walk(a,&shape,shape.start_level,0,0,&next,1,0,0,0,0,0,0);
+    if(status!=ArmSmmu4KSuccess || next!=shape.table_pages) {state->poisoned=1;return ArmSmmu4KStateMismatch;}
+    state->tables=shape;state->generation=0;state->prepared=1;state->context_offset=0;
+    return ArmSmmu4KSuccess;
+}
+static int same_config(const ArmSmmu4KConfig *a,const ArmSmmu4KConfig *b)
+{
+    return a && b && a->input_bits==b->input_bits && a->output_bits==b->output_bits &&
+        a->table_physical==b->table_physical && a->leaf_budget==b->leaf_budget;
+}
+ArmSmmu4KStatus ArmSmmu4KLiveAudit(const ArmSmmu4KLiveArena *a,const ArmSmmu4KLiveState *state,
+    const ArmSmmu4KRange *ranges,size_t count,ArmSmmu4KLiveResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KLiveResult){0};r->must_retain_resources=1;
+    if(!state || !state->prepared || state->poisoned)return ArmSmmu4KArgument;
+    ArmSmmu4KResult shape;
+    ArmSmmu4KStatus status=layout(a,&shape);
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(state->tables.root_physical!=shape.root_physical || state->tables.mair!=shape.mair ||
+        state->tables.table_pages!=shape.table_pages || state->tables.start_level!=shape.start_level ||
+        state->tables.upper_region!=shape.upper_region)return ArmSmmu4KArgument;
+    size_t leaves=0;
+    status=validate_ranges(a,ranges,count,&leaves);if(status!=ArmSmmu4KSuccess)return status;
+    if(leaves!=state->tables.leaf_pages)return ArmSmmu4KArgument;
+    status=verify(a,&shape,ranges,count,0,0,0,r);
+    r->complete=status==ArmSmmu4KSuccess;return status;
+}
+static ArmSmmu4KStatus leaf_index(const ArmSmmu4KLiveArena *a,
+    const ArmSmmu4KResult *shape,uint64_t va,size_t *index,ArmSmmu4KLiveResult *r)
+{
+    size_t page=0;
+    for(unsigned level=shape->start_level;level<3;++level) {
+        unsigned shift=39-9*level,width=level==shape->start_level?a->config.input_bits-shift:9;
+        uint64_t entry=a->mapping[page*512+((va>>shift)&((1u<<width)-1))];++r->descriptor_reads;
+        uint64_t physical=entry&PA_MASK;
+        if(entry!=(physical|3u) || physical<a->config.table_physical ||
+            physical-a->config.table_physical>=shape->table_pages*PAGE)return ArmSmmu4KStateMismatch;
+        page=(size_t)((physical-a->config.table_physical)/PAGE);
+    }
+    *index=page*512+((va>>12)&511);
+    return ArmSmmu4KSuccess;
+}
+static int overlaps(uint64_t a,uint64_t abytes,uint64_t b,uint64_t bbytes)
+{return a<b+bbytes && b<a+abytes;}
+static int touches_pool(const ArmSmmu4KRange *r,const ArmSmmu4KLiveArena *a)
+{return overlaps(r->physical,r->bytes,a->config.table_physical,a->capacity_pages*PAGE);}
+static ArmSmmu4KStatus region_metadata(const ArmSmmu4KLiveRegion *region,
+    const ArmSmmu4KConfig *config,const ArmSmmu4KResult *root,unsigned upper,int aliases)
+{
+    if(!region)return (!config && !root)?ArmSmmu4KSuccess:ArmSmmu4KArgument;
+    if(!region->arena || !region->state || region->arena->upper_region!=upper ||
+        root!=&region->state->tables || !same_config(config,&region->arena->config) ||
+        !region->state->prepared || region->state->poisoned)return ArmSmmu4KArgument;
+    ArmSmmu4KResult shape;
+    ArmSmmu4KStatus status=layout(region->arena,&shape);if(status)return status;
+    const ArmSmmu4KResult *r=&region->state->tables;
+    if(r->root_physical!=shape.root_physical || r->mair!=shape.mair || r->table_pages!=shape.table_pages ||
+        r->start_level!=shape.start_level || r->upper_region!=shape.upper_region)return ArmSmmu4KArgument;
+    size_t leaves=0;
+    status=validate_ranges_checked(region->arena,region->ranges,region->count,&leaves,aliases);if(status)return status;
+    return leaves==r->leaf_pages?ArmSmmu4KSuccess:ArmSmmu4KArgument;
+}
+/* aliases=0 (an update that is not its region's whole-verification one) skips the existing ranges' alias checks against each other
+ * and across the regions: each range was checked against all of them when it was mapped, and the 64th update re-proves them. */
+static ArmSmmu4KStatus context_metadata(const ArmSmmu4KContextConfig *context,
+    const ArmSmmu4KLiveRegion *lower,const ArmSmmu4KLiveRegion *upper,int aliases)
+{
+    if(!context || (!lower && !upper))return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=region_metadata(lower,context->lower,context->lower_tables,0,aliases);if(status)return status;
+    status=region_metadata(upper,context->upper,context->upper_tables,1,aliases);if(status)return status;
+    if(lower && upper) {
+        const ArmSmmu4KLiveArena *a=lower->arena,*b=upper->arena;
+        if(lower->state==upper->state || a->config.output_bits!=b->config.output_bits ||
+            overlaps(a->config.table_physical,a->capacity_pages*PAGE,b->config.table_physical,b->capacity_pages*PAGE) ||
+            overlaps((uintptr_t)a->mapping,a->capacity_pages*PAGE,(uintptr_t)b->mapping,b->capacity_pages*PAGE))
+            return ArmSmmu4KOverlap;
+        for(size_t i=0;i<lower->count;++i)if(touches_pool(&lower->ranges[i],b))return ArmSmmu4KOverlap;
+        for(size_t i=0;i<upper->count;++i)if(touches_pool(&upper->ranges[i],a))return ArmSmmu4KOverlap;
+        if(aliases && any_conflicting_alias(lower->arena,lower->ranges,lower->count,upper->ranges,upper->count))return ArmSmmu4KOverlap;
+    }
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KLiveAuditContext(const ArmSmmu4KContextConfig *context,
+    const ArmSmmu4KLiveRegion *lower,const ArmSmmu4KLiveRegion *upper,ArmSmmu4KLiveResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KLiveResult){0};r->must_retain_resources=1;
+    ArmSmmu4KStatus status=context_metadata(context,lower,upper,1);if(status)return status;
+    const ArmSmmu4KLiveRegion *regions[]={lower,upper};
+    for(unsigned i=0;i<2;++i)if(regions[i]) {
+        const ArmSmmu4KLiveRegion *v=regions[i];
+        status=verify(v->arena,&v->state->tables,v->ranges,v->count,0,0,0,r);if(status)return status;
+    }
+    r->complete=1;return ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus update(const ArmSmmu4KLiveArena *a,ArmSmmu4KLiveState *state,
+    const ArmSmmu4KIo *io,unsigned bank,const ArmSmmu4KContextConfig *context,
+    const ArmSmmu4KLiveVisibility *visibility,const ArmSmmu4KRange *before,size_t count,
+    const ArmSmmu4KLiveRegion *peer,const ArmSmmu4KRange *changes,size_t change_count,unsigned map,unsigned budget,
+    ArmSmmu4KLiveResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KLiveResult){0};r->must_retain_resources=1;
+    if(!state || !state->prepared || state->poisoned || !context ||
+        !visibility || !visibility->publish_table_page || map>1 || !change_count ||
+        !budget || budget>1048576 || state->generation==UINT64_MAX)return ArmSmmu4KArgument;
+    ArmSmmu4KResult shape;
+    ArmSmmu4KStatus status=layout(a,&shape);
+    if(status!=ArmSmmu4KSuccess)return status;
+    const ArmSmmu4KResult *root=a->upper_region?context->upper_tables:context->lower_tables;
+    if((!peer && (a->upper_region?(context->lower || context->lower_tables):(context->upper || context->upper_tables))) ||
+        !same_config(a->upper_region?context->upper:context->lower,&a->config) ||
+        root!=&state->tables || state->tables.root_physical!=shape.root_physical ||
+        state->tables.mair!=shape.mair || state->tables.table_pages!=shape.table_pages ||
+        state->tables.start_level!=shape.start_level || state->tables.upper_region!=shape.upper_region)
+        return ArmSmmu4KArgument;
+    /* Every 64th update of a region (its first included) re-proves the whole region: the existing ranges against each other and every
+     * table descriptor before and after. The others prove what they change: each changed leaf holds its old descriptor before the store
+     * and its new one after it, the existing ranges are still sorted, disjoint and in budget, and the changes conflict with none of
+     * them. The ranges were each checked as changes when they were added, and the tables were last proved whole at most 63 updates ago.
+     * A whole-region walk read every descriptor of a 2 GiB aperture four times per update (int-143: 10 ms per buffer map). */
+    const int whole=(state->generation&63)==0;
+    r->whole_verification=whole?1u:0u;
+    size_t leaves=0;
+    status=validate_ranges_checked(a,before,count,&leaves,whole);if(status!=ArmSmmu4KSuccess)return status;
+    if(leaves!=state->tables.leaf_pages)return ArmSmmu4KArgument;
+    /* The changes: sorted, disjoint, each valid; together within the leaf budget. */
+    size_t changed=0;
+    if(!changes)return ArmSmmu4KBadRange;
+    if(change_count>a->config.leaf_budget)return ArmSmmu4KArgument;
+    for(size_t i=0;i<change_count;++i) {
+        status=validate_range(a,&changes[i]);if(status!=ArmSmmu4KSuccess)return status;
+        if(i && changes[i].iova<=changes[i-1].iova+(changes[i-1].bytes-1))return ArmSmmu4KOverlap;
+        size_t pages=(size_t)(changes[i].bytes/PAGE);
+        if(pages>a->config.leaf_budget-changed)return ArmSmmu4KBudget;
+        changed+=pages;
+    }
+    if(peer) {
+        ArmSmmu4KLiveRegion target={a,state,before,count};
+        status=context_metadata(context,a->upper_region?peer:&target,a->upper_region?&target:peer,whole);
+        if(status)return status;
+        for(size_t i=0;i<change_count;++i)if(touches_pool(&changes[i],peer->arena))return ArmSmmu4KOverlap;
+        if(map && any_conflicting_alias(a,changes,change_count,peer->ranges,peer->count))return ArmSmmu4KOverlap;
+    }
+    if(map && changed>a->config.leaf_budget-leaves)return ArmSmmu4KBudget;
+    if(map && (any_conflicting_alias(a,changes,change_count,changes,change_count) ||
+        any_conflicting_alias(a,changes,change_count,before,count)))return ArmSmmu4KOverlap;
+    for(size_t i=0;i<change_count;++i)for(uint64_t offset=0;offset<changes[i].bytes;offset+=PAGE) {
+        uint64_t va=changes[i].iova+offset,old=expected(before,count,va);
+        if(map?old!=0:old!=descriptor(&changes[i],va))return ArmSmmu4KStateMismatch;
+    }
+    /* The context image and faults are observed around the stores of the whole-verification updates only (every 64th, the first
+     * included), and remembered there. Between them the bank stays the caller's exclusively owned one; each of these reads is a
+     * device register access, and an update observed it five times (int-159: 1.1 ms of a 1.7 ms buffer map). */
+    const int observed=whole || !state->context_offset;
+    if(observed) {
+        status=ArmSmmu4KObserveOwnedContext(io,bank,context,&r->synchronization);
+        if(status!=ArmSmmu4KSuccess)goto poisoned;
+    }
+    if(whole) {
+        status=verify(a,&shape,before,count,0,0,0,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+        if(peer) {
+            status=verify(peer->arena,&peer->state->tables,peer->ranges,peer->count,0,0,0,r);
+            if(status)goto poisoned;
+        }
+    } else {
+        status=verify_changed(a,&shape,changes,change_count,map,0,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+    }
+    if(observed) {
+        ArmSmmu4KProgramResult initial=r->synchronization;
+        status=ArmSmmu4KObserveOwnedContext(io,bank,context,&r->synchronization);
+        if(status!=ArmSmmu4KSuccess)goto poisoned;
+        if(initial.id0!=r->synchronization.id0 || initial.id1!=r->synchronization.id1 ||
+            initial.id2!=r->synchronization.id2 || initial.context_offset!=r->synchronization.context_offset)
+            {status=ArmSmmu4KStateMismatch;goto poisoned;}
+    }
+    /* All validation precedes the first store. Caller keeps every master
+     * quiesced and retains both old/new object references through this call. */
+    for(size_t i=0;i<change_count;++i)for(uint64_t offset=0;offset<changes[i].bytes;offset+=PAGE) {
+        uint64_t va=changes[i].iova+offset;size_t index;
+        status=leaf_index(a,&shape,va,&index,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+        a->mapping[index]=map?descriptor(&changes[i],va):0;++r->descriptor_writes;
+    }
+    /* Sorted changes reach leaf pages in order, so each changed page is published once. */
+    size_t last_page=SIZE_MAX;
+    for(size_t i=0;i<change_count;++i)for(uint64_t offset=0;offset<changes[i].bytes;offset+=PAGE) {
+        size_t index;
+        status=leaf_index(a,&shape,changes[i].iova+offset,&index,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+        size_t page=index/512;
+        if(page!=last_page) {
+            if(visibility->publish_table_page(visibility->cookie,a->mapping+page*512,4096)) {status=ArmSmmu4KIoError;goto poisoned;}
+            ++r->published_pages;last_page=page;
+        }
+    }
+    /* A map of leaves that were invalid needs no TLB invalidation: the TLBs hold no translation of an invalid descriptor (as Linux's
+     * io-pgtable maps without one). The unmap invalidates the ASID before it reports the translation removed. */
+    if(observed) {
+        status=ArmSmmu4KSynchronizeOwnedContext(io,bank,context,budget,&r->synchronization);
+        if(status!=ArmSmmu4KSuccess)goto poisoned;
+    } else if(!map) {
+        status=ArmSmmu4KSyncContextTlb(io,state->context_offset,context->asid,0,budget,&r->synchronization);
+        if(status!=ArmSmmu4KSuccess)goto poisoned;
+    }
+    if(whole) {
+        status=verify(a,&shape,before,count,changes,change_count,map,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+        if(peer) {
+            status=verify(peer->arena,&peer->state->tables,peer->ranges,peer->count,0,0,0,r);
+            if(status)goto poisoned;
+        }
+    } else {
+        status=verify_changed(a,&shape,changes,change_count,map,1,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+    }
+    if(observed) {
+        ArmSmmu4KProgramResult after;
+        status=ArmSmmu4KObserveOwnedContext(io,bank,context,&after);if(status!=ArmSmmu4KSuccess)goto poisoned;
+        if(after.id0!=r->synchronization.id0 || after.id1!=r->synchronization.id1 ||
+            after.id2!=r->synchronization.id2 || after.context_offset!=r->synchronization.context_offset)
+            {status=ArmSmmu4KStateMismatch;goto poisoned;}
+        state->context_offset=r->synchronization.context_offset;
+    }
+    state->tables.leaf_pages=map?leaves+changed:leaves-changed;++state->generation;
+    r->complete=1;r->translation_removed=!map;r->must_retain_resources=0;
+    return ArmSmmu4KSuccess;
+poisoned:
+    state->poisoned=1;if(peer)peer->state->poisoned=1;return status;
+}
+ArmSmmu4KStatus ArmSmmu4KLiveUpdate(const ArmSmmu4KLiveArena *a,ArmSmmu4KLiveState *state,
+    const ArmSmmu4KIo *io,unsigned bank,const ArmSmmu4KContextConfig *context,
+    const ArmSmmu4KLiveVisibility *visibility,const ArmSmmu4KRange *before,size_t count,
+    const ArmSmmu4KRange *change,unsigned map,unsigned budget,ArmSmmu4KLiveResult *r)
+{return update(a,state,io,bank,context,visibility,before,count,0,change,1,map,budget,r);}
+ArmSmmu4KStatus ArmSmmu4KLiveUpdateContextBatch(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *context,const ArmSmmu4KLiveRegion *lower,
+    const ArmSmmu4KLiveRegion *upper,unsigned change_upper,const ArmSmmu4KLiveVisibility *visibility,
+    const ArmSmmu4KRange *changes,size_t change_count,unsigned map,unsigned budget,ArmSmmu4KLiveResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KLiveResult){0};r->must_retain_resources=1;
+    if(change_upper>1)return ArmSmmu4KArgument;
+    const ArmSmmu4KLiveRegion *target=change_upper?upper:lower,*peer=change_upper?lower:upper;
+    if(!target || !target->state)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=context_metadata(context,lower,upper,(target->state->generation&63)==0);if(status)return status;
+    return update(target->arena,target->state,io,bank,context,visibility,target->ranges,target->count,
+        peer,changes,change_count,map,budget,r);
+}
+ArmSmmu4KStatus ArmSmmu4KLiveUpdateContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *context,const ArmSmmu4KLiveRegion *lower,
+    const ArmSmmu4KLiveRegion *upper,unsigned change_upper,const ArmSmmu4KLiveVisibility *visibility,
+    const ArmSmmu4KRange *change,unsigned map,unsigned budget,ArmSmmu4KLiveResult *r)
+{return ArmSmmu4KLiveUpdateContextBatch(io,bank,context,lower,upper,change_upper,visibility,change,1,map,budget,r);}
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4KLive.h b/iokit/Kernel/arm/a740/ArmSmmu4KLive.h
new file mode 100644
index 0000000..d796657
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4KLive.h
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_LIVE_H
+#define ARM_SMMU_4K_LIVE_H
+#include "ArmSmmu4KProgram.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    ArmSmmu4KConfig config;
+    uint64_t iova,bytes;              /* Bounded native VA aperture, no conversion. */
+    unsigned upper_region;
+    volatile uint64_t *mapping;       /* Real writable CPU mapping of owned pool. */
+    size_t capacity_pages;
+    /* Optional caller-owned scratch for the physical-alias checks (one entry per range of the smaller compared side), used by one
+     * call at a time; absent or too small, those checks compare pairwise. Never read as state. */
+    uint32_t *alias_scratch;
+    size_t alias_scratch_entries;
+} ArmSmmu4KLiveArena;
+typedef struct {
+    ArmSmmu4KResult tables;
+    uint64_t generation;
+    unsigned prepared,poisoned;
+    /* The context bank's register offset the last whole-verification update observed its image at; 0 before the first. */
+    uint64_t context_offset;
+} ArmSmmu4KLiveState;
+typedef struct {
+    void *cookie;
+    /* Clean/publish the actual mapped table page for device walks. Required
+     * even for coherent walks (where the platform may use ordering alone).
+     * Return zero only after visibility is established. No fake success. */
+    int (*publish_table_page)(void *,volatile uint64_t *,size_t bytes);
+} ArmSmmu4KLiveVisibility;
+typedef struct {
+    const ArmSmmu4KLiveArena *arena;
+    ArmSmmu4KLiveState *state;
+    const ArmSmmu4KRange *ranges;
+    size_t count;
+} ArmSmmu4KLiveRegion;
+typedef struct {
+    size_t descriptor_reads,descriptor_writes,published_pages;
+    unsigned complete,translation_removed,must_retain_resources;
+    unsigned whole_verification;   /* this update re-proved the whole region (every 64th of a region) */
+    ArmSmmu4KProgramResult synchronization;
+} ArmSmmu4KLiveResult;
+/* Prepare an INACTIVE empty native4K arena. Preallocate only real intermediate
+ * table pages; all leaf slots remain invalid. No MMIO, TLB, allocator or cache
+ * operations. The explicit leaf budget bounds aperture size and traversal.
+ * state must be zero initialized and never reset while a context can access
+ * the pool. Capacity errors do not write tables. Caller must publish all used
+ * pages before enabling a context with &state->tables. This is not activation.
+ * The pool uses a fixed owned topology; no shadow/rebuilt translation exists. */
+ArmSmmu4KStatus ArmSmmu4KLivePrepare(const ArmSmmu4KLiveArena *,ArmSmmu4KLiveState *);
+/* Read-only exact graph check, including reserved empty intermediate tables.
+ * Use before context activation and while masters are quiesced. This neither
+ * observes a context/streams nor clears poison or authorizes resource release. */
+ArmSmmu4KStatus ArmSmmu4KLiveAudit(const ArmSmmu4KLiveArena *,const ArmSmmu4KLiveState *,
+    const ArmSmmu4KRange *ranges,size_t count,ArmSmmu4KLiveResult *);
+/* Incrementally map (map=1) an entirely invalid range, or unmap (map=0) an
+ * exactly matching mapped range. Replacement requires unmap then map; valid
+ * descriptors are never overwritten with different valid descriptors.
+ * before describes ALL currently mapped resources, sorted by native IOVA.
+ * Exact physical graph checks precede/follow changes to the actual pool.
+ * No copies/reference table graphs, block mappings or table retirement.
+ *
+ * Requires a SINGLE enabled region rooted in this arena, an exclusive powered
+ * bank/ASID/stream lease, installed fault handling, and ALL masters quiesced
+ * until successful completion. Caller establishes/retains actual CPU->PA
+ * ownership, attributes, object references, data-cache ordering and queue
+ * serialization. Metadata, arrays, state/results and table storage are disjoint
+ * and immutable during each call except the explicit outputs/table writes.
+ * These conditions are platform responsibilities, not caller boolean proofs.
+ * On any uncertain context/table/cache/TLB failure the state is poisoned and
+ * all old/new resources and tables must remain owned until an independently
+ * verified quiesce/fault/disable/reset. No automatic rollback/replay occurs.
+ * Successful unmap removes translation only; it does not generate a GPU fence
+ * or establish completion of previous DMA. No hardware ownership is inferred
+ * from declared addresses. The software tests are not hardware qualification. */
+ArmSmmu4KStatus ArmSmmu4KLiveUpdate(const ArmSmmu4KLiveArena *,ArmSmmu4KLiveState *,
+    const ArmSmmu4KIo *,unsigned bank,const ArmSmmu4KContextConfig *,
+    const ArmSmmu4KLiveVisibility *,const ArmSmmu4KRange *before,size_t count,
+    const ArmSmmu4KRange *change,unsigned map,unsigned poll_budget,ArmSmmu4KLiveResult *);
+/* Full enabled-context variant: supply exactly its enabled lower/upper regions.
+ * Both actual pool graphs are audited; cross-pool resource access, pool CPU/PA
+ * aliases and inconsistent cross-region physical aliases refuse before writes.
+ * Context roots/configs must match the actual supplied arena/state pairs.
+ * AuditContext is read-only and does not observe hardware or release anything.
+ * UpdateContext edits only the selected region, publishes its changed pages,
+ * synchronizes the actual shared ASID and rechecks BOTH graphs. Any uncertainty
+ * poisons both states and retains all resources. All ownership/quiescence/cache
+ * preconditions of LiveUpdate apply to the entire context. No context switch,
+ * TTBR change, copied/converted/shadow mapping or GPU fence is implemented. */
+ArmSmmu4KStatus ArmSmmu4KLiveAuditContext(const ArmSmmu4KContextConfig *,
+    const ArmSmmu4KLiveRegion *lower,const ArmSmmu4KLiveRegion *upper,ArmSmmu4KLiveResult *);
+ArmSmmu4KStatus ArmSmmu4KLiveUpdateContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,const ArmSmmu4KLiveRegion *lower,
+    const ArmSmmu4KLiveRegion *upper,unsigned change_upper,
+    const ArmSmmu4KLiveVisibility *,const ArmSmmu4KRange *change,unsigned map,
+    unsigned poll_budget,ArmSmmu4KLiveResult *);
+/* UpdateContext for several ranges of one region in one transaction: changes are
+ * sorted by native IOVA and disjoint; map wants each entirely invalid, unmap
+ * each exactly mapped. Every check of UpdateContext covers all of them before
+ * the first store; their leaf pages are published once, the ASID synchronized
+ * once and both graphs rechecked once. A buffer of scattered physical pages is
+ * one change per page, so its mapping costs one transaction, not one per page.
+ * The changes may lie inside the target region's ranges (an unmap). */
+ArmSmmu4KStatus ArmSmmu4KLiveUpdateContextBatch(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,const ArmSmmu4KLiveRegion *lower,
+    const ArmSmmu4KLiveRegion *upper,unsigned change_upper,
+    const ArmSmmu4KLiveVisibility *,const ArmSmmu4KRange *changes,size_t change_count,
+    unsigned map,unsigned poll_budget,ArmSmmu4KLiveResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4KMmio.c b/iokit/Kernel/arm/a740/ArmSmmu4KMmio.c
new file mode 100644
index 0000000..df974ba
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4KMmio.c
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KMmio.h"
+#if !defined(__aarch64__) || __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error Direct SMMUv2 MMIO binding requires little-endian AArch64
+#endif
+static int fits(const ArmSmmu4KMmio *m,size_t at,size_t bytes)
+{return m && m->mapping && m->bytes && m->bytes-1<=UINTPTR_MAX-(uintptr_t)m->mapping && !((uintptr_t)m->mapping&7) && !(at&(bytes-1)) && at<=m->bytes && bytes<=m->bytes-at;}
+static int read32(void *cookie,size_t at,uint32_t *out)
+{ArmSmmu4KMmio *m=cookie;if(!out || !fits(m,at,4))return 1;*out=*(volatile uint32_t *)(m->mapping+at);return 0;}
+static int read64(void *cookie,size_t at,uint64_t *out)
+{ArmSmmu4KMmio *m=cookie;if(!out || !fits(m,at,8))return 1;*out=*(volatile uint64_t *)(m->mapping+at);return 0;}
+static int write32(void *cookie,size_t at,uint32_t value)
+{ArmSmmu4KMmio *m=cookie;if(!fits(m,at,4))return 1;*(volatile uint32_t *)(m->mapping+at)=value;return 0;}
+static int write64(void *cookie,size_t at,uint64_t value)
+{ArmSmmu4KMmio *m=cookie;if(!fits(m,at,8))return 1;*(volatile uint64_t *)(m->mapping+at)=value;return 0;}
+static int barrier(void *cookie)
+{(void)cookie;__asm__ volatile("dsb sy":::"memory");return 0;}
+ArmSmmu4KStatus ArmSmmu4KBindMmio(ArmSmmu4KMmio *mapping,ArmSmmu4KIo *out)
+{
+    if(!out)return ArmSmmu4KArgument;
+    *out=(ArmSmmu4KIo){0};
+    if(!mapping || !mapping->mapping || ((uintptr_t)mapping->mapping&7) || mapping->bytes<0x2c || mapping->bytes-1>UINTPTR_MAX-(uintptr_t)mapping->mapping)return ArmSmmu4KArgument;
+    out->cookie=mapping;out->register_bytes=mapping->bytes;out->read32=read32;out->read64=read64;
+    out->write32=write32;out->write64=write64;out->barrier=barrier;
+    return ArmSmmu4KSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4KMmio.h b/iokit/Kernel/arm/a740/ArmSmmu4KMmio.h
new file mode 100644
index 0000000..52a2d37
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4KMmio.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_MMIO_H
+#define ARM_SMMU_4K_MMIO_H
+#include "ArmSmmu4KProgram.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {volatile unsigned char *mapping;size_t bytes;} ArmSmmu4KMmio;
+/* AArch64 little-endian direct volatile MMIO adapter, with dsb sy barriers.
+ * Caller supplies an owned live Device mapping. This allocates/maps nothing,
+ * powers nothing and cannot recover a synchronous external bus abort. All
+ * inputs/output must be disjoint and retained for the I/O object's lifetime.
+ * Never bind arbitrary physical/virtual addresses or ordinary user buffers
+ * as a hardware mapping. Software tests are explicitly separate fixtures. */
+ArmSmmu4KStatus ArmSmmu4KBindMmio(ArmSmmu4KMmio *,ArmSmmu4KIo *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4KProgram.c b/iokit/Kernel/arm/a740/ArmSmmu4KProgram.c
new file mode 100644
index 0000000..2cb6695
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4KProgram.c
@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KProgram.h"
+#define FSR_FAULT UINT32_C(0xc00001fe)
+static int read_image(const ArmSmmu4KIo *io,size_t gr1,size_t cb,unsigned bank,
+    ArmSmmu4KContextImage *v)
+{
+    v->reserved_zero=0;
+    return io->read32(io->cookie,gr1+bank*4,&v->cbar) ||
+        io->read32(io->cookie,gr1+0x800+bank*4,&v->cba2r) ||
+        io->read32(io->cookie,cb+0x30,&v->tcr) ||
+        io->read32(io->cookie,cb+0x10,&v->tcr2) ||
+        io->read64(io->cookie,cb+0x20,&v->ttbr0) ||
+        io->read64(io->cookie,cb+0x28,&v->ttbr1) ||
+        io->read32(io->cookie,cb+0x38,&v->mair0) ||
+        io->read32(io->cookie,cb+0x3c,&v->mair1) ||
+        io->read32(io->cookie,cb,&v->sctlr);
+}
+static int write32(const ArmSmmu4KIo *io,size_t at,uint32_t value,ArmSmmu4KProgramResult *r)
+{
+    ++r->writes;return io->write32(io->cookie,at,value);
+}
+static int write64(const ArmSmmu4KIo *io,size_t at,uint64_t value,ArmSmmu4KProgramResult *r)
+{
+    ++r->writes;return io->write64(io->cookie,at,value);
+}
+/* TLBIASID (+0x610, value = ASID) or, with all set, TLBIALL (+0x618, value ignored), then TLBSYNC/TLBSTATUS. */
+static ArmSmmu4KStatus sync_tlb(const ArmSmmu4KIo *io,size_t cb,unsigned asid,unsigned all,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    r->tlb_synchronized=0;
+    if(io->barrier(io->cookie) || write32(io,cb+(all?0x618:0x610),all?0:asid,r) ||
+        write32(io,cb+0x7f0,UINT32_MAX,r) || io->barrier(io->cookie))return ArmSmmu4KIoError;
+    for(unsigned i=0;i<budget;++i) {
+        uint32_t status;++r->poll_reads;
+        if(io->read32(io->cookie,cb+0x7f4,&status))return ArmSmmu4KIoError;
+        if(!(status&1)) {
+            /* Order the completed device observation before callers recycle
+             * normal-memory tables or publish subsequent context work. */
+            if(io->barrier(io->cookie))return ArmSmmu4KIoError;
+            r->tlb_synchronized=1;return ArmSmmu4KSuccess;
+        }
+    }
+    return ArmSmmu4KTimeout;
+}
+static ArmSmmu4KStatus sync_asid(const ArmSmmu4KIo *io,size_t cb,unsigned asid,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    return sync_tlb(io,cb,asid,0,budget,r);
+}
+static ArmSmmu4KStatus disable_sync(const ArmSmmu4KIo *io,size_t cb,unsigned asid,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    r->must_retain_tables=1;r->disabled_verified=0;
+    uint32_t value;
+    if(write32(io,cb,0,r) || io->barrier(io->cookie) || io->read32(io->cookie,cb,&value))return ArmSmmu4KIoError;
+    if(value)return ArmSmmu4KStateMismatch;
+    r->disabled_verified=1;r->enabled=0;
+    ArmSmmu4KStatus status=sync_asid(io,cb,asid,budget,r);
+    if(status==ArmSmmu4KSuccess)r->must_retain_tables=0;
+    return status;
+}
+static ArmSmmu4KStatus prepare(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r,
+    ArmSmmu4KContextConfig *actual,ArmSmmu4KContextImage *image,size_t *gr1)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KProgramResult){0};
+    r->must_retain_tables=1;
+    if(!io || !config || !io->read32 || !io->read64 || !io->write32 || !io->write64 ||
+        !io->barrier || io->register_bytes<0x2c || !budget || budget>1048576 || bank>255)return ArmSmmu4KArgument;
+    r->phase=1;
+    if(io->read32(io->cookie,0x20,&r->id0) || io->read32(io->cookie,0x24,&r->id1) ||
+        io->read32(io->cookie,0x28,&r->id2))return ArmSmmu4KIoError;
+    unsigned shift=(r->id1>>31)?16:12;
+    size_t pages=(size_t)1<<(((r->id1>>28)&7)+1);
+    size_t stride=(size_t)1<<shift;
+    unsigned banks=r->id1&255,s2=(r->id1>>16)&255;
+    if(!banks || banks>pages || s2>banks || bank<s2 || bank>=banks ||
+        io->register_bytes<2*pages*stride)return ArmSmmu4KUnsupported;
+    *gr1=stride;r->context_offset=(pages+bank)*stride;
+    if(r->context_offset>io->register_bytes || io->register_bytes-r->context_offset<0x7f8 ||
+        *gr1+0x804+bank*4>io->register_bytes)return ArmSmmu4KBadRange;
+    *actual=*config;actual->id0=r->id0;actual->id2=r->id2;
+    return ArmSmmu4KEncodeContext(actual,image);
+}
+ArmSmmu4KStatus ArmSmmu4KProgramDisabledContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    ArmSmmu4KContextConfig actual;ArmSmmu4KContextImage image;size_t gr1;
+    ArmSmmu4KStatus status=prepare(io,bank,config,budget,r,&actual,&image,&gr1);
+    if(status!=ArmSmmu4KSuccess)return status;
+    size_t cb=(size_t)r->context_offset;uint32_t sctlr;
+    if(io->read32(io->cookie,cb,&sctlr))return ArmSmmu4KIoError;
+    if(sctlr&1){r->enabled=1;return ArmSmmu4KBusy;}
+    r->must_retain_tables=1;r->phase=2;
+    /* A disabled owned bank only. TCR2/TCR precede all TTBR accesses. */
+    if(write32(io,cb,0,r) || io->barrier(io->cookie) ||
+        write32(io,gr1+0x800+bank*4,image.cba2r,r) || write32(io,gr1+bank*4,image.cbar,r) ||
+        write32(io,cb+0x10,image.tcr2,r) || write32(io,cb+0x30,image.tcr,r) ||
+        write64(io,cb+0x20,image.ttbr0,r) || write64(io,cb+0x28,image.ttbr1,r) ||
+        write32(io,cb+0x38,image.mair0,r) || write32(io,cb+0x3c,image.mair1,r) ||
+        write32(io,cb+0x58,UINT32_MAX,r)) {status=ArmSmmu4KIoError;goto failed;}
+    status=sync_asid(io,cb,actual.asid,budget,r);if(status!=ArmSmmu4KSuccess)goto failed;
+    r->phase=3;
+    if(read_image(io,gr1,cb,bank,&r->readback)) {status=ArmSmmu4KIoError;goto failed;}
+    r->readback_valid=1;
+    /* Verify configuration while M is still zero; never enable a bad granule. */
+    sctlr=r->readback.sctlr;r->readback.sctlr=image.sctlr;
+    status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);r->readback.sctlr=sctlr;
+    if(status!=ArmSmmu4KSuccess || sctlr) {status=ArmSmmu4KStateMismatch;goto failed;}
+    r->readback_valid=0;
+    if(io->barrier(io->cookie) || write32(io,cb,image.sctlr,r) || io->barrier(io->cookie)) {status=ArmSmmu4KIoError;goto failed;}
+    r->phase=4;
+    if(read_image(io,gr1,cb,bank,&r->readback)) {status=ArmSmmu4KIoError;goto failed;}
+    r->readback_valid=1;r->enabled=r->readback.sctlr&1;
+    if(io->read32(io->cookie,cb+0x58,&r->fault_status)) {status=ArmSmmu4KIoError;goto failed;}
+    status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);if(status!=ArmSmmu4KSuccess)goto failed;
+    if(r->fault_status&FSR_FAULT) {status=ArmSmmu4KFault;goto failed;}
+    r->phase=5;r->enabled=1;return ArmSmmu4KSuccess;
+failed:
+    /* Even a reported failed write may have reached hardware. On uncertainty
+     * retain all tables/leases; never claim safe recycling after timeout. */
+    r->readback_valid=0;(void)disable_sync(io,cb,actual.asid,budget,r);
+    r->phase=6;return status;
+}
+ArmSmmu4KStatus ArmSmmu4KDisableOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    ArmSmmu4KContextConfig actual;ArmSmmu4KContextImage image;size_t gr1;
+    ArmSmmu4KStatus status=prepare(io,bank,config,budget,r,&actual,&image,&gr1);
+    if(status!=ArmSmmu4KSuccess)return status;
+    size_t cb=(size_t)r->context_offset;r->must_retain_tables=1;
+    if(read_image(io,gr1,cb,bank,&r->readback))return ArmSmmu4KIoError;
+    r->readback_valid=1;uint32_t sctlr=r->readback.sctlr;
+    /* An enabled bank must match the owned image (ValidateContextReadback, with its documented read-only bits); a
+     * disabled one is compared with SCTLR substituted. */
+    if(sctlr)status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);
+    else {r->readback.sctlr=image.sctlr;status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);r->readback.sctlr=sctlr;}
+    if(status!=ArmSmmu4KSuccess)return status; /* Another context: do not touch. */
+    r->readback_valid=0;status=disable_sync(io,cb,actual.asid,budget,r);r->phase=status==ArmSmmu4KSuccess?7:6;
+    return status;
+}
+
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,ArmSmmu4KProgramResult *r)
+{
+    ArmSmmu4KContextConfig actual;ArmSmmu4KContextImage image;size_t gr1;
+    ArmSmmu4KStatus status=prepare(io,bank,config,1,r,&actual,&image,&gr1);
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(read_image(io,gr1,(size_t)r->context_offset,bank,&r->readback))return ArmSmmu4KIoError;
+    r->readback_valid=1;r->enabled=r->readback.sctlr&1;
+    status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(io->read32(io->cookie,(size_t)r->context_offset+0x58,&r->fault_status) || io->barrier(io->cookie))return ArmSmmu4KIoError;
+    if(r->fault_status&FSR_FAULT)return ArmSmmu4KFault;
+    r->phase=8;return ArmSmmu4KSuccess;
+}
+
+static ArmSmmu4KStatus synchronize(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned all,unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KProgramResult){0};r->must_retain_tables=1;
+    if(!budget || budget>1048576)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=ArmSmmu4KObserveOwnedContext(io,bank,config,r);
+    if(status!=ArmSmmu4KSuccess)return status;
+    status=sync_tlb(io,(size_t)r->context_offset,config->asid,all,budget,r);
+    if(status!=ArmSmmu4KSuccess)return status;
+    ArmSmmu4KProgramResult after;
+    status=ArmSmmu4KObserveOwnedContext(io,bank,config,&after);
+    r->readback=after.readback;r->readback_valid=after.readback_valid;
+    r->fault_status=after.fault_status;r->enabled=after.enabled;
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(r->id0!=after.id0 || r->id1!=after.id1 || r->id2!=after.id2 ||
+        r->context_offset!=after.context_offset)return ArmSmmu4KStateMismatch;
+    r->phase=9;return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KSyncContextTlb(const ArmSmmu4KIo *io,uint64_t context_offset,unsigned asid,unsigned all,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KProgramResult){0};r->must_retain_tables=1;
+    if(!io || !io->write32 || !io->read32 || !io->barrier || !budget || budget>1048576 || !context_offset ||
+        context_offset>io->register_bytes || io->register_bytes-context_offset<0x7f8)return ArmSmmu4KArgument;
+    r->context_offset=context_offset;
+    ArmSmmu4KStatus status=sync_tlb(io,(size_t)context_offset,asid,all,budget,r);
+    if(status==ArmSmmu4KSuccess)r->phase=9;
+    return status;
+}
+ArmSmmu4KStatus ArmSmmu4KSynchronizeOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{return synchronize(io,bank,config,0,budget,r);}
+ArmSmmu4KStatus ArmSmmu4KInvalidateAllOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{return synchronize(io,bank,config,1,budget,r);}
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4KProgram.h b/iokit/Kernel/arm/a740/ArmSmmu4KProgram.h
new file mode 100644
index 0000000..25ccf6d
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4KProgram.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_PROGRAM_H
+#define ARM_SMMU_4K_PROGRAM_H
+#include "ArmSmmu4KContext.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Byte offsets are relative to one real, owned SMMUv2 MMIO mapping. All I/O
+ * callbacks return 0 on success. read/write64 must perform actual aligned
+ * 64-bit TTBR accesses; barrier orders table visibility and device writes.
+ * A barrier is NOT cache cleaning. No callback may silently fake success. */
+typedef struct {
+    void *cookie;
+    size_t register_bytes;
+    int (*read32)(void *,size_t,uint32_t *);
+    int (*read64)(void *,size_t,uint64_t *);
+    int (*write32)(void *,size_t,uint32_t);
+    int (*write64)(void *,size_t,uint64_t);
+    int (*barrier)(void *);
+} ArmSmmu4KIo;
+typedef struct {
+    uint64_t context_offset;
+    uint32_t id0,id1,id2,phase,writes,poll_reads,fault_status;
+    uint32_t readback_valid,enabled,disabled_verified,tlb_synchronized,must_retain_tables;
+    ArmSmmu4KContextImage readback;
+} ArmSmmu4KProgramResult;
+
+/* REAL register programming primitive, not a device-discovery/ownership layer.
+ * Caller MUST hold an exclusive bank/ASID/stream lease, keep the device powered
+ * and clocked, quiesce/fault its streams, install its fault interrupt handler,
+ * establish platform ACTLR/security requirements, and clean/publish real owned
+ * native4K tables before calling. Every argument/result must be disjoint.
+ * Reads actual ID0/ID1/ID2 through I/O and overrides config's supplied IDs.
+ * Refuses enabled banks before any write. Enables SCTLR only after register
+ * readback and bounded ASID invalidation/synchronization. No global reset,
+ * stream reassignment or other bank is touched. On failure attempts disable
+ * and sync; must_retain_tables stays set unless both are confirmed. Success
+ * also retains table ownership while the installed context is active.
+ * This does not walk tables or establish actual GPU execution/correctness. */
+ArmSmmu4KStatus ArmSmmu4KProgramDisabledContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* Read-only observation of actual IDs and all owned context registers. Requires
+ * exact enabled native4K image and no pending context fault. Does not walk the
+ * physical tables or establish ownership. Readback is a momentary observation;
+ * callers retain resources, quiescence/exclusive lease and fault handling. */
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,ArmSmmu4KProgramResult *);
+/* Publish already cleaned descriptor changes with a real ASID invalidation
+ * and bounded context TLBSYNC. Observe the complete enabled native4K image and
+ * faults before and after. Caller exclusively owns this bank/ASID, serializes
+ * all page-table updates and keeps every master quiesced. A barrier is not a
+ * cache clean. No SCTLR/TTBR/stream writes or recovery/reset are performed.
+ * Any failure retains all mappings/resources; success is not a GPU fence. */
+ArmSmmu4KStatus ArmSmmu4KSynchronizeOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* TLBIASID (or, with all set, TLBIALL) and the bounded TLBSYNC of the context bank at context_offset alone: no image or fault
+ * observation. For a caller that observed this owned bank's image at that offset already and keeps it owned (the live updater
+ * between its whole-verification updates). */
+ArmSmmu4KStatus ArmSmmu4KSyncContextTlb(const ArmSmmu4KIo *,uint64_t context_offset,unsigned asid,unsigned all,
+    unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* As ArmSmmu4KSynchronizeOwnedContext, but with TLBIALL for the bank instead of TLBIASID: every cached translation of the bank goes,
+ * whatever ASID it was tagged with. */
+ArmSmmu4KStatus ArmSmmu4KInvalidateAllOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* Disable only if actual stage/format/roots/ASID/attributes still match the
+ * expected owned context. Retain bank, mappings and tables on any uncertainty.
+ * Does not release the caller's lease or power/stream/interrupt resources. */
+ArmSmmu4KStatus ArmSmmu4KDisableOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4KStreams.c b/iokit/Kernel/arm/a740/ArmSmmu4KStreams.c
new file mode 100644
index 0000000..4145ef2
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4KStreams.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KStreams.h"
+#define FAULT (UINT32_C(2)<<16)
+static int rd(const ArmSmmu4KIo *io,size_t at,uint32_t *v,ArmSmmu4KStreamResult *r)
+{++r->reads;return io->read32(io->cookie,at,v);}
+static int wr(const ArmSmmu4KIo *io,size_t at,uint32_t v,ArmSmmu4KStreamResult *r)
+{++r->writes;return io->write32(io->cookie,at,v);}
+static unsigned exids(uint32_t id){return (id>>8)&1;}
+static uint32_t valid_smr(uint32_t id){return exids(id)?0:UINT32_C(1)<<31;}
+static uint32_t valid_s2cr(uint32_t id){return exids(id)?1u<<10:0;}
+static int valid(uint32_t id,uint32_t smr,uint32_t s2cr)
+{return exids(id)?!!(s2cr&(1u<<10)):!!(smr&(UINT32_C(1)<<31));}
+static ArmSmmu4KStatus global(const ArmSmmu4KIo *io,ArmSmmu4KStreamResult *r)
+{
+    if(!io || !io->read32 || !io->write32 || !io->barrier || io->register_bytes<0xc04)return ArmSmmu4KArgument;
+    if(rd(io,0x20,&r->id0,r) || rd(io,0,&r->scr0,r) || rd(io,0x48,&r->global_fault,r))return ArmSmmu4KIoError;
+    if(!(r->id0&(1u<<27)) || !(r->id0&255) || 0xc00u+4*(r->id0&255)>io->register_bytes)return ArmSmmu4KUnsupported;
+    /* Real global enable (CLIENTPD clear), global fault reporting (GFRE/GFIE) and unmatched-stream fault
+     * policy (USFCFG). Configuration-access fault reporting (GCFGFRE/GCFGFIE) is not required: Linux sets
+     * it only in its own global reset, and firmware that owns sCR0 may leave it clear (an Adreno SMMU read
+     * 0x002f0406). It reports bad register accesses, it does not change translation or bypass. */
+    if((r->scr0&0x407)!=0x406 || !!(r->scr0&8)!=exids(r->id0))return ArmSmmu4KStateMismatch;
+    return r->global_fault?ArmSmmu4KFault:ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus scan(const ArmSmmu4KIo *io,const ArmSmmu4KStream *s,unsigned n,
+    unsigned bank,unsigned attached,ArmSmmu4KStreamResult *r)
+{
+    unsigned slots=r->id0&255;uint32_t sidmask=exids(r->id0)?0xffffu:(1u<<((r->id0>>9)&15))-1;
+    for(unsigned i=0;i<n;++i) {
+        if(s[i].slot>=slots || (s[i].sid&~sidmask))return ArmSmmu4KArgument;
+        for(unsigned j=0;j<i;++j)if(s[i].slot==s[j].slot || s[i].sid==s[j].sid)return ArmSmmu4KOverlap;
+    }
+    r->streams_verified=0;
+    for(unsigned slot=0;slot<slots;++slot) {
+        uint32_t smr,s2cr;
+        if(rd(io,0x800+4*slot,&smr,r) || rd(io,0xc00+4*slot,&s2cr,r))return ArmSmmu4KIoError;
+        unsigned own=n;
+        for(unsigned i=0;i<n;++i)if(s[i].slot==slot){own=i;break;}
+        if(own<n) {
+            unsigned live=valid(r->id0,smr,s2cr);
+            if(attached) {
+                if(smr!=(valid_smr(r->id0)|s[own].sid) || s2cr!=(bank|valid_s2cr(r->id0)))return ArmSmmu4KStateMismatch;
+            } else if((s2cr&~valid_s2cr(r->id0))!=FAULT ||
+                (live && smr!=(valid_smr(r->id0)|s[own].sid)))return ArmSmmu4KBusy;
+            ++r->streams_verified;
+        } else if(valid(r->id0,smr,s2cr)) {
+            if(!(s2cr&(3u<<16)) && (s2cr&255)==bank)return ArmSmmu4KBusy;
+            uint32_t mask=(smr>>16)&(exids(r->id0)?0xffffu:0x7fffu),id=smr&0xffff;
+            for(unsigned i=0;i<n;++i)if(!((s[i].sid^id)&~mask&sidmask))return ArmSmmu4KOverlap;
+        }
+    }
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KCheckFaultedStreams(const ArmSmmu4KIo *io,const ArmSmmu4KStream *s,
+    unsigned n,unsigned bank,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !n || n>8 || bank>255)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    return scan(io,s,n,bank,0,r);
+}
+static int quarantine(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *state,unsigned count,ArmSmmu4KStreamResult *r)
+{
+    r->streams_faulted=0;int failed=0;
+    for(unsigned i=0;i<count;++i) {
+        size_t at=0xc00+4*state->streams[i].slot;uint32_t value;
+        /* First stop translation. Only after confirmed FAULT may we restore
+         * the exact owned SID and make EXIDS matching valid again. This also
+         * handles an indeterminate/failed SMR publication without activating
+         * an old or corrupted SID from an initially invalid slot. */
+        size_t smr=0x800+4*state->streams[i].slot;
+        uint32_t match=valid_smr(state->id0)|state->streams[i].sid;
+        if(wr(io,at,FAULT,r) || io->barrier(io->cookie) || rd(io,at,&value,r) || value!=FAULT ||
+            wr(io,smr,match,r) || io->barrier(io->cookie) || rd(io,smr,&value,r) || value!=match ||
+            wr(io,at,FAULT|valid_s2cr(state->id0),r) || io->barrier(io->cookie) ||
+            rd(io,at,&value,r) || value!=(FAULT|valid_s2cr(state->id0)))failed=1;
+        else ++r->streams_faulted;
+    }
+    return failed;
+}
+static ArmSmmu4KStatus observe(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *s,
+    const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    if(r->id0!=s->id0 || r->scr0!=s->scr0)return ArmSmmu4KStateMismatch;
+    status=ArmSmmu4KObserveOwnedContext(io,s->bank,c,&r->context);if(status)return status;
+    status=scan(io,s->streams,s->count,s->bank,1,r);if(status)return status;
+    return io->barrier(io->cookie)?ArmSmmu4KIoError:ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KObserveStreams(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *s,
+    const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !s->attached || s->poisoned || !s->count || s->count>8)return ArmSmmu4KArgument;
+    return observe(io,s,c,r);
+}
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedStreams(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *s,
+    const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !s->attached || s->poisoned || !s->count || s->count>8)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    if(r->id0!=s->id0 || r->scr0!=s->scr0)return ArmSmmu4KStateMismatch;
+    status=ArmSmmu4KObserveOwnedContext(io,s->bank,c,&r->context);if(status)return status;
+    for(unsigned i=0;i<s->count;++i) {
+        uint32_t smr,s2cr;
+        if(rd(io,0x800+4*s->streams[i].slot,&smr,r) || rd(io,0xc00+4*s->streams[i].slot,&s2cr,r))return ArmSmmu4KIoError;
+        if(smr!=(valid_smr(r->id0)|s->streams[i].sid) || s2cr!=(s->bank|valid_s2cr(r->id0)))return ArmSmmu4KStateMismatch;
+        ++r->streams_verified;
+    }
+    return io->barrier(io->cookie)?ArmSmmu4KIoError:ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KAttachStreams(const ArmSmmu4KIo *io,ArmSmmu4KStreamState *state,
+    const ArmSmmu4KStream *s,unsigned n,unsigned bank,const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!state || !s || !n || n>8 || bank>255)return ArmSmmu4KArgument;
+    if(state->attempted || state->attached || state->poisoned)return ArmSmmu4KBusy;
+    r->phase=1;ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    status=ArmSmmu4KObserveOwnedContext(io,bank,c,&r->context);if(status)return status;
+    status=scan(io,s,n,bank,0,r);if(status)return status;
+    state->attempted=1;state->id0=r->id0;state->scr0=r->scr0;state->count=n;state->bank=bank;
+    for(unsigned i=0;i<n;++i)state->streams[i]=s[i];
+    unsigned touched=0;r->phase=2;
+    for(unsigned i=0;i<n;++i) {
+        uint32_t value;size_t smr=0x800+4*s[i].slot,s2cr=0xc00+4*s[i].slot;
+        touched=i+1;
+        /* In EXIDS mode make this leased slot invalid until its new SID is
+         * installed. All masters are quiesced, and unmatched SIDs fault. */
+        if(wr(io,s2cr,bank,r) || io->barrier(io->cookie) || rd(io,s2cr,&value,r)) {status=ArmSmmu4KIoError;goto failed;}
+        if(value!=bank){status=ArmSmmu4KStateMismatch;goto failed;}
+        if(wr(io,smr,valid_smr(r->id0)|s[i].sid,r) || io->barrier(io->cookie) || rd(io,smr,&value,r)) {status=ArmSmmu4KIoError;goto failed;}
+        if(value!=(valid_smr(r->id0)|s[i].sid)){status=ArmSmmu4KStateMismatch;goto failed;}
+        if(exids(r->id0) && (wr(io,s2cr,bank|valid_s2cr(r->id0),r) || io->barrier(io->cookie))) {status=ArmSmmu4KIoError;goto failed;}
+    }
+    r->phase=3;status=observe(io,state,c,r);if(status)goto failed;
+    state->attached=1;r->phase=4;return ArmSmmu4KSuccess;
+failed:
+    state->poisoned=1;state->attached=0;r->phase=5;
+    (void)quarantine(io,state,touched,r);return status;
+}
+ArmSmmu4KStatus ArmSmmu4KFaultStreams(const ArmSmmu4KIo *io,ArmSmmu4KStreamState *s,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !s->attached || s->poisoned || !s->count || s->count>8)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    if(r->id0!=s->id0 || r->scr0!=s->scr0)return ArmSmmu4KStateMismatch;
+    status=scan(io,s->streams,s->count,s->bank,1,r);if(status)return status;
+    r->phase=6;
+    if(quarantine(io,s,s->count,r)){s->poisoned=1;s->attached=0;return ArmSmmu4KIoError;}
+    s->attached=0;r->phase=7;return ArmSmmu4KSuccess;
+}
diff --git a/iokit/Kernel/arm/a740/ArmSmmu4KStreams.h b/iokit/Kernel/arm/a740/ArmSmmu4KStreams.h
new file mode 100644
index 0000000..56d3d2e
--- /dev/null
+++ b/iokit/Kernel/arm/a740/ArmSmmu4KStreams.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_STREAMS_H
+#define ARM_SMMU_4K_STREAMS_H
+#include "ArmSmmu4KProgram.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {unsigned slot;uint16_t sid;} ArmSmmu4KStream;
+typedef struct {
+    unsigned attempted,attached,poisoned,count,bank;
+    uint32_t id0,scr0;
+    ArmSmmu4KStream streams[8];
+} ArmSmmu4KStreamState;
+typedef struct {
+    unsigned phase,reads,writes,streams_verified,streams_faulted,must_retain_resources;
+    uint32_t id0,scr0,global_fault;
+    ArmSmmu4KProgramResult context;
+} ArmSmmu4KStreamResult;
+/* Read-only preflight of global fault policy, target faulting slots and all
+ * conflicting live routes, including unrelated SIDs using the selected bank.
+ * Intended before programming a disabled context under the same global lease. */
+ArmSmmu4KStatus ArmSmmu4KCheckFaultedStreams(const ArmSmmu4KIo *,const ArmSmmu4KStream *,
+    unsigned count,unsigned bank,ArmSmmu4KStreamResult *);
+/* Native SMMUv2 exact stream matching (SMS), both legacy and EXIDS layouts.
+ * Caller owns the listed slots, bank/ASID, mappings and a global configuration
+ * lock. All client masters MUST remain quiesced until successful attachment.
+ * Requires live powered MMIO and installed context/global fault handlers,
+ * active native4K context/tables with verified physical ownership/coherence,
+ * and global fault-on-unmatched (no bypass). Global setup/quirks and context
+ * creation belong to the platform; no global reset or mask probing occurs.
+ * All target S2CRs must already fault; valid target SMRs must be exact matches.
+ * Every other active SMR is checked for overlapping requested SIDs. No masked
+ * attachment, bypass, privilege override, implicit slot selection or context
+ * reassignment is supported. Reads actual ID0 and enabled context registers.
+ * Inputs/state/result must be disjoint; state is zero-initialized and remains
+ * exclusively owned. Configuration/tables remain immutable while attached.
+ * Writes S2CR before publishing SMR; EXIDS keeps EXIDVALID clear until the
+ * exact SMR has been read back. Success rereads actual context/stream state.
+ * Any failure after a mutation attempt faults only the leased touched slots,
+ * poisons state and forbids replay. Resources are retained on EVERY outcome.
+ * Successful software I/O fixtures are not proof of active hardware tables. */
+ArmSmmu4KStatus ArmSmmu4KAttachStreams(const ArmSmmu4KIo *,ArmSmmu4KStreamState *,
+    const ArmSmmu4KStream *,unsigned count,unsigned bank,const ArmSmmu4KContextConfig *,ArmSmmu4KStreamResult *);
+/* Read-only, checks all routes/conflicts/global fault policy and complete
+ * enabled native4K context image. No fault clear or recovery is synthesized. */
+ArmSmmu4KStatus ArmSmmu4KObserveStreams(const ArmSmmu4KIo *,const ArmSmmu4KStreamState *,
+    const ArmSmmu4KContextConfig *,ArmSmmu4KStreamResult *);
+/* Read-only, the global fault policy, the complete enabled native4K context
+ * image and the exact owned routes, without the scan of every other slot for
+ * conflicting routes: a fixed read count however many slots the SMMU has. A
+ * route another agent added later is only seen by ArmSmmu4KObserveStreams,
+ * which a caller observing this way must still run at a bounded interval. */
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedStreams(const ArmSmmu4KIo *,const ArmSmmu4KStreamState *,
+    const ArmSmmu4KContextConfig *,ArmSmmu4KStreamResult *);
+/* Require exact owned active routes before changing them to FAULT. SMRs stay
+ * valid, so those SIDs remain blocked. Does not drain transactions/TLBs, stop
+ * devices, disable context, release ownership or authorize freeing tables.
+ * Failure poisons state; external real reset/recovery is required. */
+ArmSmmu4KStatus ArmSmmu4KFaultStreams(const ArmSmmu4KIo *,ArmSmmu4KStreamState *,ArmSmmu4KStreamResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/a740/GpuPowerBoard.h b/iokit/Kernel/arm/a740/GpuPowerBoard.h
new file mode 100644
index 0000000..83bec65
--- /dev/null
+++ b/iokit/Kernel/arm/a740/GpuPowerBoard.h
@@ -0,0 +1,409 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// ishtar (SM8550) Adreno power/clock observation: board facts plus the staged, gated read sequence. Every offset names its
+// source. Nothing here touches hardware; GpuPowerProbe.cpp owns the MMIO. Host-tested by GpuPowerBoardTests.c.
+//
+// Why staged: the GPU SMMU, GPUCC and the GPU register window sit behind clocks and power domains that Darwin has no driver
+// for. Reading a block whose clock or rail is off can hang the bus (reset) instead of failing, so each stage runs only if the
+// previous one showed its prerequisite on, and the first hardware boot learns the whole chain in one photo.
+#ifndef ISHTAR_GPU_POWER_BOARD_H
+#define ISHTAR_GPU_POWER_BOARD_H
+#include <stdint.h>
+
+// sm8550.dtsi (pinned ianchb/sm8550-mainline 42f3b40c): clock-controller@100000 (GCC), gpucc: clock-controller@3d90000 size 0xa000,
+// adreno_smmu: iommu@3da0000 size 0x40000, gpu: gpu@3d00000 size 0x40000.
+#define GPB_GCC_BASE 0x00100000ULL
+#define GPB_GCC_SIZE 0x1000ULL            // only the 0x71000 page and 0x52000 vote page are read, mapped separately
+#define GPB_GCC_GPU_PAGE 0x00171000ULL    // GCC_BASE + 0x71000
+#define GPB_GCC_VOTE_PAGE 0x00152000ULL   // GCC_BASE + 0x52000
+#define GPB_GPUCC_BASE 0x03d90000ULL
+#define GPB_GPUCC_SIZE 0xa000ULL
+#define GPB_SMMU_BASE 0x03da0000ULL
+#define GPB_SMMU_GR0_SIZE 0x1000ULL       // global space 0 only: the apps_smmu abort happened on the first gr1 read
+#define GPB_GPU_BASE 0x03d00000ULL
+#define GPB_GPU_WINDOW 0x1000ULL          // one page is enough for RBBM_STATUS
+
+// gcc-sm8550.c: gcc_gpu_cfg_ahb_clk 0x71004 is enabled by the driver probe (qcom_branch_set_clk_en(regmap, 0x71004));
+// gcc_gpu_memnoc_gfx_clk halt/enable 0x71010 (voted); gcc_gpu_snoc_dvm_gfx_clk 0x71018; gcc_gpu_gpll0_clk_src enable 0x52000 bit 15,
+// gcc_gpu_gpll0_div_clk_src bit 16.
+// Offsets below are relative to the mapped page (0x71000 for the GPU branches, 0x52000 for the PLL vote register).
+#define GPB_GCC_GPU_CFG_AHB 0x004
+#define GPB_GCC_GPU_MEMNOC_GFX 0x010
+#define GPB_GCC_GPU_SNOC_DVM_GFX 0x018
+#define GPB_GCC_PLL_VOTE 0x000
+#define GPB_CBCR_CLK_OFF (1u << 31)       // clk-branch.c: BRANCH_CLK_OFF; a running branch reads 0
+#define GPB_CBCR_ENABLE (1u << 0)
+
+// gpucc-sm8550.c: gpu_cc_cx_gdsc gdscr 0x9108, gpu_cc_gx_gdsc gdscr 0x905c; gpu_cc_ahb_clk 0x911c; gpu_cc_cx_gmu_clk 0x913c;
+// gpu_cc_hlos1_vote_gpu_smmu_clk 0x7000. gdsc.c: PWR_ON_MASK BIT(31), SW_COLLAPSE_MASK BIT(0).
+#define GPB_CC_CX_GDSCR 0x9108
+#define GPB_CC_GX_GDSCR 0x905c
+#define GPB_CC_AHB_CLK 0x911c
+#define GPB_CC_CX_GMU_CLK 0x913c
+#define GPB_CC_SMMU_VOTE_CLK 0x7000
+#define GPB_CC_CX_GDS_HW_CTRL 0x953c      // gpu_cc_cx_gdsc.gds_hw_ctrl: with it set, gdsc.c polls PWR_ON here (VOTABLE)
+#define GPB_GDSC_RETAIN_MEM (1u << 14)    // gdsc.c RETAIN_MEM / RETAIN_PERIPH, set by gdsc_force_mem_on; RETAIN_FF_ENABLE bit 11
+#define GPB_GDSC_RETAIN_PERIPH (1u << 13)
+#define GPB_GDSC_RETAIN_FF (1u << 11)
+#define GPB_GDSC_POLL_US 2000             // STATUS_POLL_TIMEOUT_US in gdsc.c
+#define GPB_GDSC_PWR_ON (1u << 31)
+#define GPB_GDSC_SW_COLLAPSE (1u << 0)
+
+// ARM SMMUv2 global space 0 (IHI 0062D.c): sCR0 0x0, ID0 0x20, ID1 0x24, ID2 0x28, sGFSR 0x48. Matches the reads of the UFS probe.
+#define GPB_SMMU_SCR0 0x0
+#define GPB_SMMU_ID0 0x20
+#define GPB_SMMU_ID1 0x24
+#define GPB_SMMU_ID2 0x28
+#define GPB_SMMU_GFSR 0x48
+#define GPB_SMMU_SMR(n) (0x800 + 4 * (n))
+#define GPB_SMMU_S2CR(n) (0xc00 + 4 * (n))
+#define GPB_SMMU_MAX_SMR 128             // GR0 is 0x1000 bytes: 0x800..0xbff holds 256 SMRs, the scan is capped
+
+// a6xx.xml: RBBM_STATUS dword offset 0x0210 (A6XX-A7XX); the Adreno register accessors in this tree scale dword offsets by 4.
+#define GPB_RBBM_STATUS_BYTES (0x0210 * 4)
+
+// Stages. A stage records "skipped" with a reason instead of reading when its prerequisite is not met.
+enum gpb_state {GPB_NOT_RUN = 0, GPB_DONE = 1, GPB_SKIPPED_PREREQ = 2, GPB_SKIPPED_MODE = 3, GPB_NOMAP = 4};
+
+struct gpb_io {
+    void *cookie;
+    int (*read32)(void *cookie, unsigned window, uint32_t offset, uint32_t *out);   // 0 on success
+    int (*write32)(void *cookie, unsigned window, uint32_t offset, uint32_t value);
+    void (*delay_us)(void *cookie, unsigned us);                                     // may be NULL (host tests that need none)
+};
+enum {GPB_WIN_GCC_GPU = 0, GPB_WIN_GCC_VOTE = 1, GPB_WIN_GPUCC = 2, GPB_WIN_SMMU = 3, GPB_WIN_GPU = 4};
+
+struct gpb_result {
+    unsigned mode;                       // 1 read-only; 2 additionally enable gcc_gpu_cfg_ahb_clk if it is off (as Linux does)
+    enum gpb_state gcc, cc, smmu, gpu;
+    uint32_t cfg_ahb, cfg_ahb_after, memnoc, dvm, pll_vote;
+    uint32_t cx_gdscr, gx_gdscr, cc_ahb, cc_smmu, cc_gmu;
+    uint32_t scr0, id0, id1, id2, gfsr;
+    uint32_t smr_valid, smr_first, smr_first_val, s2cr_first_val;
+    uint32_t rbbm_status;
+    uint32_t cx_before, cx_hwctrl, cc_smmu_before;   // mode 3: GDSCR before the vote, the polled hw_ctrl word, smmu clock before
+    unsigned powered_cx, powered_clocks;             // mode 3 actions taken (1 = the sequence ran and the status confirmed)
+    unsigned enabled_ahb;                // 1 if mode 2 wrote the enable bit
+    int io_error;
+};
+
+static inline int gpb_clock_on(uint32_t cbcr) {return (cbcr & GPB_CBCR_CLK_OFF) == 0;}
+// gcc_gpu_cfg_ahb_clk has hwcg_bit 1 (bit 1): with hardware clock gating an idle branch reads CLK_OFF=1 even though it is enabled
+// and wakes on access (docs/native-ufs.md recorded the same for the UFS branches). int-003 read 0x80000003 here, so CLK_OFF is not
+// a usable "off" test for it; the enable bit (bit 0) is. Voted branches without hwcg (gpu_cc_hlos1_vote_gpu_smmu_clk) keep CLK_OFF.
+static inline int gpb_cfg_ahb_enabled(uint32_t cbcr) {return (cbcr & GPB_CBCR_ENABLE) != 0;}
+static inline int gpb_gdsc_on(uint32_t gdscr) {return (gdscr & GPB_GDSC_PWR_ON) != 0;}
+static inline unsigned gpb_smmu_num_smr(uint32_t id0) {return id0 & 0xff;}        // IDR0.NUMSMRG
+static inline unsigned gpb_smmu_num_cb(uint32_t id1) {return id1 & 0xff;}         // IDR1.NUMCB
+
+static inline int gpb_rd(const struct gpb_io *io, struct gpb_result *r, unsigned window, uint32_t offset, uint32_t *out) {
+    uint32_t v = 0;
+    if (io->read32(io->cookie, window, offset, &v)) {r->io_error = 1; *out = 0; return -1;}
+    *out = v;
+    return 0;
+}
+
+// Runs the gated sequence. `have` is a bitmask of mapped windows (1 << GPB_WIN_*); a missing window makes its stage GPB_NOMAP.
+static inline void gpb_run(const struct gpb_io *io, unsigned mode, unsigned have, struct gpb_result *r) {
+    __builtin_memset(r, 0, sizeof *r);
+    r->mode = mode;
+    if (!mode || !(have & (1u << GPB_WIN_GCC_GPU))) {r->gcc = (mode ? GPB_NOMAP : GPB_SKIPPED_MODE); return;}
+    // Stage 1: GCC. Always safe: the same window family the touch and UFS probes already read.
+    if (gpb_rd(io, r, GPB_WIN_GCC_GPU, GPB_GCC_GPU_CFG_AHB, &r->cfg_ahb)) return;
+    gpb_rd(io, r, GPB_WIN_GCC_GPU, GPB_GCC_GPU_MEMNOC_GFX, &r->memnoc);
+    gpb_rd(io, r, GPB_WIN_GCC_GPU, GPB_GCC_GPU_SNOC_DVM_GFX, &r->dvm);
+    if (have & (1u << GPB_WIN_GCC_VOTE)) gpb_rd(io, r, GPB_WIN_GCC_VOTE, GPB_GCC_PLL_VOTE, &r->pll_vote);
+    r->cfg_ahb_after = r->cfg_ahb;
+    if (!gpb_cfg_ahb_enabled(r->cfg_ahb) && mode >= 2) {
+        // The single write Linux's gcc-sm8550 probe makes (qcom_branch_set_clk_en); mode 1 never writes.
+        if (!io->write32(io->cookie, GPB_WIN_GCC_GPU, GPB_GCC_GPU_CFG_AHB, r->cfg_ahb | GPB_CBCR_ENABLE)) {
+            r->enabled_ahb = 1;
+            gpb_rd(io, r, GPB_WIN_GCC_GPU, GPB_GCC_GPU_CFG_AHB, &r->cfg_ahb_after);
+        } else r->io_error = 1;
+    }
+    r->gcc = GPB_DONE;
+    // Stage 2: GPUCC needs gcc_gpu_cfg_ahb_clk running.
+    if (!(have & (1u << GPB_WIN_GPUCC))) r->cc = GPB_NOMAP;
+    else if (!gpb_cfg_ahb_enabled(r->cfg_ahb_after)) r->cc = GPB_SKIPPED_PREREQ;
+    else {
+        gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_CX_GDSCR, &r->cx_gdscr);
+        gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_GX_GDSCR, &r->gx_gdscr);
+        gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_AHB_CLK, &r->cc_ahb);
+        gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_SMMU_VOTE_CLK, &r->cc_smmu);
+        gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_CX_GMU_CLK, &r->cc_gmu);
+        r->cc = GPB_DONE;
+    }
+    // Mode 3 (writes, mirrors gdsc.c gdsc_enable for gpu_cc_cx_gdsc and the three clock enables Linux's adreno-smmu needs): only when
+    // GPUCC was read, CX is off and the stage-2 snapshot is sane. GX is never touched here (the GMU owns it).
+    r->cx_before = r->cx_gdscr; r->cc_smmu_before = r->cc_smmu;
+    if (mode >= 3 && r->cc == GPB_DONE && !gpb_gdsc_on(r->cx_gdscr)) {
+        uint32_t v = r->cx_gdscr, st = 0;
+        int bad = io->write32(io->cookie, GPB_WIN_GPUCC, GPB_CC_CX_GDSCR, v & ~GPB_GDSC_SW_COLLAPSE);   // gdsc_update_collapse_bit(off)
+        if (!bad) {
+            unsigned waited = 0;
+            if (io->delay_us) io->delay_us(io->cookie, 1);
+            for (;;) {                                                      // gdsc_poll_status(GDSC_ON) on gds_hw_ctrl bit 31
+                if (gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_CX_GDS_HW_CTRL, &st)) {bad = 1; break;}
+                if (gpb_gdsc_on(st) || waited >= GPB_GDSC_POLL_US) break;
+                if (io->delay_us) io->delay_us(io->cookie, 10);
+                waited += 10;
+            }
+            r->cx_hwctrl = st;
+            if (!bad && gpb_gdsc_on(st)) {
+                gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_CX_GDSCR, &v);          // gdsc_force_mem_on, then retain_ff_on, 1 us apart
+                bad |= io->write32(io->cookie, GPB_WIN_GPUCC, GPB_CC_CX_GDSCR, v | GPB_GDSC_RETAIN_MEM | GPB_GDSC_RETAIN_PERIPH);
+                if (io->delay_us) io->delay_us(io->cookie, 1);
+                bad |= io->write32(io->cookie, GPB_WIN_GPUCC, GPB_CC_CX_GDSCR, v | GPB_GDSC_RETAIN_MEM | GPB_GDSC_RETAIN_PERIPH | GPB_GDSC_RETAIN_FF);
+                if (io->delay_us) io->delay_us(io->cookie, 1);
+                gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_CX_GDSCR, &r->cx_gdscr);
+                r->powered_cx = !bad && gpb_gdsc_on(r->cx_hwctrl);
+            }
+        }
+        if (bad) r->io_error = 1;
+        if (r->powered_cx) {
+            // gpu_cc_ahb_clk (enable 0x911c bit 0, halt-delay) and gpu_cc_hlos1_vote_gpu_smmu_clk (0x7000 bit 0, voted), as the
+            // adreno_smmu DT node lists them; then wait for the voted branch's CLK_OFF to clear.
+            uint32_t a = 0, c = 0;
+            gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_AHB_CLK, &a);
+            gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_SMMU_VOTE_CLK, &c);
+            int cbad = io->write32(io->cookie, GPB_WIN_GPUCC, GPB_CC_AHB_CLK, a | GPB_CBCR_ENABLE);
+            cbad |= io->write32(io->cookie, GPB_WIN_GPUCC, GPB_CC_SMMU_VOTE_CLK, c | GPB_CBCR_ENABLE);
+            unsigned waited = 0;
+            for (;;) {
+                if (gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_SMMU_VOTE_CLK, &r->cc_smmu)) {cbad = 1; break;}
+                if (gpb_clock_on(r->cc_smmu) || waited >= 500) break;
+                if (io->delay_us) io->delay_us(io->cookie, 10);
+                waited += 10;
+            }
+            gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_AHB_CLK, &r->cc_ahb);
+            r->powered_clocks = !cbad && gpb_clock_on(r->cc_smmu);
+            if (cbad) r->io_error = 1;
+        }
+    }
+    // Stage 3: the GPU SMMU needs the CX power domain and its HLOS vote clock (adreno_smmu DT: power-domains = CX_GDSC, clocks
+    // hlos = GPU_CC_HLOS1_VOTE_GPU_SMMU_CLK). The bus/iface clocks are not required to be on for a global-space read; this is a
+    // conservative guess made visible in the rows, not a validated rule. Global space 0 only.
+    if (!(have & (1u << GPB_WIN_SMMU))) r->smmu = GPB_NOMAP;
+    else if (r->cc != GPB_DONE || !gpb_gdsc_on(r->cx_gdscr) || !gpb_clock_on(r->cc_smmu)) r->smmu = GPB_SKIPPED_PREREQ;
+    else {
+        gpb_rd(io, r, GPB_WIN_SMMU, GPB_SMMU_SCR0, &r->scr0);
+        gpb_rd(io, r, GPB_WIN_SMMU, GPB_SMMU_ID0, &r->id0);
+        gpb_rd(io, r, GPB_WIN_SMMU, GPB_SMMU_ID1, &r->id1);
+        gpb_rd(io, r, GPB_WIN_SMMU, GPB_SMMU_ID2, &r->id2);
+        gpb_rd(io, r, GPB_WIN_SMMU, GPB_SMMU_GFSR, &r->gfsr);
+        unsigned n = gpb_smmu_num_smr(r->id0);
+        if (n > GPB_SMMU_MAX_SMR) n = GPB_SMMU_MAX_SMR;
+        r->smr_first = 0xffffffffu;
+        for (unsigned i = 0; i < n; ++i) {
+            uint32_t smr = 0;
+            if (gpb_rd(io, r, GPB_WIN_SMMU, GPB_SMMU_SMR(i), &smr)) break;
+            if (smr & (1u << 31)) {                      // SMR.VALID
+                ++r->smr_valid;
+                if (r->smr_first == 0xffffffffu) {
+                    r->smr_first = i; r->smr_first_val = smr;
+                    gpb_rd(io, r, GPB_WIN_SMMU, GPB_SMMU_S2CR(i), &r->s2cr_first_val);
+                }
+            }
+        }
+        r->smmu = GPB_DONE;
+    }
+    // Stage 4: the GPU register window needs the GX domain on (RBBM_STATUS is in the GX-gated space on A7XX) and CX on.
+    if (!(have & (1u << GPB_WIN_GPU))) r->gpu = GPB_NOMAP;
+    else if (r->cc != GPB_DONE || !gpb_gdsc_on(r->cx_gdscr) || !gpb_gdsc_on(r->gx_gdscr)) r->gpu = GPB_SKIPPED_PREREQ;
+    else {
+        gpb_rd(io, r, GPB_WIN_GPU, GPB_RBBM_STATUS_BYTES, &r->rbbm_status);
+        r->gpu = GPB_DONE;
+    }
+}
+
+// Mode 5: read-only snapshot of the clocks a6xx_gmu_resume needs before a GMU cold start (DT gmu clocks ahb, gmu, cxo, axi,
+// memnoc, hub, demet) and of their sources. Linux sets gmu_clk_src to 200 MHz (the table rounds to 220 MHz = GPU_CC_PLL1 / 2,
+// parent_map_1 sel 3) and hub_clk_src to 200 MHz (GPLL0 / 3, sel 5); gpucc probe configures PLL1 (L 0x16, alpha 0xeaaa) and
+// enables CXO_AON 0x9004 / DEMET 0x900c. Offsets: gpucc-sm8550.c and clk-alpha-pll.c (LUCID_OLE) at the pinned 42f3b40c.
+#define GPB_CC_PLL1 0x1000                // gpu_cc_pll1.offset; MODE +0, OPMODE +4, L_VAL +0x10, USER_CTL +0x18
+#define GPB_PLL_MODE 0x0
+#define GPB_PLL_OPMODE 0x4
+#define GPB_PLL_L_VAL 0x10
+#define GPB_PLL_USER_CTL 0x18
+#define GPB_PLL_LOCK_DET (1u << 31)       // clk-alpha-pll.c PLL_LOCK_DET
+#define GPB_CC_GMU_RCGR 0x9318            // gpu_cc_gmu_clk_src cmd_rcgr; CFG at +4 (clk-rcg2.c: SRC_DIV 4:0, SRC_SEL 10:8)
+#define GPB_CC_HUB_RCGR 0x93ec            // gpu_cc_hub_clk_src
+#define GPB_RCG_ROOT_OFF (1u << 31)       // clk-rcg2.c CMD_ROOT_OFF
+#define GPB_CC_CXO_CLK 0x9144
+#define GPB_CC_HUB_CX_INT_CLK 0x9148
+#define GPB_CC_DEMET_CLK 0x900c
+#define GPB_GCC_DDRSS_GPU_AXI 0x154       // gcc-sm8550.c gcc_ddrss_gpu_axi_clk 0x71154, in the 0x71000 page
+
+struct gpb_gmu_clocks {
+    uint32_t pll1_mode, pll1_opmode, pll1_l, pll1_user;
+    uint32_t gmu_cmd, gmu_cfg, hub_cmd, hub_cfg;
+    uint32_t cx_gmu, cxo, hub_cx_int, demet, axi, memnoc, gpll0_vote;
+    int done;                            // 0: GPUCC was not readable, nothing was read
+};
+// A branch digit for the banner: bit 0 enable, bit 1 CLK_OFF.
+static inline unsigned gpb_branch_digit(uint32_t cbcr) {return (cbcr & GPB_CBCR_ENABLE) | ((cbcr >> 30) & 2);}
+// The GMU register blocks (gmu core, RSCC, CX_MISC) are read only when CX is on and both the GPUCC AHB clock and
+// gpu_cc_cx_gmu_clk already run; nothing in mode 5 turns them on.
+static inline int gpb_gmu_regs_readable(const struct gpb_result *r, const struct gpb_gmu_clocks *k) {
+    return k->done && gpb_gdsc_on(r->cx_gdscr) && gpb_clock_on(r->cc_ahb) && gpb_clock_on(k->cx_gmu);
+}
+static inline void gpb_read_gmu_clocks(const struct gpb_io *io, struct gpb_result *r, struct gpb_gmu_clocks *k) {
+    __builtin_memset(k, 0, sizeof *k);
+    if (r->cc != GPB_DONE || !gpb_cfg_ahb_enabled(r->cfg_ahb_after)) return;
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_MODE, &k->pll1_mode);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_OPMODE, &k->pll1_opmode);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_L_VAL, &k->pll1_l);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_USER_CTL, &k->pll1_user);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_GMU_RCGR, &k->gmu_cmd);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_GMU_RCGR + 4, &k->gmu_cfg);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_HUB_RCGR, &k->hub_cmd);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_HUB_RCGR + 4, &k->hub_cfg);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_CX_GMU_CLK, &k->cx_gmu);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_CXO_CLK, &k->cxo);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_HUB_CX_INT_CLK, &k->hub_cx_int);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_DEMET_CLK, &k->demet);
+    gpb_rd(io, r, GPB_WIN_GCC_GPU, GPB_GCC_DDRSS_GPU_AXI, &k->axi);
+    k->memnoc = r->memnoc;
+    // Read again (int-012 showed the stale stage-1 word after the bring-up had set the votes).
+    if (gpb_rd(io, r, GPB_WIN_GCC_VOTE, GPB_GCC_PLL_VOTE, &k->gpll0_vote)) k->gpll0_vote = r->pll_vote;
+    k->done = 1;
+}
+
+// Mode 6: the GMU clock bring-up a6xx_gmu_resume relies on, in Linux order (int-011 read PLL1 MODE 0x100 OPMODE 0 L 0,
+// both RCGs on XO, the GMU branches already enabled and the GPLL0 GPU votes clear):
+//   1 gcc_gpu_gpll0_clk_src / _div_clk_src votes (0x52000 bits 15/16, BRANCH_HALT_DELAY 10 us)
+//   2 clk_lucid_ole_pll_configure for gpu_cc_pll0 and gpu_cc_pll1 (the gpucc probe; PLL0 is only configured, as there)
+//   3 alpha_pll_lucid_evo_enable for PLL1 (RESET_N, OPMODE RUN, LOCK_DET within 1500 us, USER_CTL outputs, OUTCTRL)
+//   4 gpu_cc_hub_clk_src 200 MHz (GPLL0 sel 5, div 3 -> 5) and 5 gpu_cc_gmu_clk_src 220 MHz (PLL1 sel 3, div 2 -> 3), each by
+//     clk_rcg2_shared_force_enable_clear: ROOT_EN, wait ROOT_OFF clear, CFG, CMD_UPDATE until it clears (500 us), ROOT_EN off
+//   6 qcom_branch_set_clk_en for CXO_AON 0x9004 / DEMET 0x900c, then the seven DT GMU branches, waiting for cx_gmu CLK_OFF
+// A PLL that already runs is not reconfigured; any timeout stops the sequence at its step.
+#define GPB_CC_PLL0 0x0000
+#define GPB_CC_CXO_AON_CLK 0x9004
+#define GPB_PLL_OUTCTRL (1u << 0)
+#define GPB_PLL_RESET_N (1u << 2)
+#define GPB_PLL_OUT_MASK 0x7u
+#define GPB_PLL_RUN 1u
+#define GPB_RCG_UPDATE (1u << 0)
+#define GPB_RCG_ROOT_EN (1u << 1)
+#define GPB_RCG_CFG_CLEAR (0x1fu | (7u << 8) | (3u << 12) | (1u << 20))   // hid 5 bits, SRC_SEL, MODE, HW_CLK_CTRL
+#define GPB_GPLL0_VOTES ((1u << 15) | (1u << 16))
+
+struct gpb_gmu_clock_on {
+    unsigned step;                       // last step started (1..6), 7 when all passed
+    int failed;                          // 1 timeout or refusal at `step`, 2 I/O error
+    unsigned lock_polls, hub_polls, gmu_polls;
+    uint32_t pll1_mode, pll1_opmode, hub_cfg, gmu_cfg, cx_gmu;
+};
+// lucid_ole configs from gpucc-sm8550.c: offsets L 0x10 .. TEST_CTL_U2 0x38; clk_alpha_pll_write_config skips zero values.
+static inline int gpb_pll_configure(const struct gpb_io *io, struct gpb_result *r, uint32_t base, uint32_t l, uint32_t alpha) {
+    static const uint32_t off[] = {0x10, 0x14, 0x20, 0x24, 0x28, 0x18, 0x1c, 0x2c, 0x30, 0x34, 0x38};
+    const uint32_t val[] = {l | 0x44u << 16 | 0x44u << 24, alpha, 0x20485699u, 0x00182261u, 0x82aa299cu, 0, 5, 0, 3, 0x9000, 0x34};
+    uint32_t mode = 0;
+    for (unsigned i = 0; i < sizeof off / sizeof off[0]; ++i)
+        if (val[i] && io->write32(io->cookie, GPB_WIN_GPUCC, base + off[i], val[i])) return -1;
+    if (gpb_rd(io, r, GPB_WIN_GPUCC, base + GPB_PLL_MODE, &mode)) return -1;
+    if (io->write32(io->cookie, GPB_WIN_GPUCC, base + GPB_PLL_MODE, mode & ~GPB_PLL_OUTCTRL)) return -1;
+    if (io->write32(io->cookie, GPB_WIN_GPUCC, base + GPB_PLL_OPMODE, 0)) return -1;      // PLL_STANDBY
+    if (gpb_rd(io, r, GPB_WIN_GPUCC, base + GPB_PLL_MODE, &mode)) return -1;
+    return io->write32(io->cookie, GPB_WIN_GPUCC, base + GPB_PLL_MODE, mode | GPB_PLL_RESET_N);
+}
+static inline int gpb_pll_running(uint32_t mode, uint32_t opmode) {return (opmode & GPB_PLL_RUN) && (mode & GPB_PLL_OUTCTRL);}
+// 0 done, 1 timeout, -1 I/O.
+static inline int gpb_rcg_set(const struct gpb_io *io, struct gpb_result *r, uint32_t rcgr, uint32_t sel, uint32_t div,
+                              uint32_t *cfg_after, unsigned *polls) {
+    uint32_t cmd = 0, cfg = 0;
+    int timeout = 1;
+    if (gpb_rd(io, r, GPB_WIN_GPUCC, rcgr, &cmd) || io->write32(io->cookie, GPB_WIN_GPUCC, rcgr, cmd | GPB_RCG_ROOT_EN)) return -1;
+    for (unsigned i = 0; i < 500; ++i) {
+        if (gpb_rd(io, r, GPB_WIN_GPUCC, rcgr, &cmd)) return -1;
+        if (!(cmd & GPB_RCG_ROOT_OFF)) {timeout = 0; break;}
+        if (io->delay_us) io->delay_us(io->cookie, 1);
+    }
+    if (timeout) return 1;
+    if (gpb_rd(io, r, GPB_WIN_GPUCC, rcgr + 4, &cfg) ||
+        io->write32(io->cookie, GPB_WIN_GPUCC, rcgr + 4, (cfg & ~GPB_RCG_CFG_CLEAR) | sel << 8 | div)) return -1;
+    if (gpb_rd(io, r, GPB_WIN_GPUCC, rcgr, &cmd) || io->write32(io->cookie, GPB_WIN_GPUCC, rcgr, cmd | GPB_RCG_UPDATE)) return -1;
+    timeout = 1;
+    for (unsigned i = 0; i < 500; ++i) {
+        ++*polls;
+        if (gpb_rd(io, r, GPB_WIN_GPUCC, rcgr, &cmd)) return -1;
+        if (!(cmd & GPB_RCG_UPDATE)) {timeout = 0; break;}
+        if (io->delay_us) io->delay_us(io->cookie, 1);
+    }
+    if (timeout) return 1;
+    if (io->write32(io->cookie, GPB_WIN_GPUCC, rcgr, cmd & ~GPB_RCG_ROOT_EN)) return -1;
+    return gpb_rd(io, r, GPB_WIN_GPUCC, rcgr + 4, cfg_after) ? -1 : 0;
+}
+static inline int gpb_set_bit0(const struct gpb_io *io, struct gpb_result *r, unsigned w, uint32_t off) {
+    uint32_t v = 0;
+    if (gpb_rd(io, r, w, off, &v)) return -1;
+    return (v & GPB_CBCR_ENABLE) ? 0 : io->write32(io->cookie, w, off, v | GPB_CBCR_ENABLE);
+}
+static inline void gpb_gmu_clocks_on(const struct gpb_io *io, struct gpb_result *r, const struct gpb_gmu_clocks *k,
+                                     struct gpb_gmu_clock_on *o) {
+    __builtin_memset(o, 0, sizeof *o);
+    int e = 0;
+    uint32_t v = 0;
+    o->step = 1;
+    if (!k->done || !gpb_gdsc_on(r->cx_gdscr)) {o->failed = 1; return;}
+    if (gpb_rd(io, r, GPB_WIN_GCC_VOTE, GPB_GCC_PLL_VOTE, &v)) goto io;
+    if ((v & GPB_GPLL0_VOTES) != GPB_GPLL0_VOTES) {
+        if (io->write32(io->cookie, GPB_WIN_GCC_VOTE, GPB_GCC_PLL_VOTE, v | GPB_GPLL0_VOTES)) goto io;
+        if (io->delay_us) io->delay_us(io->cookie, 10);
+    }
+    o->step = 2;
+    // A running PLL is left alone; a stopped one gets the probe's configuration.
+    if (!gpb_pll_running(k->pll1_mode, k->pll1_opmode)) {
+        uint32_t m0 = 0, op0 = 0;
+        if (gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL0 + GPB_PLL_MODE, &m0) || gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL0 + GPB_PLL_OPMODE, &op0)) goto io;
+        if (!gpb_pll_running(m0, op0) && gpb_pll_configure(io, r, GPB_CC_PLL0, 0x1e, 0xbaaa)) goto io;
+        if (gpb_pll_configure(io, r, GPB_CC_PLL1, 0x16, 0xeaaa)) goto io;
+        o->step = 3;
+        if (gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_MODE, &v) ||
+            io->write32(io->cookie, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_MODE, v | GPB_PLL_RESET_N) ||
+            io->write32(io->cookie, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_OPMODE, GPB_PLL_RUN)) goto io;
+        e = 1;
+        for (unsigned i = 0; i < 1500; ++i) {
+            ++o->lock_polls;
+            if (gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_MODE, &v)) goto io;
+            if (v & GPB_PLL_LOCK_DET) {e = 0; break;}
+            if (io->delay_us) io->delay_us(io->cookie, 1);
+        }
+        if (e) {o->failed = 1; goto out;}
+        if (gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_USER_CTL, &v) ||
+            io->write32(io->cookie, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_USER_CTL, v | GPB_PLL_OUT_MASK) ||
+            gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_MODE, &v) ||
+            io->write32(io->cookie, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_MODE, v | GPB_PLL_OUTCTRL)) goto io;
+    }
+    o->step = 4;
+    e = gpb_rcg_set(io, r, GPB_CC_HUB_RCGR, 5, 5, &o->hub_cfg, &o->hub_polls);
+    if (e) {o->failed = e < 0 ? 2 : 1; goto out;}
+    o->step = 5;
+    e = gpb_rcg_set(io, r, GPB_CC_GMU_RCGR, 3, 3, &o->gmu_cfg, &o->gmu_polls);
+    if (e) {o->failed = e < 0 ? 2 : 1; goto out;}
+    o->step = 6;
+    if (gpb_set_bit0(io, r, GPB_WIN_GPUCC, GPB_CC_CXO_AON_CLK) || gpb_set_bit0(io, r, GPB_WIN_GPUCC, GPB_CC_DEMET_CLK) ||
+        gpb_set_bit0(io, r, GPB_WIN_GPUCC, GPB_CC_AHB_CLK) || gpb_set_bit0(io, r, GPB_WIN_GPUCC, GPB_CC_CX_GMU_CLK) ||
+        gpb_set_bit0(io, r, GPB_WIN_GPUCC, GPB_CC_CXO_CLK) || gpb_set_bit0(io, r, GPB_WIN_GCC_GPU, GPB_GCC_DDRSS_GPU_AXI) ||
+        gpb_set_bit0(io, r, GPB_WIN_GCC_GPU, GPB_GCC_GPU_MEMNOC_GFX) || gpb_set_bit0(io, r, GPB_WIN_GPUCC, GPB_CC_HUB_CX_INT_CLK)) goto io;
+    e = 1;
+    for (unsigned i = 0; i < 500; ++i) {
+        if (gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_CX_GMU_CLK, &o->cx_gmu)) goto io;
+        if (gpb_clock_on(o->cx_gmu)) {e = 0; break;}
+        if (io->delay_us) io->delay_us(io->cookie, 1);
+    }
+    if (e) {o->failed = 1; goto out;}
+    o->step = 7;
+    goto out;
+io:
+    o->failed = 2;
+out:
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_MODE, &o->pll1_mode);
+    gpb_rd(io, r, GPB_WIN_GPUCC, GPB_CC_PLL1 + GPB_PLL_OPMODE, &o->pll1_opmode);
+}
+
+// Formats the four status rows (47 characters each, space padded by the caller). Row text is the photo evidence.
+static inline const char *gpb_state_text(enum gpb_state s) {
+    return s == GPB_DONE ? "ok" : s == GPB_SKIPPED_PREREQ ? "skip" : s == GPB_SKIPPED_MODE ? "off" : s == GPB_NOMAP ? "nomap" : "-";
+}
+#endif
diff --git a/iokit/Kernel/arm/a740/IshtarA740Firmware.cpp b/iokit/Kernel/arm/a740/IshtarA740Firmware.cpp
new file mode 100644
index 0000000..4306d0b
--- /dev/null
+++ b/iokit/Kernel/arm/a740/IshtarA740Firmware.cpp
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: MIT */
+/* A740 firmware from the ADT node /ishtar-gpu (gmu-firmware, sqe-firmware, zap-firmware): mkadt puts the files there
+ * locally, so no Qualcomm blob is part of the kernel or this repository. */
+#include <stdint.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+extern "C" {
+const uint8_t *native_adreno_firmware_image, *native_adreno_sqe_firmware_image, *native_adreno_zap_image;
+uint64_t native_adreno_firmware_image_size, native_adreno_sqe_firmware_image_size, native_adreno_zap_image_size;
+volatile uint64_t armcpu_ipi_interrupts, armcpu_ipi_sent, armcpu_ipi_selftest_sent;
+volatile uint32_t armcpu_gic_diag_stage;
+void ishtar_a740_fw_load(void);
+}
+static void one(DTEntry e, const char *name, const uint8_t **p, uint64_t *n)
+{
+    void const *prop;
+    unsigned int size;
+    if (SecureDTGetProperty(e, name, &prop, &size) == kSuccess && size > 4) {
+        *p = (const uint8_t *)prop;
+        *n = size;
+    }
+    IOLog("ISHTAR GPU: firmware %s %u bytes\n", name, *p ? (unsigned)*n : 0u);
+}
+/* Not in this kernel: UniXNU's ArmCpu component (SPI attach goes to pe_fiq.c instead) and the G2 publish/accelerator
+ * objects. The probe checks for them. */
+extern "C" {
+void armcpu_ipi_selftest(uint64_t) {}
+void armcpu_sgi_selfprobe(uint64_t *) {}
+int ishtar_spi_attach(uint32_t, int, void (*)(void *), void *, uint32_t *, uint64_t *);   /* pexpert/arm/pe_fiq.c */
+IOReturn armcpu_spi_attach(uint32_t intid, bool edge, void (*handler)(void *), void *context, uint32_t *enabled,
+                           uint64_t *router)
+{ return ishtar_spi_attach(intid, edge, handler, context, enabled, router) ? kIOReturnBadArgument : kIOReturnSuccess; }
+volatile uint64_t armcpu_spi_unhandled, native_adreno_fence_phys;
+void *native_adreno_accelerator_allocate(void) { return nullptr; }
+/* UniXNU's GOP presenter (drivers/GopFramebuffer) is not in this kernel: the plugin's scanout stage finds no hand-off. */
+IOReturn native_gop_handoff_call(uint32_t, task_t, const void *, size_t, void *, size_t) { return kIOReturnUnsupported; }
+IOMemoryDescriptor *native_gop_handoff_memory(void) { return nullptr; }
+/* The board's UFS export log (kits/sheng/BootLog.c) is not here either: the render server's cache export is refused. */
+int boot_log_export_put(uint32_t, uint32_t, uint32_t, const void *, uint32_t) { return -1; }
+unsigned native_adreno_accelerator_instance_size(void) { return 0; }
+void native_adreno_accelerator_static_init(void) __asm__("__GLOBAL__sub_I_NativeAdrenoAccelerator.cpp");
+void native_adreno_accelerator_static_init(void) {}
+}
+void ishtar_a740_fw_load(void)
+{
+    DTEntry e;
+    if (SecureDTLookupEntry(NULL, "/ishtar-gpu", &e) != kSuccess) {
+        IOLog("ISHTAR GPU: no /ishtar-gpu ADT node (firmware missing)\n");
+        return;
+    }
+    one(e, "gmu-firmware", &native_adreno_firmware_image, &native_adreno_firmware_image_size);
+    one(e, "sqe-firmware", &native_adreno_sqe_firmware_image, &native_adreno_sqe_firmware_image_size);
+    one(e, "zap-firmware", &native_adreno_zap_image, &native_adreno_zap_image_size);
+}
diff --git a/iokit/Kernel/arm/a740/IshtarGpuPower.cpp b/iokit/Kernel/arm/a740/IshtarGpuPower.cpp
new file mode 100644
index 0000000..25c90be
--- /dev/null
+++ b/iokit/Kernel/arm/a740/IshtarGpuPower.cpp
@@ -0,0 +1,1939 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Default-off, staged read-only observation of the Adreno power and clock state. `ishtar-gpu-power=<n>`:
+//   1  read GCC GPU branches, GPUCC gdscr/branches, GPU SMMU global space 0 and RBBM_STATUS, each only when the previous stage
+//      showed its prerequisite on (GpuPowerBoard.h); no register is written
+//   2  as 1, plus the one write Linux's gcc-sm8550 probe makes: enable gcc_gpu_cfg_ahb_clk if its enable bit is clear
+//   3  as 2, plus, if GPUCC shows the CX power domain off: the gdsc.c enable sequence for gpu_cc_cx_gdsc and the gpu_cc_ahb_clk and
+//      gpu_cc_hlos1_vote_gpu_smmu_clk enables, so the SMMU global space can be read; GX and the SMMU are never programmed
+//   4  as 3, then, if the SMMU global space read cleanly with CX on and the vote clock running and no SMR valid: map the
+//      whole adreno SMMU window and build the GMU's own context through NativeAdreno (NativeAdrenoGmuContextBringup):
+//      fixed a6xx_gmu.c payload addresses, native4K TTBR0 tables, context bank 1 / ASID 1, SMR+S2CR slot 2 for the GMU
+//      stream 5 (iommus of gmu@3d6a000 at the pinned tree). Bank, ASID and slot are this probe's own choice: Linux gives
+//      bank 0 to the GPU and takes the first free SMR. The GMU itself is not booted, so no transaction uses the context.
+//      Rows 5 and 7 then show that result instead of the clock words and SMMU IDs mode 3 already recorded (int-005).
+//   5  as 4, then, only if the GMU context reached Ready, read-only GMU cold-start prerequisites: the GMU clock tree
+//      (gpb_read_gmu_clocks) in row 6; the AOP command DB (reserved-memory aop-cmd-db-region@81c60000, also reserved in
+//      the ishtar UEFI memory map, so outside the DarwinBoot window) copied with aligned reads, parsed by
+//      Sm8550GmuCommandDbInputs and turned into the HFI vote table by Sm8550GmuBuildStartup (ACD and IFPC off), plus the
+//      GMU reset/retention/RSC/HFI words when gpu_cc_cx_gmu_clk already runs, in row 7. Nothing is written. The version
+//      passed to the parser is the word just read, so a pass shows the layout, not a qualified version.
+//   6  as 5, then, between the clock snapshot and the GMU state read, the GMU clock bring-up of gpb_gmu_clocks_on (GPLL0
+//      GPU votes, gpucc PLL0/PLL1 configuration, PLL1 enable, hub 200 MHz / gmu 220 MHz, the GMU branches). Row 5 shows its
+//      result, row 6 the clock tree after it. The GMU itself stays in reset; no GMU or GPU register is written.
+//   7  as 6, then, only if the clocks came up (s7 f0), the command DB gave a startup table (p0 s0) and the GMU reads
+//      in reset and idle (1/0/0/0): the GMU cold start. a6xx_gmu_resume's interrupt clear/mask, a write-combine CPU view
+//      of the five context payloads (the GMU maps them Normal non-cacheable), then Sm8550GmuColdStart with the embedded
+//      gmu_gen70200.bin (hash-checked in full before any write) and the command-DB startup table: RSC/PDC setup,
+//      firmware load and readback, CM3 release, FW and HFI ready, then the HFI startup messages with their ACKs. Row 6
+//      shows the HFI protocol result, row 7 the load result, row 4 the GMU state before and after.
+//   8  as 7, then, only after a complete cold start, the first GPU steps of a6xx_gmu_resume / hw_init: GMU2HOST interrupt
+//      clear and mask, the HFI GX_BW_PERF_VOTE (a6xx_hfi_set_freq; perf index 1 = 220 MHz and bandwidth index 1, the
+//      lowest real levels of the command-DB tables, where Linux starts at the top one) and the OOB GPU_SET request
+//      (set bit 30, ack bit 31) that makes the GMU power GX. Row 5 shows the GX state before/after, and RBBM_STATUS /
+//      GBIF_HALT only when GX reports on. Nothing in the GPU register space is written.
+//   9  as 8, then, only when GX reports on, the rest of a6xx hw_init up to a7xx_cp_init, in Linux order: the GPU's own
+//      native-4K SMMU context (bank 0, SIDs 0/1 on SMR 0/1, as arm-smmu-qcom gives the GPU bank 0) with the SQE, ring,
+//      memptrs, power-up list and scratch buffers; the SQE copy (a740_sqe.fw minus its first dword); GBIF halt release,
+//      SECVID TSB, hwcg (a740_hwcg), QoS, UCHE, AHB, hang detect, CP protect (a730_protect), APRIV, interrupt mask; SQE
+//      base, ring, rptr shadows, SQE start; the power-up list; CP_THREAD_CONTROL + CP_ME_INIT with a timestamp fence;
+//      then one CP_MEM_WRITE to the scratch page with a second fence. UBWC and the zap shader / secure-mode exit are
+//      not done yet (ishtar uses a zap shader, so RBBM_SECVID_TRUST_CNTL is never written). Row 6 shows the GPU
+//      context, row 7 the CP result. From mode 8 on, row 4 becomes a heartbeat every two seconds once the run ends.
+//      hw_init also programs UBWC (a6xx_set_ubwc_config with the sm8550 qcom_ubwc_cfg_data). After the scratch write:
+//      the zap shader (zap_shader_load_mdt / qcom_mdt_load: PAS 13 init_image with the ELF header + hash segment,
+//      mem_setup over gpu_micro_code_mem 0x9b09a000, segment copy, auth_and_reset, all as SIP SMC calls) and, only if TZ
+//      accepted it, CP_SET_SECURE_MODE 0 with a fence (row 2); then the GPU interrupt line SPI 300 in the GIC
+//      distributor before and after RBBM_INT_CLEAR_CMD, and the CP always-on counter rate (row 3).
+// The result is drawn in diagnostic extension rows 4-7 (the GPU slots) so one photo carries the whole chain. It runs in a thread
