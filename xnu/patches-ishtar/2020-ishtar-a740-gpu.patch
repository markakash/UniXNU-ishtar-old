+	gicd_write32(0x6000 + intid * 8 + 4, (uint32_t)(aff >> 32));
+	gicd_write32(0x100 + word, bit);                                         /* ISENABLER */
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
