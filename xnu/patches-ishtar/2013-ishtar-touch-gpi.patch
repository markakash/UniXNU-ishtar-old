+static void
+ishtar_touch_probe_thread(void *arg, wait_result_t wr __unused)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline((uint32_t)(uintptr_t)arg, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&tp_pace_ms, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	int stage = 1;
+	(void)PE_parse_boot_argn("ishtartouchstage", &stage, sizeof(stage));
+	printf("ISHTAR TOUCHPROBE: deferred probe, stage %d\n", stage);
+	ishtar_touch_probe(stage);
+	printf("ISHTAR TOUCHPROBE: deferred probe done\n");
+}
