diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index d0efb31..32a9992 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -10075,6 +10075,21 @@ mkdir_extended(proc_t p, struct mkdir_extended_args *uap, __unused int32_t *retv
 	return ciferror;
 }
 
+
+#if defined(ARM64_BOARD_CONFIG_ISHTAR)
+/* bsd/dev/ishtar_push.c: mkdir of a kernel-space path as the kernel. */
+int ishtar_mkdir(const char *path, int mode);
+int
+ishtar_mkdir(const char *path, int mode)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, (mode & ACCESSPERMS));
+	return mkdir1at(vfs_context_kernel(), CAST_USER_ADDR_T(path), &va, AT_FDCWD, UIO_SYSSPACE);
+}
+#endif
+
 int
 mkdir(proc_t p, struct mkdir_args *uap, __unused int32_t *retval)
 {
