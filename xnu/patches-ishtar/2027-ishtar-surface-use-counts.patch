-IOReturn
-IOSurfaceRootUserClient::trapUseCount(__unused void *id, __unused void *category,
-    void *, void *, void *, void *)
+/*
+ * IOSurfaceIncrement/DecrementUseCount: backboardd counts the app surfaces it composes from, and the app's backing store
+ * draws only into a buffer IOSurfaceIsInUse (the u64 at +0x18 of the state page, also the display's hold) calls free. As a
+ * no-op the count stayed 0: the Clock app redrew digits into the buffer being composed (torn and old digits).
+ * ponytail: no per-client bookkeeping; a process that dies holding counts leaves its surfaces "in use" until they are freed.
+ */
+static IshtarSurface *ishtar_surface_held(IOLock *lock, OSArray *refs, uint32_t id);
+
+static IOReturn
+ishtar_surface_use(IOLock *lock, OSArray *refs, void *id, bool up)
 {
+	IshtarSurface *s = ishtar_surface_held(lock, refs, (uint32_t)(uintptr_t)id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	volatile SInt64 *count = (volatile SInt64 *)((uint8_t *)s->state->getBytesNoCopy() + 0x18);
+	if (up) {
+		OSAddAtomic64(1, count);
+	} else {
+		for (SInt64 c = *count; c > 0 && !OSCompareAndSwap64((UInt64)c, (UInt64)(c - 1), (volatile UInt64 *)count); c = *count) {
+		}
+	}
+	s->release();
 	return kIOReturnSuccess;
 }
 
+IOReturn
+IOSurfaceRootUserClient::trapIncrementUse(void *id, __unused void *category, void *, void *, void *, void *)
+{
+	return ishtar_surface_use(fLock, fRefs, id, true);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapDecrementUse(void *id, __unused void *category, void *, void *, void *, void *)
+{
+	return ishtar_surface_use(fLock, fRefs, id, false);
+}
