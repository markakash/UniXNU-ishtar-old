+	/* ishtar: SMMU state of the USB (0x40) and GPI DMA (0x436, touch SPI) streams; 0x40 decides the auto map */
+	extern int ishtar_smmu_probe_sid(unsigned sid, unsigned level);
+	usb_smmu_state = ishtar_smmu_probe_sid(0x40, 2);
+	(void)ishtar_smmu_probe_sid(0x436, 2);
 	if (enabled >= 2) {
 		ishtar_usb_gadget_start(dwc);
 	}
+	usb_probe_tail();
+	if (!ishtar_board_ref()) {
+		return;         /* ishtar: eUSB2 PHY, the QUSB2 read below is the upstream board's */
+	}
 	if (cbcr[5] & CBCR_CLK_OFF) {
