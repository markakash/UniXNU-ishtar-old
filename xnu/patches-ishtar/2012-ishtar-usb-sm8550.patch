 		return;
@@ -1286,6 +1309,26 @@ ishtar_usb_gadget_start(vm_offset_t dwc)
 		/* apps_smmu stream 0x740: the first DMA would fault and reset the SoC */
 		int se = ishtar_smmu_map_sid(0x740);
