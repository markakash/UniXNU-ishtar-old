+		}
+		if (sm < 0) {
+			sm = usb_smmu_state == 0 || usb_smmu_state == 3;
+		}
+		if (sm) {
+			printf("ISHTAR USB: apps_smmu sid 0x40 -> %d\n", ishtar_smmu_map_sid(0x40));
+		}
 	}
 
 	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
