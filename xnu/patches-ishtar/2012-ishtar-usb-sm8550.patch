 	return v;
 }
 
+/* ishtar: ishtarusbhold=N seconds on screen for the lines above. */
+static int usb_smmu_state = -1;        /* ishtar_smmu_probe_sid(0x40): 0 unmatched, 1 bypass, 2 translate, 3 fault */
+
+static void
+usb_probe_tail(void)
+{
+	int hold = 0;
+	if (PE_parse_boot_argn("ishtarusbhold", &hold, sizeof(hold)) && hold > 0 && hold <= 120) {
+		printf("ISHTAR USB: holding %d s for the camera\n", hold);
+		delay(hold * 1000000);
+	}
+}
+
 void
 ishtar_usb_probe(void)
 {
@@ -111,6 +125,7 @@ ishtar_usb_probe(void)
 	clocks_on = (gdscr & (1u << 31)) && !(cbcr[0] & CBCR_CLK_OFF) && !(cbcr[3] & CBCR_CLK_OFF);
 	if (!clocks_on) {
 		printf("ISHTAR USB: controller unpowered or unclocked; DWC3 not read\n");
