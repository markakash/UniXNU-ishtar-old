diff --git a/bsd/dev/ishtar_usb.c b/bsd/dev/ishtar_usb.c
index 996299e..d987cd4 100644
--- a/bsd/dev/ishtar_usb.c
+++ b/bsd/dev/ishtar_usb.c
@@ -16,6 +16,7 @@
 #include <kern/clock.h>
 #include <kern/thread.h>
 #include <kern/sched_prim.h>
+#include <kern/kalloc.h>
 #include <machine/machine_routines.h>
 #include <arm/caches_internal.h>
 #include <vm/pmap.h>
@@ -1054,6 +1055,81 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
  */
 extern uint32_t ishtar_log_copy(uint64_t *pos, char *out, uint32_t max);
 extern uint64_t ishtar_log_position(void);
+extern int ishtar_push_write_file(const char *path, const void *data, size_t len);      /* ishtar_push.c */
+
+/*
+ * The link dies now and then while iOS runs on, and its log dies with it. Once per boot, when the host unconfigures us or
+ * transmission stalls (frames queued or a transfer busy, no frame sent for 5 s), the controller state goes into the console
+ * ring and the ring's last 64 KiB to /private/var/ishtar-usbdrop.log (push.py --get it after the next boot).
+ */
+static void
+ud_drop_check(void)
+{
+	static bool was_up, saved;
+	static uint64_t last_tx, since;
+	const uint64_t now = mach_absolute_time();
+	uint64_t ns;
+	bool dropped = false;
+	if (ud.configured) {
+		was_up = true;
+	} else if (was_up) {
+		dropped = true;
+	}
+	if (ud.tx_frames != last_tx || (!ud.tx_busy && ud.txq_count == 0)) {
+		last_tx = ud.tx_frames;
+		since = now;
+	} else {
+		absolutetime_to_nanoseconds(now - since, &ns);
+		dropped |= ns > 5ull * NSEC_PER_SEC;
+	}
+	if (!dropped) {
+		return;
+	}
+	was_up = false;
+	since = now;
+	if (saved) {
+		goto reconnect;
+	}
+	saved = true;
+	volatile uint32_t *rx = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	volatile uint32_t *tx = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
+	ud_sync(UD_TRB_RX, 0x20);
+	printf("ISHTAR USB: DROP rx %llu tx %llu frames; cfg %d alt %u txbusy %d txq %u; rx trb %08x/%08x act %d, tx trb %08x/%08x "
+	    "act %d; DSTS 0x%08x DCTL 0x%08x GEVNTCOUNT 0x%x events %u\n", ud.rx_frames, ud.tx_frames, ud.configured, ud.data_alt,
+	    ud.tx_busy, ud.txq_count, rx[2], rx[3], ud.xfer_active[EP_RX], tx[2], tx[3], ud.xfer_active[EP_TX], dwc_rd(DSTS),
+	    dwc_rd(DCTL), dwc_rd(GEVNTCOUNT), (unsigned)ud.events);
+	char *buf = (char *)kalloc_data(65536, Z_WAITOK);
+	if (buf != NULL) {
+		uint64_t pos = ishtar_log_position();
+		pos = pos > 65536 ? pos - 65536 : 0;
+		uint32_t len = 0, n;
+		while (len < 65536 && (n = ishtar_log_copy(&pos, buf + len, 65536 - len)) > 0) {
+			len += n;
+		}
+		int err = ishtar_push_write_file("/private/var/ishtar-usbdrop.log", buf, len);
+		printf("ISHTAR USB: drop evidence %u bytes -> /private/var/ishtar-usbdrop.log (err %d)\n", len, err);
+		kfree_data(buf, 65536);
+	}
+reconnect:
+	/*
+	 * hz-2's drop: DSTS link state 3 (L2 suspend) with frames queued; we take no link-state events, and a replug brought no
+	 * disconnect event either. Soft disconnect (DCTL.RUN_STOP off until DSTS.DEVCTRLHLT, then on): the host sees an unplug
+	 * and a new device, and the bus reset path sets everything up as at boot.
+	 */
+	ud_bus_reset("soft reconnect");        /* data endpoints ended, link down for the network stack */
+	if (ud.xfer_active[0]) {
+		ud_epcmd(0, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | ((uint32_t)ud.xfer_res[0] << 16), 0, 0, 0);
+		ud.xfer_active[0] = false;
+	}
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~(1u << 31));
+	for (int i = 0; i < 500 && !(dwc_rd(DSTS) & (1u << 22)); i++) {
+		ud_sleep_ms(1);
+	}
+	ud_sleep_ms(200);
+	dwc_wr(DCTL, dwc_rd(DCTL) | (1u << 31));
+	ud_start_setup();                       /* as at start: SETUP armed for the new enumeration */
+	printf("ISHTAR USB: soft reconnect, DSTS 0x%08x DCTL 0x%08x\n", dwc_rd(DSTS), dwc_rd(DCTL));
+}
 
