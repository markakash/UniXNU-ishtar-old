diff --git a/bsd/dev/ishtar_ufs.c b/bsd/dev/ishtar_ufs.c
index 27caa07..38eee26 100644
--- a/bsd/dev/ishtar_ufs.c
+++ b/bsd/dev/ishtar_ufs.c
@@ -623,6 +623,55 @@ ufs_find_partition(const char *want)
 	return ENOENT;
 }
 
+/*
+ * ishtar (SM8550): Mu's Qualcomm UFS driver can leave the UFS power domain or its clocks off at
+ * ExitBootServices, and a host register read with the AXI/AHB clocks gated stalls the bus (the CPU
+ * hangs, nothing is printed). Check and, if needed, switch on the GDSC and the branches first.
+ * GCC offsets from Linux v6.12 drivers/clk/qcom/gcc-sm8550.c (GDSC bit31 PWR_ON, bit0 SW_COLLAPSE; CBCR
+ * bit31 CLK_OFF, bit0 CLK_ENABLE).
+ */
+#define GCC_UFS_PA         0x00177000u
+#define GCC_UFS_GDSCR      0x004u
+static const struct { const char *name; uint32_t off; } ufs_gcc_branches[] = {
+	{ "axi", 0x018 }, { "ahb", 0x024 }, { "tx_sym0", 0x028 }, { "rx_sym0", 0x02c },
+	{ "unipro", 0x068 }, { "ice", 0x074 }, { "phy_aux", 0x0b0 }, { "rx_sym1", 0x0cc }, { "aggre_axi", 0x0e4 },
+};
+
+static int
+ufs_power_check(void)
+{
+	vm_offset_t gcc = ml_io_map(GCC_UFS_PA, 0x1000);
+	if (!gcc) {
+		printf("ISHTAR UFS: GCC map failed\n");
+		return ENOMEM;
+	}
+	volatile uint32_t *gdsc = (volatile uint32_t *)(gcc + GCC_UFS_GDSCR);
+	uint32_t g = *gdsc;
+	printf("ISHTAR UFS: GDSC 0x%08x (%s)\n", g, (g & 0x80000000u) ? "on" : "OFF");
+	if (!(g & 0x80000000u)) {
+		*gdsc = g & ~1u;	/* SW_COLLAPSE = 0 */
+		for (int i = 0; i < 1000 && !(*gdsc & 0x80000000u); i++) {
+			delay(10);
+		}
+		printf("ISHTAR UFS: GDSC now 0x%08x\n", *gdsc);
+		if (!(*gdsc & 0x80000000u)) {
+			return ENXIO;
+		}
+	}
+	for (size_t i = 0; i < sizeof(ufs_gcc_branches) / sizeof(ufs_gcc_branches[0]); i++) {
+		volatile uint32_t *cbcr = (volatile uint32_t *)(gcc + ufs_gcc_branches[i].off);
+		uint32_t c = *cbcr;
+		if (c & 0x80000000u) {
+			*cbcr = c | 1u;
+			for (int n = 0; n < 1000 && (*cbcr & 0x80000000u); n++) {
+				delay(10);
+			}
+		}
+		printf("ISHTAR UFS: clk %s 0x%08x -> 0x%08x\n", ufs_gcc_branches[i].name, c, *cbcr);
+	}
+	return 0;
+}
+
 static int
 ufs_take_over_host(void)
 {
@@ -1081,6 +1130,11 @@ ishtar_ufs_init(void)
 	    su.verify, su.fua, su.retries, su.syncsecs, su.dmasync);
 
 	printf("ISHTAR UFS: init, regs 0x%lx+0x%lx\n", (unsigned long)reg[0], (unsigned long)reg[1]);
+	error = ufs_power_check();
+	if (error) {
+		printf("ISHTAR UFS: UFS power/clocks unavailable (%d), not touching the host\n", error);
+		return error;
+	}
 	su.regs = ml_io_map(reg[0], reg[1]);
 	printf("ISHTAR UFS: hce 0x%x hcs 0x%x cap 0x%x ver 0x%x is 0x%x utrlba 0x%x:%x dbr 0x%x rsr 0x%x\n",
 	    ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(REG_CAP), ufs_rd(0x08), ufs_rd(REG_IS),
