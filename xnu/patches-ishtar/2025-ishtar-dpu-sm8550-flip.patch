+	ishtar_lowpool.base = base;
+	ishtar_lowpool.pages = pages;
+	ishtar_lowpool.until = until;
+	ishtar_lowpool.minW = minW;
+	ishtar_lowpool.minH = minH;
+	ishtar_lowpool.ready = true;
