 OSDefineMetaClassAndStructors(IshtarPlatformExpert, IODTPlatformExpert);
 
+/*
+ * Bring-up heartbeat (boot-arg ishtaralive=N seconds, 0 = off): one line every N s for a minute.
+ * It sleeps on the timer, so lines appearing means timer interrupts and the scheduler work.
+ */
+static void
+ishtar_alive_thread(void *arg, wait_result_t wr __unused)
+{
+	uint32_t secs = (uint32_t)(uintptr_t)arg;
+	for (uint32_t n = 1; n * secs <= 60; n++) {
+		IOSleep(secs * 1000);
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		IOLog("ISHTAR: alive %u (%llu ms since boot)\n", n, ns / 1000000ull);
+	}
+	thread_terminate(current_thread());
+}
+
 bool
 IshtarPlatformExpert::start(IOService *provider)
 {
@@ -39,6 +59,12 @@ IshtarPlatformExpert::start(IOService *provider)
 	}
 	registerService();
 	IOLog("ISHTAR: platform expert registered\n");
+	uint32_t alive = 0;
+	thread_t thread;
+	if (PE_parse_boot_argn("ishtaralive", &alive, sizeof(alive)) && alive > 0 &&
+	    kernel_thread_start(ishtar_alive_thread, (void *)(uintptr_t)alive, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
