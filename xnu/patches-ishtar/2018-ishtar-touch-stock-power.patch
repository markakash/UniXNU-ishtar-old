+static bool
+rh8_up(void)
+{
+	if (!rh8_tcs) {
+		vm_offset_t rsc = ml_io_map(0x17a20000u, 0x4000);
+		rh8_db = ml_io_map(0x81c60000u, 0x20000);
+		if (!rsc || !rh8_db || touch_rd(rh8_db, 4) != 0x0c0330dbu || ((touch_rd(rsc, 0) >> 16) & 0xff) != 3) {
+			return false;
+		}
+		rh8_tcs = rsc + 0xd00;
+	}
+	return true;
+}
+
+/*
+ * RPMh BCM votes for the QUP2 DMA path (Linux sm8550 interconnect: QUP2 core,
+ * SN3 = aggre2 -> snoc, which carries qhm_qup2).
+ * ponytail: fixed vote of 1 unit per BCM, real bandwidth math (cmd-db aux) when needed.
+ */
+static void
+touch_bcm_votes(void)
+{
+	static const char *const names[] = { "QUP2", "SN3", "SN0", "SH0", "MC0" };
+	uint32_t addr[5], data[5], n = 0, v = 1;
+	PE_parse_boot_argn("ishtartouchbcmv", &v, sizeof(v));
+	if (!rh8_up()) {
+		return;
+	}
+	for (uint32_t k = 0; k < 5; k++) {
+		if ((addr[n] = rh8_lookup(names[k], 5))) {
+			data[n++] = (1u << 30) | (1u << 29) | (v << 14) | v;    /* commit, valid, x, y */
+		}
+	}
+	rh8_send(addr, data, n);
+}
+
+/* SPMI v7 observer read (EE 0) of one PMIC register, -1 on error; PPID = SID << 8 | periph */
+static int
+touch_spmi_rd(uint32_t ppid, uint32_t reg)
+{
+	static vm_offset_t core, obs;
+	if (!core) {
+		core = ml_io_map(0x0c400000u, 0x4000);
+		obs = ml_io_map(0x0c440000u, 0x10000);
+	}
+	for (uint32_t i = 0; core && obs && i < 512; i++) {
+		uint32_t map = touch_rd(core, 0x2000u + 4u * i);
+		if (map && ((map >> 8) & 0xfffu) == ppid) {
+			touch_wr(obs, 0x20u * i, (1u << 27) | ((reg & 0xffu) << 4));   /* EXT_READL, one byte */
+			for (int k = 0; k < 1000; k++) {
+				uint32_t st = touch_rd(obs, 0x20u * i + 8);
+				if (st & 1u) {
+					return (st & 0xeu) ? -1 : (int)(touch_rd(obs, 0x20u * i + 0x18) & 0xff);
+				}
+				delay(1);
+			}
+			return -1;
+		}
+	}
+	return -1;
+}
+
+/*
+ * Stock fts power cycle (fts.c fts_chip_power_switch) with stock regulators (HyperOS regulator_summary:
+ * spi1.0-vdd = pm_humu_l12 = L12B 1.8 V via rpmh-regulator "ldob12"; spi1.0-avdd = PM8008i L7 3.3 V):
+ * reset low, vdd on, 1 ms, avdd (stage 4), 16 ms, reset high.
+ */
+static void
+touch_power_cycle(vm_offset_t tlmm)
+{
+	vm_offset_t rst = tlmm + 117 * 0x1000u;
+	geni_w(rst, 4, 0);
+	geni_w(rst, 0, (3u << 6) | 0x200 | 3);             /* output low, 8 mA, pull-up (stock mi_ts_active_new) */
+	geni_w(tlmm + 67 * 0x1000u, 0, (3u << 6) | 3);     /* irq gpio67: input, 8 mA, pull-up */
+	printf("ISHTAR TOUCHPROBE: L12B (ppid 0x14b) before: status1 %#x en %#x vset %#x/%#x\n", touch_spmi_rd(0x14b, 0x08),
+	    touch_spmi_rd(0x14b, 0x46), touch_spmi_rd(0x14b, 0x40), touch_spmi_rd(0x14b, 0x41));
+	uint32_t a = rh8_up() ? rh8_lookup("ldob12", 4) : 0;
+	if (a) {
+		const uint32_t addr[3] = { a, a + 8, a + 4 }, data[3] = { 1800, 7, 1 };     /* mV, mode HPM, enable */
+		rh8_send(addr, data, 3);
+	}
+	delay(1000);
+	printf("ISHTAR TOUCHPROBE: L12B after vote: status1 %#x en %#x\n", touch_spmi_rd(0x14b, 0x08), touch_spmi_rd(0x14b, 0x46));
+	delay(16000);
+	geni_w(rst, 4, 2);                                 /* reset high */
+	delay(300000);
 }
 
