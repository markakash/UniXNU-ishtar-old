diff --git a/osfmk/kern/thread.c b/osfmk/kern/thread.c
index ea99a0f..d8e11e0 100644
--- a/osfmk/kern/thread.c
+++ b/osfmk/kern/thread.c
@@ -1935,6 +1935,29 @@ kernel_thread_create(
 	return result;
 }
 
+/* ishtar: every kernel thread's id and entry function (fixed table, no allocation), for the CPU probe's unnamed threads. */
+#define ISHTAR_KTHREADS 512
+static struct { uint64_t tid; uintptr_t fn; } ishtar_kthreads[ISHTAR_KTHREADS];
+static uint32_t ishtar_kthread_next;
+static void
+ishtar_kthread_note(uint64_t tid, thread_continue_t fn)
+{
+	const uint32_t i = os_atomic_inc_orig(&ishtar_kthread_next, relaxed) % ISHTAR_KTHREADS;
+	ishtar_kthreads[i].fn = (uintptr_t)fn;
+	ishtar_kthreads[i].tid = tid;
+}
+uintptr_t ishtar_kthread_entry(uint64_t tid);
+uintptr_t
+ishtar_kthread_entry(uint64_t tid)
+{
+	for (uint32_t i = 0; i < ISHTAR_KTHREADS; i++) {
+		if (ishtar_kthreads[i].tid == tid) {
+			return VM_KERNEL_UNSLIDE(ishtar_kthreads[i].fn);
+		}
+	}
+	return 0;
+}
+
 kern_return_t
 kernel_thread_start_priority(
 	thread_continue_t       continuation,
@@ -1951,6 +1974,7 @@ kernel_thread_start_priority(
 	}
 
 	*new_thread = thread;
+	ishtar_kthread_note(thread->thread_id, continuation);
 
 	thread_mtx_lock(thread);
 	thread_start(thread);
